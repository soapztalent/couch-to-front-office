  function lv2PosHtml(p){lv2ApplyPos(p);var main=p.pos||'—',sub=p.pos==='D'?(p.dSide||''):(p.pos2||'');return '<span class="lv2-pos"><b>'+esc(main)+'</b>'+(sub?'<i>/ '+esc(sub)+(p.pos==='D'&&p.sideFlex?' ±':'')+'</i>':'')+'</span>';}
  function lv2PosText(p){lv2ApplyPos(p);var sub=p.pos==='D'?(p.dSide||''):(p.pos2||'');return (p.pos||'—')+(sub?' / '+sub:'');}
  function lv2RoleTags(p,kind){var t=[];if(p.ppRole&&kind!=='PK')t.push('PP '+p.ppRole);if(p.pkRole&&kind!=='PP')t.push(p.pkRole);return t.length?' <span class="lv2-roles">'+esc(t.join(' · '))+'</span>':'';}
