  /* ---------- sim lineup (penalties + PP/PK roles) ---------- */
  function lv2SitAdj(S,O,sit){if(sit!=='PP')return 0;return clamp((Number(S.ppAdj)||0)-(Number(O.pkAdj)||0),-12,12)*.7;}
  function simV2Lineup(g,id,club,day){
    if(!club)return null;if(!club.lines||club.lv2LinesV!==LV2.VER)ensureLineup(club);
    var roster=club.roster||[],byId={};roster.forEach(function(p){byId[p.id]=p;});var used={},lines=[],pairs=[],slotOf={};
    function take(pid,slot){var p=byId[pid];if(!p||used[p.id]||!simV2Healthy(p)||p.pos==='G')return null;used[p.id]=true;slotOf[p.id]=slot;return p;}
    var fl=club.lines&&club.lines.forwards||[],dl=club.lines&&club.lines.defense||[];
    for(var i=0;i<4;i++){var l=fl[i]||{};lines.push(LV2.F.map(function(s){return take(l[s],s);}));}
    for(var j=0;j<3;j++){var d=dl[j]||{};pairs.push(LV2.D.map(function(s){return take(d[s],s);}));}
