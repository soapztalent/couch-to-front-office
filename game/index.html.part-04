  function lv2Dressed(club){var on={},L=club.lines||{};(L.forwards||[]).forEach(function(l){LV2.F.forEach(function(s){if(l&&l[s])on[l[s]]=s;});});(L.defense||[]).forEach(function(l){LV2.D.forEach(function(s){if(l&&l[s])on[l[s]]=s;});});(L.goalies||[]).forEach(function(id){if(id)on[id]='G';});return on;}
  function lv2FillUnit(cands,ids,keys,kind,unitNo,exclude){var ok={};cands.forEach(function(p){ok[p.id]=p;});var seen={},out=keys.map(function(k,i){var id=ids&&ids[i];if(!id||!ok[id]||seen[id]||exclude.indexOf(id)>=0)return '';seen[id]=1;return id;}),pairs=[];
    cands.forEach(function(p){if(seen[p.id]||exclude.indexOf(p.id)>=0)return;var u=kind==='PP'?p.ppUnit:p.pkUnit,base=kind==='PP'?lv2Off(p):lv2Def(p);keys.forEach(function(k,i){if(!out[i])pairs.push({p:p,i:i,s:base-lv2RolePen(p,k,kind)*(kind==='PP'?2:2.5)+(u===unitNo?3:u?-1:0)-lv2Rust(p)});});});
    pairs.sort(function(a,b){return b.s-a.s;});pairs.forEach(function(x){if(out[x.i]||seen[x.p.id])return;out[x.i]=x.p.id;seen[x.p.id]=1;});return out;}
  function ensureSpecialTeams(club,opts){if(!club||!Array.isArray(club.roster))return;var fresh=opts&&opts.fresh,old=fresh?{}:(club.specialTeams||{}),on=lv2Dressed(club);
    var sk=club.roster.filter(function(p){return p.pos!=='G'&&lv2Healthy(p)&&on[p.id];});if(sk.length<10)sk=club.roster.filter(function(p){return p.pos!=='G'&&lv2Healthy(p);});
    var st={};st.pp1=lv2FillUnit(sk,old.pp1,LV2.PP,'PP',1,[]);st.pp2=lv2FillUnit(sk,old.pp2,LV2.PP,'PP',2,st.pp1);st.pk1=lv2FillUnit(sk,old.pk1,LV2.PK,'PK',1,[]);st.pk2=lv2FillUnit(sk,old.pk2,LV2.PK,'PK',2,st.pk1);
    var so=[],soSeen={},prior=Array.isArray(old.shootout)?old.shootout:[];prior.forEach(function(id){if(so.length<10&&sk.some(function(p){return p.id===id;})&&!soSeen[id]){so.push(id);soSeen[id]=1;}});
    sk.slice().sort(function(a,b){return (lv2Off(b)+(b.pos==='D'?-4:0))-(lv2Off(a)+(a.pos==='D'?-4:0));}).forEach(function(p){if(so.length<10&&!soSeen[p.id]){so.push(p.id);soSeen[p.id]=1;}});while(so.length<10)so.push('');st.shootout=so;club.specialTeams=st;}
