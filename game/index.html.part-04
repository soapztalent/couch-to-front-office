  function ensureLineup(club,opts){if(!club||!Array.isArray(club.roster))return;opts=opts||{};club.roster.forEach(lv2ApplyPos);
    var fresh=!!opts.fresh||club.lv2LinesV!==LV2.VER||!club.lines||!Array.isArray(club.lines.forwards),old=fresh?{}:club.lines,seed=fresh&&!opts.noSeed&&!club.lv2Seeded,byId={},used={},i,d;
    club.roster.forEach(function(p){byId[p.id]=p;});var lines={forwards:[],defense:[],goalies:['','']};for(i=0;i<4;i++)lines.forwards.push({LW:'',C:'',RW:''});for(d=0;d<3;d++)lines.defense.push({LD:'',RD:''});
