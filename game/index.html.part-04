    if(direction==='down'){player=g.roster.filter(function(p){return p.id===id;})[0];if(!player)return false;if(lv2OnIR(player)){setNotice(player.name+' is on '+player.injStatus+' and cannot be assigned until he is healthy.',true);return false;}
      var sdb=typeof userSendDownBlock==='function'?userSendDownBlock(g,player):'';if(sdb){setNotice(sdb,true);return false;}if(lv2ActiveCount(g)<=18){setNotice('Keep at least 18 active players on the NHL roster.',true);return false;}var waive=ahlWaiverEligible(player);var res=lv2SendDown(g,g.team,g,player,'GM assignment');current.rosterGroup='nhl';if(current.rosterFocus===id)current.rosterFocus='';
      var claimed=/claimed/.test(res),txt=claimed?player.name+' was '+res.replace('claimed by ','claimed off waivers by ')+'.':waive?team(g.team).name+' assign '+player.name+' to the AHL after he cleared waivers.':team(g.team).name+' assign '+player.name+' to the AHL ('+csWhyFree(g,player)+').';
      (g.history=g.history||[]).push({year:seasonLabel(g),text:txt,tag:claimed?'WAIVER CLAIM':'ROSTER MOVE'});if(!opt.quiet){persist();renderOffice();setNotice(txt,claimed);}return true;}
    var pool=g.reserveRoster.concat(g.orgProspects);player=pool.filter(function(p){return p.id===id;})[0];if(!player)return false;
    if(lv2ActiveCount(g)>=csRosterMax(g)){lv2RecallPrompt(g,player);return false;}
    if(lv2PastDeadline(g)&&(Number(g.lv2PDR)||0)>=LV2.PD_RECALLS){setNotice('After the trade deadline a club gets '+LV2.PD_RECALLS+' regular recalls. Emergency recalls still happen automatically when you cannot dress 12 F, 6 D and 2 G.',true);return false;}
    var deal=lv2Deal(g,player);if(!deal.ok){setNotice(deal.notice,true);return false;}g.reserveRoster=g.reserveRoster.filter(function(p){return p.id!==id;});g.orgProspects=g.orgProspects.filter(function(p){return p.id!==id;});lv2ApplyDeal(player,deal);if(typeof capRefRecall==='function')capRefRecall(g,player,deal.salary);else if(g.payrollOn&&g.season===1&&g.payrollRef)g.capAdjustment+=deal.salary;
    lv2ApplyPos(player);player.unsigned=false;player.reserveList=false;player.rosterStatus='Active NHL roster';player.level='NHL';player.club=g.team;player.promotedYear=g.startYear+g.season;player.lv2Buried=0;g.roster.push(player);if(lv2PastDeadline(g))g.lv2PDR=(Number(g.lv2PDR)||0)+1;current.rosterGroup='nhl';current.rosterFocus=id;
    (g.history=g.history||[]).push({year:seasonLabel(g),text:team(g.team).name+' recall '+player.name+' to the NHL roster'+(deal.fresh?' on a '+deal.years+'-year league-minimum contract.':'.'),tag:'ROSTER MOVE'});ensureLineup(g);persist();renderOffice();setNotice(player.name+' recalled to the NHL roster.');return true;}
  function promoteProspect(g,id){return moveRosterPlayer(g,id,'up');}
  function lv2RecallPrompt(g,up){var old=document.getElementById('lv2-prompt');if(old)old.remove();var ug=lv2Grp(up.pos),list=g.roster.filter(function(p){return !lv2OnIR(p);}).sort(function(a,b){var x=lv2Grp(a.pos)===ug?0:1,y=lv2Grp(b.pos)===ug?0:1;return x-y||(Number(a.ovr)||0)-(Number(b.ovr)||0);});
    var box=document.createElement('div');box.id='lv2-prompt';box.className='lv2-prompt';box.setAttribute('role','dialog');box.setAttribute('aria-label','Choose a player to send down');
    box.innerHTML='<div class="lv2-prompt-card"><header><p class="section-kicker">ROSTER IS FULL · 23/23</p><h3>Who goes down for '+esc(up.name)+'?</h3><p>Waiver-exempt players (and players who cleared waivers within the last 30 days / 10 NHL GP) move freely. Anyone marked WAIVERS can be claimed by the other 31 clubs, worst record first.</p></header><div class="lv2-prompt-list">'+list.map(function(p){var w=ahlWaiverEligible(p);return '<button type="button" data-lv2-down="'+esc(p.id)+'" data-lv2-up="'+esc(up.id)+'"><span>'+lv2PosHtml(p)+' '+esc(p.name)+'</span><b>'+p.ovr+'</b><em class="'+(w?'lv2-waive':'lv2-exempt')+'">'+(w?'WAIVERS':(csWaiver(g,p).exempt?'EXEMPT':'CLEARED'))+'</em><em class="cs-way">'+(csWay(g,p).way==='two-way'?'2-WAY':'1-WAY')+'</em></button>';}).join('')+'</div><footer><button type="button" class="button button-quiet" data-lv2-cancel>Cancel</button></footer></div>';document.body.appendChild(box);}
  /* ---------- user waiver claims ---------- */
  function lv2UserClaim(g,p){var pref=g.lv2Claim||{};if(!pref.on||(Number(p.ovr)||0)<(Number(pref.minOvr)||80))return false;if(lv2ActiveCount(g)>=csRosterMax(g))return false;if(lv2Payroll(g,g.team,g)+contractHit(p)>g.cap+lv2LtirRelief(g,g))return false;if(typeof ahlContractCount==='function'&&ahlContractCount(g)>=50)return false;return true;}
  function lv2DoUserClaim(g,fromId,p,date){g.roster.push(p);p.club=g.team;p.reserveList=false;p.level='NHL';p.rosterStatus='Active roster · waiver claim';p.ahlMovedDate=date;p.waiverClaimedFrom=fromId;p.lv2Buried=0;lv2ApplyPos(p);var text=team(g.team).name+' claim '+p.name+' ('+p.pos+', '+p.ovr+' OVR, '+shortMoney(contractHit(p))+') off waivers from '+team(fromId).name+'.';
    g.transactionLog=g.transactionLog||[];g.transactionLog.unshift({when:lv2Pretty(date)+' · WAIVER CLAIM',text:text,teams:[g.team,fromId],tag:'WAIVER CLAIM'});g.transactionLog=g.transactionLog.slice(0,80);(g.history=g.history||[]).push({year:seasonLabel(g),text:text,tag:'WAIVER CLAIM'});lv2Note(g,text);try{ensureLineup(g);}catch(e){}return g.team;}
  /* ---------- lines page ---------- */
  function lv2Rating(p,pen){var o=Number(p.ovr)||0,r=lv2Rust(p),e=o-pen-r;return pen+r>0?'<b class="lv2-ovr-drop" title="'+esc((pen?'-'+pen+' out of position':'')+(pen&&r?' · ':'')+(r?'-'+r+' return rust':''))+'"><s>'+o+'</s><i>→</i>'+e+'</b>':'<b>'+o+'</b>';}
  function lv2Slot(byId,slot,label,id,opt){opt=opt||{};var p=id?byId[id]||null:null,pen=0,flag='';if(p){pen=opt.kind?lv2RolePen(p,opt.key,opt.kind):opt.pos?lv2SlotPen(p,opt.pos):0;if(pen>0)flag='<em class="lv2-flag">'+esc(opt.kind?'NOT A '+(opt.kind==='PP'?LV2.PPROLE[opt.key]:opt.key)+' −'+pen:'OFF-POSITION −'+pen)+'</em>';else if(!opt.kind&&opt.pos&&lv2IsSec(p,opt.pos))flag='<em class="lv2-flag lv2-flag-sec">SECONDARY</em>';}
    var inj=p&&!lv2Healthy(p)?'<em class="lv2-inj">✚ '+esc(lv2InjShort(p))+'</em>':'',rust=p&&lv2Rust(p)?'<em class="lv2-rust">RUST '+p.lv2Rust.g+' GP</em>':'',name=p?p.name:'Drop player here';
    return '<div class="ls-slot-drop'+(pen>0?' lv2-off':'')+'" data-drop-slot="'+slot+'" data-position="'+esc(label)+'"><button type="button" '+(p?'draggable="true" data-chart-player="'+esc(p.id)+'"':'')+' class="ls-player-card '+(p?'filled':'empty')+'" data-click-slot="'+slot+'" data-slot-player="'+esc(id||'')+'" aria-label="'+esc(label+': '+name+(p?', overall '+p.ovr+(pen?', minus '+pen+' out of position':''):''))+'">'+(p?officeAvatar(p):'<span class="ls-position">'+esc(label)+'</span>')+'<span class="ls-player-copy"><strong>'+esc(name)+'</strong><small>'+(p?lv2PosHtml(p)+lv2RoleTags(p,opt.kind):'Open position')+'</small>'+flag+inj+rust+'</span>'+(p?lv2Rating(p,pen):'<b>—</b>')+'</button></div>';}
  function lv2LineCard(byId,line,index,keys,kind){var key=(kind==='forwards'?'forwards.':'defense.')+index+'.',vals=[],offN=0;keys.forEach(function(pos){var p=line[pos]?byId[line[pos]]:null;if(p){vals.push(lv2Eff(p,pos));if(lv2SlotPen(p,pos)>0)offN++;}});var str=vals.length?Math.round(vals.reduce(function(a,b){return a+b;},0)/vals.length):0;
    return '<section class="ls-line-card"><header><strong>'+(kind==='forwards'?'LINE ':'PAIR ')+(index+1)+'</strong><span>'+vals.length+'/'+keys.length+' SET'+(offN?' · <em class="lv2-flag-inline">'+offN+' OFF-POS</em>':'')+'</span><span class="ls-chem">Strength <b>'+str+'</b><i><u style="width:'+str+'%"></u></i></span></header><div class="ls-line-slots">'+keys.map(function(pos){return lv2Slot(byId,key+pos,pos,line[pos],{pos:pos});}).join('')+'</div></section>';}
  function lv2Mini(p,extra){return '<button type="button" draggable="true" class="lv2-mini" data-chart-player="'+esc(p.id)+'">'+lv2PosHtml(p)+'<strong>'+esc(p.name)+'</strong><b>'+p.ovr+'</b>'+(extra||'')+'</button>';}
  function lv2SpecialEditor(g,byId,specialKey,units){var u=units[specialKey],kind=u[1],keys=kind==='PP'?LV2.PP:LV2.PK,ids=g.specialTeams[specialKey]||[],adj=lv2UnitAdj(ids,keys,kind,byId),specN=ids.filter(function(id,i){var p=byId[id];return p&&lv2Spec(p,keys[i],kind);}).length;
    var cells=keys.map(function(k,i){var cls=kind==='PP'?'lv2-cell lv2-'+k.toLowerCase():'lv2-cell lv2-pk'+(i<2?'f':'d')+(i%2+1),lab=kind==='PP'?LV2.PPNAME[k]:LV2.PKNAME[i];return '<div class="'+cls+'"><span class="lv2-cell-label">'+esc(lab)+'</span>'+lv2Slot(byId,'specialTeams.'+specialKey+'.'+i,lab,ids[i],{kind:kind,key:k})+'</div>';}).join('');
    var tabs=Object.keys(units).map(function(key){return '<button type="button" class="ls-unit-tab '+(specialKey===key?'active':'')+'" data-special-unit="'+key+'">'+units[key][0]+'</button>';}).join('');
    return '<div class="ls-units-goalies"><section><div class="ls-unit-tabs">'+tabs+'</div><section class="ls-line-card ls-special-editor"><header><strong>'+u[0]+'</strong><span>'+(kind==='PP'?'1-3-1 UMBRELLA':'2 PK FORWARDS + 2 PK D')+' · SPECIALISTS '+specN+'/'+keys.length+' · UNIT EDGE <b class="'+(adj<0?'lv2-neg':'lv2-plus')+'">'+(adj>=0?'+':'')+adj.toFixed(1)+'</b></span></header><div class="'+(kind==='PP'?'lv2-pp-grid':'lv2-pk-grid')+'"><span class="lv2-net" aria-hidden="true">NET</span>'+cells+'</div><p class="lv2-unit-note">'+(LV2DATA?'Roles come from real NHL usage (QB, flank, bumper, net-front; PK forward and PK defense). A player in a role he does not play loses effectiveness; specialists add to the unit edge in the sim.':'Role data is not loaded, so units are built from position and ratings.')+'</p></section></section><section class="ls-line-group ls-goalies-group"><header><b>GOALIE DEPTH</b><span>STARTER · BACKUP</span></header><div class="ls-line-stack">'+g.lines.goalies.map(function(id,i){return '<section class="ls-line-card"><header><strong>GOALIE '+(i+1)+'</strong><span>'+(i?'BACKUP':'STARTER')+'</span></header>'+lv2Slot(byId,'goalies.'+i,'G'+(i+1),id,{pos:'G'})+'</section>';}).join('')+'</div></section></div>';}
  function renderDepthChart(g){
    if(current.lineGame!==g){current.lineGame=g;current.lineUndo=[];current.linesDirty=false;}assignRoles(g);var roster=g.roster.slice().sort(lv2RosterCmp),byId={};roster.forEach(function(p){byId[p.id]=p;});
    var tabs=['Lines','Special Teams & Goalies','Shootout','Line Strategy'],active=tabs.indexOf(current.lineTab)>=0?current.lineTab:'Lines',units={pp1:['Power play 1','PP',1],pp2:['Power play 2','PP',2],pk1:['Penalty kill 1','PK',1],pk2:['Penalty kill 2','PK',2]},specialKey=units[current.specialUnit]?current.specialUnit:'pp1';current.lineTab=active;current.specialUnit=specialKey;
    var S=function(slot,label,id,opt){return lv2Slot(byId,slot,label,id,opt);},on=lv2Dressed(g),scratches=roster.filter(function(p){return on[p.id]==null&&lv2Healthy(p);}),injured=roster.filter(function(p){return !lv2Healthy(p);}).sort(function(a,b){return (Number(b.injury)||0)-(Number(a.injury)||0);});
    var bench='<section class="ls-line-group lv2-bench"><header><b>EXTRAS / SCRATCHES</b><span>'+scratches.length+' HEALTHY · C · LW · RW · D · G</span></header><div class="lv2-mini-list">'+(scratches.map(function(p){return lv2Mini(p);}).join('')||'<p class="chart-pool-empty">Everyone healthy is dressed.</p>')+'</div><header><b>INJURED</b><span>'+injured.length+' OUT</span></header><div class="lv2-mini-list">'+(injured.map(function(p){return lv2Mini(p,'<em class="lv2-inj">✚ '+esc((p.injuryType||'Injury')+' · '+lv2InjShort(p))+'</em>');}).join('')||'<p class="chart-pool-empty">No injuries.</p>')+'</div></section>';
    var editor='';
    if(active==='Lines')editor='<div class="ls-combination-page"><section class="ls-line-group"><header><b>FORWARD LINES</b><span>LEFT WING · CENTER · RIGHT WING</span></header><div class="ls-line-stack">'+g.lines.forwards.map(function(line,i){return lv2LineCard(byId,line,i,LV2.F,'forwards');}).join('')+'</div></section><section class="ls-line-group"><header><b>DEFENSE PAIRS</b><span>LEFT D · RIGHT D</span></header><div class="ls-line-stack">'+g.lines.defense.map(function(pair,i){return lv2LineCard(byId,pair,i,LV2.D,'defense');}).join('')+'</div></section>'+bench+'</div>';
    else if(active==='Special Teams & Goalies')editor=lv2SpecialEditor(g,byId,specialKey,units);
    else if(active==='Shootout')editor='<section class="ls-line-card ls-shootout-editor"><header><strong>SHOOTOUT ORDER</strong><span>DRAG TO REORDER · TOP 10</span></header><ol class="ls-shootout-list">'+g.specialTeams.shootout.map(function(id,i){return '<li><b class="ls-shootout-number">'+(i+1)+'</b>'+S('specialTeams.shootout.'+i,String(i+1),id)+'</li>';}).join('')+'</ol></section>';
    else editor='<section class="ls-line-card ls-strategy"><header><strong>TEAM SYSTEM</strong><span>APPLIES TO SIMULATED GAMES</span></header><div class="ls-strategy-grid">'+[['offensive','Offensive pressure',['Balanced','Shoot first','Possession','Crash the net']],['forecheck','Forecheck',['1-2-2','2-1-2','1-1-3']],['defensive','Defensive coverage',['Balanced','Tight point','Protect slot']],['neutral','Neutral zone',['1-2-2','1-3-1','2-1-2']],['goalieWorkload','Goalie workload',['Balanced','Ride the starter','Split starts']]].map(function(item){var value=(g.lineStrategy||{})[item[0]]||item[2][0];return '<label>'+item[1]+'<select data-line-strategy="'+item[0]+'">'+item[2].map(function(v){return '<option '+(v===value?'selected':'')+'>'+v+'</option>';}).join('')+'</select></label>';}).join('')+'</div></section>';
    var filter=current.chartPositionFilter||'all',query=(current.chartSearch||'').trim().toLowerCase(),poolPlayers=roster.filter(function(p){return (filter==='all'||filter===lv2Grp(p.pos))&&(!query||(p.name+' '+lv2PosText(p)).toLowerCase().indexOf(query)>=0);});
    var pool=poolPlayers.map(function(p){var st=!lv2Healthy(p)?'INJURED':on[p.id]!=null?'IN LINEUP':'AVAILABLE';return '<button type="button" draggable="true" class="ls-pool-player '+(current.chartSelectedId===p.id?'selected':'')+'" data-chart-player="'+esc(p.id)+'" aria-pressed="'+(current.chartSelectedId===p.id)+'"><span class="ls-grip" aria-hidden="true">⠿</span>'+officeAvatar(p)+'<span class="ls-player-copy"><strong>'+esc(p.name)+'</strong><small>'+lv2PosHtml(p)+' · '+st+'</small></span><b>'+p.ovr+'</b><span class="ls-add" aria-hidden="true">+</span></button>';}).join('')||'<p class="chart-pool-empty">No players match.</p>';
    var rinkForward=g.lines.forwards.map(function(line,i){return '<div class="ls-rink-row"><span>LINE '+(i+1)+'</span>'+LV2.F.map(function(pos){return S('forwards.'+i+'.'+pos,pos,line[pos],{pos:pos});}).join('')+'</div>';}).join(''),rinkDefense=g.lines.defense.map(function(pair,i){return '<div class="ls-rink-pair">'+LV2.D.map(function(pos){return S('defense.'+i+'.'+pos,pos,pair[pos],{pos:pos});}).join('')+'</div>';}).join('');
    var goalies=g.lines.goalies.map(function(id,i){return S('goalies.'+i,'G'+(i+1),id,{pos:'G'});}).join(''),rinkContent=active==='Shootout'?'<ol class="ls-rink-shootout-list">'+g.specialTeams.shootout.map(function(id,i){return '<li><b>'+(i+1)+'</b>'+S('specialTeams.shootout.'+i,String(i+1),id)+'</li>';}).join('')+'</ol>':active==='Special Teams & Goalies'?'<div class="ls-rink-special"><div class="ls-rink-goalie">'+goalies+'</div></div>':'<div class="ls-rink-forwards">'+rinkForward+'</div><div class="ls-rink-defense">'+rinkDefense+'</div><div class="ls-rink-goalie">'+S('goalies.0','G',g.lines.goalies[0],{pos:'G'})+'</div>';
    var filters=['all','F','D','G'].map(function(f){return '<button type="button" class="chart-pool-filter '+(filter===f?'active':'')+'" data-chart-filter="'+f+'">'+({all:'All',F:'F',D:'D',G:'G'}[f])+'</button>';}).join('');
    $('office-content').innerHTML=officeHeader(team(g.team).name,'Lines & Strategy','Real NHL positions. Anyone can play anywhere, but an off-position player loses overall in the sim.')+'<section class="ls-workspace"><div class="ls-toolbar"><div class="ls-commands"><button type="button" data-line-action="autofill" title="Fill open slots by position">✦ <span>Auto Fill</span></button><button type="button" data-line-action="best" title="Rebuild from ratings with everyone at his best position">★ <span>Best Lines</span></button><button type="button" data-line-action="reset" title="Real opening-night lines where known">↻ <span>Reset</span></button><button type="button" data-line-action="undo" '+(!(current.lineUndo||[]).length?'disabled':'')+'>↶ <span>Undo</span></button></div><div class="ls-apply"><span class="'+(current.linesDirty?'dirty':'')+'">'+(current.linesDirty?'● Changes unsaved':'● Lines saved')+'</span><button type="button" data-line-action="apply">Apply Lines</button></div></div><nav class="ls-tabs" aria-label="Line editing views">'+tabs.map(function(tab){return '<button type="button" data-line-tab="'+tab+'" class="'+(active===tab?'active':'')+'" aria-pressed="'+(active===tab)+'">'+tab+'</button>';}).join('')+'</nav><div class="ls-grid"><section class="ls-editor"><div class="ls-editor-heading"><div><p class="section-kicker">'+esc(team(g.team).name.toUpperCase())+' STRATEGY</p><h3>'+esc(active==='Special Teams & Goalies'?units[specialKey][0]:active==='Shootout'?'Shootout order':active)+'</h3></div><span>DRAG A PLAYER INTO A POSITION · RED = OVERALL LOST OUT OF POSITION</span></div>'+editor+'</section><section class="ls-rink-panel"><div class="ls-view-toggle">'+['Lineup view','Ice view'].map(function(view){return '<button type="button" data-line-view="'+view+'" class="'+((current.lineView||'Lineup view')===view?'active':'')+'">'+view+'</button>';}).join('')+'</div><div class="ls-rink"><span class="ls-center-mark">'+esc(g.team)+'</span>'+rinkContent+'</div></section><aside class="ls-pool"><div class="ls-pool-heading"><div><h3>Player pool</h3><span>'+poolPlayers.length+' / '+roster.length+'</span></div><span>DRAG TO ASSIGN</span></div><label class="chart-pool-search"><span aria-hidden="true">⌕</span><input id="chart-player-search" type="search" value="'+esc(current.chartSearch||'')+'" placeholder="Search players..." aria-label="Search players"></label><div class="chart-pool-filters">'+filters+'</div><div class="ls-pool-list">'+pool+'</div></aside></div></section>';
    var workspace=$('office-content').querySelector('.ls-workspace');if(workspace)workspace.dataset.lineView=current.lineView||'Lineup view';}
  function assignChartPlayer(slot,playerId){var g=current.game;if(!g)return false;ensureLineup(g);var parts=String(slot).split('.'),player=g.roster.filter(function(p){return p.id===playerId;})[0];if(!player)return false;
    if(parts[0]==='specialTeams'){if(player.pos==='G'){setNotice('Goalies cannot play on special teams.',true);return false;}if(!lv2Healthy(player)){setNotice(player.name+' is injured.',true);return false;}var unit=g.specialTeams[parts[1]],index=Number(parts[2]);if(!unit||!Number.isInteger(index)||index<0||index>=unit.length)return false;var previous=unit.indexOf(playerId);if(previous===index)return false;pushLineUndo(g);var displaced=unit[index];unit[index]=playerId;if(previous>=0)unit[previous]=displaced||'';
      var twin={pp1:'pp2',pp2:'pp1',pk1:'pk2',pk2:'pk1'}[parts[1]];if(twin&&g.specialTeams[twin]){var ti=g.specialTeams[twin].indexOf(playerId);if(ti>=0)g.specialTeams[twin][ti]=previous<0&&displaced?displaced:'';}
      if(twin){var isPP=parts[1].slice(0,2)==='pp',key=isPP?LV2.PP[index]:LV2.PK[index],pen=lv2RolePen(player,key,isPP?'PP':'PK');if(pen>0)setNotice(player.name+' is not a '+(isPP?LV2.PPROLE[key]:key)+': −'+pen+' effectiveness on this unit.',true);}return true;}
    var grp=parts[0]==='forwards'?'F':parts[0]==='defense'?'D':parts[0]==='goalies'?'G':'';if(!grp)return false;if((grp==='G')!==(player.pos==='G')){setNotice(player.pos==='G'?player.name+' is a goalie and can only play in net.':player.name+' cannot play goal.',true);return false;}
    if(!lv2Healthy(player)){setNotice(player.name+' is injured ('+lv2InjShort(player)+') and cannot dress.',true);return false;}
    var old=parts[0]==='goalies'?g.lines.goalies[Number(parts[1])]:(g.lines[parts[0]]||[])[Number(parts[1])]&&g.lines[parts[0]][Number(parts[1])][parts[2]];if(old===playerId)return false;pushLineUndo(g);var ok=setLinePlayer(g,slot,playerId,true);
    if(ok!==false&&grp!=='G'){var sp=lv2SlotPen(player,parts[2]);if(sp>0)setNotice(player.name+' is out of position at '+parts[2]+': '+player.ovr+' → '+(player.ovr-sp)+' OVR in the sim.',true);}return ok!==false;}
  /* patch19 'Center' premium role: only PRIMARY centers qualify (top two primary C + any primary C whose POT >= the 2C's OVR) */
  if(typeof premiumRosterSelection==='function'){var lv2OrigPremium=premiumRosterSelection;premiumRosterSelection=function(g,id){var club=null;try{club=id===g.team?g:(typeof tradeClubObject==='function'?tradeClubObject(g,id):leagueClub(g,id));}catch(e){club=null;}var pool=(typeof clubRoster==='function'?clubRoster(g,id)||[]:[]).concat(club&&club.reserveRoster||[],club&&club.orgProspects||[]),byId={};pool.forEach(function(p){if(p){lv2ApplyPos(p);byId[p.id]=p;}});
    var r=lv2OrigPremium.apply(this,arguments),keep=function(ids){return (ids||[]).filter(function(pid){return !byId[pid]||lv2IsPrimaryC(byId[pid]);});};if(r){r.centers=keep(r.centers);if(r.topCenters)r.topCenters=keep(r.topCenters);if(r.projectedCenters)r.projectedCenters=keep(r.projectedCenters);}return r;};}
  /* ---------- page panels ---------- */
  function lv2InjRows(list){return list.map(function(x){var p=x.p;return '<tr><td>'+(x.team?'<b>'+esc(x.team)+'</b> ':'')+esc(p.name)+'</td><td>'+lv2PosHtml(p)+'</td><td>'+(Number(p.ovr)||'—')+'</td><td>'+esc(p.injuryType||'Undisclosed')+'</td><td><em class="lv2-st lv2-st-'+esc((p.injStatus||'DTD').toLowerCase())+'">'+esc(p.injStatus||'DTD')+'</em></td><td>'+(Number(p.injury)||0)+' GP</td><td>'+esc(p.injuryReturn?lv2Pretty(p.injuryReturn):'—')+'</td></tr>';}).join('');}
  function lv2InjTable(list,title,sub){return '<section class="panel lv2-panel"><header><p class="section-kicker">'+esc(title)+'</p><h3>'+esc(sub)+'</h3></header>'+(list.length?'<div class="player-table-wrap"><table class="player-table lv2-inj-table"><thead><tr><th>Player</th><th>Pos</th><th>OVR</th><th>Injury</th><th>Status</th><th>Out</th><th>Target</th></tr></thead><tbody>'+lv2InjRows(list)+'</tbody></table></div>':'<p class="lv2-empty">No injuries.</p>')+'<p class="lv2-unit-note">DTD: stays on the roster but cannot dress. IR: 7-day minimum, frees a roster spot, recall without waivers. LTIR: 10 games and 24 days, cap relief while out.</p></section>';}
  function lv2PostRender(){var g=current.game,box=document.getElementById('office-content');if(!g||!box)return;var page=current.page;
    if(page==='roster'){var id=current.rosterTeam&&teamMap[current.rosterTeam]?current.rosterTeam:g.team,club=id===g.team?g:(leagueClub(g,id)||{}),last='';
      Array.prototype.forEach.call(box.querySelectorAll('tr[data-roster-row]'),function(tr){var p=lv2All(club).filter(function(x){return x.id===tr.getAttribute('data-player-id');})[0];if(!p)return;var k=LV2.ORD[p.pos]!=null?p.pos:'—';if(k!==last){last=k;var h=document.createElement('tr');h.className='lv2-group-row';h.innerHTML='<td colspan="11">'+({C:'CENTERS',LW:'LEFT WINGS',RW:'RIGHT WINGS',D:'DEFENSE',G:'GOALTENDERS'}[k]||'OTHER')+'</td>';tr.parentNode.insertBefore(h,tr);}});
      var anchor=box.querySelector('.roster-franchise-table');if(anchor&&!box.querySelector('.lv2-roster-extra')){var wrap=document.createElement('div');wrap.className='lv2-roster-extra';var hurt=(club.roster||[]).filter(function(p){return Number(p.injury)>0;}).map(function(p){return {p:p};});
        var html=lv2InjTable(hurt,'INJURY REPORT · '+team(id).name.toUpperCase(),'Active '+lv2ActiveCount(club)+'/23 · IR/LTIR '+(club.roster||[]).filter(lv2OnIR).length);
        if(id===g.team){var pref=g.lv2Claim||{},wire=(g.ahlLog&&g.ahlLog.rows||[]).filter(function(r){return /waiv/.test(String(r[3]||r.action||''));}).slice(-6).reverse();
          html+='<section class="panel lv2-panel lv2-wire"><header><p class="section-kicker">WAIVER WIRE</p><h3>Claims (worst record picks first)</h3></header><label><input type="checkbox" data-lv2-claim-toggle '+(pref.on?'checked':'')+'> Auto-claim players placed on waivers by other clubs</label> <label>Minimum OVR <select data-lv2-claim-min>'+[76,78,80,82,84].map(function(v){return '<option '+((Number(pref.minOvr)||80)===v?'selected':'')+'>'+v+'</option>';}).join('')+'</select></label><p class="lv2-unit-note">Claims need an open roster spot (23 active) and cap room. Sending down a non-exempt player puts him on waivers; exempt players (CBA 13.4: age at signing + NHL games/seasons) move freely.'+(lv2PastDeadline(g)?' Post-deadline recalls used: '+(Number(g.lv2PDR)||0)+'/'+LV2.PD_RECALLS+'.':'')+'</p>'+(wire.length?'<ul class="lv2-list">'+wire.map(function(r){return '<li>'+esc(Array.isArray(r)?r.join(' · '):JSON.stringify(r))+'</li>';}).join('')+'</ul>':'')+'</section>';}
        wrap.innerHTML=html;anchor.parentNode.insertBefore(wrap,anchor.nextSibling);}}
    else if(page==='salarycap'&&!box.querySelector('.lv2-cap')){var rel=lv2LtirRelief(g,g),lt=g.roster.filter(function(p){return Number(p.injury)>0&&p.injStatus==='LTIR';}),bur=(g.reserveRoster||[]).filter(function(p){return Number(p.lv2Buried)>0&&Number(p.years)>0;}),el=document.createElement('section');el.className='fo-panel lv2-panel lv2-cap';
      el.innerHTML='<header><p class="section-kicker">LTIR & BURIED CONTRACTS</p><h3>Cap ceiling with LTIR relief: '+shortMoney(g.cap+rel)+'</h3></header><div class="lv2-cap-grid"><span>LTIR RELIEF<b>'+shortMoney(rel)+'</b></span><span>SPACE AT FIRST LTIR PLACEMENT<b>'+(g.lv2LtirSpace!=null&&lt.length?shortMoney(g.lv2LtirSpace):'—')+'</b></span><span>BURIED IN AHL<b>'+shortMoney(lv2Buried(g))+'</b></span><span>EFFECTIVE ROOM<b>'+shortMoney(g.cap+rel-capUsed(g))+'</b></span></div>'+(lt.length?'<ul class="lv2-list">'+lt.map(function(p){return '<li>'+esc(p.name)+' · '+shortMoney(contractHit(p))+' · '+esc(p.injuryType||'')+' · '+p.injury+' GP left</li>';}).join('')+'</ul>':'')+(bur.length?'<ul class="lv2-list">'+bur.map(function(p){return '<li>'+esc(p.name)+' buried: '+shortMoney(p.lv2Buried)+' still counts</li>';}).join('')+'</ul>':'')+'<p class="lv2-unit-note">LTIR players still count on the cap; relief equals the injured cap hit minus the space you had when he was placed (2025-26 CBA: capped near the prior average salary unless out for the season). A team coming off LTIR must be cap compliant. A player sent down after clearing waivers still counts for his hit minus (league minimum + $375K).</p>';
      var m=box.querySelector('.metric-row');if(m&&m.parentNode)m.parentNode.insertBefore(el,m.nextSibling);else box.appendChild(el);}
    else if(page==='league'&&!box.querySelector('.lv2-league')){var all=[];teams.forEach(function(t){var c=t.id===g.team?g:leagueClub(g,t.id);(c&&c.roster||[]).forEach(function(p){if(Number(p.injury)>0)all.push({p:p,team:t.id});});});all.sort(function(a,b){return (Number(b.p.ovr)||0)-(Number(a.p.ovr)||0);});
      var wrap2=document.createElement('div');wrap2.className='lv2-league';wrap2.innerHTML=lv2InjTable(all.slice(0,40),'LEAGUE INJURY REPORT',all.length+' players out')+'<section class="panel lv2-panel"><header><p class="section-kicker">LEAGUE NEWS</p><h3>Injuries, recalls, waivers, coaching moves</h3></header>'+((g.lv2News||[]).length?'<ul class="lv2-list">'+g.lv2News.slice(0,30).map(function(n){return '<li><em class="lv2-tag">'+esc(n.tag)+'</em> '+esc(lv2Pretty(n.date))+' · '+esc(n.text)+'</li>';}).join('')+'</ul>':'<p class="lv2-empty">Quiet so far.</p>')+'</section>';box.appendChild(wrap2);}}
  /* ---------- hooks (wrap existing bindings; safe with or without PR #4 / PR #6) ---------- */
  var lv2OrigMatchup=simulateMatchup;simulateMatchup=function(g,idA,idB){var before=lv2Hooked,r=lv2OrigMatchup.apply(this,arguments);if(lv2Hooked===before&&g&&g.stage==='regular'){[idA,idB].forEach(function(id){var c=simV2Club(g,id);if(!c)return;if(id===g.team)lv2TickClub(c);else simHealClub(c);});simInjureClub(g,idA);simInjureClub(g,idB);}return r;};
  var lv2OrigSimGame=simulateGame;simulateGame=function(g){try{lv2GameDay(g);}catch(e){if(window.console)console.error('lines v2 day',e);}var r=lv2OrigSimGame.apply(this,arguments);if(g&&g.lv2Notes&&g.lv2Notes.length){var n=document.getElementById('notice-bar');if(n&&g===current.game){n.hidden=false;n.textContent=((n.textContent||'')+' '+g.lv2Notes.join(' ')).trim();}g.lv2Notes=[];}return r;};
  var lv2OrigWaivers=ahlWaivers;ahlWaivers=function(g,fromId,p,date){if(fromId!==g.team&&lv2UserClaim(g,p)){var me=ahlPointsPct(g,g.team),worse=teams.filter(function(t){return t.id!==g.team&&t.id!==fromId&&ahlPointsPct(g,t.id)<me;}).length;if(worse<=15)return lv2DoUserClaim(g,fromId,p,date);var who=lv2OrigWaivers.apply(this,arguments);return who||lv2DoUserClaim(g,fromId,p,date);}var res=lv2OrigWaivers.apply(this,arguments);if(res&&fromId!==g.team)lv2News(g,res,team(res).name+' claim '+p.name+' off waivers from '+team(fromId).name+'.','WAIVERS',false);else if(!res&&fromId!==g.team)lv2News(g,fromId,p.name+' ('+team(fromId).name+') cleared waivers and was assigned to the AHL.','WAIVERS',false);return res;};
  var lv2OrigManage=ahlManageClub;ahlManageClub=function(g,id,date){var club=leagueClub(g,id);if(!club||id===g.team)return lv2OrigManage.apply(this,arguments);var c=lv2Calls(g,club),keep=AHL.MAX_SWAPS_WEEK,before={};(club.roster||[]).forEach(function(p){before[p.id]=1;});
    var need=lv2ActiveCount(club)<23&&(club.roster||[]).some(function(p){return Number(p.injury)>0;});AHL.MAX_SWAPS_WEEK=(!need||c.n>=LV2.COACH_CALLUPS||(c.last!=null&&g.day-c.last<LV2.COACH_COOLDOWN))?0:Math.min(1,keep);var r;try{r=lv2OrigManage.apply(this,arguments);}finally{AHL.MAX_SWAPS_WEEK=keep;}
    var up=(club.roster||[]).filter(function(p){return !before[p.id];});if(up.length){c.n+=up.length;c.last=g.day;up.forEach(function(p){lv2ApplyPos(p);if(!p.waiverClaimedFrom)lv2News(g,id,team(id).name+' recall '+p.name+' ('+p.pos+', '+p.ovr+') from the AHL.','RECALL',false);});}return r;};
  var lv2OrigToNhl=ahlToNhl;ahlToNhl=function(club,id,p){if(p)p.lv2Buried=0;return lv2OrigToNhl.apply(this,arguments);};
  var lv2OrigCap=capUsed;capUsed=function(g){return lv2OrigCap.apply(this,arguments)+lv2Buried(g);};
  var lv2OrigCapClub=capUsedClub;capUsedClub=function(g,id){var v=lv2OrigCapClub.apply(this,arguments);return id===g.team?v:v+lv2Buried(leagueClub(g,id));};
  var lv2OrigRender=renderPage;renderPage=function(){var r=lv2OrigRender.apply(this,arguments);try{lv2PostRender();}catch(e){if(window.console)console.error('lines v2 render',e);}return r;};
  var lv2OrigUpgrade=upgradeGame;upgradeGame=function(g){var r=lv2OrigUpgrade.apply(this,arguments);try{lv2Migrate(r||g);}catch(e){}return r;};
  document.addEventListener('click',function(e){var t=e.target.closest&&e.target.closest('[data-lv2-down],[data-lv2-cancel]');if(!t)return;var box=document.getElementById('lv2-prompt'),g=current.game;if(t.hasAttribute('data-lv2-cancel')){if(box)box.remove();return;}var down=t.getAttribute('data-lv2-down'),up=t.getAttribute('data-lv2-up');if(box)box.remove();if(!g)return;
    if(moveRosterPlayer(g,down,'down',{quiet:true})){var downName=(lv2All(g).filter(function(p){return p.id===down;})[0]||{}).name||'Player';if(moveRosterPlayer(g,up,'up'))return;persist();renderOffice();setNotice(downName+' was moved off the roster.');}});
  document.addEventListener('change',function(e){var g=current.game;if(!g||!e.target)return;if(e.target.matches('[data-lv2-claim-toggle]')){g.lv2Claim=g.lv2Claim||{minOvr:80};g.lv2Claim.on=!!e.target.checked;persist();setNotice(g.lv2Claim.on?'Auto waiver claims on (OVR '+(g.lv2Claim.minOvr||80)+'+).':'Auto waiver claims off.');}else if(e.target.matches('[data-lv2-claim-min]')){g.lv2Claim=g.lv2Claim||{};g.lv2Claim.minOvr=Number(e.target.value)||80;persist();}});
  window.CTFOLines={pen:lv2SlotPen,rolePen:lv2RolePen,eff:lv2Eff,waiver:function(p){return lv2WaiverInfo(current.game,p);},relief:function(id){var g=current.game;return lv2LtirRelief(g,!id||id===g.team?g:leagueClub(g,id));},
    injure:function(id,pid,games){var g=current.game,c=!id||id===g.team?g:leagueClub(g,id),p=c&&(c.roster||[]).filter(function(x){return x.id===pid;})[0];return p?lv2Injure(g,id||g.team,c,p,games):null;},day:function(){var g=current.game;g.lv2DayKey='';lv2GameDay(g);return true;},sendDown:function(id,pid){var g=current.game,c=id===g.team?g:leagueClub(g,id),p=c&&c.roster.filter(function(x){return x.id===pid;})[0];return p?lv2SendDown(g,id,c,p,'test'):null;}};
  /* ---------- integration fixes (v10 build) ----------
     (a) Real-data 'Injured and/or Non-Roster (NHL published list)' players start in the reserve with no in-game injury, so a healthy
         star sat in the AHL until an emergency recall (NYI Barzal). At season open they go on the NHL roster as IR (LTIR only if
         eligible and the club needs the room), seeded 6-25 games.
     (b) Safety net: an AI club never sends a healthy top-9 F, top-4 D or its No. 1 goalie down (waivers or assignment) unless it is a rehab. */
  function lv2CoreProtected(g,id,club,p){if(!g||!p||id===g.team||!club||!lv2Healthy(p))return false;var k=lv2Grp(p.pos),n=k==='F'?9:k==='D'?4:1,list=(club.roster||[]).concat(club.reserveRoster||[]).filter(function(x){return lv2Grp(x.pos)===k;}).sort(function(a,b){return (Number(b.ovr)||0)-(Number(a.ovr)||0);});var i=list.indexOf(p);return i>=0&&i<n;}
  function lv2InjuredList(g){if(!g||g.lv2InjList)return;g.lv2InjList=1;var moved=0;teams.forEach(function(t){var id=t.id,club=id===g.team?g:leagueClub(g,id);if(!club)return;club.roster=club.roster||[];
      (club.reserveRoster||[]).slice().forEach(function(p){if(!/Injured and\/or Non-Roster/i.test(String(p.rosterStatus||''))||Number(p.injury)>0||!(Number(p.years)>0))return;var k=lv2Grp(p.pos),depth=k==='F'?12:k==='D'?6:2,nhl=club.roster.filter(function(x){return lv2Grp(x.pos)===k;}).map(function(x){return Number(x.ovr)||0;}).sort(function(a,b){return b-a;}),bar=nhl[depth-1]||0;
        if(!((id!==g.team&&lv2CoreProtected(g,id,club,p))||(Number(p.ovr)||0)>=bar))return;
        club.reserveRoster=club.reserveRoster.filter(function(x){return x!==p;});club.roster.push(p);p.reserveList=false;p.level='NHL';lv2ApplyPos(p);
        var n=4+Math.floor(Math.pow(simV2Hash('injlist|'+p.id),1.5)*24),date=lv2Date(g),st=lv2LtirEligible(n)&&lv2NeedsLtir(g,id,club,p,n)?'LTIR':'IR';
        if(st==='LTIR'&&!(club.roster||[]).some(function(x){return x!==p&&Number(x.injury)>0&&x.injStatus==='LTIR';}))club.lv2LtirSpace=Math.max(0,(Number(g.cap)||104000000)-lv2Payroll(g,id,club));
        p.injury=n;p.injuryGames0=n;p.injuryType='Injury (on the NHL injured list at season open)';p.injuryBody='';p.injurySeverity=1;p.injuryDate=date;p.injStatus=st;p.injuryLabel=st;p.injuryReturn=lv2AddDays(date,Math.ceil(n*LV2.DAYS_PER_GAME));p.rosterStatus='Injured reserve · '+st;moved++;});
      if(id!==g.team)(club.reserveRoster||[]).slice().forEach(function(p){if(!/Rated roster pool/i.test(String(p.rosterStatus||''))||!lv2CoreProtected(g,id,club,p))return;var k=lv2Grp(p.pos),low=club.roster.filter(function(x){return lv2Grp(x.pos)===k&&lv2Healthy(x)&&!lv2CoreProtected(g,id,club,x)&&(Number(x.ovr)||0)<(Number(p.ovr)||0);}).sort(function(a,b){return (Number(a.ovr)||0)-(Number(b.ovr)||0);})[0];if(!low)return;
        club.roster=club.roster.filter(function(x){return x!==low;});club.reserveRoster=club.reserveRoster.filter(function(x){return x!==p;});club.roster.push(p);club.reserveRoster.push(low);p.reserveList=false;p.level='NHL';p.rosterStatus='NHL roster (season-open depth fix)';low.reserveList=true;low.level='Minor league';low.ahlMovedDate=lv2Date(g);low.rosterStatus='AHL (season-open depth fix)';g.lv2DepthFix=(g.lv2DepthFix||0)+1;});
      try{ensureLineup(club);}catch(e){}});g.lv2InjListMoved=moved;}
  var lv2SdOrig=ahlSendDown;ahlSendDown=function(g,club,id,role,p,date,reason){if(lv2CoreProtected(g,id,club,p)&&!/rehab/i.test(String(reason||''))){try{ahlLog(g,date,id,role,'kept',p,'core player not sent down ('+(reason||'')+')','');}catch(e){}return 'kept';}return lv2SdOrig.apply(this,arguments);};
  var lv2TaOrig=ahlToAhl;ahlToAhl=function(club,id,p,date,status){var g=current&&current.game;if(g&&lv2CoreProtected(g,id,club,p)&&!/rehab|cleared waivers/i.test(String(status||'')))return;return lv2TaOrig.apply(this,arguments);};
  /* patch15's AI cap-ceiling pass, same logic, but core players are never the send-down candidate */
  v10CapCeilingPass=function(g,why){if(!g||!g.leagueTeams||typeof ahlSendDown!=='function')return 0;var date=(typeof aiCurrentDate==='function'?aiCurrentDate(g):'')||'',moves=0,report=[];
    teams.forEach(function(t){if(t.id===g.team)return;var id=t.id,club=leagueClub(g,id);if(!club)return;var pay0=capUsedClub(g,id);if(pay0<=g.cap)return;var role=typeof ahlRole==='function'?ahlRole(g,id):'',mins={F:12,D:6,G:2},guard=0,done=[];club.reserveRoster=club.reserveRoster||[];
      while(capUsedClub(g,id)>g.cap&&guard++<8){var over=capUsedClub(g,id)-g.cap,cnt={F:0,D:0,G:0};club.roster.forEach(function(p){cnt[ahlGrp(p)]++;});var cands=[];
        club.roster.forEach(function(p){var k=ahlGrp(p),hit=contractHit(p);if(!(hit>0)||!(Number(p.years)>0))return;if(lv2CoreProtected(g,id,club,p))return;var rep=null;if(cnt[k]<=mins[k]||club.roster.length<=20){rep=club.reserveRoster.filter(function(x){return ahlGrp(x)===k&&ahlSigned(x)&&ahlHealthy(x)&&contractHit(x)<hit;}).sort(function(a,b){return (Number(b.ovr)||0)-(Number(a.ovr)||0);})[0];if(!rep)return;}var save=hit-(rep?contractHit(rep):0);if(save>0)cands.push({p:p,rep:rep,save:save,ovr:Number(p.ovr)||70});});
        if(!cands.length)break;var clear=cands.filter(function(c){return c.save>=over;}),pick=clear.length?clear.sort(function(a,b){return a.ovr-b.ovr||a.save-b.save;})[0]:cands.sort(function(a,b){return b.save/Math.max(1,b.ovr-60)-a.save/Math.max(1,a.ovr-60);})[0];
        var res=ahlSendDown(g,club,id,role,pick.p,date,'cap ceiling ('+(why||'season open')+')');if(pick.rep&&club.reserveRoster.indexOf(pick.rep)>=0)ahlToNhl(club,id,pick.rep,date,'Active roster · cap call-up');moves++;done.push(pick.p.name+' '+shortMoney(contractHit(pick.p))+' ('+res+')'+(pick.rep?' ↔ '+pick.rep.name:''));
        if(g.history)g.history.push({year:seasonLabel(g),tag:'ROSTER MOVE',text:team(id).name+' moves '+pick.p.name+' ('+shortMoney(contractHit(pick.p))+') off the NHL roster to get under the '+shortMoney(g.cap)+' cap.'});}
      report.push({id:id,before:pay0,after:capUsedClub(g,id),moves:done});});
    g.v10CapReport={season:seasonLabel(g),why:why||'',cap:g.cap,clubs:report};return moves;};
  var lv2FreshOrig=freshGame;freshGame=function(){var r=lv2FreshOrig.apply(this,arguments);try{lv2InjuredList(r);}catch(e){if(window.console)console.error('lines v2 injured list',e);}return r;};
  var lv2UpgOrig2=upgradeGame;upgradeGame=function(g){var r=lv2UpgOrig2.apply(this,arguments);try{if((r||g)&&(r||g).season===1&&(Number((r||g).day)||0)===0)lv2InjuredList(r||g);}catch(e){}return r;};
  /* ===== end LINES V2 ===== */
  /* ===== PATCH25 UI SYSTEM (v10.1) =====
     Display-only: home page fill-ins (pre-season Team Stats, Top News from real data, tighter Next Game line), plural fixes, active-roster
     count, and the runtime type-scale snap used by ui-system.css. No game logic. */
  function p25Plural(n,one,many){n=Number(n)||0;return n+' '+(Math.abs(n)===1?one:(many||one+'s'));}
  function p25RosterCount(list){list=list||[];var ir=list.filter(function(p){return p&&Number(p.injury)>0&&(p.injStatus==='IR'||p.injStatus==='LTIR');}).length;return (list.length-ir)+' / 23'+(ir?' · '+ir+' IR':'');}
  var P25STAT=null;
  function p25LastSeason(p){var B=window.NHL_STATS_HISTORY;if(!B||!B.byId||!p)return null;var r=B.byId[p.providerId]||B.byId[p.nhlId];
    if(!r){if(!P25STAT){P25STAT={};Object.keys(B.byId).forEach(function(k){var x=B.byId[k];if(x&&x.name)P25STAT[String(x.name).toLowerCase()]=x;});}r=P25STAT[String(p.name||'').toLowerCase()];}
    if(!r||!r.seasons)return null;var keys=Object.keys(r.seasons).sort();var s=r.seasons['20252026']||null;return s;}
  function p25Find(g,id){return (g.roster||[]).concat(g.reserveRoster||[]).find(function(p){return p&&p.id===id;});}
  function p25Short(n){n=String(n||'');var a=n.split(' ');return a.length>1?a[0].charAt(0)+'. '+a.slice(1).join(' '):n;}
  function p25NextGame(g){var cal=(g.calendarGames||[])[g.day],oppId=g.schedule&&g.schedule[Math.min(g.day,g.schedule.length-1)],away=cal&&cal.venue==='AWAY',date='',time='';
    if(cal&&cal.date)date=new Date(cal.date+'T12:00:00Z').toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric',timeZone:'UTC'});
    if(cal&&cal.startTimeUTC)time=new Date(cal.startTimeUTC).toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit',timeZone:'America/New_York'})+' ET';
    return {opp:oppId?team(oppId):null,oppId:oppId,away:away,date:date,time:time};}
  function p25Home(g){var root=$('office-content');if(!root||!root.querySelector('.home-dashboard'))return;
    var mine=g.standings[g.team]||g.record,gp=(mine.w||0)+(mine.l||0)+(mine.otl||0),pre=g.stage==='regular'&&gp===0&&(Number(g.day)||0)===0,ng=g.stage==='regular'?p25NextGame(g):null;
    // Next game: two tight lines instead of one wrapped caps sentence
