    if(seed){club.roster.forEach(function(p){var m=/^(LW|C|RW|LD|RD|G)([1-4])$/.exec(p.lineSlot0||'');if(!m||used[p.id]||!lv2Healthy(p))return;var n=Number(m[2])-1,s=m[1];
        if(s==='G'){if(n<2&&p.pos==='G'&&!lines.goalies[n]){lines.goalies[n]=p.id;used[p.id]=1;}}else if(p.pos!=='G'){var row=lv2Grp(s)==='D'?lines.defense[n]:lines.forwards[n];if(row&&!row[s]){row[s]=p.id;used[p.id]=1;}}});club.lv2Seeded=true;}
    lv2FillRows(club,lines.forwards,LV2.F,used,'F');lv2FillRows(club,lines.defense,LV2.D,used,'D');
    var gs=club.roster.filter(function(p){return p.pos==='G'&&lv2Healthy(p)&&!used[p.id];}).sort(function(a,b){return (Number(b.ovr)||0)-(Number(a.ovr)||0);});
    if(!lines.goalies[0]&&lines.goalies[1]){lines.goalies[0]=lines.goalies[1];lines.goalies[1]='';}for(i=0;i<2;i++)if(!lines.goalies[i]){var gp=gs.shift();if(gp){lines.goalies[i]=gp.id;used[gp.id]=1;}}
