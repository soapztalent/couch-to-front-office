  function csDays(a,b){var x=Date.parse(a),y=Date.parse(b);return isFinite(x)&&isFinite(y)?Math.max(0,Math.round((y-x)/864e5)):0;}
  var csCache=typeof WeakMap==='function'?new WeakMap():null;
  function csRec(p){if(!p||!CS_DATA)return null;if(csCache&&csCache.has(p))return csCache.get(p);var D=CS_DATA,i=D.ids[p.id];
    if(i==null&&p.nhlId!=null)i=D.nhl[String(p.nhlId)];
    if(i==null&&D.nm[csNorm(p.name)]!=null){var j=D.nm[csNorm(p.name)],r0=D.r[j],by=r0[17];if(!by||!(Number(p.age)>0)||Math.abs((csYear(current&&current.game)-by)-Number(p.age))<=1)i=j;}
    var r=i==null?null:D.r[i];if(csCache)csCache.set(p,r);return r;}
  function csSigned(p){try{return ahlSigned(p);}catch(e){return Number(p&&p.years)>0;}}
  function csBirthYear(g,p,r){if(r&&r[17])return r[17];var b=String(p.birthDate||p.born||'').match(/(19|20)\d\d/);if(b)return Number(b[0]);return csYear(g)-(Number(p.age)||22);}
  function csInPro(p){return !!p&&!p.unsigned&&!(p.prospect||/junior|college|europe|ncaa|chl/i.test(String(p.rosterStatus||'')+' '+String(p.level||'')));}
  function csSeasonGp(g,p,y){var Y=csYear(g);if(y===Y)return Number(p.games)||0;var n=0;(p.seasonHistory||[]).forEach(function(h){if(Number(h.year)===y)n+=Number(h.gp)||0;});return n;}
  function csGameGp(g,p){var Y=csYear(g),start=Number(g&&g.startYear)||2026,n=Number(p.games)||0;(p.seasonHistory||[]).forEach(function(h){var y=Number(h.year);if(y>=start&&y<Y)n+=Number(h.gp)||0;});return n;}
  /* Waiver status: real data (CapWages, CBA-checked) plus NHL games/seasons played in the sim; CBA 13.4 calculation otherwise. */
  function csWaiver(g,p){g=g||(current&&current.game)||{};if(!p)return {exempt:true,text:'—'};var Y=csYear(g),r=csRec(p),G=p.pos==='G'?'G':'S',a,s0,yl,gl,cs,last,red,src;
    if(r&&r[5]){a=r[4];s0=r[5];yl=r[6];gl=r[7];cs=r[9];last=r[10];red=r[12];src=r[3]?'source':'calc';}
    else{if(!csSigned(p))return {exempt:true,unsigned:true,src:r?'calc':'estimate',gp:0,text:'Unsigned (no NHL contract)'};
      if(!p.csS0)p.csS0=Y;s0=Number(p.csS0);a=s0-csBirthYear(g,p,r);if(a<18)a=18;var row=a>=25?[1,0]:CS.TBL[G][Math.min(24,a)];yl=row[0];gl=row[1];cs=a<=19?s0:0;last=0;red=0;src=r?'calc':'estimate';}
    var gp=(r?r[8]:0)+csGameGp(g,p);
    if(!cs){if(csSigned(p)&&csInPro(p)){if(!p.csCS)p.csCS=Y;cs=Number(p.csCS);}}
    if(!last){if(a<=19)last=s0+yl-1;else if(cs)last=a>=25?cs:cs+yl-1;else last=9999;}
    if(a<=19&&!red){for(var y=Math.max(s0,Number(g.startYear)||2026);y<=Y;y++){if(csSeasonGp(g,p,y)>=11){last=Math.min(last,y+(G==='G'?3:2));break;}}}
    var ex=Y<=last&&(!gl||gp<gl);
    var until=last>=9999?'his first pro season':csLabel(last);
    var text=ex?'Waiver exempt until '+until+(gl?' or '+gl+' NHL GP ('+gp+' played)':''):'Waivers required';
    return {exempt:ex,years:yl,gpLimit:gl,gp:gp,since:Math.max(0,Y-(cs||s0)),signedAge:a,lastSeason:last,src:src,text:text};}
  /* Waiver-expiry window (CBA 13.2(b)/13.5): after clearing, he can be loaned again without waivers until 10 NHL GP or 30 days on the NHL roster (10 GP on emergency recall). */
  function csWindow(g,p){g=g||(current&&current.game)||{};var w=p&&p.csWin;if(!w||w.s!==g.season)return null;var u=p.csUp,dd=0,dg=0,em=!!((u&&u.em)||(p.lv2CallUp&&p.lv2CallUp.kind==='emergency'));
    if(u&&u.s===g.season&&!p.reserveList){dd=csDays(u.d,csDate(g));dg=Math.max(0,(Number(p.games)||0)-(Number(u.gp)||0));}
    if(em){var e=(w.em||0)+dg;return {open:e<CS.EM_GP,em:true,gp:e,days:w.days||0};}
    var d=(w.days||0)+dd,n=(w.gp||0)+dg;return {open:d<CS.WIN_DAYS&&n<CS.WIN_GP,em:false,gp:n,days:d};}
  function csNeedsWaivers(g,p){if(csWaiver(g,p).exempt)return false;var w=csWindow(g,p);return !(w&&w.open);}
  function csWhyFree(g,p){var s=csWaiver(g,p);if(s.exempt)return 'waiver exempt';var w=csWindow(g,p);if(w&&w.open)return w.em?'emergency recall, '+w.gp+'/10 GP since clearing waivers':'cleared waivers: '+w.gp+'/10 GP, '+w.days+'/30 days used';return 'waivers required';}
  /* contract type */
  function csContractEnd(g,p){return csYear(g)+Math.max(1,Number(p.years)||1)-1;}
  function csWay(g,p){g=g||(current&&current.game)||{};var r=csRec(p);if(!csSigned(p))return {way:'',ahl:0,src:'none'};
    var Y=csYear(g);if(r&&r[0]&&r[15]&&Y<=r[15]&&(Y===2026||csContractEnd(g,p)===r[15]))return {way:r[0]===2?'two-way':'one-way',ahl:r[1],guar:r[18],src:r[20]?'source':'inferred',kind:r[14],yearIdx:csYear(g)-r[16]};
    var min=850000;try{min=leagueMinSalary(g);}catch(e){}var hit=contractHit(p),elc=/entry/i.test(String(p.contractType||p.contractSource||''))||p.elc===true;
    return {way:(elc||hit<min+150000)?'two-way':'one-way',ahl:0,src:'inferred',kind:elc?1:0,yearIdx:0};}
  function csWayLabel(w){return w.way?(w.way==='two-way'?'Two-way':'One-way')+(w.way==='two-way'&&w.ahl?' (AHL $'+(w.ahl>=1e6?(w.ahl/1e6).toFixed(2)+'M':Math.round(w.ahl/1000)+'K')+')':''):'No NHL contract';}
  function csStatusText(g,p){var w=csWay(g,p),s=csWaiver(g,p),win=s.exempt?null:csWindow(g,p);return csWayLabel(w)+' · '+s.text+(win&&win.open?' · cleared waivers, so he can be '+(p.reserveList?'recalled and sent back':'sent down')+' without re-waivers until 10 NHL GP or 30 days on the NHL roster ('+win.gp+'/10 GP, '+win.days+'/30 days)':'');}
  function csShort(g,p){var w=csWay(g,p),s=csWaiver(g,p);return (w.way==='two-way'?'2-WAY':w.way==='one-way'?'1-WAY':'UNSIGNED')+' · '+(s.unsigned?'—':s.exempt?'EXEMPT':(function(){var x=csWindow(g,p);return x&&x.open?'WAIVERS · CLEARED':'WAIVERS';})());}
  /* buried cap charge (CBA 50.5(d)(i)(B)(5)-(7)) */
  function csBuried(g,p){var min=850000;try{min=leagueMinSalary(g);}catch(e){}var w=csWay(g,p),hit=contractHit(p),allow=min+CS.BURY_ALLOW;
    if(w.kind===2&&w.yearIdx>=1)return {amt:Math.max(0,hit-CS.OLD_ALLOW),rule:'35+ contract (year 2+): cap hit above $100K stays on the cap'};
    if(w.way==='two-way'){var sal=Math.max(Number(w.ahl)||0,Number(w.guar)||0);return {amt:Math.max(0,sal-allow),rule:'two-way: minor-league salary/guarantee above '+shortMoney(allow)+' counts'};}
    return {amt:Math.max(0,hit-allow),rule:'one-way: cap hit above '+shortMoney(allow)+' (minimum + $375K) counts'};}
  function csInRef(g,p){try{return capReferenceActive(g)&&p.club===g.team&&!!((g.payrollSnapshotIds||{})[p.id]||p.capRefCharged);}catch(e){return false;}}
  lv2SetBuried=function(g,p){g=g||current.game;if(csInRef(g,p)){p.lv2Buried=0;p.csBuriedRule='already counted in the season-1 real payroll reference';return;}var b=csBuried(g,p);p.lv2Buried=b.amt;p.csBuriedRule=b.rule;};
  lv2WaiverInfo=function(g,p){if(!p)return {exempt:true};var s=csWaiver(g||current.game,p);return {exempt:s.exempt,years:s.years,gpLimit:s.gpLimit,gp:s.gp,since:s.since,signedAge:s.signedAge,text:s.text,src:s.src};};
  ahlWaiverEligible=function(p){return csNeedsWaivers(current&&current.game,p);};
  /* recall/loan tracking */
  function csAllClubs(g){var out=[g];try{teams.forEach(function(t){if(t.id!==g.team){var c=leagueClub(g,t.id);if(c)out.push(c);}});}catch(e){}return out;}
  function csTrack(g){if(!g||!g.roster)return;var date=csDate(g);
    if(g.csInit!==g.season){var ref=false;try{ref=capReferenceActive(g);}catch(e){}csAllClubs(g).forEach(function(c){var user=c===g;(c.reserveRoster||[]).forEach(function(p){if(!csSigned(p))return;if(!csWaiver(g,p).exempt)p.csWin={s:g.season,days:0,gp:0,em:0,d:'camp'};if(!(user&&ref)){var b=csBuried(g,p);p.lv2Buried=b.amt;p.csBuriedRule=b.rule;}});});g.csInit=g.season;}
    csAllClubs(g).forEach(function(c){(c.roster||[]).forEach(function(p){if(!p.csUp||p.csUp.s!==g.season)p.csUp={s:g.season,d:date,gp:Number(p.games)||0,em:!!(p.lv2CallUp&&p.lv2CallUp.kind==='emergency')};});});
    if(g.stage==='regular'&&g.standings){var pc={};try{teams.forEach(function(t){pc[t.id]=ahlPointsPct(g,t.id);});}catch(e){}g.csPct={season:g.season,pct:pc};}}
  var csOrigToAhl=ahlToAhl;ahlToAhl=function(club,id,p,date,status){var g=current&&current.game;if(g&&p){var w=p.csWin,u=p.csUp;
      if(u&&w&&w.s===g.season&&u.s===g.season){var dg=Math.max(0,(Number(p.games)||0)-(Number(u.gp)||0));if(u.em)w.em=(w.em||0)+dg;else{w.days=(w.days||0)+csDays(u.d,date||csDate(g));w.gp=(w.gp||0)+dg;}}
      delete p.csUp;p.csDown=date||csDate(g);if(/cleared waivers/.test(String(status||'')))p.csWin={s:g.season,days:0,gp:0,em:0,d:p.csDown};}
    return csOrigToAhl.apply(this,arguments);};
  var csOrigToNhl=ahlToNhl;ahlToNhl=function(club,id,p,date){var r=csOrigToNhl.apply(this,arguments);var g=current&&current.game;if(g&&p)p.csUp={s:g.season,d:date||csDate(g),gp:Number(p.games)||0,em:!!(p.lv2CallUp&&p.lv2CallUp.kind==='emergency')};return r;};
  lv2SendDown=function(g,id,club,p,reason){var date=lv2Date(g),emerg=!!(p.lv2CallUp&&p.lv2CallUp.kind==='emergency'),s=csWaiver(g,p),win=s.exempt?null:csWindow(g,p),res;
    if(s.exempt||(win&&win.open)){delete p.lv2CallUp;ahlToAhl(club,id,p,date,'AHL / Minor league · '+(emerg?'emergency recall returned':s.exempt?'assigned (waiver exempt)':'assigned (no re-waivers: '+win.gp+'/10 GP, '+win.days+'/30 days)'));lv2SetBuried(g,p);res='down';}
    else{if(win&&win.em&&p.csUp)p.csUp.em=true;delete p.lv2CallUp;res=ahlSendDown(g,club,id,ahlRole(g,id),p,date,reason)||'down';if(res==='cleared')lv2SetBuried(g,p);if(/claimed/.test(res))lv2News(g,id,p.name+' ('+p.pos+', '+p.ovr+') was '+res.replace('claimed by ','claimed off waivers by ')+'.','WAIVERS',false);}
    try{ensureLineup(club);}catch(e){}return res;};
  /* waiver priority: before Nov 1 the previous season's final standings (CBA 13.19) */
  function csPrevPct(g){if(Number(g.season)<=1)return CS_DATA&&CS_DATA.pct?CS_DATA.pct:null;var s=g.csPctPrev;return s&&s.season===g.season-1?s.pct:null;}
  var csOrigWaivers=ahlWaivers;ahlWaivers=function(g,fromId,p,date){var d=String(date||csDate(g)),nov=csYear(g)+'-11-01',prev=d<nov?csPrevPct(g):null;
    if(!prev)return csOrigWaivers.apply(this,arguments);var orig=ahlPointsPct;ahlPointsPct=function(gg,id){var v=prev[id];if(v==null)v=prev[String(id).toUpperCase()];return v==null?orig(gg,id):v;};
    try{return csOrigWaivers.apply(this,arguments);}finally{ahlPointsPct=orig;}};
  function csRosterMax(g){return (lv2PastDeadline(g)||(g&&g.stage==='playoffs'))?999:23;}
  /* user recall: no paper transactions (2026 CBA) */
  var csOrigMove=moveRosterPlayer;moveRosterPlayer=function(g,id,direction,opt){if(g&&direction!=='down'){var pl=(g.reserveRoster||[]).concat(g.orgProspects||[]).filter(function(x){return x.id===id;})[0],d=csDate(g);
      if(pl&&pl.csDown&&g.stage==='regular'&&pl.csDown>=d){var dl='';try{dl=tradeDeadlineISO(g);}catch(e){}if(d!==dl){setNotice('No paper transactions: '+pl.name+' was assigned to the AHL on '+pl.csDown+' and has to play for the AHL club before he can be recalled (2026 CBA). Recall him after the next game day.',true);return false;}}}
    var r=csOrigMove.apply(this,arguments);if(r&&g&&direction!=='down'){var p=(g.roster||[]).filter(function(x){return x.id===id;})[0];if(p)p.csUp={s:g.season,d:csDate(g),gp:Number(p.games)||0,em:false};}return r;};
  /* after the trade deadline only players recalled after it can be loaned (CBA 13.12(j)) */
  var csOrigBlock=typeof userSendDownBlock==='function'?userSendDownBlock:null;userSendDownBlock=function(g,p){var m=csOrigBlock?csOrigBlock.apply(this,arguments):'';if(m)return m;
    try{if(lv2PastDeadline(g)){var dl=tradeDeadlineISO(g);if(!(p.csUp&&p.csUp.s===g.season&&p.csUp.d>dl))return 'After the trade deadline a player can only be loaned to the AHL if he was recalled after the deadline (CBA 13.12(j)). '+p.name+' was on the NHL roster at the deadline.';}}catch(e){}return '';};
  /* season rollover: keep last season's points % for early-season waiver priority */
  function csSeasonRoll(g){if(!g)return;if(g.csPct&&g.csPct.season===g.season-1&&!(g.csPctPrev&&g.csPctPrev.season===g.season-1))g.csPctPrev=g.csPct;}
  var csOrigSimGame=simulateGame;simulateGame=function(g){try{csSeasonRoll(g);csTrack(g);}catch(e){if(window.console)console.error('contract status track',e);}return csOrigSimGame.apply(this,arguments);};
  /* UI */
  function csFind(g,id){var all=[];csAllClubs(g).forEach(function(c){all=all.concat(c.roster||[],c.reserveRoster||[],c.orgProspects||[]);});return all.filter(function(x){return x&&x.id===id;})[0];}
  function csDecorate(){var g=current&&current.game,box=document.getElementById('office-content');if(!g||!box)return;
    if(current.page==='roster'){Array.prototype.forEach.call(box.querySelectorAll('tr[data-roster-row]'),function(tr){if(tr.querySelector('.cs-tag'))return;var p=csFind(g,tr.getAttribute('data-player-id'));if(!p)return;var td=tr.children[5];if(!td)return;var s=document.createElement('small');s.className='cs-tag';s.setAttribute('data-cs-status',csShort(g,p));s.title=csStatusText(g,p);s.textContent=csShort(g,p);td.appendChild(s);});
      var sel=box.querySelector('.roster-player-link[aria-pressed="true"]'),sec=box.querySelector('.roster-detail-section');if(sel&&sec&&!sec.querySelector('.cs-status-row')){var p=csFind(g,sel.getAttribute('data-roster-player'));if(p){var d=document.createElement('div');d.className='roster-status-row cs-status-row';d.innerHTML='<span>Contract · waivers</span><strong>'+esc(csStatusText(g,p))+'</strong>';sec.appendChild(d);}}}
    if(current.page==='salarycap'&&!box.querySelector('.cs-cap')){var el=document.createElement('section');el.className='fo-panel lv2-panel cs-cap';var list=(g.roster||[]).concat(g.reserveRoster||[]).filter(csSigned);
      el.innerHTML='<header><p class="section-kicker">CONTRACT TYPE & WAIVERS</p><h3>One-way / two-way and waiver status</h3></header><table class="player-table"><thead><tr><th>PLAYER</th><th>LEVEL</th><th>CAP HIT</th><th>TYPE</th><th>WAIVERS</th><th>IF BURIED IN AHL</th></tr></thead><tbody>'+list.map(function(p){var w=csWay(g,p),s=csWaiver(g,p),b=csBuried(g,p);return '<tr data-cs-player="'+esc(p.id)+'"><td>'+esc(p.name)+'</td><td>'+(!p.reserveList?'NHL':'AHL')+'</td><td>'+shortMoney(contractHit(p))+'</td><td>'+esc(csWayLabel(w))+'</td><td>'+esc(s.text)+'</td><td title="'+esc(b.rule)+'">'+shortMoney(b.amt)+'</td></tr>';}).join('')+'</tbody></table><p class="lv2-unit-note">Buried cap charge: one-way contracts count the cap hit above league minimum + $375K; two-way contracts only count AHL salary/guarantee above that; 35+ contracts (2nd year on) count everything above $100K. Exempt players move freely; others go on waivers unless they cleared within the last 30 days / 10 NHL GP.</p>';
      var host=box.querySelector('.lv2-cap')||box.firstElementChild;if(host&&host.parentNode)host.parentNode.insertBefore(el,host.nextSibling);else box.appendChild(el);}}
  function csDecorateModal(){var g=current&&current.game;if(!g||typeof officeUI!=='object'||officeUI.modal!=='player-card')return;var m=document.getElementById('workspace-modal');if(!m)return;var st=m.querySelector('.player-file-status');if(!st||st.querySelector('.cs-modal-row'))return;var p=csFind(g,officeUI.side);if(!p)return;var d=document.createElement('div');d.className='cs-modal-row';d.innerHTML='<span>CONTRACT · WAIVERS</span><strong>'+esc(csStatusText(g,p))+'</strong>';st.appendChild(d);}
  var csOrigRender=renderPage;renderPage=function(){var r=csOrigRender.apply(this,arguments);try{var g=current&&current.game;if(g){csSeasonRoll(g);csTrack(g);}csDecorate();}catch(e){if(window.console)console.error('contract status render',e);}return r;};
  var csOrigModal=officeModalContent;officeModalContent=function(){var r=csOrigModal.apply(this,arguments);try{csDecorateModal();}catch(e){if(window.console)console.error('contract status modal',e);}return r;};
  (function(){try{var st=document.createElement('style');st.textContent='.cs-tag{display:block;font-size:10px;letter-spacing:.04em;opacity:.8}.cs-modal-row{display:flex;justify-content:space-between;gap:8px}.cs-modal-row strong{font-size:12px;text-align:right;max-width:70%}.cs-cap table{width:100%}';document.head.appendChild(st);}catch(e){}})();
  window.CTFOStatus={data:function(){return CS_DATA;},rec:csRec,waiver:function(p){return csWaiver(current.game,p);},window:function(p){return csWindow(current.game,p);},way:function(p){return csWay(current.game,p);},buried:function(p){return csBuried(current.game,p);},text:function(p){return csStatusText(current.game,p);},short:function(p){return csShort(current.game,p);},track:function(){csTrack(current.game);},rosterMax:function(){return csRosterMax(current.game);}};
  /* ===== end CTFO contract status ===== */
  /* ===== TRADE VALUE v2 (trade-value/apply_value.py) =====
     User rule (Oct 8): "value picks a lot more". Picks were ~half of what a top-6 forward was worth, and a young RFA's
     ceiling was valued as if he had already reached it (77 OVR / 91 POT at 23 = an 88 OVR) on top of a growth projection,
     so a retooling club paid two 1sts + a rental for a 77 OVR depth RFA. This block:
       1. re-prices every draft pick (projected slot from the original club's standing, conditions, modest future discount);
       2. bounds the ceiling credit for 22-26 year-olds by how believable the ceiling is (label + size of the gap), and caps
          what a not-yet-established depth player can be worth (well under a mid 1st);
       3. makes AI clubs protect their 1sts (own-pick premium; a 1st only for a top-6/top-4 player, two only for a star);
       4. grades deadline deals on value given vs received with a full A+ ... F spread.
     Unchanged: deadline calls 115-140% (meter), counter 95-105%, Center role +15% (primary C only), age<=21 valued on full ceiling.
     v10.3 adds proven-star values, the ceiling discount, franchise-star protection, the 2-firsts cap and the 115% call floor (see below). */
  var TV={
    R1_FLOOR:240,R1_TOP:300,R1_DECAY:8,      // 1st by slot: 240 + 300*e^(-(slot-1)/8) -> #1 540, #5 422, #10 337, #16 286, #24 257, #32 246
    R2_FLOOR:92,R2_TOP:60,R2_DECAY:12,       // 2nd (solid prospect): #33 152, #48 109, #64 97
    R3_FLOOR:36,R3_TOP:14,R3_DECAY:12,       // 3rd: 50 -> 37
    LATE:{4:20,5:11,6:6,7:4},                // later rounds drop off steeply
    YEAR_DISC:.92,                           // per season ahead (modest)
    SLOT_REGRESS:.30,SLOT_REGRESS_MAX:.60,   // future-year projected slot regresses toward the middle 30%/season (max 60%)
    EARLY_REGRESS:.50,EARLY_GP:45,           // current-year slot early in the season: up to 50% toward the middle until ~45 GP
    PROTECT_SPREAD:3,PROTECT_SPREAD_YR:2,    // protected pick: conveys with prob. ramping over +-spread slots around the protection line
    COMP_W:.90,UPGRADE_P:.20,OPTION_W:.92,OWED_MIN:.10,OWED_MIN_DISC:.08,
    // User rule (9:34): an unprotected pick is worth the most; every protection costs value, more the deeper it is, more again when
    // the club projects inside it, and a rollover/compensation can never lift it back to the unprotected value.
    PROTECT_DISC:[[1,.05],[3,.10],[5,.15],[10,.25],[12,.30],[15,.35],[20,.40]], // discount vs unprotected by protection depth (top-N), interpolated
    INSIDE_EXTRA:.15,                        // when it falls inside the protection: at least a further 15% off the protected value
    CRED_LABEL:{high:1,med:.8,medium:.8,low:.6,exact:1,'':.85}, // ceiling belief for 22-26 year-olds by potential label
    GAP_FREE:6,GAP_STEP:.05,CRED_MIN:.30,    // ... minus 5%/pt of (POT-OVR) beyond 6, full effect from age 23
    DEPTH_OVR:81,DEPTH_ESCAPE_VO:84,DEPTH_CAP:.75,DEPTH_CLUB_SLACK:1.10, // sub-81 OVR player whose believable ceiling is < 84: max .75 x a mid 1st (club view +10%)
    YOUNG_RFA_MAX:1.12,                      // a club's 'control years' premium on a young RFA: at most +12% over his neutral value
    OWN_FIRST_KEEP:{REBUILD:1.30,YOUTH_MOVEMENT:1.30,RETOOL:1.20,BUBBLE:1.10,CONTENDER:1.0,WIN_NOW:1.0},
    IMPACT_F:83,IMPACT_D:82,IMPACT_G:84,STAR:87,BLOCK:100000, // one net 1st out needs a top-6 F / top-4 D (league median 6th F = 84, 4th D = 84); two need a star
    GRADE_W_NEUTRAL:.70,GRADE_OWN_MIN:.5,GRADE_OWN_MAX:1.5, // own valuation counts 30% and is clamped (a rebuilder's near-zero keep value on a rental can't turn a loss into an A+)
    GRADES:[[1.30,'A+'],[1.15,'A'],[1.07,'A\u2212'],[1.02,'B+'],[.97,'B'],[.92,'B\u2212'],[.87,'C+'],[.82,'C'],[.77,'C\u2212'],[.68,'D'],[0,'F']]
  };
  function tvCurve(round,slot){slot=clamp(Number(slot)||16,1,32);if(round===1)return TV.R1_FLOOR+TV.R1_TOP*Math.exp(-(slot-1)/TV.R1_DECAY);if(round===2)return TV.R2_FLOOR+TV.R2_TOP*Math.exp(-(slot-1)/TV.R2_DECAY);if(round===3)return TV.R3_FLOOR+TV.R3_TOP*Math.exp(-(slot-1)/TV.R3_DECAY);return (TV.LATE[round]||3)*(1.05-.003*(slot-1));}
  function tvMid1st(){return tvCurve(1,16);}
  function tvYearNow(g){return Number((g.offseason&&g.offseason.year)||(Number(g.startYear)+Number(g.season)));}
  function tvProjSlot(g,origin,ya){var s=16.5;try{s=draftSlotForTeam(g,origin);}catch(e){}if(ya>0)return s+(16.5-s)*Math.min(TV.SLOT_REGRESS_MAX,TV.SLOT_REGRESS*ya);
    if(g.stage==='regular'){var r=g.standings&&g.standings[origin],gp=r?(Number(r.w)||0)+(Number(r.l)||0)+(Number(r.otl)||0):0;s=s+(16.5-s)*TV.EARLY_REGRESS*Math.max(0,1-gp/TV.EARLY_GP);}return s;}
  function tvKey(k){var a=String(k||'').split('-');return {origin:a[0],year:Number(a[1]),round:Number(a[2])};}
  function tvPlain(g,origin,year,round){var ya=Math.max(0,year-tvYearNow(g));return tvCurve(round,tvProjSlot(g,origin,ya))*Math.pow(TV.YEAR_DISC,ya);}
  function tvConvey(slot,top,ya){var sp=TV.PROTECT_SPREAD+TV.PROTECT_SPREAD_YR*ya;return clamp((slot-top-.5)/(2*sp)+.5,.03,.97);}
  function tvProtTop(key){try{var r=typeof realPickMap==='function'?realPickMap()[key]:null,c=r&&(r.conditions||[]).filter(function(x){return x.kind==='protected';})[0];return c?Number(c.top)||0:0;}catch(e){return 0;}}
  function tvProtDisc(top){var T=TV.PROTECT_DISC;top=Number(top)||0;if(top<=T[0][0])return T[0][1];for(var i=1;i<T.length;i++)if(top<=T[i][0])return T[i-1][1]+(T[i][1]-T[i-1][1])*(top-T[i-1][0])/(T[i][0]-T[i-1][0]);return T[T.length-1][1];}
  // Protected pick vs the same pick unprotected (U): conveys -> U x (1-d); kept -> the compensation, never above U x (1-d) x (1-INSIDE_EXTRA).
  function tvProtected(U,slot,top,ya,comp){var d=tvProtDisc(top),pc=tvConvey(slot,top,ya),out=U*(1-d),inside=Math.min(out*(1-TV.INSIDE_EXTRA),Math.max(0,comp)*TV.COMP_W*(1-d));return {v:Math.min(out,pc*out+(1-pc)*inside),d:d,pc:pc};}
  // Neutral value of a draft pick (replaces the old 205/88/43... scale). Conditions that reduce certainty (protection, owed, option)
  // only ever lower it below the unprotected value U; better/worse-of just picks which slot U is priced at; an upgrade adds its expected bump.
  pickValue=function(g,p){var round=Math.max(1,Number(p.round)||1),ny=tvYearNow(g),year=Number(p.year)||ny,ya=Math.max(0,year-ny),origin=p.origin||p.team,
      slot=p.overall?((Number(p.overall)-1)%32)+1:tvProjSlot(g,origin,ya),disc=Math.pow(TV.YEAR_DISC,ya),conds=(p.conditions||[]).filter(function(c){return c&&!c.resolved;});
    conds.forEach(function(c){if((c.kind==='better_of'||c.kind==='worse_of')&&!p.overall){var ss=(c.candidates||[]).map(function(t){return tvProjSlot(g,t,ya);});if(ss.length)slot=c.kind==='better_of'?Math.min.apply(null,ss):Math.max.apply(null,ss);}});
    var U=tvCurve(round,slot)*disc,v=U,minD=0,bump=0;
    conds.forEach(function(c){try{
      if(c.kind==='protected'){var comp=(c.compensation||[]).reduce(function(n,x){var k=tvKey(x.key);return n+(k.round?tvPlain(g,k.origin,k.year,k.round):0);},0),pr=tvProtected(U,slot,Number(c.top)||0,ya,comp);v*=pr.v/U;minD=Math.max(minD,pr.d);}
      else if(c.kind==='owed'){var sk=tvKey(c.sourceKey),top=tvProtTop(c.sourceKey),pk=1;if(top&&sk.round){var sya=Math.max(0,sk.year-ny);pk=Math.max(TV.OWED_MIN,tvConvey(tvProjSlot(g,sk.origin,sya),top,sya));}v*=Math.min(1-TV.OWED_MIN_DISC,pk);minD=Math.max(minD,TV.OWED_MIN_DISC);}
      else if(c.kind==='option'){v*=TV.OPTION_W;minD=Math.max(minD,1-TV.OPTION_W);}
      else if(c.kind==='upgrade'){var to=Number(c.toRound)||round;if(to<round)bump+=TV.UPGRADE_P*(tvCurve(to,slot)-tvCurve(round,slot))*disc;}
      else if(c.kind!=='better_of'&&c.kind!=='worse_of'){v*=TV.OPTION_W;minD=Math.max(minD,1-TV.OPTION_W);}   // any other condition: treat as uncertainty
    }catch(e){}});
    if(minD>0)v=Math.min(v,U*(1-minD));   // compensation / rollovers can never lift a conditional pick to its unprotected value
    v+=bump*(minD>0?(1-minD):1);
    return Math.max(2,Math.round(v));};
  function tvPriceTable(round,slot,ya,top,comp){var U=tvCurve(round,slot)*Math.pow(TV.YEAR_DISC,ya||0);if(!top)return Math.round(U);return Math.round(Math.min(tvProtected(U,slot,top,ya||0,comp).v,U*(1-tvProtDisc(top))));}
  // Believable ceiling: age <= 21 keeps the full ceiling (user rule); 22-26 year-olds get p19's age weight x credibility.
  function tvCred(p){var age=Number(p&&p.age)||27;if(!p||age<=21)return 1;var o=Number(p.ovr)||0,pot=Math.max(o,Number(p.potential)||o),lab=String(p.nhlRatings&&p.nhlRatings.potentialLabel||'').toLowerCase(),lf=TV.CRED_LABEL[lab]!=null?TV.CRED_LABEL[lab]:TV.CRED_LABEL[''];
    return clamp(lf*(1-Math.max(0,pot-o-TV.GAP_FREE)*TV.GAP_STEP*Math.min(1,(age-21)/2)),TV.CRED_MIN,1);}
  p19ValueOvr=function(p){var o=Number(p&&p.ovr)||0,pot=Math.max(o,Number(p&&p.potential)||o);if(!p||p.pos==='G')return o;return o+(pot-o)*p19PotWeight(p.age)*tvCred(p);};
  var tvPrevProspect=aiProspectValue;aiProspectValue=function(p){var c=tvCred(p);if(c>=1)return tvPrevProspect(p);var o=Number(p.ovr)||0,pot=Math.max(o,Number(p.potential)||o);return tvPrevProspect(Object.assign({},p,{potential:o+(pot-o)*c}));};
  function tvDepth(p){if(!p||p.round||p.pos==='G')return false;return (Number(p.ovr)||0)<TV.DEPTH_OVR&&p19ValueOvr(p)<TV.DEPTH_ESCAPE_VO;}
  function tvDepthCap(g,p){return TV.DEPTH_CAP*tvMid1st()*(typeof p19IsCenter==='function'&&p19IsCenter(g,p)?P19.CENTER:1);}
  var tvPrevMarket=aiMarket;aiMarket=function(g,a){var v=tvPrevMarket.apply(this,arguments);if(typeof v==='number'&&a&&!a.round&&tvDepth(a))v=Math.min(v,tvDepthCap(g,a));return v;};
  var tvPrevAiValue=aiValue;aiValue=function(g,ctx,a,receiving){var key='tv|'+(receiving?'in|':'out|')+(a.round?pickKey(a):a.id);if(ctx&&ctx.values&&ctx.values[key]!=null)return ctx.values[key];var v=tvPrevAiValue.apply(this,arguments);
    if(a.round){if(!receiving&&Number(a.round)===1&&(a.origin||a.team)===ctx.id)v*=TV.OWN_FIRST_KEEP[ctx.role]||1;}
    else if(!aiIsProspect(a)){var s=aiStatusInfo(g,a);if(receiving&&s&&s.youngRfa)v=Math.min(v,s.neutral*TV.YOUNG_RFA_MAX);if(tvDepth(a))v=Math.min(v,tvDepthCap(g,a)*TV.DEPTH_CLUB_SLACK);}
    if(ctx&&ctx.values)ctx.values[key]=v;return v;};
  // AI clubs protect their 1sts: each net 1st out needs a top-6 F / top-4 D (or a blue-chip young player) back; two need a star.
  function tvImpactOvr(a){if(!a||a.round)return 0;var o=Number(a.ovr)||0,vo=p19ValueOvr(a),age=Number(a.age)||27,adj=a.pos==='D'?TV.IMPACT_F-TV.IMPACT_D:a.pos==='G'?TV.IMPACT_F-TV.IMPACT_G:0;
    var eff=aiIsProspect(a)?vo-(age<=21?3:6):Math.max(o,age<=23?vo-1:o);return eff+adj;}
  function tvFirstsBlock(g,ctx,give,get){var n1=function(l){return l.filter(function(a){return a&&a.round&&Number(a.round)===1;}).length;},net=n1(give)-n1(get);if(net<=0)return '';
    var best=get.reduce(function(m,a){return Math.max(m,tvImpactOvr(a));},0);if(best>=(net>=2?TV.STAR:TV.IMPACT_F))return '';return net>=2?'two 1sts need a star back':'a 1st needs a top-6/top-4 player back';}
  var tvPrevSide=aiSideScore;aiSideScore=function(g,ctx,give,get){var s=tvPrevSide.apply(this,arguments);try{if(ctx&&g&&ctx.id&&ctx.id!==g.team&&!ctx.capTrouble){var why=tvFirstsBlock(g,ctx,give||[],get||[]);if(why){s.give+=TV.BLOCK;s.tvBlock=why;aiNote('1st protected: '+why);}}}catch(e){}return s;};
  // Desk (Trade Office) values use the same pick scale and depth cap; AI clubs' own 1sts carry the keep premium.
  var tvPrevGm=gmAssetValue;gmAssetValue=function(g,id,asset){var v=tvPrevGm.apply(this,arguments);if(typeof v!=='number'||!asset)return v;
    if(asset.round){if(g&&id!==g.team&&Number(asset.round)===1&&(asset.origin||asset.team)===id){var r='';try{r=(leagueClub(g,id).orgState||{}).role||'';}catch(e){}v=Math.round(v*(TV.OWN_FIRST_KEEP[r]||1));}return v;}
    if(tvDepth(asset))v=Math.min(v,Math.round(tvDepthCap(g,asset)));return v;};
  // Deadline grades: value received / value given (70% neutral market, 30% the club's own valuation clamped to .5-1.5), A+ ... F.
  dlScore=function(e,side){var mA=Number(e.marketA)||0,mB=Number(e.marketB)||0,v=side==='A'?e.valueA:e.valueB,n=side==='A'?mB/Math.max(1,mA):mA/Math.max(1,mB),o=v&&v.give>0?v.get/v.give:n;return TV.GRADE_W_NEUTRAL*Math.min(3,n)+(1-TV.GRADE_W_NEUTRAL)*clamp(o,TV.GRADE_OWN_MIN,TV.GRADE_OWN_MAX);};
  dlGrade=function(s){for(var i=0;i<TV.GRADES.length;i++)if(s>=TV.GRADES[i][0])return TV.GRADES[i][1];return 'F';};
  /* ----- v10.3: proven stars, ceiling discount, franchise-star protection, 2-firsts cap, 115% call floor -----
     User rules (9:45): a proven star (league top ~20 by OVR) is worth more than ANY young player valued on ceiling; a ceiling is
     worth at most ~82% of the same OVR proven; AI clubs only move a franchise star for a king's ransom or when something happens
     (cap trouble, aging star on a rebuild/retool club, a pending UFA they won't re-sign / pending RFA they can't afford, a trade
     request); one star deal per deadline; never more than two 1sts in one AI deadline deal. Steering (9:46): deadline calls and
     pitches never below 115% in the AI club's favour, after noon too (counters stay 95-105%). */
  var TVS={STAR_N:20,STAR_MIN_OVR:90,STAR_AGE_MAX:33,AGING_AGE:30,
    STAR_PREM:1.30,STAR_PREM_STEP:.04,STAR_PREM_MAX:1.50,     // franchise-star premium on market value: 1.30 at the star line, +.04/OVR above, max 1.50
    CEIL_SHARE:.82,                                           // ceiling-based value <= 82% of a proven player of his value OVR (season value + control; no growth, no cheap-contract surplus)
    STAR_LINE_SHARE:.92,STAR_LINE_MIN:1.40,                   // ... and <= 92% of the lowest franchise star (line floored at 1.4 x a mid 1st)
    KING_KEEP:1.35,KING_PREMIUM_N:2,PREMIUM_MIN:.90,          // untouchable without a trigger: club values him +35% and wants 2+ premium assets (1sts / players >= .9 x mid 1st)
    MAX_FIRSTS:2,STAR_DEALS_PER_DEADLINE:1};
  var tvStarC={k:''},tvCtxDepth=0,tvNoKeep=0,tvLastSingle=null,tvPackStar=null;
  function tvSKey(g){return g.season+'|'+g.stage+'|'+(g.day||0)+'|'+(aiStatusNow&&aiStatusNow.kind||'');}
  function tvStars(g){var k=tvSKey(g);if(tvStarC.k===k)return tvStarC;var o=[];teams.forEach(function(t){(clubRoster(g,t.id)||[]).forEach(function(p){if(p&&!p.round)o.push(Number(p.ovr)||0);});});o.sort(function(a,b){return b-a;});
    tvStarC={k:k,thr:Math.max(TVS.STAR_MIN_OVR,o[Math.min(o.length,TVS.STAR_N)-1]||99),line:null,desk:{}};return tvStarC;}
  function tvIsStar(g,p){return !!p&&!p.round&&!aiIsProspect(p)&&(Number(p.ovr)||0)>=tvStars(g).thr;}
  function tvFranchiseInfo(p,si){return (Number(p.age)||27)<=TVS.STAR_AGE_MAX&&!(si&&(si.rental||si.rights));}
  function tvIsFranchise(g,p){if(!tvIsStar(g,p))return false;var si=null;try{si=aiStatusInfo(g,p);}catch(e){}return tvFranchiseInfo(p,si);}
  function tvStarPrem(g,p){return Math.min(TVS.STAR_PREM_MAX,TVS.STAR_PREM+TVS.STAR_PREM_STEP*Math.max(0,(Number(p.ovr)||0)-tvStars(g).thr));}
  function tvExplicitUT(p){return p&&(p.untouchable===true||p.untouchable===1||String(p.untouchable).toLowerCase()==='true');}
  function tvOwner(g,p){if(!p)return '';if((g.roster||[]).indexOf(p)>=0)return g.team;for(var i=0;i<teams.length;i++){var r=clubRoster(g,teams[i].id)||[];if(r.indexOf(p)>=0||r.some(function(x){return x.id===p.id;}))return teams[i].id;}return '';}
  // 'Something happens': the only reasons an AI club shops a star without a king's ransom.
  function tvTrigger(g,id,p,ctx){if(!p||!id||id===g.team)return '';var st={};try{st=(leagueClub(g,id)||{}).orgState||{};}catch(e){}var role=(ctx&&ctx.role)||st.role||'';
    if((ctx&&ctx.capTrouble)||st.capTrouble)return 'cap trouble';
    if((role==='REBUILD'||role==='YOUTH_MOVEMENT'||role==='RETOOL')&&(Number(p.age)||27)>=TVS.AGING_AGE)return 'aging star on a '+role.toLowerCase().replace('_',' ')+' club';
    var si=null;try{si=aiStatusInfo(g,p);}catch(e){}
    if(si&&si.pending&&si.status==='UFA'&&role!=='WIN_NOW'&&role!=='CONTENDER')return 'pending UFA they won\u2019t re-sign';
    if(ctx&&ctx.cantAffordIds&&ctx.cantAffordIds[p.id])return 'pending RFA they can\u2019t afford';
    if(p.tradeRequest)return 'trade request';return '';}
  function tvScaleInfo(info,k){return Object.assign({},info,{now:info.now*k,premium:(info.premium||0)*k,control:(info.control||0)*k,surplus:(info.surplus||0)*k,growth:(info.growth||0)*k,rentalEq:(info.rentalEq||0)*k,neutral:Math.max(2,Math.round(info.neutral*k))});}
  // Lowest market value among franchise stars (final aiMarket scale, Center role included).
  function tvStarLine(g){var S=tvStars(g);if(S.line!=null)return S.line;S.line=Infinity;var m=Infinity;
    teams.forEach(function(t){(clubRoster(g,t.id)||[]).forEach(function(p){if(!p||(Number(p.ovr)||0)<S.thr||aiIsProspect(p))return;var si=aiStatusInfo(g,p);if(!tvFranchiseInfo(p,si))return;m=Math.min(m,aiMarket(g,p));});});
    S.line=Math.max(isFinite(m)?m:0,TVS.STAR_LINE_MIN*tvMid1st());return S.line;}
  var tvPrevStatus=aiStatusInfo;aiStatusInfo=function(g,p){var info=tvPrevStatus.apply(this,arguments);if(!info||!p||p.round||String(p.id).indexOf('#')>=0)return info;
    var key='tvs|'+p.id+'|'+tvSKey(g)+'|'+(p.years||0)+'|'+(p.club||'');if(aiStatusCache[key])return aiStatusCache[key];var out=info,o=Number(p.ovr)||0,S=tvStars(g);
    if(o>=S.thr){if(tvFranchiseInfo(p,info)){out=tvScaleInfo(info,tvStarPrem(g,p));out.tvStar='franchise';}else out=Object.assign({},info,{tvStar:'star'});}
    else if(info.valueOvr!=null&&info.valueOvr>o){var base=p19OrigStatus.call(this,g,p),floor=base?Math.max(2,base.neutral-(base.growth||0)):2,
        cm=typeof p19IsCenter==='function'&&p19IsCenter(g,p)?P19.CENTER:1,cap1=TVS.CEIL_SHARE*Math.max(0,info.neutral-(info.growth||0)-(info.surplus||0)),cap2=TVS.STAR_LINE_SHARE*tvStarLine(g)/cm,
        t=Math.max(floor,Math.min(info.neutral,cap1,cap2));if(t<info.neutral){out=tvScaleInfo(info,t/info.neutral);out.tvCeil={floor:Math.round(floor),cap1:Math.round(cap1),cap2:Math.round(cap2)};}}
    aiStatusCache[key]=out;return out;};
  var tvPrevProspect2=aiProspectValue;aiProspectValue=function(p){var v=tvPrevProspect2.apply(this,arguments);if(tvStarC.line!=null&&isFinite(tvStarC.line))v=Math.min(v,Math.round(TVS.STAR_LINE_SHARE*tvStarC.line));return v;};
  function tvN1(l){return (l||[]).filter(function(a){return a&&a.round&&Number(a.round)===1;}).length;}
  function tvPremiumN(g,l){var m=TVS.PREMIUM_MIN*tvMid1st();return (l||[]).filter(function(a){if(!a)return false;if(a.round)return Number(a.round)===1;try{return aiMarket(g,a)>=m;}catch(e){return false;}}).length;}
  // AI clubs: franchise stars are protected unless something happens; triggered stars become shoppable.
  var tvPrevCtx=aiTeamCtx;aiTeamCtx=function(g,id,kind){var ctx;tvCtxDepth++;try{ctx=tvPrevCtx.apply(this,arguments);}finally{tvCtxDepth--;}
    try{if(ctx&&g&&id!==g.team)(ctx.club.roster||[]).forEach(function(p){if(!tvIsStar(g,p))return;var why=tvTrigger(g,id,p,ctx);
      if(!why){if(tvIsFranchise(g,p))ctx.protectedIds[p.id]=1;}else if(!tvExplicitUT(p)&&Number(p.aiTradeLockSeason)!==Number(g.season))delete ctx.protectedIds[p.id];});}catch(e){}return ctx;};
  function tvStarDealsKey(g){return 'dl|'+g.season;}
  var tvPrevSide2=aiSideScore;aiSideScore=function(g,ctx,give,get){var s=tvPrevSide2.apply(this,arguments);try{if(!ctx||!g||!ctx.id||ctx.id===g.team)return s;give=give||[];get=get||[];var why='';
      if(ctx.kind==='deadline'&&tvN1(give)+tvN1(get)>TVS.MAX_FIRSTS)why='no deadline deal carries more than two 1sts';
      var stars=give.filter(function(a){return tvIsStar(g,a);});
      if(!why&&stars.length&&ctx.kind==='deadline'){var sd=g.tvStarDeals;if(sd&&sd.key===tvStarDealsKey(g)&&sd.n>=TVS.STAR_DEALS_PER_DEADLINE)why='one star deal per deadline';}
      if(!why)stars.forEach(function(p){if(why||!tvIsFranchise(g,p)||tvTrigger(g,ctx.id,p,ctx))return;s.give+=(TVS.KING_KEEP-1)*aiValue(g,ctx,p,false);if(tvPremiumN(g,get)<TVS.KING_PREMIUM_N)why='franchise star: king\u2019s ransom only';});
      if(why){s.give+=TV.BLOCK;s.tvBlock=s.tvBlock||why;aiNote('star rule: '+why);}}catch(e){}return s;};
  var tvPrevExec=aiExecute;aiExecute=function(g,found,kind,date){var r=tvPrevExec.apply(this,arguments);try{if(kind==='deadline'&&found&&found.deal){var all=(found.deal.giveA||[]).concat(found.deal.giveB||[]);
      if(all.some(function(a){return tvIsStar(g,a);})){var k=tvStarDealsKey(g);if(!g.tvStarDeals||g.tvStarDeals.key!==k)g.tvStarDeals={key:k,n:0};g.tvStarDeals.n++;}}}catch(e){}return r;};
  // Deadline calls/pitches: 115% floor after noon too; never > 2 firsts; shopping/pitching a franchise star needs 2+ premium assets.
  var tvPrevTarget=p19Target;p19Target=function(dl,type,X){return Math.max(P19.LOP_MIN,tvPrevTarget.apply(this,arguments));};
  var tvPrevNeutral=aiNeutral;aiNeutral=function(g,list){if(list&&list.length===1&&list[0]&&!list[0].round)tvLastSingle=list[0];return tvPrevNeutral.apply(this,arguments);};
  function tvNeedsKing(g,p){if(!p||!tvIsFranchise(g,p))return false;var own=tvOwner(g,p);return own===g.team||!tvTrigger(g,own,p,null);}
  var tvPrevPack=p19Pack;p19Pack=function(g,pool,ratioOf,target,lo,hi,legal){var star=tvPackStar||tvLastSingle,king=false;try{king=tvNeedsKing(g,star);}catch(e){}
    if(hi===P19.LOP_MAX&&lo<P19.LOP_MIN)lo=P19.LOP_MIN;
    var L=function(c){if(tvN1(c)>TVS.MAX_FIRSTS)return false;if(king&&tvPremiumN(g,c)<TVS.KING_PREMIUM_N)return false;return legal?legal(c):true;};
    var r=tvPrevPack.call(this,g,pool,ratioOf,target,lo,hi,L);tvLastSingle=star;return r;};
  var tvPrevFair=p19Fair;p19Fair=function(){var keep=tvPackStar;tvPackStar=tvLastSingle;try{return tvPrevFair.apply(this,arguments);}finally{tvPackStar=keep;}};
  // Trade desk: star premium, king's-ransom keep for AI clubs, ceiling discount vs the desk's own star line.
  function tvDeskLine(g,id){var S=tvStars(g);if(S.desk[id]!=null)return S.desk[id];S.desk[id]=Infinity;var m=Infinity;tvNoKeep++;
    try{teams.forEach(function(t){(clubRoster(g,t.id)||[]).forEach(function(p){if(!p||(Number(p.ovr)||0)<S.thr||aiIsProspect(p))return;var si=aiStatusInfo(g,p);if(!tvFranchiseInfo(p,si))return;m=Math.min(m,gmAssetValue(g,id,p));});});}finally{tvNoKeep--;}
    S.desk[id]=Math.max(isFinite(m)?m:0,TVS.STAR_LINE_MIN*tvMid1st());return S.desk[id];}
  var tvPrevGm2=gmAssetValue;gmAssetValue=function(g,id,asset){var v=tvPrevGm2.apply(this,arguments);if(typeof v!=='number'||!asset||asset.round||!g)return v;
    try{var o=Number(asset.ovr)||0,S=tvStars(g);
      if(o>=S.thr&&!aiIsProspect(asset)){var si=aiStatusInfo(g,asset);if(!tvFranchiseInfo(asset,si))return v;v=v*tvStarPrem(g,asset);
        if(!tvNoKeep&&id!==g.team&&tvOwner(g,asset)===id&&!tvTrigger(g,id,asset,null))v*=TVS.KING_KEEP;return Math.round(v);}
      var vo=p19ValueOvr(asset);if(vo>o+.5){var cm=typeof p19IsCenter==='function'&&p19IsCenter(g,asset)?P19.CENTER:1,real=p19PrevGmValue.call(this,g,id,asset)*cm;
        v=Math.round(Math.max(real,Math.min(v,TVS.CEIL_SHARE*v,TVS.STAR_LINE_SHARE*tvDeskLine(g,id))));}}catch(e){}return v;};
  // Desk ask for an AI club's franchise star: no longer an automatic insult when the offer is a king's ransom
  // (2+ premium assets and enough value to clear the +35% keep premium); otherwise the old 'untouchable' answer stands.
  function tvKingRansom(g,d){var club=leagueClub(g,d.target);if(!club)return false;var inc=(d.userPlayers||[]).map(function(id){return clubRoster(g,g.team).find(function(p){return p.id===id;});}).filter(Boolean),
      pk=(d.userPicks||[]).map(function(k){return clubPicks(g,g.team).find(function(p){return pickKey(p)===k;});}).filter(Boolean);
    if(tvPremiumN(g,inc.concat(pk))<TVS.KING_PREMIUM_N)return false;var r=tradeAcceptanceRead(g,d);return r&&r.score>=100;}
  var tvPrevUT=playerIsUntouchable;playerIsUntouchable=function(g,id,p){var r=tvPrevUT.apply(this,arguments);if(!r||tvCtxDepth||!g||!p||id===g.team||tvExplicitUT(p)||!tvIsStar(g,p))return r;
    try{if(tvTrigger(g,id,p,null))return false;var d=typeof current!=='undefined'&&current&&current.tradeDraft;if(d&&d.target===id&&(d.marketPlayers||[]).indexOf(p.id)>=0&&tvKingRansom(g,d))return false;}catch(e){}return r;};
  var tvPrevRead=tradeAcceptanceRead;tradeAcceptanceRead=function(g,d){var r=tvPrevRead.apply(this,arguments);try{var club=leagueClub(g,d.target);if(!r||!club)return r;
      var out=(d.marketPlayers||[]).map(function(id){return club.roster.find(function(p){return p.id===id;});}).filter(Boolean).filter(function(p){return tvIsFranchise(g,p)&&!tvTrigger(g,d.target,p,null);});
      if(out.length){var inc=(d.userPlayers||[]).map(function(id){return clubRoster(g,g.team).find(function(p){return p.id===id;});}).filter(Boolean),pk=(d.userPicks||[]).map(function(k){return clubPicks(g,g.team).find(function(p){return pickKey(p)===k;});}).filter(Boolean);
        if(tvPremiumN(g,inc.concat(pk))<TVS.KING_PREMIUM_N){r=Object.assign({},r,{score:Math.min(r.score,30),tvKing:out[0].name+' is a franchise player: only a king\u2019s ransom (two or more premium assets) gets a deal.'});}}}catch(e){}return r;};
  if(typeof window!=='undefined')window.CTFOTradeValue={TV:TV,TVS:TVS,curve:tvCurve,cred:tvCred,depth:tvDepth,price:tvPriceTable,protDisc:tvProtDisc,stars:function(g){var S=tvStars(g);return {thr:S.thr,line:tvStarLine(g)};},isStar:tvIsStar,isFranchise:tvIsFranchise,trigger:tvTrigger,premiumN:tvPremiumN,kingRansom:tvKingRansom,deskLine:tvDeskLine};
  /* ===== DEADLINE SANITY v10.3.1 — one block, wrappers only (port this whole section) =====
     Stars with 2+ years stay on the king's-ransom rule. Signed 85+ costs more than a rental.
     Cap relief cannot force a dump through. No same-season flips. Young core is protected.
     Reasons describe the package. Phone calls, counters, the 2-first cap, Center +15%, and pick values are untouched. */
  function tvYears(p){return Number(p&&p.years)||0;}
  function tvAge(p){return Number(p&&p.age)||0;}
  function tvOvr(p){return Number(p&&p.ovr)||0;}
  function tvPot(p){return Math.max(tvOvr(p),Number(p&&p.potential)||0);}
  function tvRental(g,p){if(!p||p.round)return false;if(tvYears(p)<=1)return true;try{var si=aiStatusInfo(g,p);if(si&&si.rental)return true;}catch(e){}return false;}
  // Clearly declining: 36+ or already 4 OVR under his own potential at 33+.
  function tvDeclining(p){if(!p||p.round)return false;var age=tvAge(p),o=tvOvr(p),pot=tvPot(p);return age>=36||(age>=33&&pot>=o+4);}
  function tvSweet(a){return !!(a&&(a.round||aiIsProspect(a)||a.__group==='prospect'||a.__group==='reserve'));}
  function tvYoungAsset(a){if(!a||a.round)return false;if(aiIsProspect(a)||a.__group==='prospect'||a.__group==='reserve')return tvPot(a)>=84&&tvOvr(a)>=70;return tvAge(a)<=25&&(tvOvr(a)>=78||tvPot(a)>=86);}
  function tvYoungCore(p){if(!p||p.round||aiIsProspect(p))return false;return tvAge(p)<=25&&tvYears(p)>=3&&(tvOvr(p)>=82||tvPot(p)>=88);}
  // A ceiling (potential well above today's OVR, or a prospect) is not a proven star.
  function tvCeilingOnly(a){if(!a||a.round)return false;if(aiIsProspect(a)||a.__group==='prospect'||a.__group==='reserve')return true;return tvAge(a)<=25&&tvPot(a)>=tvOvr(a)+6&&tvOvr(a)<90;}
  function tvProvenOvr(a){if(!a||a.round||tvCeilingOnly(a))return tvOvr(a);return tvOvr(a);}
  function tvMovedKey(a){if(!a)return '';if(a.round)return 'pk|'+(a.id||pickKey(a));return 'pl|'+a.id;}
  function tvMoved(g,a){if(!g||!a)return false;var season=Number(g.season);if(!a.round&&Number(a.aiTradeLockSeason)===season)return true;var bag=g.tvMoved&&g.tvMoved[season];return !!(bag&&bag[tvMovedKey(a)]);}
  function tvShopKey(id,g,assetId){return id+'|'+(g&&g.season)+'|'+assetId;}
  // Signed impact with term: a 1st plus a real young piece or an 82+ NHLer, two 1sts, or another signed impact player.
  // A pure rental (or a 34+ player with 2 years or less) is priced at about one 1st, or one 82+ player.
  function tvTermPaid(g,get){get=get||[];var firsts=tvN1(get),young=get.some(tvYoungAsset),real=get.some(function(a){return a&&!a.round&&!aiIsProspect(a)&&tvOvr(a)>=82&&tvYears(a)>=2&&!tvRentalPriced(g,a);}),equiv=get.some(function(a){return a&&!a.round&&!aiIsProspect(a)&&tvOvr(a)>=85&&tvYears(a)>=2&&!tvRental(g,a);}),star=get.some(function(a){return tvProvenOvr(a)>=87&&!tvCeilingOnly(a);});if(firsts>=2||equiv||star)return true;if(firsts>=1&&(young||real))return true;return false;}
  // A second premium has to be a signed 84+, not a walk-year and not a ceiling kid. One 1st plus a rental is a rental price.
  function tvTermPremiums(g,get){var n=tvN1(get);(get||[]).forEach(function(a){if(!a||a.round||tvRentalPriced(g,a))return;if(tvOvr(a)>=84&&!tvCeilingOnly(a))n++;});return n;}
  function tvRentalPriced(g,p){return tvRental(g,p)||tvYears(p)<=1||(tvAge(p)>=34&&tvYears(p)<=2);}
  function tvDealReason(g,found){try{
    var A=found.A,B=found.B,d=found.deal||{},type=found.type||'',recv=found.receiver||B,other=recv===A?B:A;
    var recvGets=recv===A?(d.giveB||[]):(d.giveA||[]),recvGives=recv===A?(d.giveA||[]):(d.giveB||[]);
    var players=function(list){return (list||[]).filter(function(a){return a&&!a.round;});};
    var best=function(list){return players(list).sort(function(a,b){return tvOvr(b)-tvOvr(a);})[0];};
    var h=best(recvGets),out=best(recvGives),sweet=(recvGets||[]).filter(tvSweet);
    if(type==='cap dump'){var dumped=best(d.giveA||[])||h;if(sweet.length)return team(A.id).name+' cleared '+ (dumped?dumped.name+'\'s ':'')+'cap hit and sent '+sweet.map(aiAssetLabel).join(' and ')+' to '+team(B.id).name+' for taking the contract.';return team(A.id).name+' moved '+(dumped?dumped.name+' ':'salary ')+'to '+team(B.id).name+', which had room under the cap.';}
    if(type==='floor salary')return team(B.id).name+' was short of the cap floor and took salary on from '+team(A.id).name+'.';
    if(type==='hockey trade'){var ha=best(d.giveA),hb=best(d.giveB);if(ha&&hb)return team(A.id).name+' sent '+ha.name+' to '+team(B.id).name+' for '+hb.name+' — each club filled the position the other had extra of.';return team(A.id).name+' and '+team(B.id).name+' swapped surplus pieces into positions they were short.';}
    if(h&&tvRentalPriced(g,h)&&(type==='contender buy'||type==='bubble rental'||type==='retool sell'||type==='rebuild sell'||type==='youth sell'))return team(recv.id).name+' added rental '+h.name+' ('+tvOvr(h)+' OVR, age '+tvAge(h)+') for the playoff push'+(out?'; '+team(other.id).name+' cashed an expiring contract.':'.');
    if(h&&(other.role==='RETOOL'||other.role==='REBUILD'||other.role==='YOUTH_MOVEMENT')&&tvAge(h)>=29&&tvRentalPriced(g,h))return team(other.id).name+' sold expiring veteran '+h.name+'; '+team(recv.id).name+' added him for the rest of the year.';
    if(type==='rfa target'&&h)return team(recv.id).name+' acquired '+h.name+' ('+tvOvr(h)+' OVR, age '+tvAge(h)+') for the control years still on his deal.';
    if((type==='rebuild sell'||type==='retool sell'||type==='youth sell')&&h)return team(other.id).name+' ('+(other.role||'')+') moved '+h.name+' ('+tvOvr(h)+' OVR, '+tvYears(h)+'y) for a return that fits that plan.';
    if(h&&tvYoungCore(h))return team(recv.id).name+' added young core piece '+h.name+' ('+tvOvr(h)+' OVR, age '+tvAge(h)+', '+tvYears(h)+'y).';
    if(h)return team(recv.id).name+' acquired '+h.name+' ('+tvOvr(h)+' OVR, age '+tvAge(h)+(tvRentalPriced(g,h)?', rental':', '+tvYears(h)+'y left')+').';
    return team(recv.id).name+' and '+team(other.id).name+' completed a '+type+' deal.';
  }catch(e){return 'League trade completed.';}}
  // 1. Aging-star trigger: 2+ years left stays under the king's-ransom rule unless he is clearly declining.
  //    Cap trouble, a true walk year, an unaffordable RFA, and a trade request still open the door.
  var tvPrevTriggerFix=tvTrigger;tvTrigger=function(g,id,p,ctx){var why=tvPrevTriggerFix.apply(this,arguments);if(!why||String(why).indexOf('aging star')!==0)return why;if(tvYears(p)<=1||tvRental(g,p))return why;if(tvDeclining(p))return 'declining star on a club that is not built around him';return '';};
  // 4. Young core on a contender or retool is protected the way a star is, unless the club is in cap trouble.
  var tvPrevCtxFix=aiTeamCtx;aiTeamCtx=function(g,id,kind){var ctx=tvPrevCtxFix.apply(this,arguments);try{if(ctx&&g&&id!==g.team&&(ctx.role==='WIN_NOW'||ctx.role==='CONTENDER'||ctx.role==='RETOOL')&&!ctx.capTrouble){(ctx.club.roster||[]).forEach(function(p){if(tvYoungCore(p))ctx.protectedIds[p.id]=1;});}}catch(e){}return ctx;};
  var tvPrevSellerFix=aiSellerAvailable;aiSellerAvailable=function(g,ctx,p,buyer){if(tvMoved(g,p))return false;if(ctx&&ctx.kind==='deadline'&&p&&g&&g.tvShopTry&&g.tvShopTry[tvShopKey(ctx.id,g,p.id)])return false;if(tvYoungCore(p)&&(ctx.role==='WIN_NOW'||ctx.role==='CONTENDER'||ctx.role==='RETOOL')&&!ctx.capTrouble)return false;return tvPrevSellerFix.apply(this,arguments);};
  var tvPrevAssetsFix=aiTradeableAssets;aiTradeableAssets=function(g,ctx,kind,opts){var list=tvPrevAssetsFix.apply(this,arguments);try{list=list.filter(function(a){return !tvMoved(g,a);});}catch(e){}return list;};
  // 2, 3, 5. Term price, dump cap, role fit, no same-season flips. AI package builder only — phone-call math is untouched.
  var tvDealType=null;
  var tvPrevSideFix=aiSideScore;aiSideScore=function(g,ctx,give,get){var s=tvPrevSideFix.apply(this,arguments);var type=tvDealType;if(!type||!ctx||!g)return s;try{
    give=give||[];get=get||[];var why='';
    var ban=function(msg){if(!why)why=msg;};
    if(give.some(function(a){return tvMoved(g,a);}))ban('that player already changed clubs this season');
    give.forEach(function(p){if(why||!p||p.round||aiIsProspect(p))return;var o=tvOvr(p),yrs=tvYears(p);
      if(o>=90&&!tvCeilingOnly(p)&&!tvRentalPriced(g,p)){var proven=get.some(function(a){return tvProvenOvr(a)>=87&&!tvCeilingOnly(a);});if(!proven&&!tvTermPaid(g,get))ban(p.name+' is a proven '+o+' with '+yrs+' years left — a ceiling prospect cannot stand in for him');}
      else if(o>=87&&yrs>=3&&!tvRentalPriced(g,p)&&tvTermPremiums(g,get)<2&&!get.some(function(a){return tvProvenOvr(a)>=87&&!tvCeilingOnly(a);}))ban(p.name+' ('+o+' OVR, '+yrs+'y) is signed impact — one 1st and a rental is a rental price');
      else if(o>=85&&yrs>=2&&!tvRentalPriced(g,p)&&!tvTermPaid(g,get))ban(p.name+' ('+o+' OVR, '+yrs+'y) is signed impact — the return has to be a 1st plus a real piece, or another impact player');
      else if(o>=87&&tvRentalPriced(g,p)&&tvN1(get)<1)ban(p.name+' is an '+o+' rental — the going rate is about one 1st');
      else if(o>=85&&tvRentalPriced(g,p)&&tvN1(get)<1&&!get.some(function(a){return a&&!a.round&&!aiIsProspect(a)&&tvOvr(a)>=82;}))ban(p.name+' is an '+o+' rental — the going rate is about one 1st');
    });
    if((ctx.role==='WIN_NOW'||ctx.role==='CONTENDER'||ctx.role==='RETOOL')&&give.some(tvYoungCore)){var core=give.filter(tvYoungCore)[0];var okBack=tvTermPaid(g,get)||get.some(function(a){return a&&!a.round&&!aiIsProspect(a)&&tvAge(a)<=30&&tvYears(a)>=3&&tvOvr(a)>=Math.max(80,tvOvr(core)-2);});if(!okBack)ban(ctx.role+' keeps '+core.name+' (young core) unless the return is a real young piece');}
    if((ctx.role==='REBUILD'||ctx.role==='YOUTH_MOVEMENT')&&type!=='cap dump'){get.forEach(function(a){if(why||!a||a.round||aiIsProspect(a))return;if(tvAge(a)<30||tvYears(a)<2||tvRental(g,a))return;var similar=give.some(function(b){return b&&!b.round&&!aiIsProspect(b)&&tvAge(b)>=28&&Math.abs(tvOvr(b)-tvOvr(a))<=3;});if(!similar&&!get.some(tvSweet))ban(ctx.role+' does not take '+a.name+' ('+tvAge(a)+', '+tvYears(a)+'y) on without a pick or a prospect');});}
    if(type==='cap dump'){var dumping=!!ctx.capTrouble;if(!dumping){var otherHit=0;/* taker side: still refuse a package that robs them */}
      var nGive=aiNeutral(g,give),nGet=aiNeutral(g,get),ratio=nGet/Math.max(1,nGive);
      var givesSweet=give.some(tvSweet),getsSweet=get.some(tvSweet);
      var useful=give.some(function(a){return a&&!a.round&&!tvSweet(a)&&tvOvr(a)>=83&&tvYears(a)>=2&&!tvRental(g,a);});
      var rentalDump=give.some(function(a){return a&&!a.round&&!tvSweet(a)&&tvRental(g,a);});
      if(dumping&&getsSweet&&!givesSweet)ban('the club taking the salary is the one that should receive the sweetener');
      if(dumping&&givesSweet&&rentalDump&&!useful)ban('a walk-year deal does not need a pick attached to dump it');
      if(dumping){var floor=0.80;if(givesSweet&&!useful&&!rentalDump)floor=0;if(floor&&ratio<floor)ban('cap relief cannot paper over a dump that gives away '+(ratio).toFixed(2)+'x the hockey value');}
      if(!dumping&&ratio<0.80)ban('the club taking the contract still has to come out at 0.80x or better');
    }
    if(!why&&type!=='cap dump'&&type!=='floor salary'){var nOut=aiNeutral(g,give),nIn=aiNeutral(g,get),gap=nIn/Math.max(1,nOut);if(gap>1.27||gap<1/1.27)ban('hockey value has to stay inside 1.27x ('+gap.toFixed(2)+'x)');}
    if(why){s.give+=TV.BLOCK;s.tvBlock=s.tvBlock||why;aiNote(why);}
  }catch(e){}return s;};
  var tvPrevBuildFix=aiBuild;aiBuild=function(g,A,B,coreA,coreB,payer,pool,kind,type){var prev=tvDealType;tvDealType=type||'';try{return tvPrevBuildFix.apply(this,arguments);}finally{tvDealType=prev;}};
  // 4. Cooldown: a headline already shopped by this club at this deadline is not shopped again on the next pass.
  var tvPrevTryFix=aiTryPairs;aiTryPairs=function(g,pairs,kind,type,limit){var lim=limit||AI_TRADE.PAIR_TRIES;if(g&&kind==='deadline'){pairs=(pairs||[]).filter(function(pr){return pr&&pr.p&&pr.seller&&!(g.tvShopTry&&g.tvShopTry[tvShopKey(pr.seller.id,g,pr.p.id)]);});}var res=tvPrevTryFix.call(this,g,pairs,kind,type,lim);if(g&&kind==='deadline'){g.tvShopTry=g.tvShopTry||{};var touched=0;for(var i=0;i<(pairs||[]).length&&touched<lim;i++){var pr=pairs[i];if(!pr||(pr.buyer&&pr.buyer.__done)||(pr.seller&&pr.seller.__done))continue;if(pr.p&&pr.seller)g.tvShopTry[tvShopKey(pr.seller.id,g,pr.p.id)]=1;touched++;if(res&&res.headline&&pr.p&&res.headline===pr.p)break;}}return res;};
  // 6. Reason from the package, and remember every asset that moved so it cannot flip this season.
  var tvPrevExecFix=aiExecute;aiExecute=function(g,found,kind,date){try{found.tvReason=tvDealReason(g,found);}catch(e){}var r=tvPrevExecFix.apply(this,arguments);try{
    g.tvMoved=g.tvMoved||{};var season=Number(g.season);g.tvMoved[season]=g.tvMoved[season]||{};var d=found.deal||{};
    [d.giveA,d.giveB].forEach(function(list){(list||[]).forEach(function(a){if(!a)return;g.tvMoved[season][tvMovedKey(a)]=1;if(!a.round)a.aiTradeLockSeason=g.season;});});
    if(g.aiLog&&g.aiLog[0]&&found.tvReason){var A=found.A,B=found.B,st=function(x){return x.st.role+(x.capTrouble?'+CAP_TROUBLE':'');};g.aiLog[0].text=team(A.id).id+' ('+st(A)+') ↔ '+team(B.id).id+' ('+st(B)+'): '+found.tvReason;}
    var tl=g.aiTradeLog;if(tl&&tl.length)tl[tl.length-1].why=found.tvReason;
  }catch(e){}return r;};
  // 5. Bubble clubs shop less often. The 115–140% call floor is not touched.
  AI_TRADE.P_DEADLINE.BUBBLE=0.40;
  if(typeof window!=='undefined'&&window.CTFOTradeValue){window.CTFOTradeValue.trigger=tvTrigger;window.CTFOTradeValue.dealReason=tvDealReason;window.CTFOTradeValue.termPaid=tvTermPaid;window.CTFOTradeValue.youngCore=tvYoungCore;window.CTFOTradeValue.declining=tvDeclining;}
  /* ===== END DEADLINE SANITY v10.3.1 ===== */
  /* ===== END TRADE VALUE v2 ===== */
  try{init();}catch(e){var box=$('fatal-message');box.hidden=false;$('fatal-detail').textContent='Startup error: '+e.message;}
})();
















</script>
</body>
</html>





