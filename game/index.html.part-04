  function lv2News(g,id,text,tag,notable){var date=lv2Date(g);g.lv2News=g.lv2News||[];g.lv2News.unshift({date:date,team:id,text:text,tag:tag});g.lv2News=g.lv2News.slice(0,150);
    if(notable){g.transactionLog=g.transactionLog||[];g.transactionLog.unshift({when:lv2Pretty(date)+' · '+tag,text:text,teams:[id],tag:tag});g.transactionLog=g.transactionLog.slice(0,80);}}
  function lv2Note(g,text){g.lv2Notes=g.lv2Notes||[];g.lv2Notes.push(text);if(g.lv2Notes.length>6)g.lv2Notes=g.lv2Notes.slice(-6);}
  function lv2PickInjury(p){var tot=0,list=LV2INJ.map(function(r){var w=r[2]*(p.pos==='G'&&(r[1]==='Groin'||r[1]==='Hip')?2.5:1)*(p.lv2LastBody&&p.lv2Fragile>0&&r[1]===p.lv2LastBody?6:1);tot+=w;return [r,w];}),x=Math.random()*tot;for(var i=0;i<list.length;i++){x-=list[i][1];if(x<=0)return list[i][0];}return LV2INJ[0];}
  function simInjureClub(g,id){lv2Hooked++;var club=simV2Club(g,id);if(!club||!Array.isArray(club.roster)||g.stage==='offseason')return;var hurt=club.roster.filter(function(p){return Number(p.injury)>0;}).length;if(hurt>=LV2.MAX_HURT)return;
    var on=lv2Dressed(club),toiF={0:1.25,1:1.05,2:.95,3:.75},toiD={0:1.2,1:1,2:.85},L=club.lines||{};
    club.roster.forEach(function(p){if(hurt>=LV2.MAX_HURT||!lv2Healthy(p)||on[p.id]==null)return;var isG=p.pos==='G';if(isG&&L.goalies&&L.goalies[0]!==p.id)return;
      var slot=lv2FindSlot(club,p.id).split('.'),toi=isG?1:slot[0]==='forwards'?toiF[slot[1]]||1:toiD[slot[1]]||1,t=simV2Talent(g,p),age=Number(p.age)||27,ageF=age>=34?1.3:age>=31?1.12:age<=22?.92:1,prone=1+.15*Math.min(4,Number(p.lv2InjCount)||0),frag=Number(p.lv2Fragile)>0?2.5:1;
