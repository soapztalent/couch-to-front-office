    var needs={};try{needs=aiNeedGroups(officeNeeds(g,g.team));}catch(e){}var byGroup=function(gr){return roster.filter(function(p){return aiGroup(p)===gr;}).map(function(p){return Number(p.ovr)||0;}).sort(function(a,b){return b-a;});};
    var prot={},key=v4fixTradeKey(g);roster.concat(g.reserveRoster||[],g.orgProspects||[]).forEach(function(p){if(p.v4TradedKey===key||Number(p.aiTradeLockSeason)===Number(g.season)&&p.v4TradedKey===key)prot[p.id]=1;try{if(playerIsUntouchable(g,g.team,p))prot[p.id]=1;}catch(e){}});
    if(forPitch){roster.filter(function(p){return p.pos!=='G';}).sort(function(a,b){return b.ovr-a.ovr;}).slice(0,4).forEach(function(p){prot[p.id]=1;});var g1=roster.filter(function(p){return p.pos==='G';}).sort(function(a,b){return b.ovr-a.ovr;})[0];if(g1)prot[g1.id]=1;}
    var pay=capUsedClub(g,g.team),space=(Number(g.cap)||0)-pay,floorGap=Math.max(0,capFloorFor(g)-pay);
    return {id:g.team,club:g,st:{role:ph,capTrouble:false},role:ph,nextRoom:Infinity,cantAffordIds:{},needs:needs,counts:counts,ahlDepth:ahlDepth,ref:{F:byGroup('F'),D:byGroup('D'),G:byGroup('G')},
      surplus:{F:counts.F>=15,D:counts.D>=9,G:counts.G>=3},protectedIds:prot,loyalIds:{},pay:pay,space:space,floorGap:floorGap,capTrouble:false,kind:'deadline',values:{}};}
  // Season 1 shows the user's payroll from the reference snapshot (capReferenceActive); keep it in step with roster moves made here.
  function dlRosterHits(g){return (g.roster||[]).reduce(function(n,p){return n+contractHit(p);},0);}
  function dlRefSync(g,pre){if(typeof capReferenceActive==='function'&&capReferenceActive(g))g.capAdjustment=(Number(g.capAdjustment)||0)+dlRosterHits(g)-pre;}
  function dlRelax(s,f){return s.get>=s.give*(1+AI_TRADE.MARGIN*(1-f)-0.06*f)+AI_TRADE.MIN_GAIN*(1-f);}
  function dlRefs(list,owner){return list.map(function(a){return a.round?{k:'pick',key:pickKey(a),team:owner,txt:aiPickName(a)}:{k:'pl',id:a.id,team:owner,txt:aiAssetLabel(a),grp:a.__group||'active'};});}
  function dlResolve(g,refs){var out=[];for(var i=0;i<refs.length;i++){var r=refs[i],a=null;if(r.k==='pick')a=clubPicks(g,r.team).find(function(k){return pickKey(k)===r.key;})||null;else{a=clubTradePlayers(g,r.team).find(function(p){return p.id===r.id;})||null;if(a)a.__group=tradePlayerGroup(g,r.team,a)||'active';}if(!a)return null;out.push(a);}return out;}
  function dlAskPool(pool,ask){if(!ask||ask==='any')return pool;return pool.filter(function(a){return ask==='picks'?!!a.round:ask==='prospects'?aiIsProspect(a):(!a.round&&!aiIsProspect(a));});}
  function dlBuyType(X){return X.role==='RETOOL'?'retool buy':X.role==='BUBBLE'?'bubble rental':'contender buy';}
  function dlSellType(X){return X.capTrouble?'cap dump':X.role==='REBUILD'?'rebuild sell':X.role==='RETOOL'?'retool sell':X.role==='YOUTH_MOVEMENT'?'youth sell':'hockey trade';}
  function dlBuildOffer(g,dl,ctxs,U,f,pid,ask){var picked=pid?[dlUserPlayer(g,pid)].filter(Boolean):g.roster.filter(function(p){return (Number(p.ovr)||0)>=76&&Number(p.years)>0&&!U.protectedIds[p.id];}),cands=[];
    picked.forEach(function(p){if(U.protectedIds[p.id])return;p.__group=tradePlayerGroup(g,g.team,p)||'active';Object.keys(ctxs).forEach(function(id){var X=ctxs[id];if((dl.calledTeams[id]||0)>=DL.PER_TEAM_CALLS)return;
      try{if(!aiConsents(p,id))return;if(p.__group==='active'&&!aiBuyerWants(X,p,g))return;var lvl=aiNeedLevel(X,p);if(!pid&&(lvl===0||!aiImproves(X,p)))return;cands.push({X:X,p:p,s:aiValue(g,X,p,true)+lvl*8+Math.random()*12-(dl.calledTeams[id]||0)*10});}catch(e){}});});
    cands.sort(function(a,b){return b.s-a.s;});
    for(var i=0;i<cands.length&&i<12;i++){var X=cands[i].X,p=cands[i].p,pool=aiTradeableAssets(g,X,'deadline'),fp=dlAskPool(pool,ask),deal=null,type=dlBuyType(X);
      try{deal=aiBuild(g,U,X,[p],[],'B',fp.length?fp:pool,'deadline',type);if(!deal&&fp.length&&fp.length<pool.length&&pid)deal=aiBuild(g,U,X,[p],[],'B',pool,'deadline',type);}catch(e){deal=null;}
      if(!deal||aiLegal(g,U,X,deal.giveA,deal.giveB))continue;var sweet=false;
      if(f>0.45&&Math.random()<f){var extra=pool.filter(function(a){return deal.giveB.indexOf(a)<0;}).sort(function(a,b){return aiMarket(g,a)-aiMarket(g,b);});
        for(var e=0;e<extra.length&&deal.giveB.length<4;e++){if(aiMarket(g,extra[e])<8)continue;var gb=deal.giveB.concat([extra[e]]);if(dlRelax(aiSideScore(g,X,gb,deal.giveA),f)&&!aiLegal(g,U,X,deal.giveA,gb)){deal.giveB=gb;sweet=true;break;}}}
      return {type:pid?'shop':'offer',team:X.id,give:dlRefs(deal.giveA,g.team),get:dlRefs(deal.giveB,X.id),dealType:type,player:p.name,sweet:sweet,
        line:(pid?'Saw '+p.name+' on the block. ':'')+'We\u2019d like '+p.name+'. '+(sweet?'It\u2019s late, so we\u2019ve sweetened it.':'Here\u2019s what we can do.')};}
    return null;}
  function dlBuildPitch(g,dl,ctxs,U,f){var cands=[];(dl.block||[]).forEach(function(r){if(r.mine||(dl.calledTeams[r.team]||0)>=DL.PER_TEAM_CALLS)return;var X=ctxs[r.team];if(!X)return;var p=(X.club.roster||[]).find(function(x){return x.id===r.pid;});if(!p)return;p.__group='active';
      try{if(!aiConsents(p,g.team))return;var lvl=aiNeedLevel(U,p),imp=aiImproves(U,p);if(!imp&&!lvl)return;if(U.space+2500000<contractHit(p))return;cands.push({X:X,p:p,s:r.value*0.03+lvl*8+(imp?6:0)+Math.random()*10});}catch(e){}});
    cands.sort(function(a,b){return b.s-a.s;});var pool=aiTradeableAssets(g,U,'deadline');
    for(var i=0;i<cands.length&&i<12;i++){var X=cands[i].X,p=cands[i].p,type=dlSellType(X),deal=null;try{deal=aiBuild(g,X,U,[p],[],'B',pool,'deadline',type);}catch(e){deal=null;}
      if(!deal||aiLegal(g,X,U,deal.giveA,deal.giveB))continue;var disc=false;
      if(f>0.45&&deal.giveB.length>1&&Math.random()<f){var cheap=deal.giveB.slice().sort(function(a,b){return aiMarket(g,a)-aiMarket(g,b);})[0],gb=deal.giveB.filter(function(a){return a!==cheap;});if(dlRelax(aiSideScore(g,X,deal.giveA,gb),f)&&!aiLegal(g,X,U,deal.giveA,gb)){deal.giveB=gb;disc=true;}}
      return {type:'pitch',team:X.id,give:dlRefs(deal.giveB,g.team),get:dlRefs(deal.giveA,X.id),dealType:type,player:p.name,sweet:disc,line:'We\u2019re moving '+p.name+' today and you\u2019re a fit. '+(disc?'Clock\u2019s running, so we dropped the price.':'Interested?')};}
    return null;}
  function dlRing(g,dl,spec){var f=dlFrac(dl),ctxs=dlCtxs(g,dl),c=null;
    try{if(spec.type==='shop'){if(dl.shop[spec.pid])c=dlBuildOffer(g,dl,ctxs,dlUserCtx(g,false),f,spec.pid,dl.shop[spec.pid]);}
      else if(spec.type==='offer')c=dlBuildOffer(g,dl,ctxs,dlUserCtx(g,false),f,null,null)||dlBuildPitch(g,dl,ctxs,dlUserCtx(g,true),f);
      else c=dlBuildPitch(g,dl,ctxs,dlUserCtx(g,true),f)||dlBuildOffer(g,dl,ctxs,dlUserCtx(g,false),f,null,null);}catch(e){console.error('deadline call',e);c=null;}
    if(spec.type!=='shop'&&c)dl.callsMade++;
    var gap=Math.round(dlRand(DL.GAP_MIN,DL.GAP_SPAN)*(1-0.45*f));dl.nextCallAt=dl.elapsed+(c?gap:4);if(!c&&spec.type!=='shop')dl.dry=(dl.dry||0)+1;if(dl.dry>=5){dl.callsMade=DL.MAX_CALLS;}
    if(!c){if(spec.type==='shop'){var sp=dlUserPlayer(g,spec.pid);if(sp)dl.feed.unshift({t:dlClockText(dl),text:'No club met your ask for '+sp.name+' yet.'});}return null;}
    c.id='c'+dl.elapsed+'_'+Math.floor(Math.random()*1e4);c.left=c.total=DL.CALL_SECS;c.state='ringing';c.countered=false;c.at=dlClockText(dl);dl.calls.push(c);dl.calledTeams[c.team]=(dl.calledTeams[c.team]||0)+1;dlUI.phoneKey='';return c;}
  function dlActive(dl){return (dl.calls||[]).find(function(c){return c.state==='ringing';})||null;}
  function dlCounter(g,dl,c){if(!c||c.countered||c.state!=='ringing')return;c.countered=true;var f=dlFrac(dl),ctxs=dlCtxs(g,dl),X=ctxs[c.team],U=dlUserCtx(g,c.type==='pitch'),give=dlResolve(g,c.give),get=dlResolve(g,c.get),done=false;
    if(X&&give&&get&&Math.random()<0.5+0.4*f){
      if(c.type==='pitch'){if(give.length>1){var cheap=give.slice().sort(function(a,b){return aiMarket(g,a)-aiMarket(g,b);})[0],g2=give.filter(function(a){return a!==cheap;});if(dlRelax(aiSideScore(g,X,get,g2),Math.max(f,0.5))&&!aiLegal(g,U,X,g2,get)){c.give=dlRefs(g2,g.team);c.note='Fine. Keep '+(cheap.round?aiPickName(cheap):cheap.name)+'. Final offer.';done=true;}}}
      else{var pool=aiTradeableAssets(g,X,'deadline').filter(function(a){return get.indexOf(a)<0;}).sort(function(a,b){return aiMarket(g,a)-aiMarket(g,b);});
        for(var i=0;i<pool.length&&get.length<4;i++){if(aiMarket(g,pool[i])<8)continue;var gb=get.concat([pool[i]]);if(dlRelax(aiSideScore(g,X,gb,give),Math.max(f,0.5))&&!aiLegal(g,U,X,give,gb)){c.get=dlRefs(gb,X.id);c.note='We can add '+(pool[i].round?aiPickName(pool[i]):pool[i].name)+'. That\u2019s it.';done=true;break;}}}}
    if(!done)c.note='That\u2019s our best offer.';else c.left=Math.max(c.left,12);dlUI.phoneKey='';dlPhone(g,dl);persist();}
  function dlUserBackfill(g){var mins={F:12,D:6,G:2},moved=[];['G','D','F'].forEach(function(k){for(var n=0;n<3;n++){var have=g.roster.filter(function(p){return aiGroup(p)===k&&!(Number(p.injury)>0);}).length;if(have>=mins[k]||g.roster.length>=23)break;
      var pool=(g.reserveRoster||[]).filter(function(p){return aiGroup(p)===k&&(typeof ahlSigned!=='function'||ahlSigned(p))&&!(Number(p.injury)>0)&&capUsed(g)+contractHit(p)<=Number(g.cap);}).sort(function(a,b){return b.ovr-a.ovr;}),c=pool[0];if(!c)break;
      g.reserveRoster.splice(g.reserveRoster.indexOf(c),1);c.reserveList=false;c.rosterStatus='Active roster \u00b7 deadline call-up';c.level='NHL';c.club=g.team;g.roster.push(c);moved.push(c.name);}});
    if(moved.length){try{assignRoles(g);}catch(e){}}return moved;}
  function dlAccept(g,dl,c){if(!c||c.state!=='ringing')return;dlStatusNow(g,dl);var ctxs=dlCtxs(g,dl),X=ctxs[c.team],U=dlUserCtx(g,false),give=dlResolve(g,c.give),get=dlResolve(g,c.get);
    if(!X||!give||!get){c.state='failed';c.note='The package changed. The deal fell through.';return dlAfterCall(g,dl,c);}
    var why=aiLegal(g,U,X,give,get);if(why){c.state='failed';c.note='Blocked by league rules: '+why.replace(/^[A-Z]{3} /,'');return dlAfterCall(g,dl,c);}
    var hits0=dlRosterHits(g),deal={giveA:give,giveB:get,sa:aiSideScore(g,U,give,get),sb:aiSideScore(g,X,get,give),nA:aiNeutral(g,give),nB:aiNeutral(g,get)},pitch=c.type==='pitch',
      head=(pitch?get:give).filter(function(a){return !a.round;})[0]||(pitch?get:give)[0],res=null;
    try{res=aiExecute(g,{A:U,B:X,deal:deal,type:c.dealType,headline:head,receiver:pitch?U:X},'deadline',dl.date);}catch(e){console.error('deadline accept',e);dlRefSync(g,hits0);c.state='failed';c.note='The league office rejected the paperwork.';return dlAfterCall(g,dl,c);}
    var log=g.aiTradeLog||[],ent=log[log.length-1];if(ent){ent.userCall=true;ent.callType=c.type;ent.clock=dlClockText(dl);}
    var up=dlUserBackfill(g);dlRefSync(g,hits0);try{ensureLineup(g);}catch(e){}Object.keys(dl.shop).forEach(function(pid){if(!dlUserPlayer(g,pid))delete dl.shop[pid];});
    dl.callDeals.push({id:ent&&ent.id,clock:dlClockText(dl),team:c.team,give:c.give.map(function(r){return r.txt;}),get:c.get.map(function(r){return r.txt;})});
    c.state='accepted';c.note='Deal done. '+(up.length?'Called up '+up.join(', ')+' from the AHL. ':'')+'Players you acquired are locked for today.';
    dl.feed.unshift({t:dlClockText(dl),text:res&&res.text||'Trade completed.',mine:true});dlBuildBlock(g,dl,[c.team,g.team]);dlAfterCall(g,dl,c);}
  function dlAfterCall(g,dl,c){c.flashUntil=dl.elapsed+DL.FLASH;c.resolvedAt=dlClockText(dl);dlUI.phoneKey='';persist();try{if(c.state==='accepted')renderOffice();}catch(e){}dlRefreshModal(g);dlPhone(g,dl);}
  /* ---------- finishing ---------- */
  function dlFinish(g){var dl=dlLive(g);if(!dl)return;(dl.calls||[]).forEach(function(c){if(c.state==='ringing')c.state='missed';});dl.queue=[];runTradeDeadline(g);persist();dlPhoneHide();dlBar(g);
    if(document.body.getAttribute('data-view')==='office'||current.phase==='office'){renderOffice();officeOpenModal('trade-deadline');}}
  function dlSnapshotUnmoved(g,dl){var left=(dl.block||[]).filter(function(r){return !r.mine&&dlOwned(g,r);});dl.unmovedCount=left.length;dl.unmoved=left.slice(0,40).map(function(r){return {name:r.name,team:r.team,pos:r.pos,age:r.age,ovr:r.ovr,hit:r.hit,years:r.years,value:r.value,why:r.why,rental:r.rental};});
    var myLeft=(dl.block||[]).filter(function(r){return r.mine&&dlOwned(g,r);});dl.unmovedMine=myLeft.map(function(r){return r.name;});}
  /* ---------- results ---------- */
  function dlScore(e,side){var mA=Number(e.marketA)||0,mB=Number(e.marketB)||0,v=side==='A'?e.valueA:e.valueB,n=side==='A'?mB/Math.max(1,mA):mA/Math.max(1,mB),o=v&&v.give>0?v.get/v.give:1;return 0.6*Math.min(2.5,n)+0.4*Math.min(2.5,o);}
  function dlGrade(s){var L=s>=1.3?'A':s>=1.12?'B':s>=0.92?'C':s>=0.75?'D':'F',lo={A:1.3,B:1.12,C:.92,D:.75,F:0}[L],hi={A:1.6,B:1.3,C:1.12,D:.92,F:.75}[L];if(L==='F')return 'F';var t=(s-lo)/(hi-lo);return L+(t>=0.67?'+':t<0.25?'\u2212':'');}
  function dlResultsHtml(g,dl){var ents=(g.aiTradeLog||[]).filter(function(e){return e.window==='deadline'&&e.date===dl.date&&Number(e.seasonIndex||g.season)===Number(g.season);}),cards=[],teams={};
    function side(e,s){var id=s==='A'?e.teamA:e.teamB,sc=dlScore(e,s),gets=s==='A'?e.aReceives:e.bReceives;(teams[id]=teams[id]||[]).push(sc);var mine=id===g.team;
      return '<div class="dl16-side'+(mine?' mine':'')+'">'+officeMark(id,'dl16-crest')+'<div><b>'+esc(team(id).name)+(mine?' <em>YOU</em>':'')+'</b><small>receive</small><ul>'+(gets||[]).map(function(x){return '<li>'+esc(x)+'</li>';}).join('')+'</ul></div><span class="dl16-grade g'+dlGrade(sc).charAt(0)+'">'+dlGrade(sc)+'</span></div>';}
    ents.forEach(function(e){var mine=e.teamA===g.team||e.teamB===g.team;cards.push('<article class="dl16-deal'+(mine?' mine':'')+'"><header><span>'+esc(mine?(e.userCall?'YOUR DEAL \u00b7 PHONE CALL':'YOUR DEAL'):(AI_TYPE_LABEL[e.type]||e.type||'TRADE').toUpperCase())+'</span><small>'+esc(e.clock||(mine?'':'3:00 PM'))+'</small></header>'+side(e,'A')+side(e,'B')+'</article>');});
    (dl.deskDeals||[]).forEach(function(d){var su=d.nGet/Math.max(1,d.nGive),sp=d.nGive/Math.max(1,d.nGet);(teams[g.team]=teams[g.team]||[]).push(su);(teams[d.partner]=teams[d.partner]||[]).push(sp);
      cards.unshift('<article class="dl16-deal mine"><header><span>YOUR DEAL \u00b7 TRADE DESK</span><small>'+esc(d.clock)+'</small></header><div class="dl16-side mine">'+officeMark(g.team,'dl16-crest')+'<div><b>'+esc(team(g.team).name)+' <em>YOU</em></b><small>receive</small><ul>'+d.get.map(function(x){return '<li>'+esc(x)+'</li>';}).join('')+'</ul></div><span class="dl16-grade g'+dlGrade(su).charAt(0)+'">'+dlGrade(su)+'</span></div>'+
        '<div class="dl16-side">'+officeMark(d.partner,'dl16-crest')+'<div><b>'+esc(team(d.partner).name)+'</b><small>receive</small><ul>'+d.give.map(function(x){return '<li>'+esc(x)+'</li>';}).join('')+'</ul></div><span class="dl16-grade g'+dlGrade(sp).charAt(0)+'">'+dlGrade(sp)+'</span></div></article>');});
    var avg=Object.keys(teams).map(function(id){var l=teams[id];return {id:id,s:l.reduce(function(a,b){return a+b;},0)/l.length,n:l.length};}).sort(function(a,b){return b.s-a.s;}),win=avg.slice(0,3),lose=avg.length>3?avg.slice(-3).reverse():[];
    var moved=0;ents.forEach(function(e){moved+=(e.players||[]).length;});(dl.deskDeals||[]).forEach(function(d){moved+=d.movedPlayers||0;});var nMine=ents.filter(function(e){return e.teamA===g.team||e.teamB===g.team;}).length+(dl.deskDeals||[]).length;
    var wl=function(l,cls){return l.map(function(x){return '<li class="'+cls+'">'+dlChip(x.id)+'<b>'+esc(team(x.id).name)+'</b><span class="dl16-grade g'+dlGrade(x.s).charAt(0)+'">'+dlGrade(x.s)+'</span></li>';}).join('')||'<li>None</li>';};
    return '<section class="dl16 dl16-results"><header class="dl16-hero"><div><span class="dl16-k">'+esc(dlDateName(dl.date))+' \u00b7 3:00 PM ET \u00b7 HORN</span><h3>Deadline results</h3><p>Trades are closed for the season. Grades blend neutral market value with each club\u2019s own valuation.</p></div>'+
      '<div class="dl16-stats"><span><b>'+(ents.length+(dl.deskDeals||[]).length)+'</b>deals</span><span><b>'+nMine+'</b>yours</span><span><b>'+moved+'</b>players moved</span><span><b>'+(dl.unmovedCount||0)+'</b>not moved</span></div></header>'+
      '<div class="dl16-wl"><div><h4>Winners</h4><ul>'+wl(win,'w')+'</ul></div><div><h4>Losers</h4><ul>'+wl(lose,'l')+'</ul></div></div>'+
      '<div class="dl16-deals">'+(cards.join('')||'<p class="dl16-empty">A quiet deadline: no trades were completed.</p>')+'</div>'+
      '<h4 class="dl16-sub">Still on the block at the horn'+(dl.unmovedCount>40?' (top 40 of '+dl.unmovedCount+')':'')+'</h4><div class="dl16-unmoved">'+(dl.unmoved||[]).map(function(r){return '<div>'+dlChip(r.team)+'<b>'+esc(r.name)+'</b><small>'+esc(r.pos)+' \u00b7 '+r.ovr+' OVR \u00b7 '+shortMoney(r.hit)+'\u00d7'+r.years+'y'+(r.rental?' \u00b7 rental':'')+'</small></div>';}).join('')+'</div>'+
      ((dl.unmovedMine||[]).length?'<p class="dl16-foot">Your shopped players who stayed: '+esc(dl.unmovedMine.join(', '))+'.</p>':'')+
      '<div class="dl16-actions"><span class="dl16-spacer"></span><button type="button" class="dl16-btn dl16-finish" data-game-action="continue-deadline">Back to the season</button></div></section>';}
  function dlModal(g){var dl=dlGet(g);if(!dl)return null;try{if(window.getSelection)window.getSelection().removeAllRanges();}catch(e){}var m=$('workspace-modal');if(m&&m.classList)m.classList.add('dl16-wide');
    if(!dl.finished){if(!dl.opened){dl.opened=true;dl.elapsed=0;}return {title:'Trade deadline \u00b7 trade block',kicker:'Trade center \u00b7 live until 3:00 PM ET',body:dlBlockHtml(g,dl)};}
    return {title:'Deadline results',kicker:'Trade deadline \u00b7 '+seasonLabel(g),body:dlResultsHtml(g,dl)};}
  function dlRefreshModal(g){if(officeUI.modal==='trade-deadline'&&!$('workspace-modal').hidden){var st=document.querySelector('#workspace-modal .dl16-list'),y=st?st.scrollTop:0;officeModalContent();var nl=document.querySelector('#workspace-modal .dl16-list');if(nl)nl.scrollTop=y;dlCount(g);}}
  function dlRenderList(g,dl){var l=document.querySelector('#workspace-modal [data-dl-list]');if(l)l.innerHTML=dlRowsHtml(g,dl);dlCount(g);}
  function dlCount(g){var dl=dlGet(g),n=document.querySelector('#workspace-modal [data-dl-count]');if(dl&&n)n.textContent=dlFiltered(g,dl).length+' shown';}
  /* ---------- floating bar + phone ---------- */
  function dlEl(id,cls){var e=document.getElementById(id);if(!e){e=document.createElement('div');e.id=id;e.className=cls;e.hidden=true;document.body.appendChild(e);}return e;}
  function dlBar(g){var dl=dlLive(g),bar=dlEl('dl16-bar','dl16-bar');if(!dl||current.phase!=='office'){bar.hidden=true;return;}
    if(!bar.firstChild)bar.innerHTML='<span class="dl16-bar-k">DEADLINE DAY</span><b data-dl-clock></b><span class="dl16-bar-n" data-dl-bar-n></span><button type="button" data-dl-act="block">Trade block</button><button type="button" class="dl16-finish" data-dl-act="finish">Finish day</button>';
    bar.hidden=false;dlClocks(dl);}
  function dlClocks(dl){var t=dlClockText(dl);document.querySelectorAll('[data-dl-clock]').forEach(function(n){if(n.textContent!==t)n.textContent=t;});var n=document.querySelector('[data-dl-bar-n]');if(n){var k=(dl.callDeals||[]).length+(dl.deskDeals||[]).length;n.textContent=k?k+' deal'+(k>1?'s':'')+' done':'';}}
  function dlPhoneHide(){var p=document.getElementById('dl16-phone');if(p){p.hidden=true;p.innerHTML='';}dlUI.phoneKey='';}
  function dlPhone(g,dl){var ph=dlEl('dl16-phone','dl16-phone'),c=dlActive(dl),flash=null;if(!c)flash=(dl.calls||[]).filter(function(x){return x.flashUntil&&x.flashUntil>dl.elapsed;}).slice(-1)[0];var cur=c||flash;
    if(!cur||current.phase!=='office'){if(!ph.hidden)dlPhoneHide();return;}
    var key=cur.id+'|'+cur.state+'|'+(cur.note||'')+'|'+cur.give.length+'|'+cur.get.length;
    if(key!==dlUI.phoneKey){dlUI.phoneKey=key;var t=team(cur.team),ring=cur.state==='ringing',label={offer:'OFFER FOR YOUR PLAYER',shop:'RE: YOUR TRADE BLOCK',pitch:'PITCHING A PLAYER'}[cur.type],
        res={accepted:'DEAL DONE',expired:'OFFER EXPIRED',declined:'DECLINED',failed:'DEAL FELL THROUGH',missed:'MISSED CALL'}[cur.state]||'';
      ph.className='dl16-phone '+(ring?'ringing':'done '+cur.state);
      ph.innerHTML='<div class="dl16-ph-top">'+officeMark(cur.team,'dl16-crest')+'<div><small>'+(ring?'INCOMING CALL \u00b7 '+label:res)+'</small><b>'+esc(t.name)+'</b><span>General Manager \u00b7 '+esc(cur.at||'')+'</span></div></div>'+
        '<p class="dl16-ph-line">\u201c'+esc(cur.line||'')+'\u201d</p>'+
        '<div class="dl16-ph-pkg"><div><small>YOU SEND</small><ul>'+cur.give.map(function(r){return '<li>'+esc(r.txt)+'</li>';}).join('')+'</ul></div><div><small>YOU GET</small><ul>'+cur.get.map(function(r){return '<li>'+esc(r.txt)+'</li>';}).join('')+'</ul></div></div>'+
        (cur.note?'<p class="dl16-ph-note">'+esc(cur.note)+'</p>':'')+
        (ring?'<div class="dl16-ph-timer"><i data-dl-tbar></i><span data-dl-tleft></span></div><div class="dl16-ph-actions"><button type="button" class="ok" data-dl-call="accept">Accept</button><button type="button" data-dl-call="counter"'+(cur.countered?' disabled':'')+'>'+(cur.countered?'Countered':'Counter once')+'</button><button type="button" class="no" data-dl-call="decline">Decline</button></div>':'');}
    ph.hidden=false;if(c){var b=ph.querySelector('[data-dl-tbar]'),l=ph.querySelector('[data-dl-tleft]');if(b)b.style.width=Math.max(0,c.left/c.total*100)+'%';if(l)l.textContent=c.left+'s';ph.classList.toggle('urgent',c.left<=8);}}
  function dlTick(){var g=current&&current.game,dl=g&&dlLive(g);if(!dl){dlPhoneHide();var b=document.getElementById('dl16-bar');if(b)b.hidden=true;return;}
    if(current.phase!=='office'||document.hidden||!dl.opened){dlBar(g);return;}
    if(dlUI.sessionGame!==g){dlUI.sessionGame=g;(dl.calls||[]).forEach(function(c){if(c.state==='ringing'){c.state='missed';c.flashUntil=0;}});}
    dl.elapsed=(Number(dl.elapsed)||0)+1;if(dl.clock<DL.CLOCK_END-1)dl.clock++;
    var c=dlActive(dl);
    if(c){c.left--;if(c.left<=0){c.left=0;c.state='expired';c.note='You let the clock run out. They\u2019ve moved on.';dlAfterCall(g,dl,c);}}
    else if(dl.clock<DL.CLOCK_END-1){var due=(dl.queue||[]).filter(function(q){return q.at<=dl.elapsed;})[0];
      if(due){dl.queue.splice(dl.queue.indexOf(due),1);dlRing(g,dl,due);}
      else if(dl.callsMade<DL.MAX_CALLS&&dl.elapsed>=dl.nextCallAt){dlRing(g,dl,{type:Math.random()<0.5?'offer':'pitch'});}}
    dlBar(g);dlPhone(g,dl);if(++dlUI.saveTick%15===0)persist();}
  /* ---------- events ---------- */
  function dlShopToggle(g,dl,pid){var p=dlUserPlayer(g,pid);if(!p)return;if(dl.shop[pid]){delete dl.shop[pid];if(dl.shopFlag[pid]){p.onTradeBlock=false;delete dl.shopFlag[pid];}dl.queue=(dl.queue||[]).filter(function(q){return q.pid!==pid;});}
    else{var sel=document.querySelector('[data-dl-ask="'+pid.replace(/"/g,'')+'"]');dl.shop[pid]=sel?sel.value:'any';if(!p.onTradeBlock){p.onTradeBlock=true;dl.shopFlag[pid]=1;}dl.queue.push({type:'shop',pid:pid,at:dl.elapsed+dlRand(7,7)});}
    dlBuildBlock(g,dl,[g.team]);persist();dlRefreshModal(g);}
  function dlOpenDesk(g,teamId,pid){var dl=dlGet(g),mine=teamId===g.team,target=teamId;
    if(mine||!teamId){var rows=(dl&&dl.block||[]).filter(function(r){return !r.mine;});target=(current.tradeDraft&&current.tradeDraft.target&&current.tradeDraft.target!==g.team)?current.tradeDraft.target:(rows[0]?rows[0].team:Object.keys(g.leagueTeams).find(function(id){return id!==g.team;}));}
    officeCloseModal();current.page='trades';officeUI.navGroup='trade';current.tradeDraft={team:g.team,target:target,userPlayers:mine&&pid?[pid]:[],marketPlayers:!mine&&pid?[pid]:[],userPicks:[],marketPicks:[],retainUser:0,retainMarket:0,intent:'balance'};
    renderOffice();var p=pid?(mine?dlUserPlayer(g,pid):clubRoster(g,teamId).find(function(x){return x.id===pid;})):null;setNotice(p?'Trade desk: '+p.name+' is loaded with '+team(target).name+'. Deadline day stays open; use Trade block to go back.':'Trade desk open. Deadline day stays open until you finish it.');}
  document.addEventListener('click',function(e){var g=current&&current.game;if(!g||!e.target||!e.target.closest)return;var t=e.target.closest('[data-dl-act],[data-dl-player],[data-dl-call],[data-dl-shop]');if(!t)return;var dl=dlGet(g);if(!dl)return;
    if(t.hasAttribute('data-dl-call')){var c=dlActive(dl),a=t.getAttribute('data-dl-call');if(!c)return;if(a==='accept')dlAccept(g,dl,c);else if(a==='counter')dlCounter(g,dl,c);else{c.state='declined';c.note='You passed.';dlAfterCall(g,dl,c);}return;}
    if(dl.finished)return;
    if(t.hasAttribute('data-dl-shop')){dlShopToggle(g,dl,t.getAttribute('data-dl-shop'));return;}
    if(t.hasAttribute('data-dl-player')){dlOpenDesk(g,t.getAttribute('data-dl-team'),t.getAttribute('data-dl-player'));return;}
    var act=t.getAttribute('data-dl-act');if(act==='finish')dlFinish(g);else if(act==='block'){officeOpenModal('trade-deadline');}else if(act==='desk')dlOpenDesk(g,null,null);else if(act==='shop'){dlUI.shopOpen=!dlUI.shopOpen;dlRefreshModal(g);}});
  function dlOnInput(e){var g=current&&current.game,t=e.target;if(!g||!t||!t.getAttribute)return;var dl=dlGet(g);if(!dl)return;
    if(t.hasAttribute('data-dl-filter')){dlUI[t.getAttribute('data-dl-filter')]=t.value;dlRenderList(g,dl);}
    else if(t.hasAttribute('data-dl-ask')&&e.type==='change'){var pid=t.getAttribute('data-dl-ask');if(dl.shop[pid]){dl.shop[pid]=t.value;dlBuildBlock(g,dl,[g.team]);persist();dlRenderList(g,dl);}}
    else if(t.hasAttribute('data-dl-pref')&&e.type==='change'){dlSetPref(t.value);setNotice(t.value==='quick'?'Presentation saved: future deadlines use the quick summary. Today\u2019s block stays open.':'Presentation saved: trade block with live calls.');}}
  document.addEventListener('input',dlOnInput);document.addEventListener('change',dlOnInput);
  /* ---------- wrappers ---------- */
  var dlOrigRunTD=runTradeDeadline;runTradeDeadline=function(g){var dl=dlLive(g);if(dl){(dl.calls||[]).forEach(function(c){if(c.state==='ringing')c.state='missed';});dl.queue=[];}
    var ev=dlOrigRunTD.apply(this,arguments);if(dl&&g.tradeDeadline&&g.tradeDeadline.year===dl.year){dl.finished=true;dl.clock=DL.CLOCK_END;dlSnapshotUnmoved(g,dl);Object.keys(dl.shopFlag||{}).forEach(function(pid){var p=dlUserPlayer(g,pid);if(p)p.onTradeBlock=false;});dl.shopFlag={};dlPhoneHide();}return ev;};
  var dlOrigIOTB=isOnTradeBlock;isOnTradeBlock=function(g,id,p){if(dlOnBlock(g,id,p))return true;return dlOrigIOTB.apply(this,arguments);};
  var dlOrigPropose=proposeTrade;proposeTrade=function(){var g=current&&current.game,dl=g&&dlLive(g);if(!dl){var h0=g?dlRosterHits(g):0,r0=dlOrigPropose.apply(this,arguments);if(g)dlRefSync(g,h0);return r0;}var hits0=dlRosterHits(g);
    var d=null,head=(g.transactionLog||[])[0],snap=null;try{d=prepareTradeDraft(g);dlStatusNow(g,dl);var mine=clubTradePlayers(g,g.team),theirs=clubTradePlayers(g,d.target),up=clubPicks(g,g.team),tp=clubPicks(g,d.target);
      var send=d.userPlayers.map(function(id){return mine.find(function(p){return p.id===id;});}).filter(Boolean).concat(up.filter(function(k){return d.userPicks.indexOf(pickKey(k))>=0;})),
          recv=d.marketPlayers.map(function(id){return theirs.find(function(p){return p.id===id;});}).filter(Boolean).concat(tp.filter(function(k){return d.marketPicks.indexOf(pickKey(k))>=0;}));
      [send,recv].forEach(function(l,ix){l.forEach(function(a){if(!a.round)a.__group=tradePlayerGroup(g,ix?d.target:g.team,a)||'active';});});
      snap={target:d.target,send:send,recv:recv,give:send.map(aiAssetLabel),get:recv.map(aiAssetLabel),nGive:aiNeutral(g,send),nGet:aiNeutral(g,recv)};}catch(e){snap=null;}
    var r=dlOrigPropose.apply(this,arguments);
    try{var top=(g.transactionLog||[])[0];if(snap&&top&&top!==head&&top.tag==='USER TRADE'){var key=v4fixTradeKey(g);snap.recv.forEach(function(a){if(!a.round){a.v4TradedKey=key;a.aiTradeLockSeason=g.season;}});
      dl.deskDeals.push({clock:dlClockText(dl),partner:snap.target,give:snap.give,get:snap.get,nGive:Math.round(snap.nGive),nGet:Math.round(snap.nGet),movedPlayers:snap.send.concat(snap.recv).filter(function(a){return !a.round;}).length});
      dl.feed.unshift({t:dlClockText(dl),text:top.text,mine:true});dlUserBackfill(g);dlRefSync(g,hits0);hits0=null;Object.keys(dl.shop).forEach(function(pid){if(!dlUserPlayer(g,pid))delete dl.shop[pid];});dlBuildBlock(g,dl,[snap.target,g.team]);persist();dlBar(g);}}catch(e){console.error('deadline desk',e);}
    if(hits0!=null)dlRefSync(g,hits0);return r;};
  var dlOrigModalContent=officeModalContent;officeModalContent=function(){var m=$('workspace-modal');if(m&&m.classList)m.classList.remove('dl16-wide');if(officeUI.modal==='trade-deadline'){try{if(window.getSelection)window.getSelection().removeAllRanges();}catch(e){}}var r=dlOrigModalContent.apply(this,arguments);if(officeUI.modal==='trade-deadline')dlCount(current.game);return r;};
  var dlOrigRenderOffice=renderOffice;renderOffice=function(){var r=dlOrigRenderOffice.apply(this,arguments);try{var g=current.game,dl=dlLive(g);dlBar(g);
      if(dl&&dlUI.autoOpened!==g&&!officeUI.modal&&current.phase==='office'){dlUI.autoOpened=g;setTimeout(function(){if(current.game===g&&dlLive(g)&&!officeUI.modal)officeOpenModal('trade-deadline');},0);}}catch(e){}return r;};
  dlUI.timer=setInterval(function(){try{dlTick();}catch(e){console.error('deadline tick',e);}},1000);
  window.CTFODeadline={state:function(){return dlGet(current.game);},ring:function(type,pid){var g=current.game,dl=dlLive(g);if(!dl||dlActive(dl))return null;return dlRing(g,dl,{type:type||'offer',pid:pid});},
    accept:function(){var g=current.game,dl=dlLive(g);if(dl)dlAccept(g,dl,dlActive(dl));},finish:function(){dlFinish(current.game);},pref:dlPref,setPref:dlSetPref};
  /* ===== END V10 DEADLINE DAY (patch16) ===== */
  /* ===== V10 VALUE & REALISM PASS (patch19) =====
     1 deadline calls lopsided toward the AI club, with a value meter; counter once lands near fair
     2 trade block realism: contenders keep their core; cap-dump reasons only for clubs at/over the cap (max 2)
     3 POT never below OVR      4 Center role only for the top-two centers + centers projected to be top-six
     5 trade value follows a young player's ceiling (age-scaled), never discounted for 4th-line usage */
  var P19={CENTER:1.15,LOP_MIN:1.15,LOP_MAX:1.40,FAIR_LO:.95,FAIR_HI:1.05,DUMPS:2,CAP_TOL:250000,POOL:18};
  /* ---------- 3. POT >= OVR ---------- */
  function p19AllPlayers(g){var out=[];var add=function(l){(l||[]).forEach(function(p){if(p&&typeof p==='object'&&p.name)out.push(p);});};add(g.roster);add(g.reserveRoster);add(g.orgProspects);add(g.prospects);
    Object.keys(g.leagueTeams||{}).forEach(function(id){var c=g.leagueTeams[id];if(c){add(c.roster);add(c.reserveRoster);add(c.orgProspects);}});(g.freeAgents||[]).forEach(function(s){if(s&&s.player)add([s.player]);else if(s&&s.name)add([s]);});return out;}
  function p19PotFloor(g){if(!g)return 0;var n=0;p19AllPlayers(g).forEach(function(p){var o=Number(p.ovr);if(o>0&&!(Number(p.potential)>=o)){p.potential=o;n++;}});return n;}
  /* ---------- 5. potential-based value ---------- */
  function p19PotWeight(age){age=Number(age)||27;return age<=21?1:age<=22?.9:age<=23?.75:age<=24?.55:age<=25?.35:age<=26?.15:0;}
  function p19ValueOvr(p){var o=Number(p&&p.ovr)||0,pot=Math.max(o,Number(p&&p.potential)||o);if(!p||p.pos==='G')return o;return o+(pot-o)*p19PotWeight(p.age);}
  var p19NoUsage=0,p19OrigProj=nhlPointProjection;nhlPointProjection=function(g,p){if(p19NoUsage)return null;return p19OrigProj.apply(this,arguments);};
  var p19PrevGmValue=gmAssetValue;gmAssetValue=function(g,id,asset){if(!asset||asset.round)return p19PrevGmValue.apply(this,arguments);var vo=p19ValueOvr(asset);if(vo<(Number(asset.ovr)||0)+.5)return p19PrevGmValue.apply(this,arguments);
    var q=Object.assign({},asset,{ovr:Math.round(vo)});p19NoUsage++;try{return p19PrevGmValue.call(this,g,id,q);}finally{p19NoUsage--;}};
  var p19OrigStatus=aiStatusInfo;aiStatusInfo=function(g,p){var info=p19OrigStatus.apply(this,arguments);if(!info||!p||p.pos==='G')return info;var vo=p19ValueOvr(p),o=Number(p.ovr)||0;if(vo<o+.5)return info;
    var key='p19|'+p.id+'|'+g.season+'|'+g.stage+'|'+(g.day||0)+'|'+(aiStatusNow.kind||'')+'|'+(p.years||0)+'|'+(p.club||'');if(aiStatusCache[key])return aiStatusCache[key];
    var v=p19OrigStatus.call(this,g,Object.assign({},p,{id:p.id+'#pv',ovr:Math.round(vo)}));if(!v)return info;
    var out=Object.assign({},info,{now:v.now,growth:v.growth,surplus:v.surplus,premium:v.premium,rentalEq:v.rentalEq,neutral:Math.max(info.neutral,v.neutral),valueOvr:Math.round(vo)});aiStatusCache[key]=out;return out;};
  /* ---------- 4. Center role: top-two centers + projected top-six centers ---------- */
  /* Center role: PRIMARY centers only (user rule 8:23). Prefers lines-work's lv2IsPrimaryC / p.posPrimary once that patch is in the build;
     until then reads window.CTFO_PRIMARY_FWD (primary-fwd.js, generated from /workspace/positions/positions.json: id -> nhlId -> canonPlayerName). */
  var P19PF=(typeof window!=='undefined'&&window.CTFO_PRIMARY_FWD)||null;
  function p19PrimaryPos(p){if(!p)return '';if(p.pos==='G'||p.pos==='D')return p.pos;
    if(typeof lv2IsPrimaryC==='function'){try{return lv2IsPrimaryC(p)?'C':(p.posPrimary||p.pos||'');}catch(e){}}
    if(p.posPrimary)return p.posPrimary;
    var v='';if(P19PF){v=P19PF.id[p.id]||(p.nhlId&&P19PF.nhl[p.nhlId])||(p.providerId&&P19PF.nhl[p.providerId])||'';if(!v&&p.name){try{v=P19PF.name[canonPlayerName(p.name)]||'';}catch(e){}}}
    return v?({C:'C',L:'LW',R:'RW'})[v]:(p.pos||'');}
  function p19IsPrimaryC(p){return p19PrimaryPos(p)==='C';}
  function p19CenterSets(g,id){var rank=function(a,b){return (Number(b.ovr)||0)-(Number(a.ovr)||0)||(Number(b.potential)||0)-(Number(a.potential)||0)||(Number(a.age)||99)-(Number(b.age)||99)||String(a.id).localeCompare(String(b.id));};
    var roster=clubRoster(g,id)||[],c=tradeClubObject(g,id)||{},top=roster.filter(function(p){return p19IsPrimaryC(p);}).sort(rank).slice(0,2),bar=top[1]?Number(top[1].ovr)||0:(top[0]?Number(top[0].ovr)||0:99),topIds=top.map(function(p){return p.id;}),proj=[];
    roster.concat(c.reserveRoster||[],c.orgProspects||[]).forEach(function(p){if(!p||!p19IsPrimaryC(p)||topIds.indexOf(p.id)>=0||proj.indexOf(p.id)>=0)return;if(Math.max(Number(p.ovr)||0,Number(p.potential)||0)>=bar)proj.push(p.id);});
    return {top:topIds,projected:proj,bar:bar};}
  var p19OrigPremiumSel=premiumRosterSelection;premiumRosterSelection=function(g,id){var r=p19OrigPremiumSel.apply(this,arguments),s=p19CenterSets(g,id);r.centers=s.top.concat(s.projected);r.topCenters=s.top;r.projectedCenters=s.projected;return r;};
  function p19RoleLabel(g,id,p){if(!p)return '';var s=p19CenterSets(g,id);if(s.top.indexOf(p.id)>=0)return 'Top-6 C';if(s.projected.indexOf(p.id)>=0)return 'Projected top-6 C';var r=premiumRosterRole(g,id,p)||p.rosterValueRole||'';return r==='Center'?'':r;}
  var p19OrigPremiumRole=premiumRosterRole;premiumRosterRole=function(g,id,p){if(!p)return '';var s=p19CenterSets(g,id);if(s.top.indexOf(p.id)>=0||s.projected.indexOf(p.id)>=0)return 'Center';var r=p19OrigPremiumRole.apply(this,arguments);return r==='Center'?'':r;};
  function p19SyncCenterRoles(g){if(!g||!g.team)return;var s=p19CenterSets(g,g.team),ok=s.top.concat(s.projected);(g.roster||[]).concat(g.reserveRoster||[],g.orgProspects||[]).forEach(function(p){if(!p)return;if(ok.indexOf(p.id)>=0)p.rosterValueRole='Center';else if(p.rosterValueRole==='Center')p.rosterValueRole='';});}
  /* ---------- 4b. Center role trade value: flat +15% (user decision), all clubs, desk value and AI engine ---------- */
  var p19CIdx={key:'',ids:{}};
  function p19CenterIndex(g){var k=g.season+'|'+g.stage+'|'+g.day+'|'+(g.transactionLog||[]).length+'|'+(g.aiTradeLog||[]).length+'|'+(g.aiLog||[]).length+'|'+(g.roster||[]).length+'|'+(g.deadlineDay&&(g.deadlineDay.callDeals||[]).length||0);
    if(p19CIdx.key===k)return p19CIdx.ids;var ids={};teams.forEach(function(t){try{var s=p19CenterSets(g,t.id);s.top.concat(s.projected).forEach(function(id){ids[id]=t.id;});}catch(e){}});p19CIdx={key:k,ids:ids};return ids;}
  function p19IsCenter(g,p){return !!(g&&p&&!p.round&&p19IsPrimaryC(p)&&p19CenterIndex(g)[p.id]);}
  function p19BonusLabel(g,id,p,role){if(role==='Center'||p19IsCenter(g,p))return 'Center role \u00b7 +15%'+(p19RoleLabel(g,id,p)?' \u00b7 '+p19RoleLabel(g,id,p):'');return role?String(role).toUpperCase()+' \u00b7 UP TO 6% FIT BONUS':'';}
  var p19GmBase=gmAssetValue;gmAssetValue=function(g,id,asset){var v=p19GmBase.apply(this,arguments);if(typeof v==='number'&&p19IsCenter(g,asset))v=Math.round(v*P19.CENTER);return v;};
  var p19MarketBase=aiMarket;aiMarket=function(g,a){var v=p19MarketBase.apply(this,arguments);if(typeof v==='number'&&a&&!a.round&&p19IsCenter(g,a))v=v*P19.CENTER;return v;};
  /* ---------- 2. trade block realism (same availability source as the AI engine) ---------- */
  function p19Core(g,ctx){if(ctx.__p19core)return ctx.__p19core;var r=(ctx.club&&ctx.club.roster)||[],by=function(k){return r.filter(function(p){return aiGroup(p)===k;}).sort(function(a,b){return (Number(b.ovr)||0)-(Number(a.ovr)||0);});},core={};
    by('F').slice(0,9).concat(by('D').slice(0,4),by('G').slice(0,1),r.filter(function(p){return (Number(p.ovr)||0)>=86&&Number(p.years)>=2;})).forEach(function(p){core[p.id]=1;});return ctx.__p19core=core;}
  function p19CapOver(g,ctx){return (Number(ctx.pay)||capUsedClub(g,ctx.id))>=(Number(g.cap)||0)-P19.CAP_TOL;}
  function p19Dumps(g,ctx){if(ctx.__p19dumps)return ctx.__p19dumps;var d={};if(p19CapOver(g,ctx)){var core,r=(ctx.club&&ctx.club.roster)||[],top3=r.slice().sort(function(a,b){return (Number(b.ovr)||0)-(Number(a.ovr)||0);}).slice(0,3).map(function(p){return p.id;});
      core=p19Core(g,ctx);r.filter(function(p){return top3.indexOf(p.id)<0&&!core[p.id]&&(Number(p.age)||27)>=26&&contractHit(p)>=1500000&&Number(p.years)>=1&&!ctx.protectedIds[p.id];}).map(function(p){return {p:p,over:contractHit(p)-aiFairHit(p.ovr)};}).sort(function(a,b){return b.over-a.over;}).slice(0,P19.DUMPS).forEach(function(x){d[x.p.id]=1;});}
    return ctx.__p19dumps=d;}
  var p19OrigSeller=aiSellerAvailable;aiSellerAvailable=function(g,ctx,p,buyer){if(!ctx||!p||ctx.id===g.team)return p19OrigSeller.apply(this,arguments);var dumps=p19Dumps(g,ctx);
    if(dumps[p.id])return !ctx.protectedIds[p.id];                                     // a cap-dump contract is always shoppable
    if(!p19OrigSeller.apply(this,arguments))return false;var role=ctx.role,age=Number(p.age)||27;
    if((role==='WIN_NOW'||role==='CONTENDER'||role==='BUBBLE')&&p19Core(g,ctx)[p.id])return false;   // contenders keep their core
    if((role==='REBUILD'||role==='YOUTH_MOVEMENT')&&age<27&&!(Number(p.years)<=1))return false;   // rebuilders sell veterans (and expiring deals)
    return true;};
  /* deadline block labels: cap dump only for the club's dump list; wants follow the real cap state */
  if(typeof dlWhy==='function'){var p19OrigWhy=dlWhy;dlWhy=function(g,x,p,si){var dumps=p19Dumps(g,x);if(dumps[p.id])return 'Cap dump \u00b7 over the cap'+(si&&si.rental?' \u00b7 pending UFA rental':'');var y=Object.assign({},x,{capTrouble:false});return p19OrigWhy.call(this,g,y,p,si);};}
  if(typeof dlWants==='function'){var p19OrigWants=dlWants;dlWants=function(g,x){return p19OrigWants.call(this,g,Object.assign({},x,{capTrouble:p19CapOver(g,x)}));};}
  /* ---------- 1. lopsided deadline calls + value meter + counter to fair ---------- */
  function p19Combos(pool,maxN){var out=[],n=pool.length;for(var i=0;i<n;i++){out.push([pool[i]]);if(maxN<2)continue;for(var j=i+1;j<n;j++){out.push([pool[i],pool[j]]);if(maxN<3)continue;for(var k=j+1;k<n;k++)out.push([pool[i],pool[j],pool[k]]);}}return out;}
  // Find the package from pool whose neutral value V makes ratio(V) closest to target and inside [lo,hi]. ratio(V)=f(V).
  function p19Pack(g,pool,ratioOf,target,lo,hi,legal){var best=null;pool=pool.filter(function(a){return aiMarket(g,a)>=3;}).sort(function(a,b){return aiMarket(g,b)-aiMarket(g,a);}).slice(0,P19.POOL);
    p19Combos(pool,3).forEach(function(c){var v=aiNeutral(g,c),r=ratioOf(v);if(!(r>=lo&&r<=hi))return;var d=Math.abs(r-target)+c.length*.004;if(best&&d>=best.d)return;if(legal&&!legal(c))return;best={c:c,d:d,v:v,r:r};});return best;}
  function p19Target(dl,type,X){var f=dlFrac(dl),t=P19.LOP_MIN+Math.random()*(P19.LOP_MAX-P19.LOP_MIN);
    if(type==='pitch')t-=0.10*Math.max(0,f-0.5)*2;                                         // sellers near 3 PM take a bit less
    else if((X.role==='WIN_NOW'||X.role==='CONTENDER')&&f>0.5)t-=0.08;                     // desperate contenders pay a bit more
    return Math.max(1.12,Math.min(P19.LOP_MAX,t));}
  function p19Assets(g,pool,ask){var fp=dlAskPool(pool,ask);return fp.length>=2?fp:pool;}
  dlBuildOffer=function(g,dl,ctxs,U,f,pid,ask){var picked=pid?[dlUserPlayer(g,pid)].filter(Boolean):g.roster.filter(function(p){return (Number(p.ovr)||0)>=76&&Number(p.years)>0&&!U.protectedIds[p.id];}),cands=[];
    picked.forEach(function(p){if(U.protectedIds[p.id])return;p.__group=tradePlayerGroup(g,g.team,p)||'active';Object.keys(ctxs).forEach(function(id){var X=ctxs[id];if((dl.calledTeams[id]||0)>=DL.PER_TEAM_CALLS)return;
      try{if(!aiConsents(p,id))return;if(p.__group==='active'&&!aiBuyerWants(X,p,g))return;var lvl=aiNeedLevel(X,p);if(!pid&&(lvl===0||!aiImproves(X,p)))return;cands.push({X:X,p:p,s:aiValue(g,X,p,true)+lvl*8+Math.random()*12-(dl.calledTeams[id]||0)*10});}catch(e){}});});
    cands.sort(function(a,b){return b.s-a.s;});
    for(var i=0;i<cands.length&&i<10;i++){var X=cands[i].X,p=cands[i].p,nu=aiNeutral(g,[p]),t=p19Target(dl,'offer',X),pool=p19Assets(g,aiTradeableAssets(g,X,'deadline'),ask);
      var best=p19Pack(g,pool,function(v){return nu/Math.max(1,v);},t,1.12,P19.LOP_MAX,function(c){return !aiLegal(g,U,X,[p],c);});if(!best)continue;
      return {type:pid?'shop':'offer',team:X.id,give:dlRefs([p],g.team),get:dlRefs(best.c,X.id),dealType:dlBuyType(X),player:p.name,nu:Math.round(nu),na:Math.round(best.v),
        line:(pid?'Saw '+p.name+' on the block. ':'')+'We\u2019d like '+p.name+'. Here\u2019s our offer.'};}
    return null;};
  dlBuildPitch=function(g,dl,ctxs,U,f){var cands=[];(dl.block||[]).forEach(function(r){if(r.mine||(dl.calledTeams[r.team]||0)>=DL.PER_TEAM_CALLS)return;var X=ctxs[r.team];if(!X)return;var p=(X.club.roster||[]).find(function(x){return x.id===r.pid;});if(!p)return;if((dl.calls||[]).some(function(c){return c.type==='pitch'&&c.get&&c.get[0]&&c.get[0].id===p.id;}))return;p.__group='active';
      try{if(!aiConsents(p,g.team))return;var lvl=aiNeedLevel(U,p),imp=aiImproves(U,p);if(!imp&&!lvl)return;if(U.space+2500000<contractHit(p))return;cands.push({X:X,p:p,s:r.value*0.03+lvl*8+(imp?6:0)+Math.random()*10});}catch(e){}});
    cands.sort(function(a,b){return b.s-a.s;});var pool=aiTradeableAssets(g,U,'deadline');
    for(var i=0;i<cands.length&&i<10;i++){var X=cands[i].X,p=cands[i].p,na=aiNeutral(g,[p]),t=p19Target(dl,'pitch',X);
      var best=p19Pack(g,pool,function(v){return v/Math.max(1,na);},t,1.12,P19.LOP_MAX,function(c){return !aiLegal(g,X,U,[p],c);});if(!best)continue;
      return {type:'pitch',team:X.id,give:dlRefs(best.c,g.team),get:dlRefs([p],X.id),dealType:dlSellType(X),player:p.name,nu:Math.round(best.v),na:Math.round(na),line:'We\u2019re moving '+p.name+' today and you\u2019re a fit. This is the price.'};}
    return null;};
  // Counter once: find the package nearest 100% inside 95-105% -- a fresh package, the current package plus sweeteners, or a trimmed one.
  function p19Fair(g,pool,base,ratioOf,legal,trim){var best=p19Pack(g,pool,ratioOf,1.0,P19.FAIR_LO,P19.FAIR_HI,legal);if(best)return best;
    var ids=base.map(function(a){return a.id;}),rest=pool.filter(function(a){return ids.indexOf(a.id)<0&&aiMarket(g,a)>=3;}).sort(function(a,b){return aiMarket(g,b)-aiMarket(g,a);}).slice(0,P19.POOL),cand=[];
    if(trim)p19Combos(base,3).forEach(function(c){if(c.length<base.length)cand.push(c);});
    else p19Combos(rest,2).forEach(function(c){cand.push(base.concat(c));});
    cand.forEach(function(c){var v=aiNeutral(g,c),r=ratioOf(v);if(!(r>=P19.FAIR_LO&&r<=P19.FAIR_HI))return;var d=Math.abs(r-1)+c.length*.004;if(best&&d>=best.d)return;if(legal&&!legal(c))return;best={c:c,d:d,v:v,r:r};});
    return best||p19Pack(g,pool,ratioOf,1.0,.92,1.08,legal);}
  dlCounter=function(g,dl,c){if(!c||c.countered||c.state!=='ringing')return;c.countered=true;var ctxs=dlCtxs(g,dl),X=ctxs[c.team],U=dlUserCtx(g,c.type==='pitch'),give=dlResolve(g,c.give),get=dlResolve(g,c.get),best=null;
    if(X&&give&&get){if(c.type==='pitch'){var na=aiNeutral(g,get);best=p19Fair(g,aiTradeableAssets(g,U,'deadline'),give,function(v){return v/Math.max(1,na);},function(cc){return !aiLegal(g,X,U,get,cc);},true);
        if(best){c.give=dlRefs(best.c,g.team);c.nu=Math.round(best.v);c.na=Math.round(na);}}
      else{var nu=aiNeutral(g,give);best=p19Fair(g,p19Assets(g,aiTradeableAssets(g,X,'deadline'),c.type==='shop'?dl.shop[(c.give[0]||{}).id]:null),get,function(v){return nu/Math.max(1,v);},function(cc){return !aiLegal(g,U,X,give,cc);},false);
        if(best){c.get=dlRefs(best.c,X.id);c.nu=Math.round(nu);c.na=Math.round(best.v);}}}
    c.note=best?'Fine. That\u2019s fair value, take it or leave it.':'That\u2019s our best offer.';if(best)c.left=Math.max(c.left,12);dlUI.phoneKey='';dlPhone(g,dl);persist();};
  function p19MeterOn(){try{return localStorage.getItem('ctfo.callMeter')!=='off';}catch(e){return true;}}
  function p19Meter(c){if(!(c&&c.nu>0&&c.na>0))return '';var r=c.nu/c.na,pct=Math.round((r-1)*100),tag=r<P19.FAIR_LO?'STEAL':r<=P19.FAIR_HI?'FAIR':r<=1.15?'OVERPAY':'RIPOFF',cls=tag.toLowerCase(),w=Math.max(8,Math.min(92,Math.round(c.nu/(c.nu+c.na)*100)));
    if(!p19MeterOn())return '<button type="button" class="p19-meter-toggle" data-p19-meter="on">Show value meter</button>';
    return '<div class="p19-meter '+cls+'"><div class="p19-meter-top"><span>VALUE</span><b>'+tag+'</b><em>'+(pct>0?'they win +'+pct+'%':pct<0?'you win +'+(-pct)+'%':'even')+'</em><button type="button" class="p19-meter-toggle" data-p19-meter="off" title="Hide value meter">\u00d7</button></div>'+
      '<div class="p19-meter-bar"><i style="width:'+w+'%"></i><span class="mid"></span></div><div class="p19-meter-legend"><span>You send '+c.nu+'</span><span>You get '+c.na+'</span></div></div>';}
  var p19OrigPhone=dlPhone;dlPhone=function(g,dl){var before=dlUI.phoneKey;p19OrigPhone.apply(this,arguments);var ph=document.getElementById('dl16-phone'),c=dlActive(dl)||(dl.calls||[]).filter(function(x){return x.flashUntil&&x.flashUntil>dl.elapsed;}).slice(-1)[0];
    if(!ph||ph.hidden||!c)return;var k=c.id+'|'+c.nu+'|'+c.na+'|'+p19MeterOn(),slot=ph.querySelector('.p19-meter-slot');if(slot&&slot.getAttribute('data-k')===k)return;
    if(!slot){slot=document.createElement('div');slot.className='p19-meter-slot';var pkg=ph.querySelector('.dl16-ph-pkg');if(pkg&&pkg.parentNode)pkg.parentNode.insertBefore(slot,pkg.nextSibling);else ph.appendChild(slot);}slot.setAttribute('data-k',k);slot.innerHTML=p19Meter(c);};
  document.addEventListener('click',function(e){var t=e.target&&e.target.closest&&e.target.closest('[data-p19-meter]');if(!t)return;try{localStorage.setItem('ctfo.callMeter',t.getAttribute('data-p19-meter'));}catch(x){}var g=current&&current.game,dl=g&&dlGet(g);if(dl){dlUI.phoneKey='';dlPhone(g,dl);}});
  /* ---------- hooks: POT floor + center roles on load / each render ---------- */
  var p19OrigUpgrade=upgradeGame;upgradeGame=function(g){g=p19OrigUpgrade.apply(this,arguments);try{if(g){p19PotFloor(g);p19SyncCenterRoles(g);}}catch(e){console.error('patch19 upgrade',e);}return g;};
  var p19RenderKey='',p19OrigRender=renderOffice;renderOffice=function(){var g=current&&current.game;try{if(g){var k=g.season+'|'+g.stage+'|'+g.day+'|'+(g.offseason&&g.offseason.phase||'')+'|'+(g.roster||[]).length+'|'+(g.transactionLog||[]).length;if(k!==p19RenderKey){p19RenderKey=k;p19PotFloor(g);p19SyncCenterRoles(g);}}}catch(e){console.error('patch19 render',e);}return p19OrigRender.apply(this,arguments);};
  window.CTFOValue={isCenter:function(p){return p19IsCenter(current.game,p);},primaryPos:p19PrimaryPos,valueOvr:p19ValueOvr,centers:function(id){var g=current.game;return p19CenterSets(g,id||g.team);},label:function(id,p){return p19RoleLabel(current.game,id,p);},potFloor:function(){return p19PotFloor(current.game);}};
  /* ===== END V10 VALUE & REALISM PASS (patch19) ===== */
  /* patch20: seasons QA port applied */
  /* ===== V10 84-GAME SEASON + OFFICIAL 2026-27 SCHEDULE (patch21) ===== */
  /* The 2026-27 regular season is 84 games (42 home / 42 away). Season 1 uses the official NHL schedule bundled in
     nhl-schedule-2026-27.js (no network). Every club plays its real dates and opponents; the other 30 clubs' games are
     simulated on their real dates as the user's calendar advances. Later seasons keep the 84-game generator. */
  var P21_GAMES=84;
  function p21Data(){var d=window.CTFO_NHL_SCHEDULE_20262027;return d&&Array.isArray(d.rows)&&d.rows.length===P21_GAMES*16?d:null;}
  function p21Year(g){return Number(g.startYear)+Number(g.season)-1;}
  function p21League(){var d=p21Data();if(!d)return null;if(p21League.cache)return p21League.cache;
    p21League.cache=d.rows.map(function(r){var id=d.idBase+r[0];return {gameId:id,date:r[1],away:r[2],home:r[3],startTimeUTC:r[4]?r[4]+':00Z':null,neutral:d.neutral&&d.neutral[String(id)]||''};});return p21League.cache;}
  function p21ClubCalendar(id){var L=p21League();if(!L)return null;return L.filter(function(x){return x.home===id||x.away===id;}).map(function(x){var home=x.home===id;return {gameId:x.gameId,date:x.date,opponent:home?x.away:x.home,venue:home?'HOME':'AWAY',startTimeUTC:x.startTimeUTC,neutralSite:x.neutral||undefined};});}
  function p21ApplyOfficial(g){if(!g||p21Year(g)!==2026||!g.team)return false;var cal=p21ClubCalendar(g.team);if(!cal||cal.length!==P21_GAMES)return false;
    g.calendarGames=cal;g.schedule=cal.map(function(x){return x.opponent;});g.seasonGames=P21_GAMES;g.scheduleSource='Official NHL 2026–27 schedule';g.scheduleStatus='loaded';g.leagueScheduleSeason=2026;g.leagueSchedulePtr=0;return true;}
  function p21OfficialActive(g){return !!(g&&g.leagueScheduleSeason===2026&&p21Year(g)===2026&&g.stage==='regular'&&String(g.scheduleSource||'').indexOf('Official NHL')===0&&p21League());}
  seasonGameCount=function(g){return (g&&Number(g.seasonGames))||P21_GAMES;};
  var p21OrigFresh=freshGame;freshGame=function(id,mode){var g=p21OrigFresh.apply(this,arguments);try{g.seasonGames=P21_GAMES;if(g.stage==='regular'&&!p21ApplyOfficial(g)){var gen=[];for(var i=0;i<P21_GAMES;i++){var opps=teams.filter(function(t){return t.id!==g.team;});gen.push(opps[(i*7+Math.floor(i/31))%opps.length].id);}g.schedule=gen;}}catch(e){console.error('patch21 fresh',e);}return g;};
  /* manual "Sync NHL calendar" and the new-season sync: the bundled schedule answers first, no network */
  var p21OrigSync=syncOfficialSchedule;syncOfficialSchedule=function(g){try{if(g&&p21Year(g)===2026&&(Number(g.day)||0)===0&&p21ApplyOfficial(g)){persist();if(current.game===g){renderOffice();setNotice('Official NHL 2026–27 schedule loaded: '+P21_GAMES+' dated games for '+team(g.team).name+'.');}return Promise.resolve(true);}}catch(e){console.error('patch21 sync',e);}return p21OrigSync.apply(this,arguments);};
  /* the other clubs play their official games on their real dates (everything up to and including the user's game date; the rest after the user's finale) */
  var p21OrigSimAI=simAI;simAI=function(g,excludedOpponent){if(!p21OfficialActive(g))return p21OrigSimAI.apply(this,arguments);
    var L=p21League(),cal=g.calendarGames||[],today=cal[g.day]&&cal[g.day].date,last=g.day>=seasonGameCount(g)-1,ptr=Number(g.leagueSchedulePtr)||0;
    while(ptr<L.length&&(last||L[ptr].date<=today)){var x=L[ptr++];if(x.home===g.team||x.away===g.team)continue;
      var box=simulateMatchup(g,x.home,x.away,x.home),type=box.ot?(box.so?'so':'ot'):'reg';adjustStandings(g.standings[x.home],box.a,box.b,type,x.away,true);adjustStandings(g.standings[x.away],box.b,box.a,type,x.home,false);}
    g.leagueSchedulePtr=ptr;};
  /* saves: an 82-game season already in progress finishes at 82; an unplayed 2026-27 season switches to the official 84 */
  var p21OrigUpgrade=upgradeGame;upgradeGame=function(g){g=p21OrigUpgrade.apply(this,arguments);try{if(g&&!g.seasonGames){var n=(g.schedule||[]).length;
      if(g.stage==='regular'&&(Number(g.day)||0)===0&&p21Year(g)===2026&&p21ApplyOfficial(g)){}
      else if(n===82&&(Number(g.day)||0)>0&&g.stage==='regular')g.seasonGames=82;
      else g.seasonGames=P21_GAMES;}}catch(e){console.error('patch21 upgrade',e);}return g;};
  /* new season: back to 84 before the schedule is generated */
  var p21OrigAdvance=advanceSeason;advanceSeason=function(g){if(g&&g.stage==='offseason'&&(!g.offseason||g.offseason.phase==='ready')){g.seasonGames=P21_GAMES;g.leagueScheduleSeason=null;}return p21OrigAdvance.apply(this,arguments);};
  window.CTFOSchedule={official:function(id){return p21ClubCalendar(id||current.game.team);},league:p21League,active:function(){return p21OfficialActive(current.game);}};
  /* ===== END V10 84-GAME SEASON + OFFICIAL 2026-27 SCHEDULE (patch21) ===== */
  /* patch22: front-office QA port applied */
  /* ===== V10 FRONT-OFFICE QA (patch22: PR #6 + PR #8 best of both) ===== */
  /* PR #8 c6/c7 + c3: older saves missing office fields or a schedule open; payroll-reference snapshot ids for old saves. Runs before the rest of upgradeGame. */
  function p22FillSave(g){if(!g||typeof g!=='object')return g;g.mode=g.mode||'franchise';g.philosophy=g.philosophy||'balanced';g.stage=g.stage||'regular';g.day=Number(g.day)||0;
    if(g.team&&!(g.coach&&g.coach.system))g.coach={name:team(g.team).name+' Head Coach',system:'balanced'};g.owner=g.owner||{trust:72,patience:70,goal:'Make the playoffs'};
    g.record=g.record||{};var ptsMissing=g.record.pts==null;['w','l','otl','gf','ga'].forEach(function(k){if(g.record[k]==null)g.record[k]=0;});if(ptsMissing)g.record.pts=(Number(g.record.w)||0)*2+(Number(g.record.otl)||0);
    (Array.isArray(g.roster)?g.roster:[]).concat(Array.isArray(g.reserveRoster)?g.reserveRoster:[]).forEach(function(p){if(!p)return;if(p.morale==null)p.morale=70;if(p.stamina==null)p.stamina=100;if(p.injury==null)p.injury=0;if(!p.pos)p.pos='C';});
    if(g.team&&(!Array.isArray(g.schedule)||!g.schedule.length)){var n=Number(g.seasonGames)||84,opps=teams.filter(function(t){return t.id!==g.team;});g.schedule=[];for(var i=0;i<n;i++)g.schedule.push(opps[(i*7+Math.floor(i/31))%opps.length].id);}
    ['results','media','history','awards'].forEach(function(k){if(!Array.isArray(g[k]))g[k]=[];});if(g.championships==null)g.championships=0;
    if(g.payrollOn&&!g.payrollSnapshotIds&&Array.isArray(g.roster)){g.payrollSnapshotIds={};g.roster.forEach(function(p){if(p&&p.id)g.payrollSnapshotIds[p.id]=1;});}
    return g;}
  var p22OrigUpgrade=upgradeGame;upgradeGame=function(g){try{p22FillSave(g);}catch(e){console.error('patch22 save fill',e);}return p22OrigUpgrade.apply(this,arguments);};
  /* ===== END V10 FRONT-OFFICE QA (patch22) ===== */
  /* patch23: draft QA port applied */
  /* ===== LINES V2 (lines patch): real NHL positions, off-position OVR penalties, PP/PK roles, injuries + IR/LTIR + waivers, AI coach ===== */
  var LV2={VER:3,F:['LW','C','RW'],D:['LD','RD'],PP:['QB','LF','RF','BUMP','NF'],PK:['PKF','PKF','PKD','PKD'],
    PPROLE:{QB:'QB',LF:'Flank',RF:'Flank',BUMP:'Bumper',NF:'NetFront'},PPNAME:{QB:'QB / point',LF:'Left flank',RF:'Right flank',BUMP:'Bumper',NF:'Net-front'},PKNAME:['PK forward','PK forward','PK defense','PK defense'],
    PEN:{sec:0,cWing:10,wingWing:10,wingC:12,cross:20,dSide:4,goal:40},ORD:{C:0,LW:1,RW:2,D:3,G:4},
    LTIR_MIN_GAMES:10,LTIR_MIN_DAYS:24,IR_MIN_DAYS:7,LTIR_NEED:1000000,LTIR_MIN_RELIEF:1000000,LTIR_LONG:20,IR_GAMES:4,LTIR_GAMES:12,DAYS_PER_GAME:2.1,BURY_ALLOW:375000,
    COACH_CALLUPS:6,COACH_COOLDOWN:7,MAX_HURT:6,PD_RECALLS:4,BASE_RISK:.0105,G_RISK:.006};
  var LV2DATA=(typeof window!=='undefined'&&window.CTFO_POSITIONS&&window.CTFO_POSITIONS.p)?window.CTFO_POSITIONS:null;
  var LV2INJ=[['Upper-body injury','Upper body',17,1,3,1],['Lower-body injury','Lower body',15,1,3,1],['Illness','Illness',6,1,2,0],['Groin strain','Groin',8,2,10,1],['Ankle sprain','Ankle',6,3,12,1],['Back spasms','Back',4,1,6,1],['Facial laceration','Face',3,1,4,1],
    ['Concussion','Head',6,3,22,2],['Shoulder separation','Shoulder',4,8,20,2],['Broken hand','Hand',4,12,26,2],['Knee sprain (MCL)','Knee',5,10,26,2],['Broken foot','Foot',3,10,22,2],['Broken jaw','Face',1,10,20,2],['Hip injury','Hip',2,12,35,2],
    ['Torn ACL','Knee',.7,60,84,3],['Shoulder surgery','Shoulder',1,35,70,3],['Achilles injury','Lower leg',.5,40,84,3],['Severe concussion','Head',.8,30,70,3]];
  var LV2WV={S:[[18,5,160],[19,4,160],[20,3,160],[21,3,80],[22,3,70],[23,3,60],[24,2,60],[25,1,1e9]],G:[[18,6,80],[19,5,80],[20,4,80],[21,4,60],[22,4,60],[23,3,60],[24,2,60],[25,1,1e9]]};
  var lv2Hooked=0;
  /* ---------- positions ---------- */
  function lv2Norm(name){try{if(typeof normalizedRatingName==='function')return normalizedRatingName(name);}catch(e){}return String(name||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z]/g,'');}
  function lv2Lookup(p){if(!LV2DATA||!p)return null;var P=LV2DATA.p,r=P[p.id];if(r)return r;var nid=p.nhlId||p.providerId;if(nid&&LV2DATA.nhl&&LV2DATA.nhl[nid]&&P[LV2DATA.nhl[nid]])return P[LV2DATA.nhl[nid]];var k=LV2DATA.n&&LV2DATA.n[lv2Norm(p.name)];return k&&P[k]||null;}
  function lv2ApplyPos(p){if(!p||p.lv2v===LV2.VER)return p;var r=lv2Lookup(p);
    if(r){var pri=r[0]||p.pos;if(pri&&((pri==='G')===(p.pos==='G')))p.pos=pri;p.pos2=r[1]&&r[1]!==p.pos?r[1]:'';p.dSide=r[2]||'';if(r[3])p.shoots=r[3];p.sideFlex=!!r[4];p.lineSlot0=r[5]||'';p.ppRole=r[6]||'';p.ppUnit=Number(r[7])||0;p.ppRole2=r[8]||'';p.pkRole=r[9]||'';p.pkUnit=Number(r[10])||0;p.shThreat=!!r[11];p.posKnown=true;}
    else{p.pos2=p.pos2||'';p.posKnown=false;}
    if(p.pos==='D'&&!p.dSide)p.dSide=p.shoots==='R'?'RD':'LD';p.posPrimary=p.pos;p.lv2v=LV2.VER;return p;}
  function lv2IsPrimaryC(p){if(!p)return false;lv2ApplyPos(p);return p.posPrimary==='C'&&p.pos==='C';}
  function lv2All(club){return (club&&club.roster||[]).concat(club&&club.reserveRoster||[],club&&club.orgProspects||[]);}
  function lv2Migrate(g){if(!g)return;if(g.lv2Mig===LV2.VER)return;lv2All(g).forEach(lv2ApplyPos);Object.keys(g.leagueTeams||{}).forEach(function(id){lv2All(g.leagueTeams[id]).forEach(lv2ApplyPos);});g.lv2Mig=LV2.VER;}
