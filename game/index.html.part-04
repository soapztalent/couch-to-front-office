  function lv2Injure(g,id,club,p,forceGames){var r=lv2PickInjury(p),n=forceGames||(r[3]+Math.floor(Math.random()*(r[4]-r[3]+1))),date=lv2Date(g),status=lv2LtirEligible(n)?'LTIR':lv2Days(n)>=LV2.IR_MIN_DAYS?'IR':'DTD';
    if(status==='LTIR'&&!forceGames&&!lv2NeedsLtir(g,id,club,p,n))status='IR';
