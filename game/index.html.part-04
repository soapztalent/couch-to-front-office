  }
  /* ---------- injuries (field-compatible with PR #4: injury = games remaining, injuryLabel) ---------- */
  function lv2Date(g){var cg=g&&(g.calendarGames||[])[g.day];if(cg&&cg.date)return String(cg.date).slice(0,10);try{return aiCurrentDate(g);}catch(e){return (Number(g.startYear)||2026)+'-11-01';}}
  function lv2AddDays(iso,n){var t=Date.parse(iso+'T12:00:00Z');if(!Number.isFinite(t))return '';return new Date(t+n*86400000).toISOString().slice(0,10);}
  function lv2Pretty(iso){var t=Date.parse(iso+'T12:00:00Z');if(!Number.isFinite(t))return '—';return new Date(t).toLocaleDateString('en-US',{month:'short',day:'numeric',timeZone:'UTC'});}
  function lv2InjShort(p){var s=p.injStatus||(Number(p.injury)>=LV2.IR_GAMES?'IR':'DTD');return s+' · '+(Number(p.injury)||0)+' GP';}
  function lv2OnIR(p){return !!p&&Number(p.injury)>0&&(p.injStatus==='IR'||p.injStatus==='LTIR');}
  function lv2ActiveCount(club){return (club&&club.roster||[]).filter(function(p){return !lv2OnIR(p)&&!(p.lv2CallUp&&p.lv2CallUp.kind==='emergency');}).length;}
  function lv2FindSlot(club,pid){var L=club.lines||{},out='';(L.forwards||[]).forEach(function(l,i){LV2.F.forEach(function(s){if(l&&l[s]===pid)out='forwards.'+i+'.'+s;});});(L.defense||[]).forEach(function(l,i){LV2.D.forEach(function(s){if(l&&l[s]===pid)out='defense.'+i+'.'+s;});});(L.goalies||[]).forEach(function(id,i){if(id===pid)out='goalies.'+i;});return out;}
  function lv2Payroll(g,id,club){try{return id===g.team?capUsed(g):capUsedClub(g,id);}catch(e){return 0;}}
  function lv2LtirRelief(g,club){club=club||g;var list=(club.roster||[]).filter(function(p){return Number(p.injury)>0&&p.injStatus==='LTIR';});if(!list.length){club.lv2LtirSpace=null;return 0;}var remain=Math.max(0,seasonGameCount(g)-(Number(g.day)||0));
    /* CBA 50.10(d): relief = LTIR cap hits minus the cap space the club had when it placed him (2026-27 cap g.cap = $104M); usable only to replace him (raises the ceiling for call-ups/signings, never banked space) */
