  function nextOpponentForRound(g,p) { var pool=p.field.filter(function(id){return id!==g.team;}); return pool[(p.round*3+g.season)%pool.length]||'BOS'; }
  function ensureStandingsRecord(rec){rec=rec||{};['w','l','otl','pts','gf','ga'].forEach(function(k){if(!Number.isFinite(Number(rec[k])))rec[k]=0;});if(!Number.isFinite(Number(rec.rw)))rec.rw=Number(rec.w)||0;if(!Number.isFinite(Number(rec.row)))rec.row=Number(rec.rw)||0;rec.headToHead=rec.headToHead||{};return rec;}
  function standingsCoreCompare(a,b){var ar=ensureStandingsRecord(a.rec),br=ensureStandingsRecord(b.rec),agp=(ar.w||0)+(ar.l||0)+(ar.otl||0),bgp=(br.w||0)+(br.l||0)+(br.otl||0);return (Number(br.pts)||0)-(Number(ar.pts)||0)||agp-bgp||(Number(br.rw)||0)-(Number(ar.rw)||0)||(Number(br.row)||0)-(Number(ar.row)||0);}
  function standingsFinalCompare(a,b){var ar=ensureStandingsRecord(a.rec),br=ensureStandingsRecord(b.rec),adiff=(ar.gf||0)-(ar.ga||0),bdiff=(br.gf||0)-(br.ga||0);return bdiff-adiff||(Number(br.gf)||0)-(Number(ar.gf)||0)||String(a.name||a.id).localeCompare(String(b.name||b.id));}
  function standingsCompare(a,b){return standingsCoreCompare(a,b)||standingsFinalCompare(a,b);}
  function standingsHeadToHeadPct(row,tied){var rec=ensureStandingsRecord(row.rec),points=0,games=0;tied.forEach(function(other){if(other.id===row.id)return;var matchup=rec.headToHead[other.id]||{},played=Array.isArray(matchup.games)?matchup.games:null;if(played&&played.length){var home=played.filter(function(x){return x.home===true;}).length,away=played.length-home,omitVenue=played.length%2===1&&home!==away?(home>away):null,omitted=false;played.forEach(function(x){if(omitVenue!==null&&!omitted&&x.home===omitVenue){omitted=true;return;}points+=Number(x.points)||0;games++;});}else{points+=Number(matchup.pts)||0;games+=Number(matchup.gp)||0;}});return games?points/(2*games):0;}
  function standingsSort(rows){var sorted=rows.slice().sort(standingsCoreCompare);for(var start=0;start<sorted.length;){var end=start+1;while(end<sorted.length&&standingsCoreCompare(sorted[start],sorted[end])===0)end++;var tied=sorted.slice(start,end);if(tied.length>1)tied.sort(function(a,b){return standingsHeadToHeadPct(b,tied)-standingsHeadToHeadPct(a,tied)||standingsFinalCompare(a,b);});Array.prototype.splice.apply(sorted,[start,tied.length].concat(tied));start=end;}return sorted;}
  function adjustStandings(rec,forGoals,against,resultType,opponentId,isHome){rec=ensureStandingsRecord(rec);var type=resultType||'reg',gf=forGoals,ga=against;if(type==='so'){if(forGoals>against)gf--;else if(forGoals<against)ga--;}rec.gf+=gf;rec.ga+=ga;var win=forGoals>against,loss=forGoals<against,points=win?2:(type==='ot'||type==='so'?1:0);if(win){rec.w++;rec.pts+=2;if(type==='reg'){rec.rw++;rec.row++;}else if(type==='ot')rec.row++;}else if(loss){if(type==='ot'||type==='so'){rec.otl++;rec.pts++;}else rec.l++;}if(opponentId){var h=rec.headToHead[opponentId]||(rec.headToHead[opponentId]={gp:0,pts:0,games:[]});h.gp++;h.pts+=points;h.games=h.games||[];h.games.push({home:!!isHome,points:points});}}
  function refreshAiPlans(g) {
    teams.forEach(function(t){if(t.id===g.team)return;var club=leagueClub(g,t.id);if(!club)return;var reviewYear=g.startYear+g.season,previous=club.plan,roster=club.roster,avg=averageRating(roster),age=meanAge(roster),rec=g.standings[t.id],played=rec.w+rec.l+rec.otl,pace=played?rec.pts/played:0;
      if(Number(club.planReviewYear)!==reviewYear){if(primeContender(g,t.id))club.plan='contend';else if(played>=18&&pace>=1.35&&avg>=79)club.plan='contend';else if((played>=18&&pace<=.95&&age>=26)||avg<=76||age>=30)club.plan='rebuild';else if(avg>=82)club.plan='contend';else club.plan='retool';club.planReviewYear=reviewYear;club.fiveYearPlan={strategy:club.plan,horizon:5,startedYear:reviewYear,targetYear:reviewYear+4,record:{w:rec.w,l:rec.l,otl:rec.otl},rosterAverage:avg,rosterAge:age,focus:club.plan==='rebuild'?'Develop a younger core, add draft capital and avoid long veteran deals.':club.plan==='contend'?'Fill immediate lineup needs, protect prime-age core players and add playoff-ready talent.':'Keep the competitive core while targeting age-appropriate value at the weakest positions.'};}
      club.tradeBlockIds=clubTradeBlockIds(roster,club.plan);
      if(previous&&previous!==club.plan&&played>=18){g.aiLog.unshift({when:seasonLabel(g)+' · GM REVIEW',text:team(t.id).name+' shifts its five-year strategy to '+planTitle(club.plan)+' after reviewing its record, age curve, roster strength and prospect pipeline.'});g.aiLog=g.aiLog.slice(0,40);}
    });
  }
  function logLeagueTrade(g,teamA,teamB,playerA,playerB,pick,tag) {
    var sendNames=(Array.isArray(playerA)?playerA:[playerA]).map(function(p){return p.name;}).join(' and '),text=team(teamA).name+' sends '+sendNames+' to '+team(teamB).name+' for '+playerB.name+(pick?' and a '+pick.year+' round '+pick.round+' pick':'')+'.';
    var entry={when:seasonLabel(g)+' · GAME '+String(g.day).padStart(2,'0'),text:text,teams:[teamA,teamB],tag:tag||'AI TRADE'};g.transactionLog.unshift(entry);g.transactionLog=g.transactionLog.slice(0,80);g.history.push({year:seasonLabel(g),text:text,tag:tag||'AI TRADE'});return entry;
  }
  function cpuTrade(g,seller,buyer) {
    var sell=leagueClub(g,seller),buy=leagueClub(g,buyer);if(!sell||!buy||sell.roster.length<=18||buy.roster.length<=18)return false;
    var playoffProtected=playoffRace(g,seller).near?protectedTradeCore(g,seller):[],buyerNeeds=officeNeeds(g,buyer),needRank=function(p){var n=buyerNeeds.find(function(x){return x.label==='Center depth'&&p.pos==='C'||(x.label==='Defense depth'||x.label==='Right-shot defense')&&p.pos==='D'||x.label==='Top 6 scoring'&&['C','LW','RW'].indexOf(p.pos)>=0||x.label==='Goaltending'&&p.pos==='G';});var score=n?(n.level==='High'?24:n.level==='Medium'?12:0):0;if(n&&n.label==='Right-shot defense'&&shotHand(p)!=='R')score=0;return score;},stars=sell.roster.filter(function(p){var available=tradeAvailability(g,seller,p).score>=28;return p.pos!=='G'&&p.ovr>=78&&playoffProtected.indexOf(p.id)<0&&(!playerIsUntouchable(g,seller,p)||playerDisgruntled(p))&&(available||sell.plan==='rebuild'&&p.age>=28&&p.ovr>=82);}).sort(function(a,b){return tradeAvailability(g,seller,b).score+needRank(b)-tradeAvailability(g,seller,a).score-needRank(a)||gmAssetValue(g,seller,a)-gmAssetValue(g,seller,b);});
    var young=buy.roster.filter(function(p){return p.pos!=='G'&&p.age<=25&&p.ovr<=86;}).sort(function(a,b){return basePlayerValue(a)-basePlayerValue(b);});
    var pick=buy.picks.filter(function(p){return p.round<=3&&p.year>=g.startYear+g.season;}).sort(function(a,b){return primeContender(g,buyer)?gmAssetValue(g,buyer,b)-gmAssetValue(g,buyer,a):gmAssetValue(g,buyer,a)-gmAssetValue(g,buyer,b);})[0];if(!stars.length||!young.length||!pick)return false;
    var star=stars[0],sellerPackage=tradeBundlePackage(g,seller,star),sellerGain=gmAssetValue(g,seller,young[0])+gmAssetValue(g,seller,pick),sellerCost=sellerPackage.reduce(function(n,p){return n+gmAssetValue(g,seller,p);},0),buyerGain=sellerPackage.reduce(function(n,p){return n+gmAssetValue(g,buyer,p);},0),buyerCost=gmAssetValue(g,buyer,young[0])+gmAssetValue(g,buyer,pick);
    if(sell.roster.length-sellerPackage.length+1<18||buy.roster.length-1+sellerPackage.length>23)return false;
    if(sellerGain<sellerCost*.92||buyerGain<buyerCost*(primeContender(g,buyer)?.74:.91))return false;
    var packageHit=sellerPackage.reduce(function(n,p){return n+contractHit(p);},0),buyerNew=capUsedClub(g,buyer)-contractHit(young[0])+packageHit,sellerNew=capUsedClub(g,seller)-packageHit+contractHit(young[0]);if(buyerNew>g.cap||sellerNew>g.cap-1500000)return false;if(buyer!==g.team&&buyerNew<capFloorFor(g)&&buyerNew<capUsedClub(g,buyer))return false;if(seller!==g.team&&sellerNew<capFloorFor(g)&&sellerNew<capUsedClub(g,seller))return false;
    sell.roster=sell.roster.filter(function(p){return !sellerPackage.some(function(x){return x.id===p.id;});});buy.roster=buy.roster.filter(function(p){return p.id!==young[0].id;});sellerPackage.forEach(function(player){player.club=buyer;buy.roster.push(player);});young[0].club=seller;sell.roster.push(young[0]);buy.picks=buy.picks.filter(function(p){return pickKey(p)!==pickKey(pick);});pick.team=seller;sell.picks.push(pick);sell.moves++;buy.moves++;
    var entry=logLeagueTrade(g,seller,buyer,sellerPackage,young[0],pick,'AI FRONT-OFFICE TRADE');g.aiLog.unshift({when:entry.when,text:team(seller).id+' ('+planTitle(sell.plan)+') moves '+sellerPackage.map(function(p){return p.name;}).join(' and ')+' for younger talent and a pick; '+team(buyer).id+' adds impact help.'});g.aiLog=g.aiLog.slice(0,40);return true;
  }
  function runAIGMs(g,date) {
    // Weekly AI GM evaluation (see AI TRADE MARKET v5). The legacy cpuTrade() is kept but no longer called.
    refreshAiPlans(g);return aiRunGmEvaluation(g,'weekly',date||aiCurrentDate(g));
  }
  function maybeCpuTradeCall(g){
    if(!g||g.mode!=='franchise'||!current.game||current.game!==g||g.day<10||g.day>75||g.cpuTradeCallSeason===g.season)return;
    var available=g.roster.filter(function(p){return (p.onTradeBlock||p.tradeRequest)&&(!madePlayoffsLastSeason(g,g.team)||playerLeverageScore(g,g.team,p)>=20)&&(!playerIsUntouchable(g,g.team,p)||playerDisgruntled(p));});if(!available.length||Math.random()>.12)return;
    var rank={High:3,Medium:2,Low:1},candidates=teams.filter(function(t){return t.id!==g.team;}).map(function(t){var club=leagueClub(g,t.id);if(!club||club.roster.length<=18||club.roster.length>=23)return null;var needs=officeNeeds(g,t.id),fit=available.reduce(function(best,p){var label=p.pos==='C'?'Center depth':p.pos==='D'?'Defense depth':p.pos==='G'?'Goaltending':'Top 6 scoring',need=needs.find(function(n){return n.label===label;});return Math.max(best,need?(rank[need.level]||1)*10:0);},0),surplus=club.roster.filter(function(p){return p.age>30||tradePremium(p)<3||isOnTradeBlock(g,t.id,p);}).length;return {id:t.id,score:fit+Math.min(12,surplus*2)+(club.plan==='contend'?2:0)};}).filter(Boolean).sort(function(a,b){return b.score-a.score;});
    if(!candidates.length||candidates[0].score<10)return;
    var partner=candidates[0].id;g.cpuTradeCallSeason=g.season;current.page='trades';officeUI.navGroup='trade';current.tradeDraft={team:g.team,target:partner,userPlayers:[],marketPlayers:[],userPicks:[],marketPicks:[],retainUser:0,retainMarket:0,intent:'balance'};g.aiLog=g.aiLog||[];g.aiLog.unshift({when:seasonLabel(g)+' · GAME '+String(g.day).padStart(2,'0'),text:team(partner).name+' contacts '+team(g.team).name+' after noticing a player placed on the trade block.'});g.aiLog=g.aiLog.slice(0,40);startTradeCall();
  }
  function ensureSeasonTeamStats(g,id){g.seasonTeamStats=g.seasonTeamStats||{};var s=g.seasonTeamStats[id]||(g.seasonTeamStats[id]={gp:0,shots:0,shotsAgainst:0,goalsFor:0,goalsAgainst:0,xGF:0,xGA:0,ppGoals:0,ppOpportunities:0,pkGoalsAgainst:0,pkOpportunities:0,faceoffWins:0,faceoffs:0,hits:0,blocks:0,saves:0});['gp','shots','shotsAgainst','goalsFor','goalsAgainst','xGF','xGA','ppGoals','ppOpportunities','pkGoalsAgainst','pkOpportunities','faceoffWins','faceoffs','hits','blocks','saves'].forEach(function(k){if(!Number.isFinite(Number(s[k])))s[k]=0;});return s;}
  function bumpPlayerStat(p,key,n){if(!p)return;p[key]=(Number(p[key])||0)+(Number(n)||0);}
  function resetPlayerSeasonStats(p){p.games=0;p.goals=0;p.assists=0;p.points=0;p.shots=0;p.goalieWins=0;p.goalieShotsAgainst=0;p.goalieGoalsAgainst=0;p.goalieSaves=0;p.toiSeconds=0;p.plusMinus=0;p.hits=0;p.blocks=0;p.faceoffWins=0;p.faceoffs=0;p.powerPlayGoals=0;p.powerPlayAssists=0;p.penaltyMinutes=0;p.shortHandedGoals=0;p.ppToiSeconds=0;p.shToiSeconds=0;p.goalieStarts=0;p.goalieLosses=0;p.goalieOtLosses=0;p.goalieShutouts=0;p.simConsecutiveStarts=0;}
  function sampleCount(mean,spread){return Math.max(0,Math.round(mean+(Math.random()*2-1)*spread));}
