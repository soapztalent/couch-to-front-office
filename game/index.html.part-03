    var league=teams.filter(function(t){return t.id!==g.team&&t.id!==excludedOpponent;}),pool=league.slice();for(var i=pool.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),tmp=pool[i];pool[i]=pool[j];pool[j]=tmp;}
