  /* ---------- window driver ---------- */
  function aiProbTable(kind){return kind==='deadline'?AI_TRADE.P_DEADLINE:kind==='draft'?AI_TRADE.P_DRAFT:kind==='july1'?AI_TRADE.P_JULY1:kind==='offseason'?AI_TRADE.P_OFF_WEEKLY:AI_TRADE.P_WEEKLY;}
  function aiWindowMax(g,kind){if(kind==='deadline')return AI_TRADE.DEADLINE_MAX;if(kind==='draft')return AI_TRADE.DRAFT_MAX;if(kind==='july1')return AI_TRADE.JULY1_MAX;if(kind==='offseason')return AI_TRADE.OFFSEASON_WEEKLY_MAX;return AI_TRADE.WEEKLY_MAX;}
  function aiTradeWindow(g,kind,date,maxOverride){var deals=[];if(!g.leagueTeams)return deals;aiStatusNow={kind:kind,date:date};aiStatusCache={};var probs=aiProbTable(kind),max=maxOverride!=null?maxOverride:aiWindowMax(g,kind),ramp=1;if(max<=0)return deals;
    if(kind==='weekly'){if(g.stage!=='regular'||date>=tradeDeadlineISO(g)||(Number(g.day)||0)<AI_TRADE.WEEKLY_FIRST_DAY/2)return deals;var start=(g.calendarGames&&g.calendarGames[0]&&g.calendarGames[0].date)||date;if(aiIsoDays(start,date)<AI_TRADE.WEEKLY_FIRST_DAY)return deals;ramp=.5+1.0*clamp((Number(g.day)||0)/Math.max(1,aiDeadlineDay(g)),0,1);}
