  function openSaveDb(){
    if(saveDbPromise)return saveDbPromise;
    saveDbPromise=new Promise(function(resolve,reject){try{if(!window.indexedDB)return reject(new Error('IndexedDB is not available'));var req=indexedDB.open(SAVE_DB_NAME,1);req.onupgradeneeded=function(){if(!req.result.objectStoreNames.contains(SAVE_DB_STORE))req.result.createObjectStore(SAVE_DB_STORE);};req.onsuccess=function(){var db=req.result;db.onversionchange=function(){db.close();saveDbPromise=null;};resolve(db);};req.onerror=function(){reject(req.error||new Error('IndexedDB could not be opened'));};req.onblocked=function(){reject(new Error('IndexedDB is blocked by another tab'));};}catch(e){reject(e);}});
    saveDbPromise.catch(function(){saveDbPromise=null;});return saveDbPromise;
  }
  function saveDbRequest(mode,fn){return openSaveDb().then(function(db){return new Promise(function(resolve,reject){var tx=db.transaction(SAVE_DB_STORE,mode),req=fn(tx.objectStore(SAVE_DB_STORE)),result;req.onsuccess=function(){result=req.result;};tx.oncomplete=function(){resolve(result);};tx.onerror=function(){reject(tx.error||req.error||new Error('IndexedDB request failed'));};tx.onabort=function(){reject(tx.error||new Error('IndexedDB write was aborted (storage may be full)'));};});});}
  function writeSaveMeta(summary,where,bytes){try{localStorage.setItem(SAVE_META_KEY,JSON.stringify(Object.assign({},summary,{where:where,bytes:bytes})));}catch(e){}}
  function writeLocalSave(json,savedAt,summary,gz){
    var payload;
    if(gz){var b64=saveToBase64(gz);payload='{"cfoSave":2,"savedAt":'+savedAt+',"encoding":"gzip-base64","data":"'+b64+'"}';}
    else payload='{"cfoSave":2,"savedAt":'+savedAt+',"encoding":"json","game":'+json+'}';
    localStorage.setItem(STORAGE_KEY,payload);
    if(localStorage.getItem(STORAGE_KEY).length!==payload.length)throw new Error('localStorage did not keep the full save');
