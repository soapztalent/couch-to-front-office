  function moveDraftPickAsset(g,key,from,to){if(!key)return false;var asset=findDraftAsset(g,from,key);if(!asset)return false;var fromList=clubPicks(g,from),at=fromList.indexOf(asset);if(at<0)return false;fromList.splice(at,1);asset.team=to;var dest=to===g.team?(g.userPicks||(g.userPicks=[])):((leagueClub(g,to)||{}).picks||[]);dest.push(asset);var state=g.offseason&&g.offseason.liveDraft;if(state&&state.order)state.order.forEach(function(r){if(r.pickKey===key)r.owner=to;});return true;}
  function acceptDraftTrade(g){var state=g.offseason&&g.offseason.liveDraft,offer=state&&state.pendingTradeOffer,row=state&&state.order[state.cursor];if(!offer||!row||row.owner!==g.team)return setNotice('There is no live draft trade offer.',true);if(!moveDraftPickAsset(g,offer.currentKey,g.team,offer.buyer)||!moveDraftPickAsset(g,offer.laterKey,offer.buyer,g.team)||offer.extraKey&&!moveDraftPickAsset(g,offer.extraKey,offer.buyer,g.team))return setNotice('The draft assets changed before the trade could be completed.',true);g.offseason.draftLog.push({overall:row.overall,teamName:team(offer.buyer).name,playerName:'TRADE UP · '+team(g.team).name+' receives '+(offer.extraKey?'two picks':'one pick'),pos:'PICK TRADE'});state.pendingTradeOffer=null;state.cursor++;advanceDraftOnePick(g);persist();renderOffice();setNotice('Draft trade accepted. '+team(offer.buyer).name+' moves up; your club adds future draft capital.');}
  function advanceDraftOnePick(g){var state=g.offseason.liveDraft||initializeDraftOrder(g),row=state.order[state.cursor];state.onClockKey=null;if(!row){g.drafted=true;g.offseason.phase='free-agency';current.offseasonSection='freeagency';return null;}if(row.owner===g.team){var userPick=(g.userPicks||[]).find(function(p){return row.pickKey&&pickKey(p)===row.pickKey;});if(!userPick){userPick={id:'sim-'+row.origin+'-'+state.year+'-'+row.round,origin:row.origin,team:g.team,year:state.year,round:row.round};g.userPicks.push(userPick);row.pickKey=pickKey(userPick);}state.onClockKey=row.pickKey;draftTradeOfferForUser(g,state,row);return row;}var club=leagueClub(g,row.owner),pool=g.prospects||[],choice=pool.slice().sort(function(a,b){var av=(Number(a.projection)||Number(a.potential)||60)+Math.floor(seededRandom('draft-night|'+state.year+'|'+row.overall+'|'+row.owner+'|'+a.id)()*13)-6,bv=(Number(b.projection)||Number(b.potential)||60)+Math.floor(seededRandom('draft-night|'+state.year+'|'+row.overall+'|'+row.owner+'|'+b.id)()*13)-6;return bv-av;})[0];if(choice&&club){choice.club=row.owner;choice.salary=925000;choice.years=3;choice.drafted=true;choice.draftYear=state.year;choice.draftRound=row.round;choice.draftOverall=row.overall;choice.pickTeam=row.origin;choice.etaYear=estimateNhlEta(choice,state.year);choice.level=prospectStage(choice,state.year);applyAIDraftPlayerChoice(g,choice,row.owner,state.year);club.orgProspects=club.orgProspects||[];club.orgProspects.push(choice);g.prospects=g.prospects.filter(function(x){return x.id!==choice.id;});g.offseason.draftLog=g.offseason.draftLog||[];g.offseason.draftLog.push({overall:row.overall,round:row.round,teamName:team(row.owner).name,playerName:choice.name,pos:choice.pos});}if(row.pickKey&&club){club.picks=(club.picks||[]).filter(function(p){return pickKey(p)!==row.pickKey;});}state.pendingTradeOffer=null;state.cursor++;return state.order[state.cursor]||null;}
