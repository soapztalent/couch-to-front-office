var REAL_PICK_ORD={1:'1st',2:'2nd',3:'3rd',4:'4th',5:'5th',6:'6th',7:'7th'};
function realPickMap(){if(realPickMap.m)return realPickMap.m;var m={};REAL_PICKS.picks.forEach(function(r){m[r.id]=r;});realPickMap.m=m;return m;}
function realPickRawKey(p){return (p.origin||p.team)+'-'+Number(p.year)+'-'+Number(p.round);}
function realPickApply(p,r){p.id=r.id;p.origin=r.origin;p.team=r.team;p.year=r.year;p.round=r.round;p.conditions=cloneData(r.conditions||[]);p.condition=r.condition||'';p.trade=r.trade||'';p.source=REAL_PICKS.source;p.verified=true;p.realPicks=REAL_PICKS.version;return p;}
function realPicksApplyToRows(rows){var m=realPickMap();(rows||[]).forEach(function(p){if(!p)return;var r=m[realPickRawKey(p)],isDefault=!p.verified||p.source==='Simulation default pick ownership';if(r&&isDefault)realPickApply(p,r);else if(!r&&isDefault&&Number(p.year)>=REAL_PICKS.years[0]&&Number(p.year)<=REAL_PICKS.years[REAL_PICKS.years.length-1]){p.source=REAL_PICKS.source;p.verified=true;p.realPicks=REAL_PICKS.version;p.conditions=p.conditions||[];}});return rows;}
function realPickOwners(g){return [g.team].concat(teams.map(function(t){return t.id;}).filter(function(id){return id!==g.team;}));}
function realPickList(g,id){if(id===g.team){g.userPicks=Array.isArray(g.userPicks)?g.userPicks:[];return g.userPicks;}var c=leagueClub(g,id);if(!c)return [];c.picks=Array.isArray(c.picks)?c.picks:[];return c.picks;}
function realPickFind(g,key){var owners=realPickOwners(g);for(var i=0;i<owners.length;i++){var list=realPickList(g,owners[i]);for(var j=0;j<list.length;j++){var p=list[j];if(p&&(pickKey(p)===key||realPickRawKey(p)===key))return {owner:owners[i],list:list,p:p};}}return null;}
function realPickMove(g,hit,to){if(!hit||hit.owner===to)return hit;var i=hit.list.indexOf(hit.p);if(i>=0)hit.list.splice(i,1);hit.p.team=to;var dest=realPickList(g,to);dest.push(hit.p);hit.owner=to;hit.list=dest;try{aiSyncDraftOrderPick(g,hit.p,to);}catch(e){}return hit;}
function realPickName(key){var a=String(key).split('-');return a[1]+' '+(REAL_PICK_ORD[Number(a[2])]||a[2]+'th')+' ('+a[0]+')';}
function realPickShort(p,c){if(!c)return '';if(c.kind==='protected')return 'top-'+c.top+' protected, else '+(c.compensation||[]).map(function(x){return realPickName(x.key);}).join(' + ')+(c.resolved?' ['+c.resolved+']':'');if(c.kind==='better_of')return 'better of '+c.candidates.join('/')+(c.resolved?' ['+c.resolved+']':'');if(c.kind==='worse_of')return 'worse of '+c.candidates.join('/')+(c.resolved?' ['+c.resolved+']':'');if(c.kind==='upgrade')return 'becomes '+(REAL_PICK_ORD[c.toRound]||c.toRound)+' if '+c.trigger.team+' reaches a '+c.trigger.years.join('/')+' conference final'+(c.resolved?' ['+c.resolved+']':'');if(c.kind==='option')return c.chooser+' option if top-'+c.top;if(c.kind==='owed')return 'owed if '+realPickName(c.sourceKey)+' is protected';return c.text||'conditional';}
function realPickTag(p){var cs=(p&&p.conditions||[]).filter(function(c){return c.kind!=='owed'||!c.resolved;});return cs.length?' · '+cs.map(function(c){return realPickShort(p,c);}).join('; '):'';}
function realPickShortTag(p){var t=realPickTag(p);return t?t.slice(3).toUpperCase():(p&&p.verified?'VERIFIED NHL OWNERSHIP':'SIMULATED INVENTORY');}
function realPickConditionText(p){var cs=p&&p.conditions||[];if(cs.length)return cs.map(function(c){return c.text||realPickShort(p,c);}).join(' · ');return p&&p.condition?p.condition:(p&&p.verified?'No conditions · verified NHL ownership':'No condition recorded');}
function realPickLabel(p){return p.year+' '+(REAL_PICK_ORD[Number(p.round)]||p.round+'th')+' ('+(p.origin||p.team)+')'+(realPickTag(p)?' - '+realPickTag(p).slice(3):'');}
function realPickLog(g,text){g.pickConditionLog=g.pickConditionLog||[];g.pickConditionLog.push({season:typeof seasonLabel==='function'?seasonLabel(g):'',text:text});g.history=g.history||[];g.history.push({year:typeof seasonLabel==='function'?seasonLabel(g):'',text:text,tag:'PICK CONDITION'});}
function realPicksMigrate(g){if(!g||g.realPicksVersion===REAL_PICKS.version)return;var m=realPickMap(),draftYear=Number(g.offseason&&g.offseason.year)||Number(g.startYear||2026)+Number(g.season||1),live=g.offseason&&g.offseason.liveDraft,rep={moved:0,tagged:0,keptSaveOwner:0,skippedDrafted:0};
  Object.keys(m).forEach(function(key){var r=m[key];if(r.year<draftYear||(r.year===draftYear&&(g.drafted||(live&&Number(live.year)===r.year)))){rep.skippedDrafted++;return;}var hit=realPickFind(g,key);if(!hit||hit.p.realPicks===REAL_PICKS.version)return;
    if(hit.owner===r.origin){if(r.team!==hit.owner){realPickMove(g,hit,r.team);rep.moved++;}else rep.tagged++;realPickApply(hit.p,r);}
    else{hit.p.conditions=cloneData((r.conditions||[]).filter(function(c){return c.kind!=='owed';}));hit.p.condition=r.condition||'';hit.p.realPicks=REAL_PICKS.version;hit.p.realPicksNote='Kept this save\u2019s owner ('+hit.owner+'); real-world owner is '+r.team;rep.keptSaveOwner++;}});
  realPickOwners(g).forEach(function(id){realPickList(g,id).forEach(function(p){if(p&&!p.realPicks&&Number(p.year)>=Math.max(draftYear,REAL_PICKS.years[0])&&Number(p.year)<=REAL_PICKS.years[REAL_PICKS.years.length-1]&&!(realPickRawKey(p) in m)){p.verified=true;p.realPicks=REAL_PICKS.version;}});});
  g.realPicksVersion=REAL_PICKS.version;g.realPicksMigration=rep;}
function realPickConvey(g,key,to,fromKey,depth){depth=depth||0;if(depth>4)return;var h=realPickFind(g,key);if(!h){g.pickObligations=g.pickObligations||[];if(!g.pickObligations.some(function(o){return o.key===key&&o.to===to;}))g.pickObligations.push({key:key,to:to,from:fromKey});realPickLog(g,realPickName(key)+' will go to '+to+' when that draft year opens (from protected '+realPickName(fromKey)+').');return;}
  if(h.owner!==to&&h.owner!==(h.p.origin||h.p.team)){(h.p.conditions||[]).forEach(function(oc){if(oc.kind==='protected'&&!oc.resolved){oc.resolved='preempted';var holder=h.owner;realPickLog(g,realPickName(key)+' was already owed to '+to+'; '+holder+' receives its fallback instead.');(oc.compensation||[]).forEach(function(cp){realPickConvey(g,cp.key,holder,key,depth+1);});}});}
  realPickMove(g,h,to);h.p.conditions=(h.p.conditions||[]).filter(function(oc){return oc.kind!=='owed'&&oc.kind!=='protected';});h.p.condition='Conveyed as compensation for protected '+realPickName(fromKey);}
function realPicksApplyObligations(g){(g.pickObligations||[]).forEach(function(o){if(o.done)return;var h=realPickFind(g,o.key);if(h){realPickMove(g,h,o.to);h.p.condition='Conveyed from protected '+realPickName(o.from);o.done=true;}});}
function realPickRecordTriggers(g,year){var pl=g.playoff||{},rr=pl.roundResults&&pl.roundResults[2]||[];g.pickTriggers=g.pickTriggers||{confFinal:{}};g.pickTriggers.confFinal=g.pickTriggers.confFinal||{};if(g.pickTriggers.confFinal[year])return;var teamsIn=[];rr.forEach(function(s){if(s&&s.a)teamsIn.push(s.a);if(s&&s.b)teamsIn.push(s.b);});if(teamsIn.length)g.pickTriggers.confFinal[year]=teamsIn;}
function realPickRosterHas(g,id,name){var c=id===g.team?g:leagueClub(g,id);return !!(c&&(c.roster||[]).some(function(p){return p&&p.name===name;}));}
function realPickAskUser(g,id,question,dflt){g.pickOptionDecisions=g.pickOptionDecisions||{};if(id in g.pickOptionDecisions)return g.pickOptionDecisions[id];var ans=dflt;try{if(typeof window!=='undefined'&&typeof window.confirm==='function')ans=!!window.confirm(question);}catch(e){ans=dflt;}g.pickOptionDecisions[id]=ans;return ans;}
function resolvePickConditions(g,year){if(!g)return;year=Number(year);g.pickConditionsResolved=g.pickConditionsResolved||{};realPickRecordTriggers(g,year);if(g.pickConditionsResolved[year])return;var rows=[];realPickOwners(g).forEach(function(id){realPickList(g,id).forEach(function(p){if(p&&Number(p.year)===year&&(p.conditions||[]).length)rows.push({owner:id,p:p});});});
  rows.forEach(function(x){(x.p.conditions||[]).forEach(function(c){if(c.resolved||c.kind!=='protected')return;var key=pickKey(x.p),slot=draftSlotForTeam(g,x.p.origin),v=c.voidIf&&c.voidIf.pickNotOwnedBy,voided=false;if(v){var vh=realPickFind(g,v.key);voided=!!(vh&&vh.owner!==v.team);}
    var userOpt=slot<=c.top&&!voided&&c.chooser&&c.chooser===g.team&&c.keeper===g.team;
    if(userOpt){var hh=realPickFind(g,key),hold=hh?hh.owner:x.owner,comp=(c.compensation||[]).map(function(cp){return realPickName(cp.key);}).join(' + ');
      if(!realPickAskUser(g,key+'|protect',realPickName(key)+' landed #'+slot+' in the '+year+' draft order. It is top-'+c.top+' protected at your option.\n\nOK = keep the #'+slot+' pick and send '+comp+' to '+hold+'.\nCancel = let '+hold+' have the #'+slot+' pick (you keep '+comp+').',true)){
        c.resolved='option declined by '+c.chooser+' (#'+slot+')';(c.compensation||[]).forEach(function(cp){var h=realPickFind(g,cp.key);if(h)h.p.conditions=(h.p.conditions||[]).filter(function(oc){return !(oc.kind==='owed'&&oc.sourceKey===key);});});realPickLog(g,realPickName(key)+' landed #'+slot+': '+c.chooser+' chose not to use the top-'+c.top+' protection, so '+hold+' keeps it and '+c.chooser+' keeps '+comp+'.');return;}}
    if(slot<=c.top&&!voided){var hit=realPickFind(g,key),holder=hit?hit.owner:x.owner;c.resolved='protected (#'+slot+')';realPickMove(g,hit,c.keeper||x.p.origin);realPickLog(g,realPickName(key)+' landed #'+slot+' (top-'+c.top+' protected): it stays with '+(c.keeper||x.p.origin)+' and '+holder+' receives '+(c.compensation||[]).map(function(cp){return realPickName(cp.key);}).join(' + ')+'.');(c.compensation||[]).forEach(function(cp){realPickConvey(g,cp.key,holder,key);});}
    else{c.resolved='conveyed (#'+slot+')';(c.compensation||[]).forEach(function(cp){var h=realPickFind(g,cp.key);if(h)h.p.conditions=(h.p.conditions||[]).filter(function(oc){return !(oc.kind==='owed'&&oc.sourceKey===key);});});realPickLog(g,realPickName(key)+' landed #'+slot+': protection not triggered, '+x.owner+' keeps it.');}});});
  rows.forEach(function(x){(x.p.conditions||[]).forEach(function(c){if(c.resolved||c.kind!=='option')return;var key=pickKey(x.p),slot=draftSlotForTeam(g,x.p.origin),mate=c.swapWith?realPickFind(g,c.swapWith):null,mc=mate&&(mate.p.conditions||[]).filter(function(oc){return oc.kind==='option';})[0];
    if(mc&&mc.swapped){c.resolved='swapped by '+c.chooser+' choice';return;}
    if(c.chooser===g.team&&mate&&slot<=c.top&&Number(mate.p.year)>year){var me=realPickFind(g,key),a=me?me.owner:x.owner,b=mate.owner;
      if(a!==b&&realPickAskUser(g,key+'|option',realPickName(key)+' landed #'+slot+' in the '+year+' draft order (top-'+c.top+'), so you choose where it goes.\n\nOK = send this #'+slot+' pick to '+b+' and '+realPickName(c.swapWith)+' to '+a+'.\nCancel = keep the default: '+a+' gets this pick, '+b+' gets '+realPickName(c.swapWith)+'.',false)){
        realPickMove(g,me,b);realPickMove(g,mate,a);c.swapped=true;mc&&(mc.resolved='swapped by '+c.chooser+' choice');c.resolved='swapped by '+c.chooser+' choice (#'+slot+')';realPickLog(g,c.chooser+' sent '+realPickName(key)+' (#'+slot+') to '+b+'; '+a+' receives '+realPickName(c.swapWith)+'.');return;}}
    c.resolved='kept by '+c.chooser+' choice';});});
  var groups={};rows.forEach(function(x){(x.p.conditions||[]).forEach(function(c){if((c.kind==='better_of'||c.kind==='worse_of')&&!c.resolved){(groups[c.group]=groups[c.group]||{})[c.kind]=x;}});});
  Object.keys(groups).forEach(function(gk){var gr=groups[gk],b=gr.better_of,w=gr.worse_of;if(!b||!w)return;var sb=draftSlotForTeam(g,b.p.origin),sw=draftSlotForTeam(g,w.p.origin);if(sw<sb){var o=b.p.origin,id=b.p.id;b.p.origin=w.p.origin;b.p.id=w.p.id;w.p.origin=o;w.p.id=id;}[b,w].forEach(function(x){(x.p.conditions||[]).forEach(function(c){if(c.group===gk)c.resolved='resolved: '+x.p.origin+' pick';});});realPickLog(g,'Better-of '+gk+': '+b.owner+' receives the '+b.p.origin+' pick (#'+Math.min(sb,sw)+'), '+w.owner+' receives the '+w.p.origin+' pick.');});
  rows.forEach(function(x){(x.p.conditions||[]).forEach(function(c){if(c.resolved||c.kind!=='upgrade')return;var t=c.trigger||{},cf=(g.pickTriggers&&g.pickTriggers.confFinal)||{},hitYear=(t.years||[]).filter(function(y){return (cf[y]||[]).indexOf(t.team)>=0;})[0];if(hitYear&&(!t.player||realPickRosterHas(g,t.team,t.player))){var up=realPickFind(g,c.swapKey),me=realPickFind(g,pickKey(x.p));if(up&&me){var holder=me.owner,giver=up.owner;realPickMove(g,up,holder);realPickMove(g,me,giver);c.resolved='upgraded ('+hitYear+')';realPickLog(g,realPickName(pickKey(x.p))+' upgraded: '+holder+' receives '+realPickName(c.swapKey)+'.');}}else if(year>=Math.max.apply(null,t.years||[year])){c.resolved='not upgraded';}});});
  g.pickConditionsResolved[year]=true;}
function realPicksAudit(g){var seen={},dup=[],count=0;realPickOwners(g).forEach(function(id){realPickList(g,id).forEach(function(p){var k=realPickRawKey(p);count++;if(seen[k])dup.push(k+' ('+seen[k]+' & '+id+')');seen[k]=id;});});return {count:count,duplicates:dup};}
(function(){var D=typeof window!=='undefined'&&window.CTFODraft;if(!D||typeof D.initializeDraftOrder!=='function'||D.__realPicks)return;var o=D.initializeDraftOrder;D.initializeDraftOrder=function(g){try{if(g&&g.offseason){var ord=typeof D.ensureOrder==='function'?D.ensureOrder(g):null,y=ord&&ord.year||Number(g.offseason.year)||Number(g.startYear)+Number(g.season);resolvePickConditions(g,Number(y));}}catch(rpE){console.error('pick conditions',rpE);}return o.apply(this,arguments);};D.__realPicks=true;})();
var __rpUpgradeGame=upgradeGame;upgradeGame=function(g){var r=__rpUpgradeGame.apply(this,arguments);try{realPicksMigrate(r||g);}catch(rpE){console.error('real picks migrate',rpE);}return r;};
/* REAL-PICKS-2026:END */

  function clubNeeds(g,id) { var roster=clubRoster(g,id),c=positionCounts(roster),need=[];if(c.F<12)need.push('Forwards');if(c.D<6)need.push('Defense');if(c.G<2)need.push('Goaltending');if(roster.length<20)need.push('Roster depth');if(capUsedClub(g,id)>g.cap-4500000)need.push('Cap relief');if(!need.length)need.push('Best available');return need; }
  function planTitle(plan) { return plan==='contend'?'All-in contender':plan==='rebuild'?'Future-first rebuild':'Competitive retool'; }
  function planSummary(plan) { return plan==='contend'?'Values impact talent and this season':plan==='rebuild'?'Prioritizes youth, picks and flexibility':'Balances core talent with future value'; }
  function clubTradeBlockIds(roster,plan){var top=(roster||[]).slice().sort(function(a,b){return b.ovr-a.ovr;}).slice(0,8).map(function(p){return p.id;});return (roster||[]).filter(function(p){return top.indexOf(p.id)<0&&(plan==='rebuild'&&p.age>=28&&p.potential<89||plan==='retool'&&p.age>=31&&p.ovr<=averageRating(roster)-3);}).map(function(p){return p.id;});}
  function isOnTradeBlock(g,id,p){var c=leagueClub(g,id);return !!(p.tradeRequest||p.onTradeBlock||c&&p.club===id&&(c.tradeBlockIds||[]).indexOf(p.id)>=0);}
  function tradePremium(p){var tier=playerPotentialRole(p),top=p.age<=32;if(tier==='Franchise')return top?5:4;if(tier==='Top Line'||tier==='Top 2')return top?4:3;if(tier==='Top 6'||tier==='Top 4')return top?3:2;return 1.5;}
  function gmFitBonus(g,id,players,picks){var needs=officeNeeds(g,id),level=function(label){var n=needs.find(function(x){return x.label===label;});return n?n.level:'Low';},bonus=0;players.forEach(function(p){if(p.pos!=='D'&&p.pos!=='G'&&level('Top 6 scoring')!=='Low')bonus+=level('Top 6 scoring')==='High'?16:8;if(p.pos==='C'&&level('Center depth')!=='Low')bonus+=level('Center depth')==='High'?16:8;if(p.pos==='D'&&level('Defense depth')!=='Low')bonus+=level('Defense depth')==='High'?16:8;if(p.pos==='D'&&shotHand(p)==='R'&&level('Right-shot defense')!=='Low')bonus+=level('Right-shot defense')==='High'?18:10;if(p.age<=23&&officePlan(g,id)==='rebuild')bonus+=8;});if(officePlan(g,id)==='rebuild')bonus+=picks.filter(function(p){return p.round<=3;}).length*8;return bonus;}
  
  
  
  function tradeAssetSummary(g,id,players,picks) { var names=players.map(function(p){return esc(p.name);}).concat(picks.map(function(p){return p.year+' RD'+p.round;}));if(!names.length)names=['—'];return {names:names.join(' + '),value:players.reduce(function(n,p){return n+gmAssetValue(g,id,p);},0)+picks.reduce(function(n,p){return n+gmAssetValue(g,id,p);},0),cap:players.reduce(function(n,p){return n+contractHit(p);},0)}; }
  function tradeAcceptanceRead(g,d){var club=leagueClub(g,d.target);if(!club)return {score:0,gain:0,cost:0,threshold:1,plan:'retool'};var incoming=d.userPlayers.map(function(id){return clubRoster(g,g.team).find(function(p){return p.id===id;});}).filter(Boolean),outgoing=d.marketPlayers.map(function(id){return club.roster.find(function(p){return p.id===id;});}).filter(Boolean),incomingPicks=d.userPicks.map(function(k){return clubPicks(g,g.team).find(function(p){return pickKey(p)===k;});}).filter(Boolean),outgoingPicks=d.marketPicks.map(function(k){return clubPicks(g,d.target).find(function(p){return pickKey(p)===k;});}).filter(Boolean),gain=incoming.reduce(function(n,p){return n+gmAssetValue(g,d.target,p);},0)+incomingPicks.reduce(function(n,p){return n+gmAssetValue(g,d.target,p);},0)+gmFitBonus(g,d.target,incoming,incomingPicks),cost=outgoing.reduce(function(n,p){return n+gmAssetValue(g,d.target,p);},0)+outgoingPicks.reduce(function(n,p){return n+gmAssetValue(g,d.target,p);},0),threshold=cost*.99+8+Math.max(0,100-(Number(club.gmPatience)||70))*.18;return {score:clamp(Math.round(gain/Math.max(1,threshold)*100),0,100),gain:Math.round(gain),cost:Math.round(cost),threshold:Math.round(threshold),plan:club.plan||'retool',hasAssets:incoming.length+outgoing.length+incomingPicks.length+outgoingPicks.length>0};}
