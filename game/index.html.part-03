  }
  function simV2Lineup(g,id,club,day){
    if(!club)return null;if(!club.lines)ensureLineup(club);
    if(!club.simV2PkDefaults){var st0=club.specialTeams||{},autoPk=(club.roster||[]).filter(function(p){return p.pos!=='G';}).sort(function(x,y){return y.ovr-x.ovr;}).slice(0,4).map(function(p){return p.id;}).sort().join(','),curPk=(st0.pk54||[]).slice().sort().join(',');if(club!==g||curPk===autoPk){if(club.specialTeams){club.specialTeams.pk54=[];club.specialTeams.pk53=[];}ensureSpecialTeams(club);}club.simV2PkDefaults=true;}
    var roster=club.roster||[],byId={};roster.forEach(function(p){byId[p.id]=p;});
    var used={},lines=[],pairs=[];
    function take(pid,ok){var p=byId[pid];if(!p||used[p.id]||!simV2Healthy(p)||!ok(p))return null;used[p.id]=true;return p;}
    var fl=club.lines&&club.lines.forwards||[],dl=club.lines&&club.lines.defense||[];
    for(var i=0;i<4;i++){var l=fl[i]||{};lines.push(['LW','C','RW'].map(function(s){return take(l[s],simV2IsF);}));}
    for(var j=0;j<3;j++){var d=dl[j]||{};pairs.push(['LD','RD'].map(function(s){return take(d[s],function(p){return p.pos==='D';});}));}
    var spareF=roster.filter(function(p){return simV2IsF(p)&&simV2Healthy(p)&&!used[p.id];}).sort(function(a,b){return b.ovr-a.ovr;}),spareD=roster.filter(function(p){return p.pos==='D'&&simV2Healthy(p)&&!used[p.id];}).sort(function(a,b){return b.ovr-a.ovr;});
    lines.forEach(function(l){for(var k=0;k<3;k++)if(!l[k]){var p=(k===1?spareF.filter(function(q){return q.pos==='C';}):spareF).find(function(q){return !used[q.id];});if(p){used[p.id]=true;l[k]=p;}}});
    pairs.forEach(function(pr){for(var k=0;k<2;k++)if(!pr[k]){var p=spareD.find(function(q){return !used[q.id];});if(p){used[p.id]=true;pr[k]=p;}}});
    lines=lines.map(function(l){return l.filter(Boolean);});pairs=pairs.map(function(pr){return pr.filter(Boolean);});
    var skaters=[].concat.apply([],lines).concat([].concat.apply([],pairs)),dressed={};skaters.forEach(function(p){dressed[p.id]=true;});
    var st=club.specialTeams||{};
    function unit(ids,size,score,exclude,mix){var out=[];(ids||[]).forEach(function(pid){var p=byId[pid];if(p&&dressed[p.id]&&out.indexOf(p)<0&&out.length<size)out.push(p);});var pool=skaters.filter(function(p){return out.indexOf(p)<0&&(!exclude||exclude.indexOf(p)<0);}).sort(function(a,b){return score(b)-score(a);});if(mix){var needD=mix.D-out.filter(function(p){return p.pos==='D';}).length,needF=mix.F-out.filter(simV2IsF).length;pool.forEach(function(p){if(out.length>=size)return;if(p.pos==='D'&&needD>0){out.push(p);needD--;}else if(p.pos!=='D'&&needF>0){out.push(p);needF--;}});}pool.forEach(function(p){if(out.length<size&&out.indexOf(p)<0)out.push(p);});return out.slice(0,size);}
