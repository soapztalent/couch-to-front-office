    var morale=Math.round(g.roster.reduce(function(a,p){return a+p.morale;},0)/Math.max(1,g.roster.length));
    var requests=g.roster.filter(function(p){return p.tradeRequest||p.morale<35;});
    $('office-content').innerHTML='<div class="panel-grid"><section class="panel"><div class="panel-head"><div><p class="section-kicker">STAFF & PLAYER ROOM</p><h2>Clubhouse</h2><p>Coach identity, player morale, readiness and roster preferences shape the season.</p></div><span class="small-badge">CHEMISTRY '+chemistryScore(g)+' / 100</span></div><div class="trade-controls"><label>Head coach system<select id="coach-system" class="inline-select"><option value="balanced" '+(g.coach.system==='balanced'?'selected':'')+'>Balanced forecheck</option><option value="attack" '+(g.coach.system==='attack'?'selected':'')+'>Aggressive attack</option><option value="defense" '+(g.coach.system==='defense'?'selected':'')+'>Defense first</option><option value="youth" '+(g.coach.system==='youth'?'selected':'')+'>Player development</option></select></label></div><div class="metric-row"><div class="stat-card"><span>ROOM MORALE</span><strong>'+morale+'%</strong></div><div class="stat-card"><span>CHEMISTRY</span><strong>'+chemistryScore(g)+'%</strong></div><div class="stat-card"><span>OWNER TRUST</span><strong>'+g.owner.trust+'%</strong></div></div><p class="panel-subtitle">System effect: '+(g.coach.system==='attack'?'extra scoring chance with higher goals against':g.coach.system==='defense'?'reduced goals against with a lower scoring ceiling':g.coach.system==='youth'?'more development for players under 24':'steady two-way balance')+'.</p></section><section class="panel"><p class="section-kicker">OWNERSHIP & MEDIA</p><h2>'+esc(g.owner.goal)+'</h2><div class="owner-meter"><i style="width:'+g.owner.trust+'%"></i></div><p class="panel-subtitle">Ownership patience: '+g.owner.patience+' · Trust rises with wins, playoff qualification and smart roster management.</p><div class="asset-list"><div class="asset-row"><span><strong>GM direction</strong><small>'+({balanced:'Retool', 'win-now':'Contender', youth:'Rebuilder'}[g.philosophy]||'Retool')+'</small></span><b class="prospect-potential">'+(g.philosophy==='win-now'?'CONTEND':g.philosophy==='youth'?'REBUILD':'RETOOL')+'</b></div><div class="asset-row"><span><strong>Player requests</strong><small>Role frustration escalates from coach to GM to agent before a trade request.</small></span><b>'+(requests.length?requests.length:'NONE')+'</b></div></div><div class="history-list">'+(g.media.length?g.media.slice(-3).reverse().map(function(m){return '<article class="history-item"><time>'+esc(m.tag)+'</time><p>'+esc(m.text)+'</p><small>ROOM TEMPERATURE · '+m.morale+'</small></article>';}).join(''):('<p class="panel-subtitle">'+team(g.team).name+' media coverage will react to the season as it unfolds.</p>'))+'</div></section></div>';
  }
  function roundName(i) { return ['First round','Second round','Conference finals','Stanley Cup Final'][i]||'Stanley Cup'; }
  function playoffBracketFromStandings(g){
