    var game={version:'0.6',team:id,mode:mode,philosophy:gm,season:1,startYear:2026,maxYears:25,stage:mode==='playoffs'?'playoffs':'regular',day:0,schedule:schedule,calendarGames:[],scheduleSource:'Simulation fallback',record:stats,standings:{},roster:roster,reserveRoster:buildReserveRoster(id),leagueTeams:{},userPicks:picksForTeam(id,2026),retainedObligations:[],transactionLog:[],aiLog:[],prospects:makeProspects(1,id),orgProspects:[],freeAgents:[],history:[],results:[],awards:[],championships:0,playoff:null,payrollOn:!!payrollOn,payrollRef:roster.reduce(function(sum,p){return sum+contractHit(p);},0),cap:projectedNhlCap(2026),capAdjustment:0,drafted:false,offseason:null,dataSources:{roster:importedMetadata.source||'Bruins roster reference + team-by-team estimates',ratings:importedMetadata.ratingSource||'EA SPORTS NHL 27 ratings · imported values only',asOf:importedMetadata.asOf||'2026-09'},scouted:{},coach:{name:team(id).name+' Head Coach',system:'balanced'},scoutingStaff:3,owner:{trust:72,patience:70,goal:'Make the playoffs'},media:[],createdAt:new Date().toISOString()};
    game.owner.goal=gm==='youth'?'Build through youth and future assets':gm==='win-now'?'Compete for the Stanley Cup':'Stay competitive and build wisely';game.owner.patience=gm==='youth'?88:gm==='win-now'?62:74;
    teams.forEach(function(t){ game.standings[t.id]={w:0,l:0,otl:0,rw:0,row:0,pts:0,gf:0,ga:0,headToHead:{}}; });
    teams.filter(function(t){return t.id!==id;}).forEach(function(t){game.leagueTeams[t.id]=makeLeagueClub(t.id,2026);});
