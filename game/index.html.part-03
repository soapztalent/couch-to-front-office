  function renderOffice() {
    var g=current.game; if(!g)return;
    var tm=team(g.team); document.documentElement.style.setProperty('--team',tm.color); document.documentElement.style.setProperty('--team2',tm.secondary);
    $('top-team').textContent=tm.name.toUpperCase(); $('top-season').textContent=seasonLabel(g)+' SEASON'; $('season-number').textContent=String(g.season).padStart(2,'0')+' / '+g.maxYears;
    $('record-number').textContent=recordText(g.record); $('cap-room').textContent=shortMoney(g.cap-capUsed(g)); $('office-title').innerHTML='Make '+esc(tm.name.split(' ').slice(-1)[0])+'<br><em>matter.</em>';
    $('office-subtitle').textContent=g.mode==='playoffs'?'One bracket. Four rounds. One shot at the Stanley Cup.':g.mode==='season'?'One season to prove what this group can do.':'The work starts now. Every move writes the next chapter.';
    $('advance-button').innerHTML=advanceLabel(g)+' <span>→</span>';
    $('advance-button').disabled=(g.stage==='complete'); $('advance-button').classList.toggle('button-quiet',g.stage==='complete');
    var offNav=document.querySelector('#sidebar-nav [data-ui-page="offseason"]');if(offNav){offNav.disabled=g.stage!=='offseason';offNav.title=offNav.disabled?'Opens after the Stanley Cup Playoffs':'Offseason is open';offNav.setAttribute('aria-disabled',offNav.disabled?'true':'false');}
