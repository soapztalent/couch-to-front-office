  function aiIsProspect(a){return !!a&&!a.round&&!!a.__group&&a.__group!=='active';}
  function aiProspectValue(p){var pot=Math.max(Number(p.potential)||0,Number(p.ovr)||0),age=Number(p.age)||20,ovr=Number(p.ovr)||60,curve=Math.pow(Math.max(0,pot-AI_TRADE.PROSPECT_POT_BASE),AI_TRADE.PROSPECT_POT_EXP),factor=AI_TRADE.PROSPECT_AGE_FACTOR-AI_TRADE.PROSPECT_AGE_STEP*Math.max(0,age-20)+AI_TRADE.PROSPECT_READY_BONUS*clamp((ovr-65)/15,0,1);return Math.max(3,Math.round(curve*Math.max(.3,factor)));}
