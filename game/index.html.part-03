  function draftPickOverall(g,pick){var slot=draftSlotForTeam(g,pick.origin||pick.team);return (Math.max(1,Number(pick.round)||1)-1)*32+slot;}
  function offseasonPlacement(g){var mine=g.team,rows=teams.map(function(t){return {id:t.id,name:t.name,rec:ensureStandingsRecord(g.standings&&g.standings[t.id])};}),overall=standingsSort(rows),club=team(mine),division=standingsSort(rows.filter(function(r){return team(r.id).division===club.division;})),conference=standingsSort(rows.filter(function(r){return (['Atlantic','Metro'].indexOf(team(r.id).division)>=0)===(['Atlantic','Metro'].indexOf(club.division)>=0);})),year=g.offseason&&g.offseason.year||g.startYear+g.season,picks=(g.userPicks||[]).filter(function(p){return Number(p.year)===Number(year);}).slice().sort(function(a,b){return draftPickOverall(g,a)-draftPickOverall(g,b);}),first=picks[0]||null;return {league:overall.findIndex(function(r){return r.id===mine;})+1,conference:conference.findIndex(function(r){return r.id===mine;})+1,division:division.findIndex(function(r){return r.id===mine;})+1,pick:first?draftPickOverall(g,first):null,round:first?first.round:null,origin:first?(first.origin||first.team):null,lottery:!!first&&draftSlotForTeam(g,first.origin||first.team)<=16};}
  function renderOffseasonEntry(g){var result=offseasonPlacement(g),name=team(g.team).name,placeText=result.pick?ordinal(result.pick)+' overall':'No draft pick currently owned',slotNote=result.lottery?'Projected slot before the NHL Draft Lottery; lottery results can move the top 16.':result.pick?'Draft position follows the club that originally owned this pick.':'Check Future Assets to review your draft inventory.';$('office-content').innerHTML=officeHeader(name,'The offseason starts now','The season is over. You are back at the table before the draft. Choose whether to make calls around the league first.')+'<section class="offseason-entry"><div class="offseason-entry-lights" aria-hidden="true"></div><div class="offseason-entry-copy"><p class="section-kicker">POSTSEASON REPORT · '+esc(seasonLabel(g))+'</p><h2>Would you like to use the phones before we draft?</h2><p>The draft room is next. Take one last look around the league, make a move if it helps your club, or head straight to the stage.</p></div><div class="offseason-finish-grid"><article><span>FINAL NHL STANDING</span><strong>'+ordinal(result.league)+'</strong></article><article><span>CONFERENCE</span><strong>'+ordinal(result.conference)+' · '+(clubConference(g.team))+'</strong></article><article><span>'+esc(team(g.team).division.toUpperCase())+' DIVISION</span><strong>'+ordinal(result.division)+'</strong></article></div><div class="offseason-draft-callout"><div><span>YOUR FIRST AVAILABLE PICK</span><strong>'+(result.pick?'#'+result.pick+' · '+placeText:placeText)+'</strong><small>'+esc(slotNote)+(result.origin?' · Pick originally belongs to '+esc(team(result.origin).name):'')+'</small></div><span class="draft-round-chip">'+(result.round?'ROUND '+result.round:'NO PICK')+'</span></div><div class="offseason-entry-actions"><button type="button" class="button button-quiet" data-action="open-offseason-phones">'+officeIcon('trade')+' Use the phones</button><button type="button" class="button button-gold" data-action="start-offseason-draft">Go to Draft Night <span>→</span></button></div></section>';}
  function clubConference(id){return ['Atlantic','Metro'].indexOf(team(id).division)>=0?'Eastern Conference':'Western Conference';}
  function initializeDraftOrder(g){var year=g.offseason&&g.offseason.year||g.startYear+g.season,assets=[];try{resolvePickConditions(g,Number(year));}catch(rpE){console.error('pick conditions',rpE);}teams.forEach(function(t){clubPicks(g,t.id).filter(function(p){return Number(p.year)===Number(year);}).forEach(function(p){assets.push({owner:t.id,pick:p,key:pickKey(p),origin:p.origin||p.team});});});var order=[];for(var round=1;round<=7;round++)teams.slice().sort(function(a,b){return draftSlotForTeam(g,a.id)-draftSlotForTeam(g,b.id);}).forEach(function(originTeam){var found=assets.find(function(x){return x.origin===originTeam.id&&Number(x.pick.round)===round;});order.push({round:round,slot:draftSlotForTeam(g,originTeam.id),overall:(round-1)*32+draftSlotForTeam(g,originTeam.id),origin:originTeam.id,owner:found?found.owner:originTeam.id,pickKey:found?found.key:null});});g.offseason.liveDraft={year:Number(year),order:order,cursor:0,onClockKey:null,pendingTradeOffer:null};g.offseason.draftLog=g.offseason.draftLog||[];return g.offseason.liveDraft;}
  function findDraftAsset(g,owner,key){return clubPicks(g,owner).find(function(p){return pickKey(p)===key;});}
