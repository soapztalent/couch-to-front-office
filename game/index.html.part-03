      var knownToi=0,knownN=0;years.forEach(function(y){var s=entry.seasons[y]||{};if(Number(s.timeOnIcePerGame)>0&&Number(s.gp)>0){knownToi+=Number(s.timeOnIcePerGame)*Number(s.gp);knownN+=Number(s.gp);}});
      years.forEach(function(y,i){var s=entry.seasons[y]||{},n=Number(s.gp)||0;if(!n)return;var wt=w[i]||.1;gp+=n*wt;goals+=(Number(s.goals)||0)*wt;assists+=(Number(s.assists)||0)*wt;shots+=(Number(s.shots)||0)*wt;var ppgS=(Number(s.points)||0)/n,tpg=Number(s.timeOnIcePerGame)||(knownN?knownToi/knownN:(pos==='D'?(16.5+6.5*Math.min(ppgS,.9)):(12.5+6*Math.min(ppgS,1.4)))*60);if(tpg>0){toi+=tpg*n*wt;toiGp+=n*wt;}if(Number(s.savePct)>0){svW+=Number(s.savePct)*n*wt;svGp+=n*wt;}});
