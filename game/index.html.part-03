  function prepareTradeDraft(g) { var d=current.tradeDraft;if(!d||d.team!==g.team||!leagueClub(g,d.target)){var first=g.team==='PHI'?'BOS':'PHI';d={team:g.team,target:first,userPlayers:[],marketPlayers:[],userPicks:[],marketPicks:[],retainUser:0,retainMarket:0,intent:'balance'};current.tradeDraft=d;}return d; }
