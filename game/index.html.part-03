    var watchCount=g.prospects.filter(function(p){return (g.scoutWatchlist||[]).indexOf(p.id)>=0;}).length,filters=['ALL','FWD','D','G','WATCHLIST'].map(function(f){var label=f==='WATCHLIST'?'Watchlist ('+watchCount+')':({ALL:'All',FWD:'Forwards',D:'Defense',G:'Goalies'}[f]);return '<button type="button" data-scout-filter="'+f+'" class="scout-filter '+(filter===f?'active':'')+'" aria-pressed="'+(filter===f)+'">'+label+'</button>';}).join(''),pickText=pick?team(g.team).name+' is selecting at #'+draftPickOverall(g,pick)+' overall · Round '+pick.round+'.':team(g.team).name+' has no picks remaining in this class.';
