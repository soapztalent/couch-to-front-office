     var gameCard=isDone?('<div class="season-end"><strong>Season complete.</strong><p>'+team(g.team).name+' finished ')+recordText(g.record)+' with '+g.record.pts+' points. Your one-season run is in the history book.</p><button class="button button-gold" data-action="home">Return to main menu →</button></div>':isOff?('<div class="season-end"><strong>Offseason in '+team(g.team).name+'.</strong><p>The post-season is followed by the draft, prospect development and free agency. Current step: ')+esc(offPhase.replace('-',' '))+'.</p><button class="button button-gold" data-action="offseason-next">'+(offPhase==='draft'?'Open draft board →':offPhase==='signings'?'Resolve draft rights →':offPhase==='free-agency'?'Open free agency →':'Begin next season →')+'</button> <button class="button button-quiet" data-page-link="organization">Organization chart →</button></div>':g.stage==='playoffs'?('<div class="season-end"><strong>The Stanley Cup Playoffs.</strong><p>'+team(g.team).name+' is entering the bracket. The regular-season streak ledger has reset. Every series has consequences.</p><button class="button button-gold" data-action="sim-round">Simulate round →</button></div>'):'<div class="next-game"><div class="game-club">'+logoMarkup(g.team,'mini-crest')+'<span><strong>'+esc(team(g.team).name)+'</strong><small>HOME ICE</small></span></div><span class="versus">VS</span><div class="game-club">'+logoMarkup(opp.id,'mini-crest')+'<span><strong>'+esc(opp.name)+'</strong><small>GAME '+String(g.day+1).padStart(2,'0')+' · '+esc(team(g.team).division.toUpperCase())+'</small></span></div></div><div class="game-detail"><span>'+seasonGameCount(g)+'-GAME REGULAR SEASON</span><strong>'+Math.min(g.day,seasonGameCount(g))+' / '+seasonGameCount(g)+'</strong></div>';
    var leaders=g.roster.slice().sort(function(a,b){return b.points-a.points;}).slice(0,5);
    $('office-content').innerHTML='<div class="panel-grid"><section class="panel"><div class="panel-head"><div><p class="section-kicker">'+seasonLabel(g)+' · '+(g.stage==='regular'?'REGULAR SEASON':g.stage.toUpperCase())+('</p><h2>Next shift</h2><p>'+team(g.team).name+' is ')+(g.stage==='regular'?('on game '+Math.min(g.day+1,seasonGameCount(g))+' of '+seasonGameCount(g)+'.'):'between chapters.')+'</p></div><span class="small-badge">'+esc(team(g.team).division.toUpperCase())+'</span></div>'+gameCard+'<div class="metric-row"><div class="stat-card"><span>GOALS FOR</span><strong>'+g.record.gf+'</strong></div><div class="stat-card"><span>GOALS AGAINST</span><strong>'+g.record.ga+'</strong></div><div class="stat-card"><span>TEAM RATING</span><strong>'+averageRating(g.roster)+'</strong></div></div></section><section class="panel"><div class="panel-head"><div><p class="section-kicker">THE ROOM</p><h2>Points leaders</h2></div><button class="button button-quiet" data-page-link="roster">Full roster ↗</button></div><div class="leaders">'+leaders.map(function(p,i){return '<div class="leader-row"><span class="rank">0'+(i+1)+'</span><span><strong>'+esc(p.name)+'</strong><small>'+esc(displayPlayerPosition(p))+' · POTENTIAL '+esc(playerPotentialRole(p))+'</small></span><span class="leader-points">'+p.points+' PTS</span></div>';}).join('')+'</div></section></div><div class="metric-row"><div class="stat-card"><span>SEASON</span><strong>'+seasonLabel(g)+'</strong></div><div class="stat-card"><span>CAP COMMITMENT</span><strong>'+shortMoney(capUsed(g))+'</strong></div><div class="stat-card"><span>DEADLINE / DRAFT</span><strong>'+(g.mode==='franchise'?'ACTIVE':'—')+'</strong></div></div>';
  }
  function renderPlayoffOverview(g) {
    var pl=g.playoff||initPlayoffs(g,false), round=pl.round;
    var done=pl.complete;
    var status=done?(pl.winner===g.team?(''+team(g.team).name+' wins the Stanley Cup.'):'The run ends in the '+roundName(round)+'.'):'Round '+(round+1)+' · '+roundName(round);
    $('office-content').innerHTML='<div class="panel-grid"><section class="panel"><div class="panel-head"><div><p class="section-kicker">STANLEY CUP PLAYOFFS</p><h2>'+status+'</h2><p>'+ (done?'The final is in the book.': 'Best-of-seven series · Four rounds to the Cup.')+'</p></div><span class="small-badge">'+(done?'FINAL':'ROUND '+(round+1)+' / 4')+'</span></div><div class="next-game"><div class="game-club">'+logoMarkup(g.team,'mini-crest')+'<span><strong>'+esc(team(g.team).name)+'</strong><small>YOUR CLUB</small></span></div><span class="versus">VS</span><div class="game-club">'+logoMarkup(pl.opponent||'BOS','mini-crest')+'<span><strong>'+esc(team(pl.opponent||'BOS').name)+'</strong><small>'+ (done?'SERIES FINAL':'SERIES')+'</small></span></div></div><p class="panel-subtitle">'+(done?'Series result recorded.': (''+team(g.team).name+' form is reset for the playoffs. A series loss carries a meaningful morale hit.'))+'</p>'+(!done?'<button class="button button-gold" data-action="sim-round">Simulate the series →</button>':'<button class="button button-gold" data-action="'+(g.mode==='playoffs'?'home':'advance-year')+'">'+(g.mode==='playoffs'?'Return to main menu →':'Continue to offseason →')+'</button>')+'</section><section class="panel"><p class="section-kicker">THE BRACKET</p><h2>Road to the Cup</h2><div class="playoff-bracket">'+[0,1,2,3].map(function(i){var results=pl.roundResults[i]||[];var state=results.length?(i<round?'✓ Complete':'● In progress'):(i===round&&!done?'● In progress':'○ Awaiting round');var details=results.map(function(r){return '<div class="bracket-game"><strong>'+esc(r.a)+' '+r.aWins+'–'+r.bWins+' '+esc(r.b)+'</strong>'+esc(team(r.winner).name)+' advances</div>';}).join('')||'<div class="bracket-game">Stanley Cup field</div>';return '<div class="round-card"><h3>'+roundName(i)+'</h3><div class="bracket-game"><strong>'+state+'</strong></div>'+details+'</div>';}).join('')+'</div></section></div>';
  }
  function renderRoster(g) {
    assignRoles(g);
    var sorted=g.roster.slice().sort(function(a,b){var order={C:0,LW:1,RW:2,D:3,G:4};return (order[a.pos]-order[b.pos])||b.ovr-a.ovr;});
    var forwardLabels=['LW','C','RW'],defenseLabels=['LD','RD'];
    function selectMarkup(value,slot,pos){var eligible=g.roster.filter(function(p){return canPlayerPlayLineSlot(p,pos==='F'?'F':pos==='D'?'D':'G',String(slot).split('.')[0]==='goalies'?Number(String(slot).split('.')[1]):String(slot).split('.')[2]);}).sort(function(a,b){return b.ovr-a.ovr;});return '<select class="inline-select line-select" data-slot="'+slot+'"><option value="">Open slot</option>'+eligible.map(function(p){return '<option value="'+esc(p.id)+'" '+(p.id===value?'selected':'')+'>'+esc(p.name)+' · '+p.pos+' · '+p.ovr+'</option>';}).join('')+'</select>';}
    var lineRows=g.lines.forwards.map(function(line,i){return '<div class="line-combo-row"><b class="line-number">'+String(i+1).padStart(2,'0')+'</b>'+forwardLabels.map(function(pos){return '<label><span>'+pos+'</span>'+selectMarkup(line[pos],'forwards.'+i+'.'+pos,'F')+'</label>';}).join('')+'</div>';}).join('');
    var dRows=g.lines.defense.map(function(line,i){return '<div class="line-combo-row defense-combo-row"><b class="line-number">'+String(i+1).padStart(2,'0')+'</b>'+defenseLabels.map(function(pos){return '<label><span>'+pos+'</span>'+selectMarkup(line[pos],'defense.'+i+'.'+pos,'D')+'</label>';}).join('')+'</div>';}).join('');
    var goalieRow='<div class="line-combo-row goalie-combo-row">'+g.lines.goalies.map(function(id,i){var p=g.roster.find(function(x){return x.id===id;});return '<label><span>G'+(i+1)+'</span>'+selectMarkup(id,'goalies.'+i,'G')+(p?'<b class="line-ovr">'+p.ovr+'</b>':'')+'</label>';}).join('')+'</div>';
    var linePanel=('<section class="panel lineup-panel"><div class="panel-head"><div><p class="section-kicker">'+team(g.team).name.toUpperCase()+' · COACHING STAFF</p><h2>Line combinations</h2><p>Set the forward lines, defense pairs and goalie order. Player health and readiness affect game results.</p></div><span class="small-badge">')+(g.lines.forwards.reduce(function(n,l){return n+['LW','C','RW'].filter(function(pos){return !!l[pos];}).length;},0))+' / 12 F · '+g.lines.defense.reduce(function(n,l){return n+(l.LD?1:0)+(l.RD?1:0);},0)+' / 6 D</span></div><div class="lineup-groups"><section class="lineup-group"><div class="depth-chart-label"><b>FORWARD LINES</b><span>LW · C · RW</span></div>'+lineRows+'</section><section class="lineup-group"><div class="depth-chart-label"><b>DEFENSE PAIRS</b><span>LEFT · RIGHT</span></div>'+dRows+'</section><section class="lineup-group goalie-group"><div class="depth-chart-label"><b>GOALIE DEPTH</b><span>STARTER · BACKUP</span></div>'+goalieRow+'</section></div><button class="button button-quiet" data-page-link="organization">Open organization chart →</button></section>';
    $('office-content').innerHTML=linePanel+('<section class="panel"><div class="panel-head"><div><p class="section-kicker">'+team(g.team).name.toUpperCase()+' · PLAYER PERSONNEL</p><h2>Roster & contracts</h2><p>Potential outlook, player preferences, deal term and season production.</p></div><span class="small-badge">')+g.roster.length+' PLAYERS · '+(g.payrollOn?'REFERENCE SNAPSHOT':'PLAYER SUM')+' CAP</span></div><div class="player-table-wrap"><table class="player-table"><thead><tr><th>Player</th><th>Pos</th><th>Age</th><th>OVR</th><th>Potential</th><th>Contract</th><th>GP</th><th>G</th><th>A</th><th>PTS</th><th>Readiness</th></tr></thead><tbody>'+sorted.map(function(p){return '<tr><td class="player-name">'+esc(p.name)+(p.injury>0?'<small>INJURED'+(p.injuryLabel?' · '+String(p.injuryLabel).toUpperCase():'')+' · '+p.injury+' GP</small>':'')+(p.hot>=5?'<small>IN FORM</small>':'')+(p.cold>=5?'<small>IN A SLUMP</small>':'')+(p.tradeRequest?'<small>TRADE REQUEST</small>':'')+'<small>'+esc(sourceLabel(p))+'</small><small>PLAYER PREF · '+esc(p.preference||'Stability')+'</small></td><td>'+esc(displayPlayerPosition(p))+'</td><td>'+p.age+'</td><td><span class="ovr">'+p.ovr+'</span></td><td><span class="potential-pill">'+esc(playerPotentialRole(p))+'</span></td><td>'+shortMoney(p.salary)+' · '+p.years+' yr</td><td>'+p.games+'</td><td>'+p.goals+'</td><td>'+p.assists+'</td><td><strong>'+p.points+'</strong></td><td><div class="rating-bar"><span>'+p.stamina+'%</span><span class="rating-meter"><i style="width:'+p.stamina+'%"></i></span></div></td></tr>';}).join('')+'</tbody></table></div><p class="panel-subtitle">Player identities and listed NHL 27 ratings are sourced separately; contracts and prospect projections remain estimates unless replaced by an authorized import.</p></section>';
  }
  function estimateNhlEta(p,baseYear) { var floorYear=Number(baseYear)||2027;if(Number.isFinite(Number(p.etaYear))&&Number(p.etaYear)>=floorYear)return Number(p.etaYear);var current=Number(p.projection)||Number(p.ovr)||60,age=Number(p.age)||18,wait=clamp(Math.ceil((77-current)/6)+(age<19?2:age<21?1:0),1,7);return floorYear+wait; }
  function prospectStage(p,currentYear) { var eta=estimateNhlEta(p,currentYear);if(eta<=currentYear)return 'NHL-ready';if(p.age<=19)return 'Development camp';return 'Development system'; }
  function renderOrganization(g) {
    assignRoles(g);g.orgProspects=g.orgProspects||[];g.reserveRoster=g.reserveRoster||[];current.orgTeam=teamMap[current.orgTeam]?current.orgTeam:g.team;current.orgTab=current.orgTab||'depth';
    var id=current.orgTeam,club=id===g.team?g:leagueClub(g,id)||{roster:[],picks:[],orgProspects:[],reserveRoster:[],retainedObligations:[]},roster=clubRoster(g,id),pipeline=(club.orgProspects||[]).concat(club.reserveRoster||[]).filter(function(p,i,all){return all.findIndex(function(x){return x.id===p.id;})===i;}),reserves=club.reserveRoster||[],cap=id===g.team?capUsed(g):capUsedClub(g,id),capRoom=g.cap-cap,players=roster.slice().sort(function(a,b){return b.ovr-a.ovr;}),year=g.startYear+g.season,yearList=[year,year+1,year+2,year+3],heldPicks=clubPicks(g,id),clubOptions=teams.map(function(t){return '<option value="'+t.id+'" '+(t.id===id?'selected':'')+'>'+esc(t.name)+'</option>';}).join('');
    var nhl27Count=roster.filter(function(p){return p.ratingSource==='EA SPORTS NHL 27'||/nhl\s*27/i.test(String(p.rosterSource||p.dataSource||''));}).length,activeContractCount=roster.concat(pipeline).filter(function(p){return !p.unsigned&&p.years>0;}).length,nav=[['depth','Depth chart'],['cap','Cap projections'],['special','Special teams'],['trade','Trade'],['ufas','UFAs'],['rfas','RFAs'],['reserve','Reserve list'],['prospects','Prospects'],['create','Create player']];
    function playerCard(p,slot){return '<article class="pp-player-card"><div class="pp-player-text"><strong>'+esc(p.name)+'</strong><small>'+esc(displayPlayerPosition(p))+' · '+p.age+' · '+esc(sourceLabel(p))+'</small></div><b>'+shortMoney(contractHit(p))+'<small>'+p.years+' YR</small></b><span class="pp-card-ovr">'+(p.ovr==null?'—':p.ovr)+'</span></article>';}
    function linesFor(clubObj){if(id===g.team){ensureLineup(g);return g.lines;}if(!clubObj.lines)ensureLineup(clubObj);return clubObj.lines;}
    var selectedLines=linesFor(club),activeIds={};
    selectedLines.forwards.forEach(function(line){['LW','C','RW'].forEach(function(pos){if(line[pos])activeIds[line[pos]]=true;});});selectedLines.defense.forEach(function(line){['LD','RD'].forEach(function(pos){if(line[pos])activeIds[line[pos]]=true;});});selectedLines.goalies.forEach(function(pid){if(pid)activeIds[pid]=true;});
    var fSlot=function(line,pos){var p=roster.find(function(x){return x.id===line[pos];});return p?playerCard(p):'<div class="pp-empty-slot">'+pos+' · OPEN</div>';};
    var depthGrid='<div class="pp-roster-head"><b>FORWARDS</b><span>LINE 1–4</span></div><div class="pp-line-grid">'+['LW','C','RW'].map(function(pos){return '<section class="pp-position"><h4>'+({LW:'LEFT WING',C:'CENTER',RW:'RIGHT WING'}[pos])+'</h4>'+selectedLines.forwards.map(function(line){return fSlot(line,pos);}).join('')+'</section>';}).join('')+'</div><div class="pp-roster-head"><b>DEFENSE & GOALIE</b><span>PAIR 1–3 · GOALIES</span></div><div class="pp-line-grid defense-line-grid">'+['LD','RD','G'].map(function(pos){return '<section class="pp-position"><h4>'+({LD:'LEFT DEFENSE',RD:'RIGHT DEFENSE',G:'GOALIE'}[pos])+'</h4>'+(pos==='G'?selectedLines.goalies.map(function(pid){var p=roster.find(function(x){return x.id===pid;});return p?playerCard(p):'<div class="pp-empty-slot">GOALIE · OPEN</div>';}).join(''):selectedLines.defense.map(function(pair){var p=roster.find(function(x){return x.id===pair[pos];});return p?playerCard(p):'<div class="pp-empty-slot">'+pos+' · OPEN</div>';}).join(''))+'</section>';}).join('')+'</div>';
    var presses=players.filter(function(p){return !activeIds[p.id]&&p.pos!=='G';});
    var pickCells=yearList.map(function(y){return '<tr><th>'+y+'</th>'+[1,2,3,4,5,6,7].map(function(round){var owned=heldPicks.filter(function(p){return Number(p.year)===y&&Number(p.round)===round;}),cell=owned.map(function(p){return '<span class="pick-asset" title="'+esc(y+' Round '+round+(p.origin&&p.origin!==id?' · originally '+team(p.origin).name:''))+'">'+logoMarkup(id,'pick-logo')+'<small>'+(p.origin&&p.origin!==id?p.origin:'OWN')+'</small></span>';}).join('');return '<td>'+(cell||'<span class="pick-missing" title="No pick held">—</span>')+'</td>';}).join('')+'</tr>';}).join('');
    var capSummary='<section class="panel pp-cap-panel"><div class="pp-cap-heading"><div><p class="section-kicker">'+esc(team(id).name.toUpperCase())+' · CAP BREAKDOWN</p><h2>'+shortMoney(cap)+' PROJECTED CAP HIT</h2></div><label>ORGANIZATION<select id="org-team-select" class="inline-select">'+clubOptions+'</select></label><span class="small-badge">'+p25RosterCount(roster)+' NHL ROSTER</span></div><div class="pp-cap-metrics"><div><span>ROSTER COUNT</span><b>'+p25RosterCount(roster)+'</b></div><div><span>PROJECTED CAP HIT</span><b>'+money(cap)+'</b></div><div><span>PROJECTED CAP SPACE</span><b>'+money(Math.max(0,capRoom))+'</b></div><div><span>RETAINED REMAINING</span><b>'+(club.retainedObligations||[]).filter(function(x){return x.yearsRemaining>0;}).length+'</b></div><div><span>POTENTIAL LTIR</span><b>'+money(roster.filter(function(p){return /LTIR|LONG.TERM/i.test(String(p.rosterStatus||''));}).reduce(function(n,p){return n+contractHit(p);},0))+'</b></div><div><span>STANDARD CONTRACTS</span><b>'+activeContractCount+' / 50</b></div></div><p class="pp-data-note">This career uses a frozen starting database. NHL 27-labelled records: '+nhl27Count+' of '+roster.length+'. Labels are not independent verification. Legacy/demo players, contracts, ratings, pick ownership and projections need source review.</p></section>';
    var subnav='<nav class="org-subnav" aria-label="Organization tools">'+nav.map(function(t){return '<button data-org-tab="'+t[0]+'" class="'+(current.orgTab===t[0]?'active':'')+'">'+t[1]+'</button>';}).join('')+'</nav>';
    var draftCapital='<section class="panel org-block"><div class="panel-head"><div><p class="section-kicker">'+esc(team(id).name.toUpperCase())+' · DRAFT CAPITAL</p><h2>Pick ownership</h2></div><span class="small-badge">'+heldPicks.length+' PICKS HELD</span></div><div class="player-table-wrap"><table class="draft-capital-table"><thead><tr><th>YEAR</th>'+[1,2,3,4,5,6,7].map(function(r){return '<th>'+r+'</th>';}).join('')+'</tr></thead><tbody>'+pickCells+'</tbody></table></div></section>';
    var transactions=(g.transactionLog||[]).filter(function(tx){return !tx.teams||tx.teams.indexOf(id)>=0;}).slice(0,8),txMarkup=transactions.map(function(tx){return '<article class="pp-transaction"><time>'+esc(tx.when)+'</time><span>'+esc(tx.text)+'</span></article>';}).join('')||'<p class="panel-subtitle">No recorded transactions for this club yet.</p>';
    var rosterSections=[['FORWARDS',['C','LW','RW']],['DEFENSE',['D']],['GOALTENDERS',['G']]].map(function(grp){var groupPlayers=players.filter(function(p){return grp[1].indexOf(p.pos)>=0;});return '<section class="pp-contract-group"><h3>'+grp[0]+' <small>'+groupPlayers.length+'</small></h3><div class="player-table-wrap"><table class="player-table pp-contract-table"><thead><tr><th>PLAYER</th>'+yearList.map(function(y){return '<th>'+y+'–'+String(y+1).slice(-2)+'</th>';}).join('')+'</tr></thead><tbody>'+groupPlayers.map(function(p){var timeline=p.contractTimeline||[];return '<tr><td class="player-name">'+esc(p.name)+'<small>'+esc(displayPlayerPosition(p))+' · AGE '+p.age+' · '+(p.term||p.years||'—')+' YR · '+esc(p.freeAgencyStatus||p.expiry||'STATUS UNKNOWN')+'</small></td>'+yearList.map(function(y,i){var entry=timeline[i];if(entry==null&&i===0)entry=contractHit(p);if(entry==null&&i<(p.years||0))entry=contractHit(p);if(entry==null&&i>=(p.years||0))entry=p.freeAgencyStatus||p.expiry||'—';return '<td>'+((typeof entry==='number')?money(entry):esc(String(entry||'—')) )+'</td>';}).join('')+'</tr>';}).join('')+'</tbody></table></div></section>';}).join('');
    var prospects=pipeline.slice().sort(function(a,b){return estimateNhlEta(a,year)-estimateNhlEta(b,year)||b.ovr-a.ovr;}),prospectMarkup=prospects.map(function(p){var eta=estimateNhlEta(p,year),stage=prospectStage(p,year),progress=clamp(Math.round((p.ovr-50)/45*100),0,100);return '<article class="pipeline-card"><div class="pipeline-top"><span class="prospect-avatar">'+esc(displayPlayerPosition(p))+'</span><div class="pipeline-name"><strong>'+esc(p.name)+'</strong><small>'+esc(stage.toUpperCase())+' · AGE '+p.age+' · '+esc(p.freeAgencyStatus||'RIGHTS / CONTRACT STATUS UNKNOWN')+'</small></div><b class="org-ovr">'+p.ovr+'<small>'+(p.ratingSource?esc(p.ratingSource):'SIM EST.')+'</small></b></div><div class="pipeline-metrics"><span><small>NHL ETA</small><b>'+eta+'</b></span><span><small>POTENTIAL</small><b>'+(p.scouted?Math.max(55,p.potential-5)+'–'+Math.min(99,p.potential+4):'SCOUT NEEDED')+'</b></span><span><small>LEVEL</small><b>'+esc(p.level||stage)+'</b></span></div><div class="pipeline-progress"><i style="width:'+progress+'%"></i></div><div class="pipeline-foot"><span>Ability '+p.ovr+' · ETA is an estimate</span>'+(id===g.team&&roster.length<23?'<button class="button button-quiet" data-action="promote-prospect" data-player="'+esc(p.id)+'">Promote ↗</button>':'')+'</div></article>';}).join('')||'<div class="season-end"><strong>No prospects loaded for '+esc(team(id).name)+'.</strong><p>Import NHL 27 player data or add prospects from the draft board. Unsigned players should be imported to Reserve List.</p>'+(id===g.team?'<button class="button button-quiet" data-page-link="prospects">Open draft board →</button>':'')+'</div>';
    var unsigned=reserves.filter(function(p){return p.unsigned||p.reserveList||/prospect|reserve|non-roster/i.test(String(p.rosterStatus||''));});
    var listsMarkup=function(arr){return arr.map(function(p){return '<div class="prospect-card"><span class="prospect-avatar">'+esc(displayPlayerPosition(p))+'</span><span><strong>'+esc(p.name)+'</strong><small>'+esc(displayPlayerPosition(p))+' · '+(p.age||'—')+' · '+(p.ovr||'—')+' OVR · '+esc(p.freeAgencyStatus||p.rosterStatus||'NHL 27')+'</small></span><span class="prospect-potential">'+shortMoney(p.salary||0)+'</span></div>';}).join('')||'<p class="panel-subtitle">No players in this section yet. Team-by-team NHL 27 data can be imported.</p>';};
    var body='';
    if(current.orgTab==='depth'){body=draftCapital+'<section class="panel org-block"><div class="panel-head"><div><p class="section-kicker">TRANSACTIONS</p><h2>Recent moves</h2></div><span class="small-badge">'+transactions.length+' TRANSACTIONS</span></div><div class="pp-transaction-list">'+txMarkup+'</div></section><section class="panel org-block"><div class="panel-head"><div><p class="section-kicker">'+esc(team(id).name.toUpperCase())+' · NHL ROSTER</p><h2>Depth chart</h2><p>Selected players appear in the active lineup; remaining skaters are in the press box.</p></div><span class="small-badge">'+p25RosterCount(roster)+'</span></div>'+depthGrid+'<div class="pp-roster-head"><b>PRESS BOX</b><span>'+presses.length+' PLAYERS</span></div><div class="pp-pressbox">'+(presses.map(playerCard).join('')||'<div class="pp-empty-slot">NO HEALTHY SCRATCHES</div>')+'</div><div class="pp-roster-head"><b>INJURED RESERVE</b><span>IR · LTIR · SEASON ENDING</span></div><div class="pp-pressbox">'+(roster.filter(function(p){return p.injury>0||/IR|LTIR/i.test(String(p.rosterStatus||''));}).map(playerCard).join('')||'<div class="pp-empty-slot">IR 0 · LTIR 0 · SELTIR 0</div>')+'</div></section><section class="panel org-block"><div class="panel-head"><div><p class="section-kicker">FULL ROSTER BREAKDOWN</p><h2>'+activeContractCount+' / 50 contracts</h2></div><span class="small-badge">NHL '+roster.length+' · RESERVE '+reserves.length+' · DEVELOPMENT (OVERLAPS RESERVES) '+pipeline.length+'</span></div>'+rosterSections+'</section><section class="panel org-block"><div class="panel-head"><div><p class="section-kicker">RESERVE LIST</p><h2>Reserve / injured / non-roster entries</h2></div><span class="small-badge">'+unsigned.length+' PLAYERS</span></div><div class="prospect-list">'+listsMarkup(unsigned)+'</div></section><section class="panel org-block"><div class="panel-head"><div><p class="section-kicker">ORGANIZATION · PLAYER DEVELOPMENT</p><h2>Reserves &amp; development</h2><p class="panel-subtitle">Includes injured/non-roster entries; not a complete prospect pool. Age, ratings and contracts may be simulation estimates.</p><p>ETA means estimated NHL arrival year. Player development is uncertain, not a fixed promise.</p></div><span class="small-badge">'+pipeline.length+' RESERVE / DEVELOPMENT PLAYERS</span></div><div class="pipeline-list">'+prospectMarkup+'</div></section>';}
    else if(current.orgTab==='cap'){body='<section class="panel org-block"><h2>Cap projections</h2><p class="panel-subtitle">Current simulation snapshot: '+money(cap)+' cap hit against '+money(g.cap)+' ceiling. Future salaries are estimates unless provided in an NHL 27/contract import.</p><div class="player-table-wrap"><table class="draft-capital-table"><thead><tr><th>CAP ITEM</th>'+yearList.map(function(y){return '<th>'+y+'–'+String(y+1).slice(-2)+'</th>';}).join('')+'</tr></thead><tbody><tr><th>Cap ceiling</th>'+yearList.map(function(y,i){return '<td>'+money(capCeilingAtIndex(g,i))+'</td>';}).join('')+'</tr><tr><th>Cap floor</th>'+yearList.map(function(y,i){return '<td>'+money(capFloorAtIndex(g,i))+'</td>';}).join('')+'</tr><tr><th>Projected cap hit</th>'+yearList.map(function(y,i){var hit=i===0?cap:roster.reduce(function(n,p){return n+(i<(p.years||0)?contractHit(p):0);},0);return '<td>'+money(hit)+'</td>';}).join('')+'</tr><tr><th>Projected cap space</th>'+yearList.map(function(y,i){var ceiling=capCeilingAtIndex(g,i),hit=i===0?cap:roster.reduce(function(n,p){return n+(i<(p.years||0)?contractHit(p):0);},0);return '<td>'+money(Math.max(0,ceiling-hit))+'</td>';}).join('')+'</tr><tr><th>Dead cap / retained</th>'+yearList.map(function(y,i){return '<td>'+money(i===0?(club.retainedObligations||[]).reduce(function(n,x){return n+(x.amount||0);},0):0)+'</td>';}).join('')+'</tr></tbody></table></div></section>'+rosterSections;}
    else if(current.orgTab==='special'){body='<section class="panel org-block"><p class="section-kicker">CLUB · SPECIAL TEAMS</p><h2>Power play & penalty kill</h2><div class="lineup-groups"><section class="lineup-group"><div class="depth-chart-label"><b>POWER PLAY 1</b><span>5 SKATERS</span></div>'+players.filter(function(p){return p.pos!=='G';}).slice(0,5).map(playerCard).join('')+'</section><section class="lineup-group"><div class="depth-chart-label"><b>POWER PLAY 2</b><span>5 SKATERS</span></div>'+players.filter(function(p){return p.pos!=='G';}).slice(5,10).map(playerCard).join('')+'</section><section class="lineup-group"><div class="depth-chart-label"><b>PENALTY KILL 1</b><span>4 SKATERS</span></div>'+players.filter(function(p){return p.pos==='C'||p.pos==='D';}).slice(0,4).map(playerCard).join('')+'</section><section class="lineup-group"><div class="depth-chart-label"><b>PENALTY KILL 2</b><span>4 SKATERS</span></div>'+players.filter(function(p){return p.pos==='C'||p.pos==='D';}).slice(4,8).map(playerCard).join('')+'</section></div><p class="panel-subtitle">Special teams use game ability estimates. Edit the five-on-five lines on Roster & lines.</p></section>';}
    else if(current.orgTab==='trade'){body='<section class="panel org-block"><p class="section-kicker">NHL TRADE MARKET</p><h2>Build a trade from the depth chart</h2><p class="panel-subtitle">Open Trade Desk to choose a partner and compare rosters, draft picks, cap impact and GM preferences.</p><button class="button button-gold" data-page-link="trades">Open trade desk →</button></section>';}
    else if(current.orgTab==='ufas'||current.orgTab==='rfas'){var status=current.orgTab==='ufas'?'UFA':'RFA',contractPlayers=roster.concat(reserves).filter(function(p){return String(p.freeAgencyStatus||p.expiry||'').toUpperCase().indexOf(status)>=0||(!p.freeAgencyStatus&&!p.expiry&&(p.years||0)<=1&&(status==='UFA'?p.age>=27:p.age<27));});body='<section class="panel org-block"><p class="section-kicker">'+esc(team(id).name.toUpperCase())+' · CONTRACT STATUS</p><h2>'+(status==='UFA'?'Unrestricted free agents':'Restricted free agents')+'</h2><p class="panel-subtitle">Players whose imported or projected contract status is '+status+'.</p><div class="pp-transaction-list">'+(contractPlayers.map(function(p){return '<article class="pp-transaction"><b>'+esc(p.name)+' · '+p.pos+' · '+p.age+'</b><span>'+shortMoney(contractHit(p))+' cap hit · '+p25Plural(p.years||0,'year')+' remaining · '+esc(p.freeAgencyStatus||p.expiry||status)+'</span></article>';}).join('')||'<p class="panel-subtitle">No '+status+' records are loaded for this club.</p>')+'</div></section>';}
    else if(current.orgTab==='reserve'){body='<section class="panel org-block"><p class="section-kicker">'+esc(team(id).name.toUpperCase())+' · RESERVE LIST</p><h2>Reserve and non-roster players</h2><p class="panel-subtitle">Includes injured/non-roster entries from the published snapshot and any separately imported prospects. This is not a complete prospect system.</p><div class="prospect-list">'+listsMarkup(reserves)+'</div><h3 class="section-kicker">DEVELOPMENT LIST (MAY OVERLAP RESERVES)</h3><div class="prospect-list">'+listsMarkup(pipeline)+'</div></section>';}
    else if(current.orgTab==='prospects'){body='<section class="panel org-block"><p class="section-kicker">'+esc(team(id).name.toUpperCase())+' · DEVELOPMENT PIPELINE</p><h2>Reserves, prospects & simulated ETA</h2><p class="panel-subtitle">Non-roster players are not necessarily prospects. ETA and development are simulation estimates, not a statement of real injury recovery or rights.</p><div class="pipeline-list">'+prospectMarkup+'</div>'+(id===g.team?'<button class="button button-quiet" data-page-link="prospects">Open draft & scout board →</button>':'')+'</section>';}
    else {body='<section class="panel org-block"><p class="section-kicker">TEAM-BY-TEAM · NHL 27</p><h2>Create a player record</h2><p class="panel-subtitle">Add a verified NHL 27 player while reviewing this club. Salary and contract fields stay marked as estimates unless imported separately.</p><form id="create-player-form" class="create-player-form"><label>PLAYER NAME<input class="inline-select" name="name" required placeholder="Full name"></label><label>POSITION<select class="inline-select" name="position"><option>C</option><option>LW</option><option>RW</option><option>D</option><option>G</option></select></label><label>AGE<input class="inline-select" name="age" type="number" min="16" max="50" value="24"></label><label>NHL 27 OVR<input class="inline-select" name="overall" type="number" min="40" max="99" required placeholder="76"></label><label>CAP HIT ESTIMATE<input class="inline-select" name="salary" type="number" min="0" step="50000" value="925000"></label><label>TERM<input class="inline-select" name="years" type="number" min="0" max="8" value="1"></label><button class="button button-gold" type="button" data-action="create-player">Add to '+esc(team(id).id)+' roster →</button></form></section>';}
    $('office-content').innerHTML=capSummary+subnav+body;
  }
  function freeAgentInterest(g,p){var affinity=p.teamAffinity||{},user=Number(affinity[g.team]);if(!Number.isFinite(user))user=38+Math.floor(seededRandom('fa-interest|'+p.id+'|'+g.team)()*45);var rivals=teams.filter(function(t){return t.id!==g.team;}).map(function(t){var value=Number(affinity[t.id]);if(!Number.isFinite(value))value=28+Math.floor(seededRandom('fa-interest|'+p.id+'|'+t.id)()*63);if(p.preference==='Contender'&&primeContender(g,t.id))value+=12;if(g.philosophy==='youth'&&p.age<25&&leagueClub(g,t.id).plan==='rebuild')value+=8;return {id:t.id,name:t.name,value:clamp(value,10,98)};}).sort(function(a,b){return b.value-a.value;}).slice(0,3);return {user:clamp(user,8,98),rivals:rivals};}
  /* ===== FA MARKET REALISM (v3.1): value-based asks, max/min contract, RFA tenders, late market ===== */
  function leagueMinSalaryFor(cap){return Math.max(775000,Math.round(775000*(Number(cap)||104000000)/95500000/25000)*25000);}
  function leagueMinSalary(g){return leagueMinSalaryFor(Number(g&&g.cap)||104000000);}
  function maxContractAav(g){return Math.floor(.2*(Number(g&&g.cap)||104000000)/25000)*25000;}
  function faClampAav(g,v){var n=Math.round(Number(v)||0);return Math.max(leagueMinSalary(g),Math.min(maxContractAav(g),n));}
  function faInterp(knots,x){if(x<=knots[0][0])return knots[0][1];for(var i=1;i<knots.length;i++){if(x<=knots[i][0]){var a=knots[i-1],b=knots[i];return a[1]+(b[1]-a[1])*(x-a[0])/Math.max(1e-9,b[0]-a[0]);}}return knots[knots.length-1][1];}
  var FA_SKATER_SHARE=[[0,0],[.15,0],[.3,.013],[.4,.021],[.5,.031],[.6,.042],[.7,.055],[.8,.072],[.9,.088],[.95,.105],[.98,.125],[.995,.145],[1,.16]];
  var FA_GOALIE_SHARE=[[0,0],[.3,0],[.45,.014],[.6,.03],[.75,.052],[.88,.08],[.95,.095],[1,.11]];
  var FA_STATIC_PCT=[[60,0],[71,.1],[78,.25],[82,.5],[85,.75],[88,.9],[90,.95],[95,.99],[99,1]];
  function faPools(g){var off=g.offseason,key=g.season+'|'+g.stage+'|'+(off?off.phase+'|'+(off.freeAgency?off.freeAgency.day:'-'):'')+'|'+(g.day||0);if(faPools.cache&&faPools.cache.g===g&&faPools.cache.key===key)return faPools.cache;var sk=[],gk=[];teams.forEach(function(t){(clubRoster(g,t.id)||[]).forEach(function(p){var o=Number(p.ovr);if(!Number.isFinite(o))return;(p.pos==='G'?gk:sk).push(o);});});sk.sort(function(a,b){return a-b;});gk.sort(function(a,b){return a-b;});faPools.cache={g:g,key:key,sk:sk,gk:gk};return faPools.cache;}
  function faRank(arr,e){if(!arr.length)return .5;var lo=0,hi=arr.length;while(lo<hi){var m=(lo+hi)>>1;if(arr[m]<e)lo=m+1;else hi=m;}var below=lo,eq=0;while(below+eq<arr.length&&arr[below+eq]===e)eq++;return (below+eq*.5)/arr.length;}
  function faEffectiveRating(p){var o=Number(p.ovr)||65,e=o;if(p.pos==='G'){var sa=Number(p.goalieShotsAgainst)||0,ga=Number(p.goalieGoalsAgainst)||0;if((Number(p.goalieStarts)||0)>=20&&sa>0)e+=clamp(((1-ga/sa)-.9)*150,-2,2.5);}else{var gp=Number(p.games)||0;if(gp>=20)e+=clamp(((Number(p.points)||0)/gp-(p.pos==='D'?.35:.55))*5,-2,3);}if((Number(p.age)||27)<=23)e+=1;return e;}
  function faValuePct(g,p){var e=faEffectiveRating(p);if(!g||!g.leagueTeams)return faInterp(FA_STATIC_PCT,e);var pools=faPools(g);return faRank(p.pos==='G'?pools.gk:pools.sk,e);}
  function faAgeMultiplier(age){age=Number(age)||27;return age<=30?1:age===31?.97:age===32?.92:age===33?.85:age===34?.75:age===35?.64:age===36?.54:age===37?.46:age===38?.4:.34;}
  function faMarketValue(g,p,cap){var c=Number(cap)||Number(g&&g.cap)||104000000,pct=faValuePct(g,p),share=faInterp(p.pos==='G'?FA_GOALIE_SHARE:FA_SKATER_SHARE,pct),base=share*c*faAgeMultiplier(p.age)*(1+(faLeagueScale(g)-1)*(1-.8*pct)),min=leagueMinSalaryFor(c),max=Math.floor(.2*c/25000)*25000;return Math.max(min,Math.min(max,Math.round(base/25000)*25000));}
  function faRfaAsk(g,p,base){var age=Number(p.age)||24,prev=Number(p.expiringCapHit)||Number(p.previousSalary)||Number(p.salary)||leagueMinSalary(g),qo=faQualifyingOffer(g,p);return Math.max(qo,Math.round(base*(age<=24?.82:.9)/25000)*25000);}
  function faQualifyingOffer(g,p){var prev=Number(p.expiringCapHit)||Number(p.previousSalary)||Number(p.salary)||leagueMinSalary(g);return faClampAav(g,Math.round(prev*(prev<=1000000?1.05:1)/25000)*25000);}
  function faSlotPlayer(g,slot){var source=slot.external?(g.currentFreeAgentPool||[]):clubRoster(g,slot.sourceTeam)||[];return source.find(function(x){return x.id===slot.playerId;})||null;}
  function faGroup(p){return p.pos==='G'?'G':p.pos==='D'?'D':'F';}
  function faOfferYears(g,p,plan,roll,sameClub){var age=Number(p.age)||27,pct=faValuePct(g,p),lo=1,hi=1;if(age>=36){lo=hi=1;}else if(age===35){hi=roll>.8?2:1;}else if(age===34){hi=2;}else if(age>=32){hi=3;}else if(age>=30){if(pct>=.6){lo=2;hi=5;}else hi=3;}else if(age>=26){if(pct>=.7){lo=3;hi=7;}else if(pct>=.4){lo=2;hi=4;}else hi=2;}else{if(pct>=.6){lo=3;hi=7;}else hi=3;}if(plan==='rebuild'&&age>=30)hi=Math.max(lo,hi-1);if(sameClub&&pct>=.7&&age<=29)hi=Math.min(8,hi+1);var y=lo+Math.floor((Number(roll)||0)*(hi-lo+1));return Math.max(1,Math.min(sameClub?8:7,y));}
  function faNormalizeOffer(g,offer,sameClub){var o=Object.assign({},offer);o.salary=faClampAav(g,o.salary);o.years=Math.max(1,Math.min(sameClub?8:7,Number(o.years)||1));return o;}
  function aiRoomCandidate(g,teamId,p){if(!g||teamId===g.team)return null;var club=leagueClub(g,teamId);if(!club)return null;var roster=club.roster||[],grp=faGroup(p),counts={F:0,D:0,G:0},mins={F:12,D:6,G:2},limit=Math.max(2*leagueMinSalary(g),2500000),ovr=Number(p.ovr)||0;roster.forEach(function(x){counts[faGroup(x)]++;});var cands=roster.filter(function(x){return x.id!==p.id&&(Number(x.years)>0||hasExtensionInPlace(x))&&contractHit(x)<=limit&&(Number(x.ovr)||0)<=ovr-3&&(faGroup(x)===grp||counts[faGroup(x)]>mins[faGroup(x)]);}).sort(function(a,b){return (faGroup(a)===grp?0:1)-(faGroup(b)===grp?0:1)||(Number(a.ovr)||0)-(Number(b.ovr)||0)||contractHit(b)-contractHit(a);});return cands[0]||null;}
  function aiMakeRoom(g,teamId,p,needCap){var club=leagueClub(g,teamId);if(!club||teamId===g.team)return false;club.reserveRoster=club.reserveRoster||[];for(var i=0;i<3;i++){var full=clubContractRosterCount(g,teamId)>=23,short=capUsedClub(g,teamId)+Math.max(0,Number(needCap)||0)>g.cap;if(!full&&!short)return true;var cut=aiRoomCandidate(g,teamId,p);if(!cut)return false;club.roster.splice(club.roster.indexOf(cut),1);cut.reserveList=true;cut.rosterStatus='AHL / cap relief';cut.level='Minor league';club.reserveRoster.push(cut);(g.history=g.history||[]).push({year:seasonLabel(g),tag:'ROSTER COVERAGE',text:team(teamId).name+' sends '+cut.name+' to the minors to open a spot for '+p.name+'.'});}return clubContractRosterCount(g,teamId)<23&&capUsedClub(g,teamId)+Math.max(0,Number(needCap)||0)<=g.cap;}
  function faWorstInGroup(g,teamId,p){var grp=faGroup(p);return (clubRoster(g,teamId)||[]).filter(function(x){return faGroup(x)===grp&&(Number(x.years)>0||hasExtensionInPlace(x));}).sort(function(a,b){return (Number(a.ovr)||0)-(Number(b.ovr)||0);})[0]||null;}
  function faTalentFit(g,teamId,p,day){if(day<2||faValuePct(g,p)<.5)return false;var w=faWorstInGroup(g,teamId,p);return !w||(Number(w.ovr)||0)<=(Number(p.ovr)||0)-3;}
  function faLateBoost(g,p,day){return day>=5&&faValuePct(g,p)>=.4?Math.min(30,(day-4)*1.2):0;}
  function faOfferValid(g,o,p,slot){if(o.team===g.team)return true;if(!leagueClub(g,o.team))return false;var fits=clubContractRosterCount(g,o.team)<23&&capUsedClub(g,o.team)+o.salary<=g.cap;return fits||!!aiRoomCandidate(g,o.team,p);}
  function faPruneOffers(g,market,offers){return (offers||[]).filter(function(o){return o.team===g.team||market.day-(Number(o.day)||0)<7;});}
  function faDecayAsks(g,market){faDecayAsksCore(g,market);faGoalieNeeds(g,market);}
  function faDecayAsksCore(g,market){var min=leagueMinSalary(g),d=Number(market.day)||0,f=d<=3?1:Math.max(.55,1-(d-3)*.0115);(g.freeAgents||[]).forEach(function(slot){if(slot.status==='RFA')return;if(!slot.baseAsk)slot.baseAsk=Number(slot.ask)||min;slot.ask=Math.max(min,Math.round(slot.baseAsk*f/25000)*25000);});}
  function rfaWorthTender(g,p,qo){if(!p)return false;var pct=faValuePct(g,p),age=Number(p.age)||24,ovr=Number(p.ovr)||65,pot=Number(p.potential)||ovr,value=faMarketValue(g,p,g.cap);if(ovr>=80||pct>=.3)return !(pct<.45&&qo>value*1.8);if(age<=23&&pot>=ovr+3&&ovr>=72)return qo<=value*1.6;return false;}
  function faSignOwn(g,teamId,p,slot,salary,years,type){var club=leagueClub(g,teamId);if(!club)return false;salary=faClampAav(g,salary);years=Math.max(1,Math.min(8,years));var v4s=v4fixContractSanity(g,p,salary,years,String(type||'').indexOf('RFA')>=0?'RFA':'UFA',teamId);salary=v4s.salary;years=v4s.years;if(clubContractRosterCount(g,teamId)>=23||capUsedClub(g,teamId)+salary>g.cap)aiMakeRoom(g,teamId,p,salary);if(clubContractRosterCount(g,teamId)>=23||capUsedClub(g,teamId)+salary>g.cap)return false;p.salary=salary;p.capHit=salary;p.years=years;p.term=years;p.contractTimeline=Array.from({length:years},function(){return salary;});p.retainedPercent=0;p.contractExpired=false;p.contractStatus='Active';p.freeAgencyStatus='';p.contractType=type;p.expiry='';p.expiringCapHit=0;p.club=teamId;p.ufaDecisionDate=(g.offseason&&g.offseason.year||'')+'-06-30';g.freeAgents=(g.freeAgents||[]).filter(function(x){return x.playerId!==p.id;});var text=team(teamId).name+(type==='RFA qualifying offer'?' qualifies '+p.name+': 1 year at '+shortMoney(salary)+'.':' re-signs '+p.name+' for '+years+' year'+(years===1?'':'s')+' at '+shortMoney(salary)+' AAV'+(type.indexOf('RFA')>=0?' (RFA)':'')+'.');(g.history=g.history||[]).push({year:seasonLabel(g),text:text,tag:type.indexOf('RFA')>=0?'RFA':'AI RE-SIGNING'});g.transactionLog=g.transactionLog||[];g.transactionLog.unshift({when:'June 30 · RE-SIGNING',text:text,teams:[teamId],tag:'RE-SIGNING'});g.transactionLog=g.transactionLog.slice(0,80);return true;}
  function enforceContractLimits(g){var max=maxContractAav(g),fixed=0;teams.forEach(function(t){var club=t.id===g.team?g:leagueClub(g,t.id);if(!club)return;(club.roster||[]).concat(club.reserveRoster||[]).forEach(function(p){if(!p)return;var hit=Number(p.capHit)||Number(p.salary)||0;if(hit>max&&(Number(p.years)>0||hasExtensionInPlace(p))){p.capHit=Math.min(Number(p.capHit)||max,max);p.salary=Math.min(Number(p.salary)||max,max);fixed++;}if(Array.isArray(p.contractTimeline))p.contractTimeline=p.contractTimeline.map(function(v){return typeof v==='number'&&v>max?max:v;});if(Number(p.extensionSalary)>max)p.extensionSalary=max;});});if(fixed)(g.history=g.history||[]).push({year:seasonLabel(g),tag:'CAP RULES',text:fixed+' contract'+(fixed===1?'':'s')+' above the 20% maximum ('+shortMoney(max)+') were reduced to the maximum.'});return fixed;}
  // Before the market opens (June 30 → July 1): refresh asks to the new cap, AI clubs qualify or
  // re-sign their RFAs (only marginal RFAs are left unqualified and become UFAs) and re-sign a share
  // of their own valuable UFAs. The user club's own players are never touched here.
  function aiPreMarketContracts(g){var off=g.offseason;if(!off||off.preMarketDone)return 0;off.preMarketDone=true;if(typeof seedCurrentFreeAgentMarket==='function')seedCurrentFreeAgentMarket(g);var year=off.year||'',done=0;faComputeLeagueScale(g);
    (g.freeAgents||[]).forEach(function(slot){var p=faSlotPlayer(g,slot);if(!p)return;var base=estimateFreeAgentAsk(p,g.cap);slot.baseAsk=slot.status==='RFA'?faRfaAsk(g,p,base):base;slot.ask=slot.baseAsk;});
    var rows=(g.freeAgents||[]).filter(function(s){return !s.external&&s.sourceTeam!==g.team;}).map(function(s){return {s:s,p:faSlotPlayer(g,s)};}).filter(function(x){return x.p;}).sort(function(a,b){return faValuePct(g,b.p)-faValuePct(g,a.p);});
    rows.forEach(function(x){var s=x.s,p=x.p,t=s.sourceTeam,club=leagueClub(g,t);if(!club)return;var pct=faValuePct(g,p),age=Number(p.age)||27,plan=club.plan||'retool',r=seededRandom('premarket|'+year+'|'+p.id)();
      if(s.status==='RFA'){var qo=faQualifyingOffer(g,p);if(!rfaWorthTender(g,p,qo)){s.status='UFA';p.freeAgencyStatus='UFA';p.contractStatus='Expired · UFA (not qualified)';s.notQualified=true;return;}
