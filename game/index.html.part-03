  }
  function simulateAiPlayoffChampion(g,field){var round=field.slice();while(round.length>1){var winners=[];for(var i=0;i<round.length;i+=2){var a=round[i],b=round[i+1],aw=0,bw=0,chance=Math.max(.27,Math.min(.73,.5+(ratingForTeam(g,a)-ratingForTeam(g,b))*.018));for(var n=0;n<7&&aw<4&&bw<4;n++){if(Math.random()<chance)aw++;else bw++;}winners.push(aw>bw?a:b);}round=winners;}return round[0]||null;}
  function initPlayoffs(g,makeFresh) {
    if(g.mode==='playoffs'&&!makeFresh){var other=teams.filter(function(t){return t.id!==g.team;}).map(function(t){return t.id;}),seeded=other.slice().sort(function(a,b){return ratingForTeam(g,a)-ratingForTeam(g,b);}).slice(-15),field=[g.team].concat(seeded),matches=[[g.team,seeded[0]]];for(var i=1;i<seeded.length;i+=2)matches.push([seeded[i],seeded[i+1]]);g.playoff={field:field,round:0,opponent:seeded[0],matches:matches,roundResults:[],complete:false,winner:null,series:[],champion:null};return g.playoff;}
    var bracket=playoffBracketFromStandings(g),userMatch=bracket.matches.find(function(match){return match.indexOf(g.team)>=0;});
    if(!userMatch){g.playoff={field:bracket.field,seeds:bracket.seeds,round:0,opponent:null,matches:[],roundResults:[],complete:false,winner:null,champion:null,notQualified:true,series:[]};var champion=v4fixFinishBracket(g,g.playoff,0,bracket.matches.slice());g.history.push({year:seasonLabel(g),text:team(g.team).name+' finishes outside the 16-team Stanley Cup Playoff field.',tag:'SEASON END'});if(champion)g.history.push({year:seasonLabel(g),text:team(champion).name+' wins the Stanley Cup after a simulated league playoff'+v4fixFinalText(g,g.playoff)+'.',tag:'STANLEY CUP'});beginOffseason(g);current.page='offseason';current.offseasonSection='overview';return g.playoff;}
    g.playoff={field:bracket.field,seeds:bracket.seeds,round:0,opponent:userMatch.find(function(id){return id!==g.team;}),matches:bracket.matches,roundResults:[],complete:false,winner:null,series:[],champion:null};
    if(makeFresh){g.stage='playoffs';g.roster.forEach(function(p){var wasHot=p.hot>=5,wasCold=p.cold>=5;p.hotAtSeasonEnd=p.hot;p.playoffMomentum=wasHot?1:(wasCold?-1:0);p.hot=0;p.cold=0;p.stamina=Math.max(65,p.stamina);});g.history.push({year:seasonLabel(g),text:'Playoff streak ledger reset. '+team(g.team).name+' enters the 16-team NHL bracket seeded by the standings.',tag:'POSTSEASON'});}
    return g.playoff;
  }
  function ratingForTeam(g,id) { return averageRating(clubRoster(g,id))||70; }
  function simPlayoffSeries(g,a,b){var ra=ensureStandingsRecord(g.standings&&g.standings[a]),rb=ensureStandingsRecord(g.standings&&g.standings[b]),aIce=(Number(ra.pts)||0)>(Number(rb.pts)||0)||((Number(ra.pts)||0)===(Number(rb.pts)||0)&&((Number(ra.rw)||0)>=(Number(rb.rw)||0))),pattern=[1,1,0,0,1,0,1],aw=0,bw=0,otGames=0,soGames=0,games=0;while(aw<4&&bw<4&&games<7){var aHome=aIce?pattern[games]===1:pattern[games]===0,box=simulateMatchup(g,a,b,aHome?a:b,false,{playoff:true});if((Number(box.a)||0)>(Number(box.b)||0))aw++;else bw++;if(box.ot)otGames++;if(box.so)soGames++;games++;}simSatOut.length=0;return {a:a,b:b,aWins:aw,bWins:bw,winner:aw>bw?a:b,otGames:otGames,soGames:soGames,games:games};}
  function simulatePlayoffRound(g) {
    if(!requireLegalUserRoster(g))return;
    var p=g.playoff||initPlayoffs(g,false); if(p.complete)return;
    var winners=[],roundResults=[],userResult=null;
    p.matches.forEach(function(match){var result=simPlayoffSeries(g,match[0],match[1]);winners.push(result.winner);roundResults.push(result);if(match[0]===g.team||match[1]===g.team)userResult=result;});
