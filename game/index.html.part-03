  function freeAgencyDateLabel(value){return new Date(value+'T12:00:00Z').toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'});}
  function freeAgentOfferScore(g,p,offer,ask){var interest=offer.team===g.team?freeAgentInterest(g,p).user:(Number((p.teamAffinity||{})[offer.team])||45),fit=offer.team===g.team?(g.philosophy==='win-now'&&p.preference==='Contender'?8:0):officePlan(g,offer.team)==='contend'&&p.preference==='Contender'?8:0;return (offer.salary/Math.max(1,ask))*58+Math.min(offer.years,7)*2+interest*.22+fit;}
  function completeFreeAgentSigning(g,id,offer){var slot=(g.freeAgents||[]).find(function(x){return x.playerId===id;});if(!slot||slot.status==='RFA'&&offer.team!==slot.sourceTeam)return false;var source=slot.external?(g.currentFreeAgentPool||[]):clubRoster(g,slot.sourceTeam),player=source.find(function(p){return p.id===id;});if(!player)return false;var sameClub=!slot.external&&slot.sourceTeam===offer.team,outgoingHit=sameClub?contractHit(player):0;offer=faNormalizeOffer(g,offer,sameClub);var v4s=v4fixContractSanity(g,player,offer.salary,offer.years,slot.status==='RFA'?'RFA':'UFA',offer.team);offer.salary=v4s.salary;offer.years=v4s.years;if(offer.team!==g.team&&(clubContractRosterCount(g,offer.team)>=23||capUsedClub(g,offer.team)-outgoingHit+offer.salary>g.cap))aiMakeRoom(g,offer.team,player,offer.salary-outgoingHit);if((!sameClub||offer.team!==g.team)&&clubContractRosterCount(g,offer.team)>=23||capUsedClub(g,offer.team)-outgoingHit+offer.salary>g.cap)return false;if(!ahlSigned(player)){var destClub=offer.team===g.team?g:leagueClub(g,offer.team);if(destClub&&ahlContractCount(destClub)>=AHL.CONTRACT_LIMIT)return false;}if(!sameClub){source.splice(source.indexOf(player),1);player.club=slot.sourceTeam;}if(offer.team===g.team&&g.payrollOn&&g.season===1&&g.payrollRef)g.capAdjustment+=offer.salary-outgoingHit;player.salary=offer.salary;player.capHit=offer.salary;player.years=offer.years;player.contractTimeline=Array.from({length:offer.years},function(){return offer.salary;});player.retainedPercent=0;player.contractExpired=false;player.contractStatus='Active';player.freeAgencyStatus='';player.contractType=slot.status==='RFA'?'RFA qualifying offer':'UFA signing';player.expiry='';player.club=offer.team;player.ufaDecisionDate=freeAgencyMarket(g).date;if(offer.team===g.team){if(!sameClub)g.roster.push(player);}else{var club=leagueClub(g,offer.team);if(club){if(!sameClub&&club.roster.indexOf(player)<0)club.roster.push(player);club.plan=club.plan||'retool';}}g.freeAgents=g.freeAg