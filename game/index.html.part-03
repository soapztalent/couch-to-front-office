  function liveGameSummary(g,log,ids){if(!log)return null;function nm(pid,clubId){if(!pid)return '';var roster=clubRoster(g,clubId)||[],p=roster.find(function(x){return x.id===pid;});return p?p.name:'';}
    var goals=log.goals.map(function(x){var c=ids[x.team],k=liveClock(x.t);return {t:x.t,period:k.period,clock:k.time,team:c,sit:x.sit,scorer:nm(x.scorer,c),a1:nm(x.a1,c),a2:nm(x.a2,c)};});
