  var simSatOut=[];
  function simHealClub(club){(club&&club.roster||[]).forEach(function(p){if(Number(p.injury)>0){p.injury--;if(p.injury<=0){p.injury=0;p.injuryLabel='';}p.stamina=Math.min(100,(Number(p.stamina)||80)+5);simSatOut.push(p);}});}
  function simInjuryLength(){var r=Math.random();if(r<.40)return {n:1+Math.floor(Math.random()*3),label:'day-to-day'};if(r<.72)return {n:4+Math.floor(Math.random()*7),label:'week-to-week'};if(r<.90)return {n:12+Math.floor(Math.random()*14),label:'IR'};return {n:28+Math.floor(Math.random()*35),label:'LTIR'};}
  function simInjureClub(g,id){var club=simV2Club(g,id);if(!club||!club.roster||Math.random()>=.12)return;var hurt=club.roster.filter(function(p){return Number(p.injury)>0;});if(hurt.length>=4)return;var healthy=club.roster.filter(function(p){return !(Number(p.injury)>0);});if(healthy.length<13)return;var pick=healthy[Math.floor(Math.random()*healthy.length)];if(pick&&pick.pos==='G'&&Math.random()<.6){var sk=healthy.filter(function(p){return p.pos!=='G';});if(!sk.length)return;pick=sk[Math.floor(Math.random()*sk.length)];}if(!pick)return;var spec=simInjuryLength();pick.injury=spec.n;pick.injuryLabel=spec.label;if(id===g.team)g.history.push({year:seasonLabel(g),text:pick.name+' is '+spec.label+' and is expected to miss about '+spec.n+' games.',tag:'MEDICAL'});}
