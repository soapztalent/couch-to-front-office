  function letterGrade(roster, pos) {
    var list = pos==='ALL' ? roster : roster.filter(function(p){ return pos==='G' ? p.pos==='G' : pos==='D' ? p.pos==='D' : p.pos!=='D' && p.pos!=='G'; });
    var n = averageRating(list.length ? list : roster);
    return n>=90?'A+':n>=86?'A':n>=82?'A-':n>=78?'B+':n>=74?'B':n>=70?'B-':'C+';
  }
  function chemistryScore(g) { var active=g.roster.filter(function(p){return p.injury===0&&p.pos!=='G';}); var morale=active.reduce(function(a,p){return a+p.morale;},0)/Math.max(1,active.length); var ready=active.reduce(function(a,p){return a+p.stamina;},0)/Math.max(1,active.length); var leaders=active.filter(function(p){return p.ovr>=82;}).length,cohesion=Math.min(8,Math.max(-8,(leaders-7)*1.2)); return clamp(Math.round(morale*.72+ready*.20+cohesion),20,100); }
