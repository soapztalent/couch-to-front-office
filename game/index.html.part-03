    pens.sort(function(){return rnd()-.5;});var wins=[];
    pens.forEach(function(pe){var t=null;for(var k=0;k<400&&t===null;k++){var per=Math.floor(rnd()*3),c=per*P+40+rnd()*(P-40-130);if(wins.every(function(w){return Math.abs(w.start-c)>=135;}))t=c;}if(t===null){for(var k2=0;k2<26&&t===null;k2++){var c2=(k2%3)*P+45+Math.floor(k2/3)*128;if(c2<(k2%3)*P+P-125&&wins.every(function(w){return Math.abs(w.start-c2)>=125;}))t=c2;}}if(t===null)t=wins.length?wins[wins.length-1].start+130:60;pe.start=Math.round(t);pe.end=pe.start+120;wins.push(pe);});
    wins.sort(function(a,b){return a.start-b.start;});
    var goals=[];sides.forEach(function(S,i){S.goalLog.forEach(function(ev){goals.push({team:i,sit:ev.emptyNet?'EN':ev.sit,late:!!ev.late,scorer:id(ev.shooter),a1:id(ev.a1),a2:id(ev.a2),onIce:ids(ev.onIce),against:ids(ev.against)});});});
