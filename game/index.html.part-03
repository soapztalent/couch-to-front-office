  function aiNeedLevel(ctx,p){var gr=aiGroup(p),n=ctx.needs;if(gr==='G')return n.G;if(gr==='D')return Math.max(n.D,shotHand(p)==='R'?n.DR:0);return Math.max(n.F,p.pos==='C'?n.C:0);}
