  function renderTrades(g) {
    var draft=prepareTradeDraft(g),opponent=leagueClub(g,draft.target),tm=team(draft.target),bosNeeds=clubNeeds(g,g.team),oppNeeds=clubNeeds(g,draft.target);
    var clubOptions=teams.filter(function(t){return t.id!==g.team;}).map(function(t){return '<option value="'+t.id+'" '+(t.id===draft.target?'selected':'')+'>'+esc(t.name)+'</option>';}).join('');
    var pickMarkup=function(id,side){return clubPicks(g,id).slice().sort(function(a,b){return a.year-b.year||a.round-b.round;}).map(function(p){var key=pickKey(p),selected=draft[side+'Picks'].indexOf(key)>=0;return '<button class="pick-chip '+(selected?'selected':'')+'" data-trade-pick="'+key+'" data-trade-side="'+side+'" aria-pressed="'+selected+'"><b>'+p.year+'</b><span>RD '+p.round+'</span></button>';}).join('')||'<span class="chart-empty">No draft picks held</span>';};
    var rosterMarkup=function(id,side){var roster=clubRoster(g,id),groups=[['FORWARDS',function(p){return p.pos==='C'||p.pos==='LW'||p.pos==='RW';}],['DEFENSE',function(p){return p.pos==='D';}],['GOALTENDERS',function(p){return p.pos==='G';}]];return groups.map(function(group){var players=roster.filter(group[1]).sort(function(a,b){return b.ovr-a.ovr;});return '<div class="depth-chart-group"><div class="depth-chart-label"><b>'+group[0]+'</b><span>'+players.length+' on roster</span></div><div class="depth-chart-rows">'+(players.map(function(p,i){var chosen=draft[side+'Players'].indexOf(p.id)>=0;return '<button class="depth-player-card '+(chosen?'selected':'')+'" data-trade-player="'+esc(p.id)+'" data-trade-side="'+side+'" aria-pressed="'+chosen+'"><span class="depth-slot">'+String(i+1).padStart(2,'0')+'</span><span class="depth-player-main"><strong>'+esc(p.name)+'</strong><small>'+esc(displayPlayerPosition(p))+' · AGE '+p.age+(p.tradeRequest?' · REQUEST':'')+'</small></span><span class="depth-rating">'+p.ovr+'<small>OVR</small></span><span class="depth-cap">'+shortMoney(contractHit(p))+'<small>'+p.years+' YR</small></span><span class="depth-add">'+(chosen?'−':'＋')+'</span></button>';}).join('')||'<span class="chart-empty">No players in this group</span>')+'</div></div>';}).join('');};
    var bosSelected=draft.userPlayers.map(function(id){return g.roster.find(function(p){return p.id===id;});}).filter(Boolean),oppSelected=draft.marketPlayers.map(function(id){return opponent.roster.find(function(p){return p.id===id;});}).filter(Boolean);
    var bosPickSelected=draft.userPicks.map(function(key){return clubPicks(g,g.team).find(function(p){return pickKey(p)===key;});}).filter(Boolean),oppPickSelected=draft.marketPicks.map(function(key){return clubPicks(g,draft.target).find(function(p){return pickKey(p)===key;});}).filter(Boolean);
    var bosSummary=tradeAssetSummary(g,g.team,bosSelected,bosPickSelected),oppSummary=tradeAssetSummary(g,draft.target,oppSelected,oppPickSelected);
    var retenA=Math.round(bosSummary.cap*Number(draft.retainUser||0)/100),retenB=Math.round(oppSummary.cap*Number(draft.retainMarket||0)/100),projectedA=capUsed(g)-bosSummary.cap+retenA+oppSummary.cap-retenB,projectedB=capUsedClub(g,draft.target)-oppSummary.cap+retenB+bosSummary.cap-retenA;
    var tx=(g.transactionLog||[]).slice(0,6),ai=(g.aiLog||[]).slice(0,5);
    var gmCards=teams.filter(function(t){return t.id!==g.team;}).map(function(t){var club=leagueClub(g,t.id);return '<button class="gm-grid-card" data-gm-target="'+t.id+'">'+logoMarkup(t.id,'team-logo')+'<span><strong>'+esc(t.name)+'</strong><small>'+planTitle(club.plan)+' · '+averageRating(club.roster)+' OVR · '+club.roster.length+' players</small><small>'+shortMoney(Math.max(0,g.cap-capUsedClub(g,t.id)))+' cap room · '+club.picks.length+' picks</small></span></button>';}).join('');
    $('office-content').innerHTML='<section class="panel market-intro"><div class="panel-head"><div><p class="section-kicker">NHL TRADE MARKET · '+esc(seasonLabel(g))+'</p><h2>Trade center</h2><p>Build a package from either club’s depth chart. Each GM weighs direction, cap room, position need, age, contract and draft value.</p></div><span class="small-badge">31 AI FRONT OFFICES</span></div><div class="trade-market-controls"><label>SELECT TRADE PARTNER<select class="inline-select" id="market-team">'+clubOptions+'</select></label><div class="market-gm-card">'+logoMarkup(draft.target,'mini-crest')+'<div><small>'+esc(tm.name.toUpperCase())+' · AI GENERAL MANAGER</small><strong>'+planTitle(opponent.plan)+'</strong><span>'+esc(planSummary(opponent.plan))+' · '+meanAge(opponent.roster)+' yr avg age</span></div></div><div class="market-needs"><span>NEEDS</span><strong>'+esc(oppNeeds.join(' · '))+('</strong></div></div><div class="market-summary"><div><small>'+team(g.team).name.toUpperCase()+' CAP HIT</small><strong>')+shortMoney(capUsed(g))+'</strong><span>'+shortMoney(Math.max(0,g.cap-capUsed(g)))+' room</span></div><i></i><div><small>'+esc(tm.id)+' CAP HIT</small><strong>'+shortMoney(capUsedClub(g,draft.target))+'</strong><span>'+shortMoney(Math.max(0,g.cap-capUsedClub(g,draft.target)))+' room</span></div><i></i><div><small>ROSTER COUNT</small><strong>'+g.roster.length+' / '+opponent.roster.length+('</strong><span>18–23 active players</span></div><i></i><div><small>'+team(g.team).name.toUpperCase()+' NEEDS</small><strong>')+esc(bosNeeds[0]||'Balanced')+'</strong><span>'+esc(bosNeeds.slice(1).join(' · ')||'No urgent gaps')+'</span></div></div></section><aside class="panel market-calibration-note"><strong>How to read market value</strong><p>Values are simulation estimates on a shared scale, not dollar prices or guarantees. Real returns depend on age, contract control, role, cap, buyer competition and timing.</p><p><b>Rumor, not a completed trade:</b> Daily Faceoff reported Philadelphia might consider an Owen Tippett offer around a first-round pick, a decent prospect and a mid-tier roster player. That is a reported asking framework, not evidence Boston made or completed that deal.</p></aside><div class="trade-depth-workspace"><section class="panel trade-depth-panel"><div class="depth-club-header"><div><p class="section-kicker">YOUR SIDE</p><h2>'+esc(team(g.team).name)+'</h2><span>'+g.roster.length+' players · '+g.userPicks.length+' picks available</span></div><b class="depth-team-mark">'+esc(team(g.team).id)+'</b></div><div class="depth-chart-scroll">'+rosterMarkup(g.team,'user')+'</div><div class="depth-picks"><div class="depth-chart-label"><b>FUTURE DRAFT PICKS</b><span>Tap to add or remove</span></div><div class="pick-board">'+pickMarkup(g.team,'user')+('</div></div><label class="retain-control">RETAINED BY '+team(g.team).name.toUpperCase()+'<select class="inline-select" id="retain-user">')+[0,10,20,30,40,50].map(function(n){return '<option value="'+n+'" '+(Number(draft.retainUser)===n?'selected':'')+'>'+n+'%</option>';}).join('')+('</select><small>Share of outgoing cap hit retained by '+team(g.team).name+'</small></label></section><section class="panel trade-depth-panel market-side"><div class="depth-club-header"><div><p class="section-kicker">TRADE PARTNER</p><h2>')+esc(tm.name)+'</h2><span>'+opponent.roster.length+' players · '+opponent.picks.length+' picks available</span></div><b class="depth-team-mark">'+esc(tm.id)+'</b></div><div class="depth-chart-scroll">'+rosterMarkup(draft.target,'market')+'</div><div class="depth-picks"><div class="depth-chart-label"><b>FUTURE DRAFT PICKS</b><span>GM keeps the assets it values</span></div><div class="pick-board">'+pickMarkup(draft.target,'market')+'</div></div><label class="retain-control">RETAINED BY '+esc(tm.id)+'<select class="inline-select" id="retain-market">'+[0,10,20,30,40,50].map(function(n){return '<option value="'+n+'" '+(Number(draft.retainMarket)===n?'selected':'')+'>'+n+'%</option>';}).join('')+('</select><small>Share of incoming '+team(g.team).name+' contract retained by ')+esc(tm.id)+('</small></label></section></div><section class="panel trade-offer-panel"><div class="offer-top"><div><p class="section-kicker">PROPOSED PACKAGE</p><h2>Trade value & cap impact</h2></div><span class="small-badge">'+team(g.team).name.toUpperCase()+' NEEDS: ')+esc(bosNeeds.join(' · '))+('</span></div><div class="offer-sides"><div><small>'+team(g.team).name.toUpperCase()+' SENDS</small><strong>')+bosSummary.names+'</strong><span>'+bosSummary.value+' market value · '+shortMoney(bosSummary.cap)+' current cap hit</span></div><b class="offer-arrows">⇄</b><div><small>'+esc(tm.id)+' SENDS</small><strong>'+oppSummary.names+'</strong><span>'+oppSummary.value+' market value · '+shortMoney(oppSummary.cap)+(' current cap hit</span></div></div><div class="projected-cap-row"><div><small>'+team(g.team).name.toUpperCase()+' PROJECTED CAP</small><strong>')+shortMoney(projectedA)+'</strong><span>'+shortMoney(g.cap-projectedA)+' room</span></div><div><small>TRADE PARTNER PROJECTED CAP</small><strong>'+shortMoney(projectedB)+'</strong><span>'+shortMoney(g.cap-projectedB)+' room</span></div></div><div class="offer-controls"><label>PROPOSED TRADE<select class="inline-select" id="trade-intent"><option value="deadline" '+(draft.intent==='deadline'?'selected':'')+'>Deadline upgrade</option><option value="contend" '+(draft.intent==='contend'?'selected':'')+'>Push for a championship</option><option value="rebuild" '+(draft.intent==='rebuild'?'selected':'')+'>Rebuild around youth and picks</option><option value="balance" '+(draft.intent==='balance'?'selected':'')+'>Improve roster balance</option></select></label><button class="button button-gold" data-action="propose-trade">Send offer to '+esc(tm.id)+' →</button></div><div class="trade-gm-meter-wrap">'+tradeAcceptanceMarkup(g,d)+'</div><div id="trade-result" class="trade-result">Select one or more players and picks on both sides, then send the package. The other GM will explain their decision.</div></section><div class="trade-log-grid"><section class="panel"><p class="section-kicker">TRANSACTION LOG</p><h2>League moves</h2><div class="market-log">'+(tx.length?tx.map(function(x){return '<article><time>'+esc(x.when)+'</time><span>'+esc(x.text)+'</span></article>';}).join(''):'<p class="panel-subtitle">Accepted player and pick trades will appear here.</p>')+'</div></section><section class="panel"><p class="section-kicker">AROUND THE LEAGUE</p><h2>AI GM activity</h2><div class="market-log">'+(ai.length?ai.map(function(x){return '<article><time>'+esc(x.when)+'</time><span>'+esc(x.text)+'</span></article>';}).join(''):'<p class="panel-subtitle">Other front offices review their plans and trade opportunities during the season.</p>')+'</div></section></div><details class="panel gm-strategy-details"><summary>See all 31 AI general managers and team plans</summary><p class="panel-subtitle">Plans respond to roster quality, age and the current standings. Rosters and draft assets change after league trades.</p><div class="gm-team-grid">'+gmCards+'</div></details>';
