  /* ===== IN-SEASON FREE AGENTS ===== */
  function inSeasonMarketDate(g){var cal=g.calendarGames||[],game=cal[Math.min(Number(g.day)||0,Math.max(0,cal.length-1))],d=game&&game.date?String(game.date).slice(0,10):'';if(!d){try{var est=officeEstimatedSchedule(g)||[],eg=est[Math.min(Number(g.day)||0,Math.max(0,est.length-1))];d=eg&&eg.date?String(eg.date).slice(0,10):'';}catch(e){d='';}}if(!/^\d{4}-\d{2}-\d{2}$/.test(d))d=((Number(g.startYear)||2026)+Math.max(0,(Number(g.season)||1)-1))+'-10-01';return d;}
  function inSeasonSigningOpen(g){return !g.offseason&&g.stage!=='playoffs'&&g.stage!=='complete'&&(Number(g.day)||0)<seasonGameCount(g);}
