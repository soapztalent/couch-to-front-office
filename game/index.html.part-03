    teams.forEach(function(t){if(t.id===g.team)return;var club=leagueClub(g,t.id);if(!club)return;var have=(club.roster||[]).filter(function(p){return faGroup(p)==='G'&&(Number(p.years)>0||hasExtensionInPlace(p));}).length;if(have>=2)return;
      var room=g.cap-capUsedClub(g,t.id),pool=(g.freeAgents||[]).filter(function(s){return s.status==='UFA'||s.external;}).map(function(s){return {s:s,p:faSlotPlayer(g,s)};}).filter(function(x){return x.p&&faGroup(x.p)==='G'&&(Number(x.p.age)||30)<=38;}).sort(function(a,b){return (Number(b.p.ovr)||0)-(Number(a.p.ovr)||0);});
