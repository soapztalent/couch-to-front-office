    // power-play goals end the minor
    goals.filter(function(x){return x.sit==='PP';}).forEach(function(x){var opts=wins.filter(function(w){return w.team!==x.team&&!w.ppGoal;});var w=opts[Math.floor(rnd()*opts.length)];if(!w){x.sit='ES';return;}w.ppGoal=x;var t=w.start+10;for(var k=0;k<40;k++){var c=w.start+8+rnd()*108;if(free(c,6)){t=c;break;}}x.t=Math.round(t);w.end=x.t;});
    goals.filter(function(x){return x.sit==='SH';}).forEach(function(x){var opts=wins.filter(function(w){return w.team===x.team&&w.end-w.start>12;}),clean=opts.filter(function(w){return x.onIce.indexOf(w.player)<0;});var w=(clean.length?clean:opts)[Math.floor(rnd()*(clean.length||opts.length))];if(!w){x.sit='ES';return;}if(x.onIce.indexOf(w.player)>=0){var S0=sides[x.team],alt=S0.skaters.filter(function(p){return x.onIce.indexOf(p.id)<0;});var np=alt[Math.floor(rnd()*alt.length)];if(np){var op=S0.skaters.find(function(p){return p.id===w.player;});if(op)bumpPlayerStat(op,'penaltyMinutes',-2);bumpPlayerStat(np,'penaltyMinutes',2);w.player=np.id;}}var t=w.start+5;for(var k=0;k<40;k++){var c=w.start+5+rnd()*(w.end-w.start-9);if(free(c,6)){t=c;break;}}x.t=Math.round(t);});
    function inWindow(t,pad){return wins.some(function(w){return t>=w.start-pad&&t<=w.end+pad;});}
    var late=goals.filter(function(x){return x.late||x.sit==='EN';}),cut=late.length?R-125:R-6;
    goals.filter(function(x){return x.sit==='ES'&&!x.late;}).forEach(function(x){var t=null;for(var k=0;k<300&&t===null;k++){var c=8+rnd()*(cut-8),pc=c%P;if(pc<6||pc>P-3)continue;if(!inWindow(c,3)&&free(c,k<200?25:6))t=c;}if(t===null){t=8+rnd()*(cut-8);}x.t=Math.round(t);});
    var pull=null;
    late.forEach(function(x,k){var c=R-70+rnd()*60;while(!free(c,8)&&c<R-3)c+=4;x.t=Math.min(R-2,Math.round(c));});
    var lateTie=late.find(function(x){return x.late;}),en=late.filter(function(x){return x.sit==='EN';}).sort(function(a,b){return a.t-b.t;})[0];
    goals.sort(function(a,b){return a.t-b.t;});
    var regGoals=goals.filter(function(x){return x.t<R;}),lastReg=regGoals.length?regGoals[regGoals.length-1].t:0;
    if(lateTie){pull={team:lateTie.team,t0:Math.max(R-110,lateTie.t-20-Math.round(rnd()*30)),t1:lateTie.t};}
    else if(en){pull={team:1-en.team,t0:Math.max(R-110,en.t-12-Math.round(rnd()*30)),t1:en.t};}
    else{var a=0,b=0;regGoals.forEach(function(x){if(x.team===0)a++;else b++;});var d=a-b;if(!o.ot&&Math.abs(d)>=1&&Math.abs(d)<=2){var t0=Math.round(R-55-rnd()*40);if(t0>lastReg+15)pull={team:d>0?1:0,t0:t0,t1:R};}}
    if(pull){var pb=goals.filter(function(x){return x.sit==='ES'&&!x.late&&x.t<R&&x.t>=pull.t0&&x.t<pull.t1;});pb.forEach(function(x){x.t=Math.max(10,pull.t0-15-Math.round(rnd()*30));});}
    if(o.ot&&o.otSec&&!o.so){var og=goals.filter(function(x){return x.sit==='OT';})[0];if(og)og.t=R+Math.max(5,Math.round(o.otSec));}
    goals.forEach(function(x){if(x.t==null)x.t=Math.round(30+rnd()*(R-60));});
    goals.sort(function(a,b){return a.t-b.t;});
    var names=['Hooking','Tripping','Slashing','Holding','Interference','Roughing','High-sticking','Cross-checking','Holding the stick'],nw=[20,18,14,12,11,9,7,6,3];
    wins.forEach(function(w){var r=rnd()*100,k=0;while(k<nw.length-1&&r>nw[k]){r-=nw[k];k++;}w.infraction=names[k];if(w.ppGoal){w.ppGoalTime=w.ppGoal.t;delete w.ppGoal;}});
