  }
  function saveCanOpen(g){if(!g||!Array.isArray(g.roster)||!g.roster.length)return false;var v=g.version;if(v==null||v==='')return true;return /^0\.[456]$/.test(String(v));}
  function openLoadedGame(g,message){
    if(!saveCanOpen(g)){setNotice('That save could not be opened. Choose a v0.4, v0.5 or v0.6 franchise export.',true);return false;}
    var compactSave=g.saveFormat===SAVE_FORMAT,syncStatus=g.nhlStatsSyncStatus,syncError=g.nhlStatsSyncError;try{rehydrateSavedGame(g);current.selected=g.team||'BOS';current.game=upgradeGame(g);}catch(e){current.game=null;console.error('openLoadedGame',e);setNotice('That save could not be opened ('+(e&&e.message||e)+').',true);return false;}if(compactSave&&current.game){current.game.nhlStatsSyncStatus=syncStatus;current.game.nhlStatsSyncError=syncError;}current.page='overview';current.tradeDraft=null;selectTeam(g.team);try{setScreen('office');renderOffice();}catch(e){console.error('openLoadedGame',e);setNotice('The save opened, but the office could not be drawn ('+(e&&e.message||e)+').',true);return true;}persist();setNotice(typeof message==='function'?message(g):message);return true;
  }
  /* ===== END SAVE SYSTEM V2 ===== */
  function start(mode,payrollOn) {
    current.mode=mode; current.tradeDraft=null; current.orgTeam=current.selected;current.orgTab='depth';current.game=freshGame(current.selected,mode,payrollOn); current.page='overview'; setScreen('office'); $('top-season').textContent=seasonLabel(current.game)+' SEASON'; renderOffice(); persist();
  }
  /* ===== LEAGUE YEAR / CAP ROLLOVER (July 1) ===== */
  // Contracts that ran out at season's end (contractExpired, no years left) keep counting at their
  // expiring cap hit until the new league year opens with free agency; then they come off the books
  // and the new season's cap ceiling applies.
  function leagueYearPending(g){return !!(g&&g.stage==='offseason'&&g.offseason&&!g.offseason.leagueYearOpened);}
