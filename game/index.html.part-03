  function simHomeGames(g,id){var rec=g.standings&&g.standings[id],n=0;if(!rec||!rec.headToHead)return 0;Object.keys(rec.headToHead).forEach(function(opp){var games=rec.headToHead[opp]&&rec.headToHead[opp].games||[];games.forEach(function(x){if(x&&x.home)n++;});});return n;}
