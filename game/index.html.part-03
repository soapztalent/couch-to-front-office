    if(g.day>=seasonGameCount(g)){completeRegularSeason(g);return;}
    ensureLineup(g);updateRoleMorale(g);Object.keys(g.leagueTeams||{}).forEach(function(id){var club=g.leagueTeams[id];ensureLineup(club);updateRoleMorale(club);});var opponent=g.schedule[g.day],activeIds=[];g.lines.forwards.forEach(function(line){['LW','C','RW'].forEach(function(pos){if(line[pos])activeIds.push(line[pos]);});});g.lines.defense.forEach(function(pair){['LD','RD'].forEach(function(pos){if(pair[pos])activeIds.push(pair[pos]);});});var activeSkaters=activeIds.map(function(id){return g.roster.find(function(p){return p.id===id;});}).filter(function(p){return p&&p.injury===0;});if(activeSkaters.length<12)activeSkaters=activeSkaters.concat(g.roster.filter(function(p){return p.pos!=='G'&&p.injury===0&&activeSkaters.indexOf(p)<0;}).sort(function(a,b){return b.ovr-a.ovr;}).slice(0,12-activeSkaters.length));var homeRating=averageRating(activeSkaters);var awayRating=ratingForTeam(g,opponent);var readiness=activeSkaters.reduce(function(a,p){return a+p.stamina;},0)/Math.max(1,activeSkaters.length);var starter=g.roster.find(function(p){return p.id===g.lines.goalies[0]&&p.injury===0;});var goalie=starter||g.roster.filter(function(p){return p.pos==='G'&&p.injury===0;}).sort(function(a,b){return b.ovr-a.ovr;})[0];
    var coachBonus=g.coach.system==='attack'?.18:g.coach.system==='defense'?.05:0;var diff=(homeRating-awayRating)*.035+(chemistryScore(g)-70)*.02+(readiness-80)*.008+coachBonus;
    var goalieBonus=goalie?(goalie.ovr-80)*.025:0;
    var scheduledGame=(g.calendarGames||[])[g.day],userHome=scheduledGame?scheduledGame.venue==='HOME':g.day%2===0,gameDate=scheduledGame&&scheduledGame.date||officeEstimatedSchedule(g)[g.day].date,beforeUser=snapshotGameStats(g,g.team),beforeOpponent=snapshotGameStats(g,opponent),box=simulateMatchup(g,g.team,opponent,userHome?g.team:opponent,true),score=box.a,against=box.b;
    var wentOvertime=box.ot,endedByShootout=box.so;
