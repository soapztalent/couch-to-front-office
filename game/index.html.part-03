    if(id===g.team){var s=g.lineStrategy||{};
      if(s.offensive==='Shoot first'){out.shots*=1.06;out.quality*=.95;}else if(s.offensive==='Possession'){out.shots*=.95;out.quality*=1.05;}else if(s.offensive==='Crash the net'){out.shots*=1.02;out.quality*=1.03;out.drawn*=1.05;}
      if(s.forecheck==='2-1-2'){out.shots*=1.03;out.oppShots*=1.02;}else if(s.forecheck==='1-1-3'){out.shots*=.97;out.oppShots*=.96;}
      if(s.defensive==='Tight point'){out.oppShots*=.97;out.oppQuality*=1.02;}else if(s.defensive==='Protect slot'){out.oppShots*=1.03;out.oppQuality*=.95;}
      if(s.neutral==='1-3-1'){out.shots*=.98;out.oppShots*=.97;}else if(s.neutral==='2-1-2'){out.shots*=1.02;out.oppShots*=1.02;}}
