  function aiContractBurden(p){var over=(contractHit(p)-aiFairHit(p.ovr)-AI_TRADE.OVERPAY_SLACK)/1000000,yrs=Math.max(0,(Number(p.years)||0)-1);return over>0?over*yrs*AI_TRADE.BURDEN_PER_M_YEAR*(Number(p.age)>=32?1.3:1):0;}
