  }
  function developOrganization(g) {
    function develop(club,isUser) {
      var seen={};
      (club.orgProspects||[]).concat(club.reserveRoster||[]).forEach(function(p){
        if(seen[p.id])return;seen[p.id]=true;
        var previousEta=estimateNhlEta(p,g.startYear+g.season);progressPlayerOffseason(p,isUser?g.team:(p.club||club.id||''),g);
        p.etaYear=Math.max(g.startYear+g.season+1,previousEta-(p.ovr>=75&&Math.random()<.36?1:0));
        p.level=prospectStage(p,g.startYear+g.season+1);p.stamina=95;p.simulatedDevelopment=true;
      });
    }
    develop(g,true);Object.keys(g.leagueTeams||{}).forEach(function(id){develop(g.leagueTeams[id],false);});
  }
  function restoreRosterDepth(g,clubId,club){
    if(!club)return 0;
    club.roster=club.roster||[];club.reserveRoster=club.reserveRoster||[];club.orgProspects=club.orgProspects||[];
    var promoted=0,target=23,pool=club.reserveRoster.concat(club.orgProspects).filter(function(p,i,a){return p&&a.findIndex(function(x){return x.id===p.id;})===i;}).sort(function(a,b){return (Number(b.ovr)||0)-(Number(a.ovr)||0)||Number(a.age)-Number(b.age);});
    while(club.roster.length<target&&pool.length){
      var index=pool.findIndex(function(p){var needsContract=p.unsigned||!p.years||p.years<=0,hit=needsContract?925000:contractHit(p);return capUsedClub(g,clubId)+hit<=g.cap;});
      if(index<0)break;
      var p=pool.splice(index,1)[0],needsContract=p.unsigned||!p.years||p.years<=0,hit=needsContract?925000:contractHit(p);
      club.reserveRoster=club.reserveRoster.filter(function(x){return x.id!==p.id;});club.orgProspects=club.orgProspects.filter(function(x){return x.id!==p.id;});
      if(needsContract){p.salary=hit;p.capHit=hit;p.years=3;p.term=3;p.contractTimeline=[hit,hit,hit];p.contractType='Entry-level call-up';p.contractSource='Franchise development system';p.unsigned=false;}
      p.club=clubId;p.reserveList=false;p.rosterStatus='Active roster · development call-up';club.roster.push(p);promoted++;
    }
    if(clubId===g.team&&promoted)ensureLineup(g);
    return promoted;
  }
  function promoteProspect(g,id) {
    var p=(g.orgProspects||[]).concat(g.reserveRoster||[]).find(function(x){return x.id===id;});if(!p)return;
    if(g.roster.length>=23)return setNotice(team(g.team).name+' needs an active roster opening.',true);
    var deal=userCallUpDeal(g,p);if(!deal.ok)return setNotice(deal.notice,true);
    g.orgProspects=(g.orgProspects||[]).filter(function(x){return x.id!==id;});
    g.reserveRoster=(g.reserveRoster||[]).filter(function(x){return x.id!==id;});
    applyUserCallUpDeal(p,deal);
    capRefRecall(g,p,deal.salary);
    p.unsigned=false;p.reserveList=false;p.rosterStatus='Active NHL roster';p.club=g.team;p.promotedYear=g.startYear+g.season;
    g.roster.push(p);ensureLineup(g);g.history.push({year:seasonLabel(g),text:team(g.team).name+' promotes '+p.name+' to the active roster'+(deal.fresh?' on a '+deal.years+'-year league-minimum contract.':'.'),tag:'PLAYER DEVELOPMENT'});
    persist();renderOffice();setNotice(p.name+' joined the active roster. Any new contract uses the simulator rules.');
  }
  function nhlGroup(p){return !p?'F':p.pos==='G'?'G':p.pos==='D'?'D':'F';}
  function nhlGroupCount(list,grp){return (list||[]).filter(function(p){return nhlGroup(p)===grp;}).length;}
  function nhlGroupMin(grp){return grp==='G'?2:grp==='D'?6:12;}
  function userSendDownBlock(g,player){var grp=nhlGroup(player),have=nhlGroupCount(g.roster,grp),min=nhlGroupMin(grp);if(have<=min)return grp==='G'?'Keep at least 2 goalies on the NHL roster.':grp==='D'?'Keep at least 6 defensemen on the NHL roster.':'Keep at least 12 forwards on the NHL roster.';var skaters=(g.roster||[]).filter(function(p){return p.pos!=='G'&&p.id!==player.id;}).length,goalies=nhlGroupCount(g.roster,'G')-(grp==='G'?1:0);if(goalies<1||skaters<6)return 'That assignment would leave a lineup that cannot play.';return '';}
  function userCallUpDeal(g,p){
