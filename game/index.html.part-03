    function grabTeam(id){var s=ensureSeasonTeamStats(g,id),o={};teamKeys.forEach(function(k){o[k]=Number(s[k])||0;});return o;}
    var playoffSnap=playoff?{a:grabPlayers(clubA.roster),b:grabPlayers(clubB.roster),ta:grabTeam(idA),tb:grabTeam(idB)}:null;
    var sides=[LA,LB],strat=[simV2Strategy(g,idA),simV2Strategy(g,idB)],home=[homeId===idA?1:0,homeId===idB?1:0];
    sides.forEach(function(S,i){S.toi={};S.es={};S.ppT={};S.shT={};S.stamina=S.skaters.reduce(function(n,p){return n+(Number(p.stamina)||88);},0)/Math.max(1,S.skaters.length);S.events=[];S.shots=0;S.goals=0;S.xg=0;S.goalieSA=0;S.goalieGA=0;S.ppGoals=0;S.shGoals=0;S.idx=i;S.shotLog=[];S.goalLog=[];S.penLog=[];S.hitLog=[];S.blockLog=[];});
    // penalties / power plays
    var opps=[0,1].map(function(i){return simV2Poisson(SIMV2.ppOppsPerTeam*strat[i].drawn*(1+home[i]*.03-home[1-i]*.03));});
    var ppSec=[opps[0]*SIMV2.ppSecondsPerOpp,opps[1]*SIMV2.ppSecondsPerOpp],esSec=Math.max(40*60,3600-ppSec[0]-ppSec[1]);
