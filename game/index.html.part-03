    if(row.age)player.age=Number(row.age);if(row.potential!=null)player.potential=Number(row.potential);if(row.years!=null)player.years=Number(row.years);
    if(row.salary!=null){player.salary=Number(row.salary);player.capHit=Number(row.salary);}if(row.contractType)player.contractType=row.contractType;if(row.expiry)player.expiry=row.expiry;if(row.rosterStatus)player.rosterStatus=row.rosterStatus;if(row.shoots)player.shoots=row.shoots;if(row.tradeProtection)player.tradeProtection=row.tradeProtection;
