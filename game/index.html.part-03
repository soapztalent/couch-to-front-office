      g.orgStateLog.rows.push([date,kind,id,standing,rosterPct[id],w,score,band,Math.round(coreAge*10)/10,poolPct[id],f.young?1:0,f.old?1:0,f.fading?1:0,candidate,role,capTrouble?1:0,Math.round(space)]);
