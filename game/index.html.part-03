    rec.gf+=score-(endedByShootout&&score>against?1:0);rec.ga+=against-(endedByShootout&&against>score?1:0);
    g.owner.trust=clamp(g.owner.trust+(won?1:-1),25,99);
    if(won&&g.record.w%5===0){g.media.push({tag:'PRESS',text:team(g.team).name+' earns praise for its compete level. The room is responding to the staff.',morale:chemistryScore(g)});}
    g.roster.forEach(function(p){if(p.morale<30&&Math.random()<.08)p.tradeRequest=true;if(p.morale>55)p.tradeRequest=false;});
    var result=team(g.team).id+' '+score+' – '+against+' '+opponent;
    g.results.push({day:g.day,opponent:opponent,score:score,against:against,result:result,won:won});
    g.history.push({year:seasonLabel(g),text:'Game '+g.day+': '+team(g.team).name+' '+score+'–'+against+' '+team(opponent).name+'. '+recordText(rec)+' ('+rec.pts+' pts).',tag:'GAME '+g.day});
    var headline=won?(''+team(g.team).name+' wins ')+score+'–'+against+' over '+team(opponent).name+'.': (''+team(g.team).name+' falls ')+score+'–'+against+' to '+team(opponent).name+'.';
    if(streakAlerts.length)headline+=' '+streakAlerts.slice(0,2).join(' ');
    if(g.day===seasonGameCount(g)){headline+=' Regular season complete.';recordSeasonAwards(g);}
    if(g.day>=seasonGameCount(g)&&g.mode==='franchise')g.stage='regular';
    if(g.day>=seasonGameCount(g)&&g.mode==='season')g.stage='complete';
    var finalUser=gameStatDelta(g,g.team,beforeUser),finalOpponent=gameStatDelta(g,opponent,beforeOpponent);g.latestBoxScore={date:gameDate,home:userHome?g.team:opponent,away:userHome?opponent:g.team,userTeam:g.team,opponent:opponent,score:score,against:against,ot:wentOvertime,so:endedByShootout,user:finalUser,opponentStats:finalOpponent,won:won,summary:liveGameSummary(g,box.log,[g.team,opponent])};liveGameLog={log:box.log,day:g.day,teams:[g.team,opponent]};/* v6: weekly AI GM tick after the box score is final */aiWeeklyGmTick(g,gameDate);if(!quiet){persist();renderOffice();setNotice(headline,!won);if(showBoxScore!==false)officeOpenModal('game-boxscore');}
  }
  function clamp(n,min,max){return Math.max(min,Math.min(max,n));}
  function completeRegularSeason(g) { if(g.day>=seasonGameCount(g)){if(g.mode==='franchise')g.stage='playoffs';else g.stage='complete';} }
  function recordSeasonAwards(g){if(g.awardsGenerated)return;g.awardsGenerated=true;g.awards=g.awards||[];var league=teams.reduce(function(all,t){return all.concat(clubRoster(g,t.id).map(function(p){return {player:p,team:t.id};}));},[]),skaters=league.filter(function(x){return x.player.pos!=='G';}),goalies=league.filter(function(x){return x.player.pos==='G';}),scoring=skaters.slice().sort(function(a,b){return (b.player.points||0)-(a.player.points||0);}),goals=skaters.slice().sort(function(a,b){return (b.player.goals||0)-(a.player.goals||0);}),defense=skaters.filter(function(x){return x.player.pos==='D';}).sort(function(a,b){return (b.player.points||0)+(b.player.ovr||0)*.35-((a.player.points||0)+(a.player.ovr||0)*.35);}),rookies=skaters.filter(function(x){return v4fixIsRookie(g,x.player);}).sort(function(a,b){return (b.player.points||0)-(a.player.points||0);}),keeper=v4fixVezinaRank(g,goalies),hart=v4fixHartRank(g,skaters),awards=[['Hart Memorial Trophy',hart[0],v4fixHartLine(g,hart[0])],['Art Ross Trophy',scoring[0],(scoring[0]&&scoring[0].player.points||0)+' points'],['Rocket Richard Trophy',goals[0],(goals[0]&&goals[0].player.goals||0)+' goals'],['James Norris Memorial Trophy',defense[0],(defense[0]&&defense[0].player.points||0)+' points · '+(defense[0]&&defense[0].player.ovr||0)+' sim OVR'],['Vezina Trophy',keeper[0],v4fixGoalieLine(g,keeper[0])],['Calder Memorial Trophy',rookies[0],v4fixCalderLine(g,rookies[0])]];awards.forEach(function(item){if(!item[1])return;var p=item[1].player,entry={year:seasonLabel(g),name:item[0],winner:p.name,team:item[1].team,stat:item[2],simulation:true};g.awards.push(entry);g.history.push({year:seasonLabel(g),text:p.name+' of the '+team(item[1].team).name+' wins the simulated '+item[0]+' with '+item[2]+'.',tag:'LEAGUE TROPHY'});});v4fixRecordCareer(g);}
  function tradeDeadlineISO(g){var year=Number(g.startYear)+Number(g.season)-1+1,first=new Date(Date.UTC(year,2,1));first.setUTCDate(1+((5-first.getUTCDay()+7)%7));return first.toISOString().slice(0,10);}
  function deadlineEnsurePicks(g,year){var all=(g.userPicks||[]).concat.apply((g.userPicks||[]),Object.keys(g.leagueTeams||{}).map(function(id){return g.leagueTeams[id].picks||[];}));teams.forEach(function(t){var club=t.id===g.team?g:leagueClub(g,t.id);if(!club)return;var inventory=t.id===g.team?(g.userPicks||(g.userPicks=[])):(club.picks||(club.picks=[]));for(var round=1;round<=3;round++){var exists=all.some(function(p){return Number(p.year)===year&&Number(p.round)===round&&(p.origin||p.team)===t.id;});if(!exists){var pick={id:t.id+'-'+year+'-'+round,origin:t.id,team:t.id,year:year,round:round};inventory.push(pick);all.push(pick);}}});}
  /* ===== AI TRADE MARKET v5 (trades-fix) =====
     Org state is the master switch for every AI club. Each AI GM re-evaluates its roster every 7 calendar
     days (in season and through the free-agency window), plus extra checkpoint evaluations at the trade
     deadline, the draft and July 1. Every evaluation recomputes org state, positional needs, surplus,
     cap situation and trade intent, and only then tries trades. All tuning constants live in AI_ORG / AI_TRADE. */
  var AI_ORG={
    STAND_W_START:.30,STAND_W_DEADLINE:.80,OFFSEASON_STAND_W:.35,   // standings weight ramp (roster weight = 1 - this)
    LEAGUE_PACE:1.12,PACE_PRIOR_GP:8,PLAYOFF_SPOTS:8,MIN_SPREAD:10,   // standings projection / normalization
    CORE_F:6,CORE_D:4,CORE_G:1,G_WEIGHT:2,                            // top-end strength sample
    // Six roles. The weekly blended score picks a band; core age and prospect pool pick the role inside the low bands:
    //   score >= T_WIN_NOW -> WIN_NOW | >= T_CONTENDER -> CONTENDER | >= T_BUBBLE -> BUBBLE (RETOOL if old core and fading)
    //   >= T_LOW -> YOUTH_MOVEMENT if young core / elite pool, else RETOOL | < T_LOW -> YOUTH_MOVEMENT if young, else REBUILD
    T_WIN_NOW:76,T_CONTENDER:60,T_BUBBLE:46,T_LOW:28,BUFFER:3,CONFIRM:3,  // score bands + hysteresis (3-pt buffer; a role change needs 3 straight evaluations)
    YOUNG_CORE_AGE:27.5,                                              // core (top 6F/4D/1G) average age at or below this = young core
    STRONG_POOL_PCT:90,STRONG_POOL_MAX_CORE_AGE:29.5,                 // elite prospect pool (league percentile) also counts as young, unless the core is very old
    OLD_CORE_AGE:29.5,FADING_STAND:42,FADING_MIN_WEIGHT:.5,          // BUBBLE-band club with an old core whose standings are fading -> RETOOL
    CAP_TROUBLE_SPACE:1000000,                                        // overlay flag: space below this or over the cap
    EVAL_DAYS:7,LOG_ROWS:1500
  };
  var AI_TRADE={
    WEEKLY_MAX:2,WEEKLY_FIRST_DAY:20,DEADLINE_MAX:10,DRAFT_MAX:6,JULY1_MAX:5,OFFSEASON_WEEKLY_MAX:1,
    TEAM_SEASON_MAX:4,DEADLINE_EXTRA_TRADES:2,TEAM_COOLDOWN_DAYS:14,
    P_WEEKLY:{WIN_NOW:.12,CONTENDER:.08,BUBBLE:.05,RETOOL:.07,REBUILD:.08,YOUTH_MOVEMENT:.03,CAP:.35,FLOOR:.25},
    P_DEADLINE:{WIN_NOW:1,CONTENDER:1,BUBBLE:.75,RETOOL:.9,REBUILD:1,YOUTH_MOVEMENT:.35,CAP:1,FLOOR:.8},
    P_DRAFT:{WIN_NOW:.7,CONTENDER:.6,BUBBLE:.35,RETOOL:.6,REBUILD:.8,YOUTH_MOVEMENT:.25,CAP:1,FLOOR:.3},
    P_JULY1:{WIN_NOW:.5,CONTENDER:.45,BUBBLE:.35,RETOOL:.5,REBUILD:.5,YOUTH_MOVEMENT:.3,CAP:.9,FLOOR:0},
    DEADLINE_PASSES:2,DRAFT_PASSES:2,PAIR_TRIES:5,DEADLINE_PAIR_TRIES:8,
    P_OFF_WEEKLY:{WIN_NOW:.06,CONTENDER:.05,BUBBLE:.04,RETOOL:.05,REBUILD:.05,YOUTH_MOVEMENT:.03,CAP:.25,FLOOR:0},
    MARGIN:.03,MIN_GAIN:2,NEUTRAL_MIN:.75,NEUTRAL_MAX:1.33,DUMP_GOOD_PLAYER:80,DUMP_NEUTRAL_MIN:.45,DUMP_CORE_SKATERS:9,   // cap dumps skip the neutral band; the dumper's own cap-relief value caps the sweetener
    
    CAP_RELIEF_PER_M:9,TIGHT_RELIEF_PER_M:3,FLOOR_VALUE_PER_M:5,
    MIN_F:12,MIN_D:6,MIN_G:2,OFFSEASON_FLOOR_SLACK:15000000,  // offseason: floor is enforced at FA close (FA code); trades may not sink a club more than this below it
    MAX_ROSTER:23,MIN_ROSTER:18,MAX_ASSETS:3,POOL_SIZE:12,
    W_PICK:{WIN_NOW:.70,CONTENDER:.85,BUBBLE:1.05,RETOOL:1.10,REBUILD:1.30,YOUTH_MOVEMENT:1.30},
    // Prospects (reserve/AHL list + unsigned draft rights, age <= 23). Value = potential curve x age/readiness factor x acquiring role.
    W_PROSPECT:{WIN_NOW:.70,CONTENDER:.85,BUBBLE:.90,RETOOL:1.05,REBUILD:1.25,YOUTH_MOVEMENT:1.30},REBUILD_BLUECHIP_BONUS:.10,
    PROSPECT_POT_BASE:55,PROSPECT_POT_EXP:1.6,PROSPECT_AGE_FACTOR:.65,PROSPECT_AGE_STEP:.05,PROSPECT_READY_BONUS:.10,
    PROSPECT_MAX_AGE:25,BLUE_CHIP_POT:85,CONTENDER_PROTECT_BLUECHIPS:2,REBUILD_PROTECT_POT:80,REBUILD_PROTECT_TOP:3,
    RETOOL_SURPLUS_SAME_POS:2,RETOOL_SURPLUS_F:4,RETOOL_SURPLUS_D:3,YOUTH_PROTECT_TOP:4,BUBBLE_PROTECT_TOP:2,
    // Role-specific shopping lists
    BUBBLE_RENTAL_MAX_YEARS:1,BUBBLE_RENTAL_MAX_HIT:4000000,BUBBLE_KEEPS_FIRSTS:true,   // BUBBLE: cheap rentals only; never trades 1st-round picks or top-2 prospects
    RETOOL_TARGET_MIN_AGE:22,RETOOL_TARGET_MAX_AGE:26,RETOOL_SELL_AGE:28,              // RETOOL: sells vets / pending UFAs, buys NHL-ready 22-26
    YOUTH_VET_MIN_AGE:28,YOUTH_VET_MAX_YEARS:2,YOUTH_VET_MAX_HIT:3500000,YOUTH_KEEP_ROUNDS:2,YOUTH_SELL_AGE:29, // YOUTH_MOVEMENT: cheap short vets in, keeps 1st/2nd-round picks, rarely sells
    ROLE_BUY_MIN_OVR:{WIN_NOW:78,CONTENDER:78,BUBBLE:76,RETOOL:76,YOUTH_MOVEMENT:76,REBUILD:99},
    DEADLINE_CURRENCY_DISCOUNT:.90,          // contenders value their own non-elite prospects lower when spending them at the deadline
    PREF_PROSPECT_CURRENCY:6,PREF_REBUILD_FUTURE:9,PREF_REBUILD_VET_PENALTY:8,
    // Neutral market scale for NHL players: the game's basePlayerValue, made steeper by rating tier,
    // minus a multi-year burden for contracts that pay well above what the rating is worth.
    TIER_UP:.04,TIER_DOWN:.03,TIER_FLOOR:.4,FAIR_HIT_BASE:800000,FAIR_HIT_K:90000,FAIR_HIT_EXP:1.7,OVERPAY_SLACK:500000,BURDEN_PER_M_YEAR:2.5,
    REBUILD_NO_VET_AGE:28,REBUILD_NO_VET_HIT:3000000,
    // Loyalty soft no-trade (V4LOYAL): when true, players for whom isLoyalToOrg(g,p,teamId) is true (8+ straight seasons)
    // are protected from AI trades. OFF by default; the user decides. No effect when the loyalty patch is absent.
    // Loyalty soft no-trade (V4LOYAL, ON): a player for whom isLoyalToOrg(g,p,currentTeam) is true (8+ straight seasons)
    // is shopped by his own club only LOYAL_SHOP_CHANCE of the time (per evaluation), and when shopped his club values him
    // x LOYAL_KEEP_MULT, so it needs a clearly lopsided return (~+40%). The neutral-value band stretches by the same factor
    // so such a deal can still clear. No effect when the loyalty patch is absent (isLoyalToOrg undefined).
    LOYAL_SOFT_NO_TRADE:true,LOYAL_KEEP_MULT:1.40,LOYAL_SHOP_CHANCE:.40
  };
  // Contract status (RFA / UFA / signed / extension) in trade value. Status itself is read from the game, never written:
  // playerFreeAgencyStatus() (explicit freeAgencyStatus/expiry text from the contract data wins; otherwise UFA at age 27+
  // or 7+ pro seasons), faQualifyingOffer(), rfaWorthTender(), faMarketValue() and v4fixContractSanity()'s RFA caps.
  // The game has no arbitration or offer sheets, so the RFA discount is modelled by the game's own RFA pricing
  // (extension ask = max(QO, UFA market x .88), capped by the RFA share-of-cap table) instead of open-market UFA pricing.
  var AI_CONTRACT_STATUS={
