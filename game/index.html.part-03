    function def(p){return (Number(p.ovr)||70)+simV2AttrDev(p,'defense')/2+(p.pos==='D'?4:0)+(p.pos==='C'?1.5:0);}
    var pp1=unit(st.pp54,5,off,null,null),pp2=unit(null,5,off,pp1,{F:4,D:1}),pk1=unit(st.pk54,4,def,null,null),pk2=unit(null,4,def,pk1.concat(skaters.filter(simV2IsF).sort(function(a,b){return b.ovr-a.ovr;}).slice(0,3)),{F:2,D:2});
