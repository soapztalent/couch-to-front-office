    var a=player.attributes||{};Object.keys(row.attributes||{}).forEach(function(k){var v=row.attributes[k];if(k==='acceleration')a.acceleration=v;else if(k==='speed')a.speed=v;else if(k==='deking')a.deking=v;else if(k==='passing')a.passing=v;else if(k==='slapshotAccuracy'||k==='slapshotPower'||k==='wristshotAccuracy'||k==='wristshotPower')a.shooting=v;else if(k==='defensiveAwareness'||k==='shotBlocking'||k==='stickChecking')a.defense=v;else a[k]=v;});var shots=['slapshot','wristshot'].map(function(k){return Number((row.attributes||{})[k]);}).filter(Number.isFinite);if(shots.length)a.shooting=Math.round(shots.reduce(function(n,v){return n+v;},0)/shots.length);
    if(a.acceleration!=null||a.speed!=null)a.skating=Math.round(((a.acceleration||a.skating)+(a.speed||a.skating))/2);if(a.deking!=null||a.passing!=null)a.puck=Math.round(((a.deking||a.puck)+(a.passing||a.puck))/2);player.attributes=a;
