    for(var i=0;i<intents.length&&deals.length<max;i++){var it=intents[i],x=it.ctx;if(x.__done)continue;var found=null;diag.attempts++;diag.byType[it.type]=(diag.byType[it.type]||0)+1;
      if(it.type==='cap dump')found=aiTryDump(g,ctxs,x,kind,'cap dump');
      else if(it.type==='floor salary')found=aiTryFloor(g,ctxs,x,kind);
