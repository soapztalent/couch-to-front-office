    aiPickPool(g,ctx.id,kind).forEach(function(p){var r=Number(p.round);if(ctx.role==='BUBBLE'&&AI_TRADE.BUBBLE_KEEPS_FIRSTS&&r===1)return;if(ctx.role==='YOUTH_MOVEMENT'&&r<=AI_TRADE.YOUTH_KEEP_ROUNDS)return;list.push(p);});return list;}
  // Draft window (before July 1): an expired player's RFA/UFA rights can be traded while his club still holds the FA slot.
  function aiRightsTradeable(g,ctx,p,kind){return AI_CONTRACT_STATUS.TRADE_RIGHTS_DRAFT&&kind==='draft'&&aiIsRights(g,p)&&!!aiRightsSlot(g,p,ctx.id);}
  function aiSideScore(g,ctx,give,get){var giveV=0,getV=0,net=0;give.forEach(function(a){giveV+=aiValue(g,ctx,a,false);net-=aiCurrentHit(g,ctx.id,a);});get.forEach(function(a){getV+=aiValue(g,ctx,a,true);net+=aiCurrentHit(g,ctx.id,a);});var cap=aiCapEffect(g,ctx,net);if(cap>=0)getV+=cap;else giveV-=cap;return {give:giveV,get:getV,net:net,cap:cap};}
  function aiAccept(s){return s.get>=s.give*(1+AI_TRADE.MARGIN)+AI_TRADE.MIN_GAIN;}
  function aiNeutral(g,list){return list.reduce(function(n,a){return n+aiMarket(g,a);},0);}
  // Role-driven package preferences: rebuilders want picks/prospects back (not aging roster players);
  // contenders spend non-elite prospects as their main deadline currency.
  function aiPackagePref(ctx,gets,gives,kind){var pref=0;if(ctx.role==='RETOOL')gets.forEach(function(a){if(!a.round&&!aiIsProspect(a)&&Number(a.age)<=AI_TRADE.RETOOL_TARGET_MAX_AGE)pref+=AI_TRADE.PREF_REBUILD_FUTURE;else if(!a.round&&Number(a.age)>=29)pref-=AI_TRADE.PREF_REBUILD_VET_PENALTY;});if(ctx.role==='REBUILD')gets.forEach(function(a){if(a.round||aiIsProspect(a))pref+=AI_TRADE.PREF_REBUILD_FUTURE;else if(Number(a.age)>=27)pref-=AI_TRADE.PREF_REBUILD_VET_PENALTY;});if((ctx.role==='WIN_NOW'||ctx.role==='CONTENDER'||ctx.role==='BUBBLE')&&kind==='deadline')gives.forEach(function(a){if(aiIsProspect(a))pref+=AI_TRADE.PREF_PROSPECT_CURRENCY;});return pref;}
  function aiCoreRfaForRentals(g,give,get){var C=AI_CONTRACT_STATUS;if(!get.length||!give.some(function(a){var si=aiStatusInfo(g,a);return si&&si.coreRfa;}))return false;
    return get.every(function(a){var si=aiStatusInfo(g,a);return si&&(si.rental||(si.rights&&si.status==='UFA'));});}
  function aiAgingMoney(p){return !p.round&&!aiIsProspect(p)&&Number(p.age)>=AI_TRADE.REBUILD_NO_VET_AGE&&Number(p.years)>=2&&contractHit(p)>=AI_TRADE.REBUILD_NO_VET_HIT;}
  // Cheap pre-screen (current-season cap/floor via net cap hit, roster size, positional minimums) so the
  // full tradeCapForecast-based aiLegal() only runs on packages that can plausibly pass.
  function aiQuickLegal(ctx,give,get,score){var net=score.net;if(net>0&&net>ctx.space){aiNote('over the cap');return false;}if(net<0&&ctx.floorGap>0){aiNote('under the floor');return false;}
    var out=give.filter(function(a){return a.__group==='active';}),inc=get.filter(function(a){return a.__group==='active';}),pre=(ctx.club.roster||[]).length,post=pre-out.length+inc.length;if((post>AI_TRADE.MAX_ROSTER&&post>pre)||(post<AI_TRADE.MIN_ROSTER&&post<pre)){aiNote('roster size');return false;}
    var cnt={F:ctx.counts.F,D:ctx.counts.D,G:ctx.counts.G},mins={F:AI_TRADE.MIN_F,D:AI_TRADE.MIN_D,G:AI_TRADE.MIN_G};out.forEach(function(p){cnt[aiGroup(p)]--;});inc.forEach(function(p){cnt[aiGroup(p)]++;});for(var k in mins)if(cnt[k]<mins[k]&&cnt[k]<ctx.counts[k]&&mins[k]-cnt[k]>((ctx.ahlDepth&&ctx.ahlDepth[k])||0)){aiNote('short at '+k);return false;}return true;}
  function aiBuild(g,A,B,coreA,coreB,payer,pool,kind,type){
    // A gives coreA, B gives coreB; payer ('A'|'B') may add up to MAX_ASSETS from pool. Returns the fairest legal package.
    pool=pool.filter(function(a){return coreA.indexOf(a)<0&&coreB.indexOf(a)<0;}).sort(function(a,b){return aiMarket(g,b)-aiMarket(g,a);});
    var payCtx=payer==='A'?A:B,other=payer==='A'?B:A;if(!coreA.every(function(p){return aiConsents(p,B.id);})||!coreB.every(function(p){return aiConsents(p,A.id);})){aiNote('core player blocked by trade protection');return null;}
    pool=pool.filter(function(a){return aiConsents(a,other.id)&&aiValue(g,other,a,true)>3;}).slice(0,AI_TRADE.POOL_SIZE);
    var combos=[[]];for(var i=0;i<pool.length;i++){combos.push([pool[i]]);for(var j=i+1;j<pool.length;j++){combos.push([pool[i],pool[j]]);if(AI_TRADE.MAX_ASSETS>=3)for(var k=j+1;k<pool.length;k++)combos.push([pool[i],pool[j],pool[k]]);}}
    var dump=type==='cap dump'||type==='floor salary',ok=[];
    combos.forEach(function(extra){var giveA=payer==='A'?coreA.concat(extra):coreA,giveB=payer==='B'?coreB.concat(extra):coreB;if(!giveA.length&&!giveB.length)return;if(giveA.length+giveB.length>6)return;
      var noVet=function(r){return r==='REBUILD'||r==='YOUTH_MOVEMENT'||r==='RETOOL';};if(!dump&&((noVet(A.role)&&giveB.some(aiAgingMoney))||(noVet(B.role)&&giveA.some(aiAgingMoney))))return;
      if(aiCoreRfaForRentals(g,giveA,giveB)||aiCoreRfaForRentals(g,giveB,giveA)){aiNote('young RFA core piece for rentals only');return;}
      var sa=aiSideScore(g,A,giveA,giveB),sb=aiSideScore(g,B,giveB,giveA);if(!aiAccept(sa)||!aiAccept(sb))return;if(!aiQuickLegal(A,giveA,giveB,sa)||!aiQuickLegal(B,giveB,giveA,sb))return;
      var nA=aiNeutral(g,giveA),nB=aiNeutral(g,giveB),ra=nB/Math.max(1,nA),rb=nA/Math.max(1,nB);
      var lA=giveA.some(function(a){return !a.round&&A.loyalIds&&A.loyalIds[a.id];}),lB=giveB.some(function(a){return !a.round&&B.loyalIds&&B.loyalIds[a.id];}),hi=AI_TRADE.NEUTRAL_MAX*(lA?AI_TRADE.LOYAL_KEEP_MULT:1),lo=AI_TRADE.NEUTRAL_MIN/(lB?AI_TRADE.LOYAL_KEEP_MULT:1);
      if(!dump&&(ra<lo||ra>hi))return;if(dump&&coreA.concat(coreB).some(function(p){return !p.round&&aiMarket(g,p)>=AI_TRADE.DUMP_GOOD_PLAYER;})&&Math.min(ra,rb)<AI_TRADE.DUMP_NEUTRAL_MIN)return;
      var slackA=sa.get-sa.give,slackB=sb.get-sb.give,pref=aiPackagePref(A,giveB,giveA,kind)+aiPackagePref(B,giveA,giveB,kind);ok.push({giveA:giveA,giveB:giveB,sa:sa,sb:sb,nA:nA,nB:nB,fair:Math.abs(slackA-slackB)+extra.length*3-pref});});
    ok.sort(function(a,b){return a.fair-b.fair;});
    if(!ok.length)aiNote('no value-balanced package');
    for(var t=0;t<ok.length&&t<40;t++){var why=aiLegal(g,A,B,ok[t].giveA,ok[t].giveB);if(!why)return ok[t];aiNote(why.replace(/^[A-Z]{3} /,'').replace(/^.* blocked by/,'blocked by'));}
    return null;}
  /* ---------- intents ---------- */
  function aiSellerAvailable(g,ctx,p,buyerCtx){if(ctx.protectedIds[p.id])return false;if((p.contractExpired||!(Number(p.years)>0))&&!aiRightsTradeable(g,ctx,p,ctx.kind))return false;var age=Number(p.age)||27,role=ctx.role,si=aiStatusInfo(g,p);
    if(ctx.cantAffordIds&&ctx.cantAffordIds[p.id])return true;   // can't fit his QO / raise next season: movable
    if(si&&si.youngRfa&&(role==='REBUILD'||role==='YOUTH_MOVEMENT'||role==='RETOOL')&&!ctx.capTrouble)return false; // youth roles rarely sell young RFAs
    if(ctx.capTrouble&&contractHit(p)>=1500000)return true;
    if(role==='REBUILD')return age>=26||(Number(p.ovr)<80&&age>=24);
    if(role==='RETOOL')return age>=AI_TRADE.RETOOL_SELL_AGE||(Number(p.years)<=1&&age>=26)||ctx.surplus[aiGroup(p)];
    if(role==='YOUTH_MOVEMENT')return (Number(p.years)<=1&&age>=AI_TRADE.YOUTH_SELL_AGE)||ctx.surplus[aiGroup(p)];
    return ctx.surplus[aiGroup(p)];}
  // What each buying role shops for (WIN_NOW/CONTENDER: anything that fills a need; REBUILD never buys roster players).
  function aiYoungRfaTarget(g,buyer,p){var r=buyer.role,si=aiStatusInfo(g,p);return !!si&&si.youngRfa&&(r==='REBUILD'||r==='YOUTH_MOVEMENT'||r==='RETOOL')&&(si.futureSigned+si.rfaYears)>=2;}
  function aiBuyerWants(buyer,p,g2){var g=g2||current&&current.game,r=buyer.role,age=Number(p.age)||27,yrs=Number(p.years)||0,hit=contractHit(p);if(g&&aiYoungRfaTarget(g,buyer,p))return true;if(Number(p.ovr)<(AI_TRADE.ROLE_BUY_MIN_OVR[r]||78))return false;
    if(r==='WIN_NOW'||r==='CONTENDER')return true;if(r==='BUBBLE')return yrs<=AI_TRADE.BUBBLE_RENTAL_MAX_YEARS&&hit<=AI_TRADE.BUBBLE_RENTAL_MAX_HIT;
    if(r==='RETOOL')return age>=AI_TRADE.RETOOL_TARGET_MIN_AGE&&age<=AI_TRADE.RETOOL_TARGET_MAX_AGE;if(r==='YOUTH_MOVEMENT')return age>=AI_TRADE.YOUTH_VET_MIN_AGE&&yrs<=AI_TRADE.YOUTH_VET_MAX_YEARS&&hit<=AI_TRADE.YOUTH_VET_MAX_HIT;return false;}
  function aiBuyPairs(g,ctxs,buyer,kind,rfaOnly){var pairs=[],need=buyer.needs;ctxs.forEach(function(seller){if(seller.id===buyer.id)return;var sRole=seller.role;if((sRole==='WIN_NOW'||sRole==='CONTENDER'||sRole==='BUBBLE')&&!seller.capTrouble&&!(seller.surplus.F||seller.surplus.D||seller.surplus.G))return;
      (seller.club.roster||[]).forEach(function(p){if(!aiBuyerWants(buyer,p,g)||!aiSellerAvailable(g,seller,p,buyer)||!aiConsents(p,buyer.id))return;if(rfaOnly&&!aiYoungRfaTarget(g,buyer,p))return;var lvl=aiNeedLevel(buyer,p);if(!rfaOnly&&lvl===0&&!(buyer.role==='WIN_NOW'&&Number(p.ovr)>=84))return;if(!rfaOnly&&!aiImproves(buyer,p))return;if(buyer.space+3000000<contractHit(p)&&!buyer.capTrouble)return;p.__group='active';
        var score=aiValue(g,buyer,p,true)-aiValue(g,seller,p,false)+lvl*8;pairs.push({buyer:buyer,seller:seller,p:p,score:score});});});
    return pairs.sort(function(a,b){return b.score-a.score;});}
  function aiSellPairs(g,ctxs,seller,kind){var pairs=[];(seller.club.roster||[]).forEach(function(p){if(Number(p.ovr)<76||!aiSellerAvailable(g,seller,p,null))return;p.__group='active';ctxs.forEach(function(buyer){if(buyer.id===seller.id)return;if(!aiBuyerWants(buyer,p,g))return;var lvl=aiNeedLevel(buyer,p);if(lvl===0||!aiImproves(buyer,p)||!aiConsents(p,buyer.id))return;pairs.push({buyer:buyer,seller:seller,p:p,score:aiValue(g,buyer,p,true)-aiValue(g,seller,p,false)+lvl*8});});});return pairs.sort(function(a,b){return b.score-a.score;});}
  function aiTryPairs(g,pairs,kind,type,limit){var tried=0;if(!pairs.length)aiNote('no target/partner fit for '+type);for(var i=0;i<pairs.length&&tried<limit;i++){var pr=pairs[i];if(pr.buyer.__done||pr.seller.__done)continue;tried++;var pool=aiTradeableAssets(g,pr.buyer,kind);var deal=aiBuild(g,pr.seller,pr.buyer,[pr.p],[],'B',pool,kind,type);if(deal)return {A:pr.seller,B:pr.buyer,deal:deal,type:type,headline:pr.p,receiver:pr.buyer};}return null;}
  function aiTryHockey(g,ctxs,T,kind){var needGroups=['F','D','G'].filter(function(gr){return gr==='F'?Math.max(T.needs.F,T.needs.C)>0:gr==='D'?Math.max(T.needs.D,T.needs.DR)>0:T.needs.G>0;}),surplusGroups=['F','D','G'].filter(function(gr){return T.surplus[gr]||(T.counts[gr]>({F:13,D:7,G:2})[gr]&&needGroups.indexOf(gr)<0);});if(!needGroups.length||!surplusGroups.length)return null;
    var mine=(T.club.roster||[]).filter(function(p){return surplusGroups.indexOf(aiGroup(p))>=0&&Number(p.ovr)>=76&&!T.protectedIds[p.id]&&!p.contractExpired&&Number(p.years)>0;}).map(function(p){p.__group='active';return p;}).sort(function(a,b){return aiPlayerMarket(b)-aiPlayerMarket(a);}).slice(0,4),tries=0;
    var partners=ctxs.filter(function(P){return P.id!==T.id&&!P.__done;});
    for(var i=0;i<partners.length;i++){var P=partners[i];for(var a=0;a<mine.length;a++){var tp=mine[a];if(aiNeedLevel(P,tp)===0)continue;
        var theirs=(P.club.roster||[]).filter(function(p){return needGroups.indexOf(aiGroup(p))>=0&&aiGroup(p)!==aiGroup(tp)&&Number(p.ovr)>=76&&!P.protectedIds[p.id]&&!p.contractExpired&&Number(p.years)>0&&aiImproves(T,p);}).map(function(p){p.__group='active';return p;}).filter(function(p){var r=aiPlayerMarket(p)/Math.max(1,aiPlayerMarket(tp));return r>.8&&r<1.25;}).slice(0,3);
        for(var b=0;b<theirs.length;b++){if(++tries>14)return null;var pp=theirs[b],dealA=aiBuild(g,T,P,[tp],[pp],'A',aiTradeableAssets(g,T,kind,{noActive:true}),kind,'hockey trade')||aiBuild(g,T,P,[tp],[pp],'B',aiTradeableAssets(g,P,kind,{noActive:true}),kind,'hockey trade');if(dealA)return {A:T,B:P,deal:dealA,type:'hockey trade',headline:pp,receiver:T};}}}
    return null;}
  function aiCoreSkaterIds(ctx){var ids={};(ctx.club.roster||[]).filter(function(p){return p.pos!=='G';}).sort(function(a,b){return b.ovr-a.ovr;}).slice(0,ctx.role==='REBUILD'?0:AI_TRADE.DUMP_CORE_SKATERS).forEach(function(p){ids[p.id]=1;});return ids;}
  function aiTryDump(g,ctxs,T,kind,type){var core=aiCoreSkaterIds(T),outs=(T.club.roster||[]).filter(function(p){return contractHit(p)>=1500000&&!core[p.id]&&!T.protectedIds[p.id]&&!p.contractExpired&&Number(p.years)>0;}).map(function(p){p.__group='active';return p;}).sort(function(a,b){return aiPlayerMarket(a)/contractHit(a)-aiPlayerMarket(b)/contractHit(b);}).slice(0,3);
    var absorbers=ctxs.filter(function(P){return P.id!==T.id&&!P.__done&&!P.capTrouble;}).sort(function(a,b){var s=function(x){return (x.floorGap>0?3:0)+(x.role==='REBUILD'?2:x.role==='RETOOL'||x.role==='YOUTH_MOVEMENT'?1:0)+x.space/5000000;};return s(b)-s(a);}).slice(0,8);
    for(var i=0;i<outs.length;i++){var d=outs[i];for(var j=0;j<absorbers.length;j++){var P=absorbers[j];if(P.space+1000000<contractHit(d))continue;var back=[];
        if((P.club.roster||[]).length>=AI_TRADE.MAX_ROSTER){var cheap=(P.club.roster||[]).filter(function(p){return !P.protectedIds[p.id]&&!p.contractExpired&&Number(p.years)>0&&contractHit(p)<=1100000&&aiGroup(p)===aiGroup(d);}).sort(function(a,b){return basePlayerValue(a)-basePlayerValue(b);})[0];if(!cheap)continue;cheap.__group='active';back=[cheap];}
        var deal=aiBuild(g,T,P,[d],back,'A',aiTradeableAssets(g,T,kind,{noActive:true}),kind,type);if(deal)return {A:T,B:P,deal:deal,type:type,headline:d,receiver:P};}}
    return null;}
  function aiTryFloor(g,ctxs,F,kind){var tight=ctxs.filter(function(P){return P.id!==F.id&&!P.__done&&P.space<4000000;});var pairs=[];tight.forEach(function(P){var core=aiCoreSkaterIds(P);(P.club.roster||[]).forEach(function(p){var hit=contractHit(p);if(hit<2000000||hit>F.space-250000||core[p.id]||P.protectedIds[p.id]||p.contractExpired||!(Number(p.years)>0))return;p.__group='active';pairs.push({P:P,p:p,score:aiValue(g,F,p,true)+Math.min(hit,F.floorGap)/1000000*AI_TRADE.FLOOR_VALUE_PER_M});});});
    pairs.sort(function(a,b){return b.score-a.score;});
    for(var i=0;i<pairs.length&&i<6;i++){var pr=pairs[i],back=[];if((F.club.roster||[]).length>=AI_TRADE.MAX_ROSTER){var cheap=(F.club.roster||[]).filter(function(p){return !F.protectedIds[p.id]&&!p.contractExpired&&Number(p.years)>0&&contractHit(p)<=1100000&&aiGroup(p)===aiGroup(pr.p);}).sort(function(a,b){return basePlayerValue(a)-basePlayerValue(b);})[0];if(!cheap)continue;cheap.__group='active';back=[cheap];}
      var deal=aiBuild(g,pr.P,F,[pr.p],back,'B',aiTradeableAssets(g,F,kind,{noActive:true}),kind,'floor salary')||aiBuild(g,pr.P,F,[pr.p],back,'A',aiTradeableAssets(g,pr.P,kind,{noActive:true}),kind,'floor salary');if(deal)return {A:pr.P,B:F,deal:deal,type:'floor salary',headline:pr.p,receiver:F};}
    return null;}
  /* ---------- execution + logging ---------- */
  function aiPickName(p){var r=Number(p.round);return p.year+' '+(r===1?'1st':r===2?'2nd':r===3?'3rd':r+'th')+'-round pick'+((p.origin||p.team)&&(p.origin||p.team)!==p.team?' ('+(p.origin)+')':'')+realPickTag(p);}
  function aiAssetLabel(a){if(a.round)return aiPickName(a);if(a.__group&&a.__group!=='active')return a.name+' (prospect, '+a.pos+', age '+a.age+', '+a.ovr+' OVR/'+(a.potential||a.ovr)+' POT)';var g=current&&current.game,si=g?aiStatusInfo(g,a):null,tag=si&&(si.pending||si.ext)?', '+(si.rental?'pending UFA':si.label):'';if(si&&si.rights)return a.name+' ('+a.pos+', '+a.ovr+' OVR, age '+a.age+', '+si.status+' rights)';return a.name+' ('+a.pos+', '+a.ovr+' OVR, age '+a.age+', '+shortMoney(contractHit(a))+' x '+(Number(a.years)||0)+'y'+tag+')';}
  function aiSyncDraftOrderPick(g,pick,owner){var st=g.offseason&&g.offseason.liveDraft;if(!st||!st.order)return;st.order.forEach(function(row){if(row.pickKey&&row.pickKey===pickKey(pick))row.owner=owner;});}
  // Organization tenure (V4LOYAL): a player who changes organization restarts at 0 with the new club. Uses the loyalty
  // patch's reset hook v4loyalEnsure when present (seeding the old club first so the new club can't inherit a seed);
  // otherwise just writes the fields. toId null = released (no organization). Same-org NHL/AHL moves never call this.
  function aiTenureMove(g,p,fromId,toId){if(!p||p.round)return;try{if(typeof v4loyalEnsure==='function'){if(fromId)v4loyalEnsure(g,p,fromId);if(toId)v4loyalEnsure(g,p,toId);}if(typeof v4loyalEnsure!=='function'||!toId){p.yearsWithOrg=0;p.orgTeam=toId||null;p.v4OrgCountedYear=null;if(!toId)p.v4LoyalSeeded=true;}}catch(e){console.error('tenure reset',e);}}
  function aiMoveAsset(g,from,to,a){if(a.round){var fl=clubPicks(g,from.id),i=fl.indexOf(a);if(i>=0)fl.splice(i,1);a.team=to.id;clubPicks(g,to.id).push(a);aiSyncDraftOrderPick(g,a,to.id);return;}var rightsSlot=aiIsRights(g,a)?aiRightsSlot(g,a,from.id):null;var grp=detachTradePlayer(g,from.id,a)||a.__group||'active';if(rightsSlot)rightsSlot.sourceTeam=to.id;attachTradePlayer(g,to.id,a,grp==='active'?'active':grp==='reserve'?'reserve':'prospect');a.aiTradeLockSeason=g.season;a.acquiredVia='Trade';a.lastTradedFrom=from.id;if(typeof v4fixTradeKey==='function')a.v4TradedKey=v4fixTradeKey(g);aiTenureMove(g,a,from.id,to.id);}
  function aiTradeTag(kind){return kind==='deadline'?'TRADE DEADLINE':kind==='draft'?'DRAFT-DAY TRADE':kind==='july1'||kind==='offseason'?'OFFSEASON TRADE':'AI TRADE';}
  var AI_TYPE_LABEL={'contender buy':'CONTENDER BUY · SELLER CASHES IN','rebuild sell':'REBUILDER SELL · CONTENDER BUY','bubble rental':'BUBBLE RENTAL · SHORT-TERM HELP','retool sell':'RETOOL · VETERAN SOLD','retool buy':'RETOOL · YOUNGER NHL PLAYER ADDED','vet add':'YOUTH MOVEMENT · CHEAP VETERAN ADDED','youth sell':'YOUTH MOVEMENT · EXPIRING VETERAN SOLD','rfa target':'YOUNG RFA ACQUIRED · CONTROL YEARS','hockey trade':'HOCKEY TRADE · NEEDS SWAP','cap dump':'CAP DUMP · SALARY RELIEF','floor salary':'CAP FLOOR · SALARY TAKEN ON'};
  function aiExecute(g,found,kind,date){var A=found.A,B=found.B,d=found.deal,preA=capUsedClub(g,A.id),preB=capUsedClub(g,B.id);
    var labelsA=d.giveA.map(aiAssetLabel),labelsB=d.giveB.map(aiAssetLabel),loyal=[];[[A,d.giveA],[B,d.giveB]].forEach(function(x){x[1].forEach(function(a){if(!a.round&&x[0].loyalIds&&x[0].loyalIds[a.id])loyal.push({name:a.name,from:x[0].id,yearsWithOrg:typeof yearsWithOrg==='function'?yearsWithOrg(g,a,x[0].id):null});});});
    var statusRows=[];[[A,B,d.giveA],[B,A,d.giveB]].forEach(function(x){x[2].forEach(function(a){if(a.round)return;if(aiIsProspect(a)){statusRows.push({name:a.name,from:x[0].id,to:x[1].id,status:'prospect',age:a.age,ovr:a.ovr,potential:a.potential});return;}var si=aiStatusInfo(g,a);if(!si)return;
      statusRows.push({name:a.name,from:x[0].id,to:x[1].id,status:si.label,expiryStatus:si.status,age:a.age,ovr:a.ovr,hit:contractHit(a),years:Number(a.years)||0,controlYears:si.controlYears,rfaYears:si.rfaYears,surplusM:si.surplusM,rfaCostM:Math.round(si.rfaCost/100000)/10,marketM:Math.round(si.market/100000)/10,potential:si.potential,potLabel:si.potLabel,effPotential:si.effPotential,projPeak:si.projPeak,certainty:si.certainty,growth:Math.round(si.growth),elitePremium:Math.round(si.premium),highPot:si.highPot,neutral:si.neutral,giverValue:Math.round(aiValue(g,x[0],a,false)),takerValue:Math.round(aiValue(g,x[1],a,true))});});});
    d.giveA.forEach(function(a){aiMoveAsset(g,A,B,a);});d.giveB.forEach(function(a){aiMoveAsset(g,B,A,a);});
    // In season, fill any positional minimum the trade opened from the club's AHL affiliate (AHL patch).
    if(g.stage==='regular'&&typeof ahlFillHoles==='function'){[A,B].forEach(function(x){try{ahlFillHoles(g,x.id,date,'trade backfill');}catch(e){console.error('ahl backfill',e);}});}
