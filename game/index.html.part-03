    var ovr=Number(p.ovr)||70,pos=p.pos==='D'?'D':'F',t={ovr:ovr,shot:Math.pow(1.045,ovr-82),finish:Math.pow(1.022,ovr-82),pass:Math.pow(1.045,ovr-82),sv:SIMV2.leagueSvPct+(ovr-84)*.0016,hist:false};
