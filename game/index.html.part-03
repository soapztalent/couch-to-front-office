  }
  function simV2PickGoalie(g,id,club,day){
    var roster=club&&club.roster||[],goalies=roster.filter(function(p){return p.pos==='G'&&simV2Healthy(p);});if(!goalies.length)return roster.filter(function(p){return p.pos==='G';})[0]||null;
    var ids=club.lines&&club.lines.goalies||[],starter=goalies.find(function(p){return p.id===ids[0];}),backup=goalies.find(function(p){return p.id===ids[1]&&p!==starter;});
    var sorted=goalies.slice().sort(function(a,b){return b.ovr-a.ovr;});if(!starter)starter=sorted[0];if(!backup)backup=sorted.find(function(p){return p!==starter;})||null;if(!backup)return starter;
    var mode=id===g.team?String((g.lineStrategy||{}).goalieWorkload||'Balanced'):'Balanced',gap=(Number(starter.ovr)||0)-(Number(backup.ovr)||0);
    var share=(mode==='Ride the starter'?.8:mode==='Split starts'?.52:gap>=8?.75:gap>=4?.7:gap>=1?.64:.56)+(simV2Hash(id+'|'+g.season+'|share')-.5)*.06;
    var teamGp=Number(ensureSeasonTeamStats(g,id).gp)||0,starts=Number(starter.goalieStarts)||0,b2b=simV2BackToBack(g,id,day);
    if(starts+1>share*(teamGp+1)+1.5)return backup;
    if(b2b&&Math.random()<(mode==='Ride the starter'?.35:.85))return backup;
    if((Number(starter.simConsecutiveStarts)||0)>=12&&Math.random()<.5)return backup;
    if(Math.random()<.03)return backup;
