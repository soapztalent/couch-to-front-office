    var countKeys=['games','goals','assists','points','shots','goalieWins','goalieShotsAgainst','goalieGoalsAgainst','goalieSaves','toiSeconds','plusMinus','hits','blocks','faceoffWins','faceoffs','powerPlayGoals','powerPlayAssists','penaltyMinutes','shortHandedGoals','ppToiSeconds','shToiSeconds','goalieStarts','goalieLosses','goalieOtLosses','goalieShutouts','simConsecutiveStarts'],teamKeys=['gp','shots','shotsAgainst','goalsFor','goalsAgainst','xGF','xGA','ppGoals','ppOpportunities','pkGoalsAgainst','pkOpportunities','faceoffWins','faceoffs','hits','blocks','saves'];
