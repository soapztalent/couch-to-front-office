    if(!(g.userPicks||[]).some(function(p){return p.year===year;}))g.history.push({year:seasonLabel(g),text:team(g.team).name+' enters the offseason without a draft pick for this year. The front office can still review the organization and free agency.',tag:'OFFSEASON'});
    g.history.push({year:seasonLabel(g),text:'Postseason complete. The offseason opens with the '+year+' NHL Draft, player development and free agency.',tag:'OFFSEASON'});
  }
  function playerFreeAgencyStatus(p){var explicit=String(p.freeAgencyStatus||p.expiry||'').toUpperCase();if(/\bUFA\b/.test(explicit))return 'UFA';if(/\bRFA\b/.test(explicit))return 'RFA';var service=Number(p.proSeasons||p.serviceYears)||0;if(!service&&current&&current.game){var orgYears=yearsWithOrg(current.game,p,p.club||p.orgTeam||current.game.team);if(orgYears>=7)service=orgYears;}return Number(p.age)>=27||service>=7?'UFA':'RFA';}
