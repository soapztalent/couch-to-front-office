    ctxs.forEach(function(x){if(!eligible(x))x.__done=true;});
    var intents=[];ctxs.forEach(function(x){if(x.__done)return;var r=x.role,roll=function(p){return Math.random()<Math.min(1,p*ramp);};
      if(x.capTrouble&&roll(probs.CAP))intents.push({ctx:x,type:'cap dump',pri:5});
      if(x.floorGap>0&&g.stage==='regular'&&roll(probs.FLOOR||0))intents.push({ctx:x,type:'floor salary',pri:4});
      if(r==='WIN_NOW'&&roll(probs.WIN_NOW))intents.push({ctx:x,type:'contender buy',pri:3});
      if(r==='CONTENDER'&&roll(probs.CONTENDER))intents.push({ctx:x,type:Math.random()<.7?'contender buy':'hockey trade',pri:2});
      if(r==='BUBBLE'&&roll(probs.BUBBLE))intents.push({ctx:x,type:Math.random()<.8?'bubble rental':'hockey trade',pri:2});
      var rfaHunt=function(){return Math.random()<(AI_CONTRACT_STATUS.RFA_TARGET_SHARE[r]||0);};
      if(r==='RETOOL'&&roll(probs.RETOOL)){if(rfaHunt())intents.push({ctx:x,type:'rfa target',pri:1});else{var q=Math.random();intents.push({ctx:x,type:q<.55?'retool sell':q<.85?'retool buy':'hockey trade',pri:q<.55?2:1});}}
      if(r==='REBUILD'&&roll(probs.REBUILD))intents.push({ctx:x,type:rfaHunt()?'rfa target':'rebuild sell',pri:2});
      if(r==='YOUTH_MOVEMENT'&&roll(probs.YOUTH_MOVEMENT))intents.push({ctx:x,type:rfaHunt()?'rfa target':Math.random()<.8?'vet add':'youth sell',pri:1});});
    intents.sort(function(a,b){return b.pri-a.pri||Math.random()-.5;});
