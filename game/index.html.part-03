  function ensureMinimumRosterDepth(g){
    if(!g||!g.offseason||g.offseason.phase!=='free-agency')return 0;
    var added=0,minimums={F:12,D:6,G:2},minimumSalary=leagueMinSalary(g);
    teams.forEach(function(t){
      var club=t.id===g.team?g:leagueClub(g,t.id);if(!club)return;
      club.roster=club.roster||[];club.reserveRoster=club.reserveRoster||[];
      function counts(){return {F:club.roster.filter(function(p){return ['C','LW','RW'].indexOf(p.pos)>=0;}).length,D:club.roster.filter(function(p){return p.pos==='D';}).length,G:club.roster.filter(function(p){return p.pos==='G';}).length};}
      for(var slot=0;slot<50&&club.roster.length<23;slot++){
        var current=counts(),need=['F','D','G'].find(function(k){return current[k]<minimums[k];}),capRoom=g.cap-capUsedClub(g,t.id);
        if(!need&&capRoom>=minimumSalary)break;
        if(capRoom<minimumSalary){
          var cut=club.roster.filter(function(p){return contractHit(p)>minimumSalary;}).sort(function(a,b){return (Number(a.ovr)||0)-(Number(b.ovr)||0)||contractHit(b)-contractHit(a);})[0];
          if(!cut)break;
          club.roster.splice(club.roster.indexOf(cut),1);cut.reserveList=true;cut.rosterStatus='AHL / cap relief';cut.level='Minor league';club.reserveRoster.push(cut);
          g.history.push({year:seasonLabel(g),tag:'ROSTER COVERAGE',text:team(t.id).name+' moves a depth contract to reserve status to clear cap room for its NHL lineup.'});
          continue;
        }
        if(!need)break;
        if(faPromoteOwnDepth(g,t.id,need)||faSignRealDepth(g,t.id,need)||faClaimDepth(g,t.id,need))continue;
        if(ahlContractCount(club)>=AHL.CONTRACT_LIMIT)break;
        var position=need==='F'?'C':need,name=team(t.id).name+' Depth '+position+' '+(g.startYear+g.season)+'-'+(slot+1),player=makePlayer(name,position,64,minimumSalary/1000000,24,t.id,false,seededRandom('depth-roster|'+t.id+'|'+g.season+'|'+slot));
        player.id='depth-'+t.id.toLowerCase()+'-'+g.season+'-'+slot;
        while(club.roster.concat(club.reserveRoster,club.orgProspects||[]).some(function(p){return p.id===player.id;}))player.id+='x';
        player.salary=minimumSalary;player.capHit=minimumSalary;player.years=1;player.term=1;player.contractTimeline=[minimumSalary];player.contractType='Emergency one-year depth';player.contractSource='Simulation-generated roster coverage';player.dataSource='Simulation-generated roster coverage';player.rosterStatus='Emergency depth signing';player.club=t.id;
        club.roster.push(player);added++;
        g.history.push({year:seasonLabel(g),tag:'ROSTER COVERAGE',text:team(t.id).name+' adds a one-year minimum-salary '+(need==='F'?'forward':need==='D'?'defenseman':'goaltender')+' to maintain active lineup coverage.'});
      }
    });
    return added;
  }
