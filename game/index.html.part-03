    var won=userResult.winner===g.team,opponent=userResult.a===g.team?userResult.b:userResult.a,our=userResult.a===g.team?userResult.aWins:userResult.bWins,them=userResult.a===g.team?userResult.bWins:userResult.aWins;
    p.series.push({round:p.round,opponent:opponent,us:our,them:them,won:won});
    g.roster.forEach(function(player){player.hot=0;player.cold=0;player.morale=Math.max(20,Math.min(100,player.morale+(won?4:-12)+((player.playoffMomentum||0)*3)));});
    var otNote=userResult.otGames?' ('+userResult.otGames+' overtime game'+(userResult.otGames===1?'':'s')+')':'';
    if(won){g.history.push({year:seasonLabel(g),text:team(g.team).name+' advances past '+team(opponent).name+' '+our+'–'+them+otNote+' in '+roundName(p.round)+'.',tag:'PLAYOFFS'});}
    else {g.history.push({year:seasonLabel(g),text:team(g.team).name+' is eliminated by '+team(opponent).name+' '+our+'–'+them+otNote+'. Room morale takes a significant hit.',tag:'PLAYOFFS'});g.roster.filter(function(pl){return pl.ovr>=85&&pl.morale<48;}).forEach(function(pl){pl.tradeRequest=true;});}
    if(!won){g.owner.trust=clamp(g.owner.trust-8,20,99);v4fixAfterUserElimination(g,p,winners,userResult,opponent);}
    else if(p.round>=3){p.complete=true;p.winner=g.team;p.champion=g.team;p.runnerUp=opponent;p.finalSeries=userResult;g.championships++;g.owner.trust=clamp(g.owner.trust+18,20,99);g.roster.forEach(function(pl){pl.morale=Math.min(100,pl.morale+12);});g.history.push({year:seasonLabel(g),text:team(g.team).name+' wins the Stanley Cup. Banner raised.',tag:'STANLEY CUP'});}
    else {p.round++;var nextMatches=[];for(var i=0;i<winners.length;i+=2)nextMatches.push([winners[i],winners[i+1]]);p.matches=nextMatches;var userMatch=nextMatches.find(function(m){return m.includes(g.team);});p.opponent=userMatch?userMatch.find(function(id){return id!==g.team;}):opponent;}
    if(p.complete){ if(g.mode==='franchise'){beginOffseason(g);current.page='offseason';current.offseasonSection='draft';}else g.stage='complete'; }
    persist(); renderOffice(); setNotice(won?(p.complete?team(g.team).name+' lifts the Cup.':team(g.team).name+' wins the series '+our+'–'+them+'; the full bracket advances.'):team(g.team).name+' is eliminated '+our+'–'+them+'. Series consequences have been applied.',!won);/* patch13 T3 club name */
  }
  function beginOffseason(g) {
