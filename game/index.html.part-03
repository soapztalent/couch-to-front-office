    CONTROL_PER_YEAR:5,RFA_CONTROL_PER_YEAR:4,CONTROL_CAP:30, // value pts per controlled future season (signed / RFA); the game's basePlayerValue uses 5/yr
    SURPLUS_PER_M_YEAR:2.0,SURPLUS_DISCOUNT:.85,SURPLUS_CAP:45,// value pts per $1M/season of (projected UFA market AAV - cost), discounted per future season
    RFA_ASK_SHARE:.88,                                     // expected RFA re-sign = max(QO, UFA market x this), then the game's RFA cap (v4fixContractSanity)
