  function faComputeLeagueScale(g){var off=g.offseason;if(!off)return 1;off.faScale=1;var committed=0;teams.forEach(function(t){(clubRoster(g,t.id)||[]).forEach(function(p){if(Number(p.years)>0||hasExtensionInPlace(p))committed+=contractHit(p);});});var sum=0;(g.freeAgents||[]).forEach(function(slot){var p=faSlotPlayer(g,slot);if(!p||(Number(p.age)||30)>38||faValuePct(g,p)<.3)return;sum+=faMarketValue(g,p,g.cap);});var target=.88*g.cap*teams.length-committed;off.faScale=Math.round(clamp(target/Math.max(1,sum),.95,1.3)*1000)/1000;off.faScaleInputs={committed:committed,faValue:sum,target:target};return off.faScale;}
