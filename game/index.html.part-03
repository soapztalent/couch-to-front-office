  function randomGoalScorer(roster,g){var eligible=(roster||[]).filter(function(p){return p&&p.pos!=='G'&&p.injury<=0;});if(!eligible.length)return roster&&roster[0];var weights=eligible.map(function(p){var rating=Math.max(50,Math.min(99,Number(p.ovr)||70)),forward=['C','LW','RW'].indexOf(p.pos)>=0,projection=g&&typeof nhlPointProjection==='function'?nhlPointProjection(g,p):null,historyFactor=projection?Math.pow(clamp(projection.points/45,.55,2.2),.65):1,weight=Math.pow(1.085,rating-75)*(forward?1.12:0.82)*historyFactor;return Math.max(.18,weight);}),total=weights.reduce(function(sum,w){return sum+w;},0),roll=Math.random()*total;for(var i=0;i<eligible.length;i++){roll-=weights[i];if(roll<=0)return eligible[i];}return eligible[eligible.length-1];}
  function attributeChange(p,delta) {
    var attrs=['skating','shooting','puck','defense'];var attr=attrs[Math.floor(Math.random()*attrs.length)];p.attributes[attr]=Math.max(45,Math.min(99,p.attributes[attr]+delta));return attr;
  }
  function updateStreaks(g) {
    var alerts=[];
    g.roster.forEach(function(p){
      if(p.injury>0)return;
      var roll=Math.random(); var performance=roll<(.19+(p.ovr-75)*.004)?'hot':roll>.78?'cold':'neutral';
      if(performance==='hot'){p.hot++;p.cold=0;}else if(performance==='cold'){p.cold++;p.hot=0;}else{p.hot=0;p.cold=0;}
      if(p.hot>=5){var attr=attributeChange(p,1);var milestone=[5,10,15,20].indexOf(p.hot);if(milestone>=0&&!p.keyMilestones.includes(p.hot)){var keys=[1,3,5,10][milestone];p.key+=keys;p.keyMilestones.push(p.hot);alerts.push(p.name+' hit a Keys milestone at '+p.hot+' straight hot games (+'+keys+' Keys).');}
        if(p.age<=21&&p.hot>=10&&!p.developmentChallenge){p.developmentChallenge=true;p.potential=Math.min(99,p.potential+3);alerts.push(p.name+' met the sustained-development challenge. Ceiling rises by 3.');}
        p.streakAttribute=attr;
      }
      if(p.cold>=5){var coldAttr=attributeChange(p,-1);if(p.age===29&&!p.persistenceUsed)p.persistenceUsed=true;p.streakAttribute=coldAttr;}
    });
    return alerts;
  }
  function snapshotGameStats(g,id){var roster=clubRoster(g,id)||[],teamStats=cloneData(ensureSeasonTeamStats(g,id));return {team:teamStats,players:roster.map(function(p){return {id:p.id,name:p.name,pos:p.pos,games:Number(p.games)||0,goals:Number(p.goals)||0,assists:Number(p.assists)||0,points:Number(p.points)||0,shots:Number(p.shots)||0,goalieSaves:Number(p.goalieSaves)||0,goalieShotsAgainst:Number(p.goalieShotsAgainst)||0,goalieGoalsAgainst:Number(p.goalieGoalsAgainst)||0,goalieWins:Number(p.goalieWins)||0,toiSeconds:Number(p.toiSeconds)||0,plusMinus:Number(p.plusMinus)||0,hits:Number(p.hits)||0,blocks:Number(p.blocks)||0,faceoffs:Number(p.faceoffs)||0,faceoffWins:Number(p.faceoffWins)||0};})};}
  function gameStatDelta(g,id,before){var after=ensureSeasonTeamStats(g,id),keys=['gp','shots','shotsAgainst','goalsFor','goalsAgainst','xGF','xGA','ppGoals','ppOpportunities','pkGoalsAgainst','pkOpportunities','faceoffWins','faceoffs','hits','blocks','saves'],stats={};keys.forEach(function(k){stats[k]=(Number(after[k])||0)-(Number(before.team[k])||0);});var players=clubRoster(g,id)||[];return {stats:stats,players:players.map(function(p){var old=before.players.find(function(x){return x.id===p.id;})||{},row={name:p.name,pos:p.pos,gp:(Number(p.games)||0)-(Number(old.games)||0),g:(Number(p.goals)||0)-(Number(old.goals)||0),a:(Number(p.assists)||0)-(Number(old.assists)||0),pts:(Number(p.points)||0)-(Number(old.points)||0),shots:(Number(p.shots)||0)-(Number(old.shots)||0),saves:(Number(p.goalieSaves)||0)-(Number(old.goalieSaves)||0),sa:(Number(p.goalieShotsAgainst)||0)-(Number(old.goalieShotsAgainst)||0),ga:(Number(p.goalieGoalsAgainst)||0)-(Number(old.goalieGoalsAgainst)||0),wins:(Number(p.goalieWins)||0)-(Number(old.goalieWins)||0),toiSeconds:(Number(p.toiSeconds)||0)-(Number(old.toiSeconds)||0),plusMinus:(Number(p.plusMinus)||0)-(Number(old.plusMinus)||0),hits:(Number(p.hits)||0)-(Number(old.hits)||0),blocks:(Number(p.blocks)||0)-(Number(old.blocks)||0),faceoffs:(Number(p.faceoffs)||0)-(Number(old.faceoffs)||0),faceoffWins:(Number(p.faceoffWins)||0)-(Number(old.faceoffWins)||0)};return row;}).filter(function(p){return p.gp||p.g||p.a||p.shots||p.saves;}).sort(function(a,b){return b.pts-a.pts||b.g-a.g||b.shots-a.shots;})};}
  function requireLegalUserRoster(g){if(!g||g!==current.game||(['regular','playoffs'].indexOf(g.stage)<0)||(g.stage==='regular'&&g.day>=seasonGameCount(g))||g.roster.length<=23)return true;current.page='roster';renderOffice();setNotice(team(g.team).name+' has '+g.roster.length+'/23 active players. Move players to the reserve roster before playing the next game.',true);return false;}
  function simulateGame(g,showBoxScore,quiet) {
