    RENTAL_BUY_W:{WIN_NOW:1.35,CONTENDER:1.20,BUBBLE:.75,RETOOL:.12,REBUILD:.05,YOUTH_MOVEMENT:.08}, // acquirer's weight on a pending-UFA rental
    RENTAL_KEEP_W:{WIN_NOW:1.10,CONTENDER:1.00,BUBBLE:.80,RETOOL:.45,REBUILD:.30,YOUTH_MOVEMENT:.40},// seller's own value of keeping a rental he loses for nothing
    RESIGN_KEEP_SHARE:.40,                                 // seller expects to re-sign him (isLoyalToOrg): + this share of a season's value when giving
    CONTROL_W:{WIN_NOW:.85,CONTENDER:1.0,BUBBLE:.95,RETOOL:1.30,REBUILD:1.50,YOUTH_MOVEMENT:1.50}, // role weight on control + surplus value (players up to CONTROL_YOUNG_AGE)
    CONTROL_YOUNG_AGE:26,CONTROL_VET_AGE:29,CONTROL_W_VET_YOUTH:.50, // youth roles (REBUILD/YOUTH/RETOOL) don't want control years of 29+ vets
    CONTROLLABLE_PREMIUM:{WIN_NOW:1.10,CONTENDER:1.10},    // contenders pay this much more for a player they control past this season
    YOUNG_RFA_AGE:25,YOUNG_RFA_MIN_OVR:76,YOUNG_RFA_KEEP:1.15,YOUNG_RFA_CORE_OVR:80, // youth roles keep/seek young RFAs; core pieces never go for rentals-only packages
    RFA_TARGET_SHARE:{REBUILD:.15,YOUTH_MOVEMENT:.20,RETOOL:.15}, // share of a youth role's trade intents spent hunting young RFAs
