  function acceptFreeAgentCounter(g,id){var market=freeAgencyMarket(g),counter=market.counters[id],slot=(g.freeAgents||[]).find(function(x){return x.playerId===id;});if(!counter||!slot||counter.team!==g.team)return setNotice('There is no player counter to accept.',true);var source=slot.external?(g.currentFreeAgentPool||[]):clubRoster(g,slot.sourceTeam),player=source.find(function(x){return x.id===id;}),sameClub=!slot.external&&slot.sourceTeam===g.team;if(!player)return setNotice('The player is no longer available.',true);if(!sameClub&&clubContractRosterCount(g,g.team)>=23)return setNotice('Open an NHL roster spot before accepting this counter.',true);if(!ahlSigned(player)&&ahlContractCount(g)>=AHL.CONTRACT_LIMIT)return setNotice(team(g.team).name+' is at the 50-contract limit.',true);if(capUsed(g)-(sameClub?contractHit(player):0)+counter.salary>g.cap)return setNotice('The counter offer does not fit under the salary cap.',true);var offer={team:g.team,salary:counter.salary,years:counter.years,day:market.day,date:market.date,counter:true};market.offers[id]=market.offers[id]||[];var at=market.offers[id].findIndex(function(x){return x.team===g.team;});if(at>=0)market.offers[id][at]=offer;else market.offers[id].push(offer);if(!completeFreeAgentSigning(g,id,offer))return setNotice('The signing could not be completed. Recheck roster space and cap room.',true);delete market.counters[id];persist();renderOffice();setNotice(player.name+' accepts your deal at the counter: '+shortMoney(offer.salary)+' for '+offer.years+' years.');}
  function signFreeAgent(g,id){if(!g.offseason)return signFreeAgentInSeason(g,id);var slot=(g.freeAgents||[]).find(function(x){return x.playerId===id;});if(!slot)return setNotice('That free agent is no longer available.',true);var source=slot.external?(g.currentFreeAgentPool||[]):clubRoster(g,slot.sourceTeam),player=source.find(function(p){return p.id===id;});if(!player)return setNotice('The player’s contract status changed.',true);var termSelect=Array.from($('office-content').querySelectorAll('.fa-term')).find(function(x){return x.dataset.fa===id;}),offerSelect=Array.from($('office-content').querySelectorAll('.fa-offer')).find(function(x){return x.dataset.fa===id;}),years=Number(termSelect&&termSelect.value||3),salary=faClampAav(g,Number(offerSelect&&offerSelect.value||slot.ask)),outgoingHit=slot.sourceTeam===g.team&&!slot.external?contractHit(player):0;if(capUsed(g)-outgoingHit+salary>g.cap)return setNotice(team(g.team).name+' cannot fit this offer under the salary cap.',true);var market=freeAgencyMarket(g);market.offers[id]=market.offers[id]||[];var offer={team:g.team,salary:salary,years:years,day:market.day,date:market.date};var existing=market.offers[id].findIndex(function(x){return x.team===g.team;});if(existing>=0)market.offers[id][existing]=offer;else market.offers[id].push(offer);persist();renderOffice();setNotice('Offer submitted: '+player.name+' · '+shortMoney(salary)+' AAV for '+years+' years. The player will decide after reviewing the market.');}
