  function ensureLineup(g) {
    if(!g||!Array.isArray(g.roster))return;
    var old=g.lines||{},used={};
    function candidates(pos,slot){var list=g.roster.filter(function(p){return canPlayerPlayLineSlot(p,pos,slot);});return list.sort(function(a,b){var prefA=a.rosterPositionChoice===(pos==='G'?(slot===0?'Starter':'Backup'):slot)?1:0,prefB=b.rosterPositionChoice===(pos==='G'?(slot===0?'Starter':'Backup'):slot)?1:0,health=(a.injury>0?1:0)-(b.injury>0?1:0);return prefB-prefA||health||b.ovr-a.ovr;});}
    function choose(saved,pos,slot){var valid=g.roster.find(function(p){return p.id===saved&&canPlayerPlayLineSlot(p,pos,slot)&&!used[p.id];});if(!valid)valid=candidates(pos,slot).find(function(p){return !used[p.id];});if(valid)used[valid.id]=true;return valid?valid.id:'';}
    var lines={forwards:[],defense:[],goalies:[]};
    for(var i=0;i<4;i++){var prior=old.forwards&&old.forwards[i]||{};lines.forwards.push({LW:choose(prior.LW,'F','LW'),C:choose(prior.C,'F','C'),RW:choose(prior.RW,'F','RW')});}
    for(var d=0;d<3;d++){var pair=old.defense&&old.defense[d]||{};lines.defense.push({LD:choose(pair.LD,'D','LD'),RD:choose(pair.RD,'D','RD')});}
    lines.goalies=[choose(old.goalies&&old.goalies[0],'G',0),choose(old.goalies&&old.goalies[1],'G',1)];
    g.lines=lines;
    ensureSpecialTeams(g);
  }
  function canPlayerPlayLineSlot(player,group,slot){if(!player)return false;var choice=player.rosterPositionChoice||'';if(group==='F'||group==='forwards'){if(['C','LW','RW'].indexOf(player.pos)<0)return false;if(['C','LW','RW'].indexOf(choice)>=0&&choice!==slot)return false;if((player.pos==='LW'||player.pos==='RW')&&slot==='C')return false;return ['C','LW','RW'].indexOf(slot)>=0;}if(group==='D'||group==='defense'){if(player.pos!=='D'||['LD','RD'].indexOf(slot)<0)return false;return !(['LD','RD'].indexOf(choice)>=0&&choice!==slot);}if(group==='G'||group==='goalies'){if(player.pos!=='G')return false;var target=Number(slot)===0?'Starter':'Backup';return !(choice==='Starter'||choice==='Backup')||choice===target;}return false;}
  function ensureSpecialTeams(g) {
    if(!g||!Array.isArray(g.roster))return;
    var old=g.specialTeams||{},skaters=g.roster.filter(function(p){return p.pos!=='G';}).sort(function(a,b){var health=(a.injury>0?1:0)-(b.injury>0?1:0);return health||b.ovr-a.ovr;});
    g.specialTeams={};
    var pkScore=function(p){var a=p.attributes||{},o=Number(p.ovr)||70,vals=['skating','shooting','puck','defense'].map(function(k){return Number(a[k]);}).filter(Number.isFinite),mean=vals.length?vals.reduce(function(x,y){return x+y;},0)/vals.length:o,dev=Number.isFinite(Number(a.defense))?clamp(Number(a.defense)-mean,-6,6):0;return o+dev/2+(p.pos==='D'?3:0)+(p.pos==='C'?1.5:0)-(p.injury>0?50:0);},isF=function(p){return ['C','LW','RW'].indexOf(p.pos)>=0;},topF=skaters.filter(isF).slice(0,3),pkD=skaters.filter(function(p){return p.pos==='D';}).sort(function(a,b){return pkScore(b)-pkScore(a);}),pkF=skaters.filter(function(p){return isF(p)&&topF.indexOf(p)<0;}).sort(function(a,b){return pkScore(b)-pkScore(a);}),pkOrder=[];for(var q=0;q<Math.max(pkD.length,pkF.length);q++){if(pkF[q])pkOrder.push(pkF[q]);if(pkD[q])pkOrder.push(pkD[q]);}skaters.forEach(function(p){if(pkOrder.indexOf(p)<0)pkOrder.push(p);});
    [['pp54',5],['pp53',5],['pk54',4],['pk53',3],['shootout',10]].forEach(function(unit){var prior=Array.isArray(old[unit[0]])?old[unit[0]]:[],selected={},slots=[],pool=unit[0].indexOf('pk')===0?pkOrder:skaters;for(var i=0;i<unit[1];i++){var player=pool.find(function(p){return p.id===prior[i]&&!selected[p.id];})||pool.find(function(p){return !selected[p.id];});var id=player?player.id:'';slots.push(id);if(id)selected[id]=true;}g.specialTeams[unit[0]]=slots;});
  }
  function assignRoles(g) {
    if(!g.lineupSet)g.lineupSet=true;
    ensureLineup(g);
  }
  function lineupRole(g,p){var forwards=g.lines&&g.lines.forwards||[],defense=g.lines&&g.lines.defense||[];if(p.pos==='C'||p.pos==='LW'||p.pos==='RW'){var fi=forwards.findIndex(function(line){return ['LW','C','RW'].some(function(slot){return line[slot]===p.id;});});return fi===0?'Top Line':fi===1?'Top 6':fi===2?'Middle 6':fi===3?'Bottom 6':'Depth';}if(p.pos==='D'){var di=defense.findIndex(function(pair){return pair.LD===p.id||pair.RD===p.id;});return di===0?'Top 2':di===1?'Top 4':di===2?'Bottom Pair':g.roster.filter(function(x){return x.pos==='D'&&x.ovr>p.ovr;}).length<6?'7th Dman':'Depth';}return p.pos==='G'?'Starting goalie':'Depth';}
  function roleMismatch(g,p){var expected=nhlPotentialRole(p.pos,Number(p.ovr)||0),actual=lineupRole(g,p),ranks={'Franchise':0,'Top Line':1,'Top 2':1,'Top 6':2,'Top 4':2,'Middle 6':3,'Bottom Pair':3,'Bottom 6':4,'7th Dman':4,'Depth':5,'Starting goalie':1},expectedRank=ranks[expected];if(expected==='Franchise')expectedRank=p.pos==='LW'||p.pos==='RW'?(p.age>=27?3:1):p.pos==='D'?(p.age>=27?2:1):p.age>=27?2:1;if(expectedRank==null||p.pos==='G')return false;return ranks[actual]>expectedRank;}
  function roleMeeting(g,p,level){p.roleMeetingLevel=level;var who=level===1?'coach':level===2?'GM':'player agent',text=level===3?p.name+'’s agent delivers a final warning: give him the role he expects, or he is done here.':p.name+' requests a meeting with the '+who+' about being used below their '+nhlPotentialRole(p.pos,p.ovr)+' role.';if(g.team===p.club){g.history=g.history||[];g.history.push({year:seasonLabel(g),text:text,tag:level===1?'COACH MEETING':level===2?'GM MEETING':'AGENT WARNING'});}else{g.aiLog=g.aiLog||[];g.aiLog.unshift({when:seasonLabel(g)+' · PLAYER MEETING',text:team(p.club).name+': '+text});g.aiLog=g.aiLog.slice(0,40);}}
  function updateRoleMorale(g){g.roster.forEach(function(p){if(p.injury>0)return;if(Number(p.tradeDiscussionUpsetGames)>0){p.tradeDiscussionUpsetGames--;if(p.tradeDiscussionUpsetGames<=0){p.tradeDiscussionUpsetGames=0;p.tradeDiscussionUpset=false;}}var step=p.age<=26?3:1.5;if(roleMismatch(g,p)){p.roleMismatchGames=(p.roleMismatchGames||0)+1;p.roleFrustration=Math.min(100,(p.roleFrustration||0)+step);p.morale=Math.max(15,(p.morale||70)-(p.age<=26?1.2:.6));if(p.roleFrustration>=20&&(p.roleMeetingLevel||0)<1)roleMeeting(g,p,1);if(p.roleFrustration>=50&&(p.roleMeetingLevel||0)<2){roleMeeting(g,p,2);p.disgruntled=true;}if(p.roleFrustration>=75&&(p.roleMeetingLevel||0)<3)roleMeeting(g,p,3);if(p.roleFrustration>=90)p.tradeRequest=true;}else{p.roleMismatchGames=Math.max(0,(p.roleMismatchGames||0)-2);p.roleFrustration=Math.max(0,(p.roleFrustration||0)-step*1.5);p.morale=Math.min(100,(p.morale||70)+.75);if(p.roleFrustration<10)p.roleMeetingLevel=0;if(p.roleFrustration<20&&Number(p.tradeDiscussionUpsetGames)<=0)p.disgruntled=false;if(p.roleFrustration<15&&p.morale>50)p.tradeRequest=false;}});}
  function seasonLabel(g) { var y=(g&&g.startYear||2026)+(g?g.season-1:0); return y+'–'+String(y+1).slice(-2); }
  function activeTeam() { return current.game ? team(current.game.team) : team(current.selected); }
  function setNotice(message,bad) { var n=$('notice-bar'); n.hidden=false; n.textContent=message; n.style.borderColor=bad?'rgba(255,107,104,.5)':''; n.style.color=bad?'#ffb0aa':'';var global=$('global-message');global.hidden=current.phase==='office';global.textContent=message;global.style.color=bad?'#ffb0aa':''; }
  function clearNotice(){var n=$('notice-bar'),global=$('global-message');if(n){n.hidden=true;n.textContent='';n.style.borderColor='';n.style.color='';}if(global){global.hidden=true;global.textContent='';global.style.color='';}}
  /* ===== SAVE SYSTEM V2: compact saves in IndexedDB (localStorage fallback) ===== */
  var SAVE_DB_NAME='couch-to-front-office',SAVE_DB_STORE='saves',SAVE_FORMAT='cfo-compact-2',SAVE_META_KEY=STORAGE_KEY+'-meta';
  var saveState={dirty:false,timer:null,writing:null,lastResult:null};
  var saveBundleCanon={id:null,name:null},saveDbPromise=null;
  function saveCanon(v){if(v===undefined)return 'null';if(v===null||typeof v!=='object')return JSON.stringify(v);if(Array.isArray(v))return '['+v.map(saveCanon).join(',')+']';return '{'+Object.keys(v).sort().filter(function(k){return v[k]!==undefined&&typeof v[k]!=='function';}).map(function(k){return JSON.stringify(k)+':'+saveCanon(v[k]);}).join(',')+'}';}
  function saveStatsDelta(map,bundleMap,kind){
    if(!map||typeof map!=='object'||!bundleMap)return map;
    var cache=saveBundleCanon[kind]||(saveBundleCanon[kind]={}),out={};
    Object.keys(map).forEach(function(k){var e=map[k],a=bundleMap[k];if(a&&e&&typeof e==='object'){var c=cache[k];if(c===undefined)c=cache[k]=saveCanon(Object.assign({},a,{playerId:a.playerId,seasons:Object.assign({},a.seasons||{})}));if(saveCanon(e)===c)return;}out[k]=e;});
    return out;
  }
  // Copy of the game without data that is rebuilt from the bundled files on load:
  // - NHL history (nhlStatsById/nhlStatsByName): only entries that differ from the bundle are kept;
  //   nhlStatsBundledVersion is dropped so mergeBundledNhlHistory re-merges the bundle on load (any build).
  // - leagueTeams[*].prospects: an unused generated list (~160 KB per club) that nothing reads.
  function compactGameForSave(g){
    var out=Object.assign({},g),bundle=window.NHL_STATS_HISTORY;
    if(bundle&&bundle.byId){out.nhlStatsById=saveStatsDelta(g.nhlStatsById,bundle.byId,'id');out.nhlStatsByName=saveStatsDelta(g.nhlStatsByName,bundle.byName,'name');delete out.nhlStatsBundledVersion;}
    if(g.leagueTeams&&typeof g.leagueTeams==='object'){var lt={};Object.keys(g.leagueTeams).forEach(function(id){var c=g.leagueTeams[id];if(c&&typeof c==='object'&&Array.isArray(c.prospects)){c=Object.assign({},c);delete c.prospects;}lt[id]=c;});out.leagueTeams=lt;}
    out.saveFormat=SAVE_FORMAT;
    return out;
  }
  function rehydrateSavedGame(g){if(!g||typeof g!=='object')return g;Object.keys(g.leagueTeams||{}).forEach(function(id){var c=g.leagueTeams[id];if(c&&typeof c==='object'&&!Array.isArray(c.prospects))c.prospects=[];});if(g.saveFormat===SAVE_FORMAT)delete g.nhlStatsBundledVersion;delete g.saveFormat;return g;}
  function saveSizeLabel(n){n=Number(n)||0;return n>=1048576?(n/1048576).toFixed(1)+' MB':Math.max(1,Math.round(n/1024))+' KB';}
  function saveSummary(g,savedAt){var r=g.record||{};return {team:g.team,season:seasonLabel(g),record:{w:r.w||0,l:r.l||0,otl:r.otl||0},day:g.day||0,stage:g.stage||'',savedAt:savedAt};}
  function saveCanGzip(){return typeof CompressionStream==='function'&&typeof DecompressionStream==='function'&&typeof Response==='function'&&typeof Blob==='function';}
  function saveGzip(text){return new Response(new Blob([text]).stream().pipeThrough(new CompressionStream('gzip'))).arrayBuffer();}
  function saveGunzip(buffer){return new Response(new Blob([buffer]).stream().pipeThrough(new DecompressionStream('gzip'))).text();}
  function saveToBase64(buffer){var bytes=new Uint8Array(buffer),parts=[];for(var i=0;i<bytes.length;i+=32768)parts.push(String.fromCharCode.apply(null,bytes.subarray(i,i+32768)));return btoa(parts.join(''));}
