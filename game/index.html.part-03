  function renderLeague(g){
    var divisions=['Atlantic','Metro','Central','Pacific'],groups=divisions.map(function(name){var list=standingsSort(teams.filter(function(t){return t.division===name;}).map(function(t){return {id:t.id,name:t.name,rec:g.standings[t.id]||{w:0,l:0,otl:0,rw:0,row:0,pts:0,gf:0,ga:0,headToHead:{}}};}));return {name:name,conference:['Atlantic','Metro'].indexOf(name)>=0?'Eastern':'Western',teams:list};});
    var qualified={};['Eastern','Western'].forEach(function(conf){var confGroups=groups.filter(function(x){return x.conference===conf;});confGroups.forEach(function(group){group.teams.slice(0,3).forEach(function(r){qualified[r.id]='DIV';});});var wildcards=standingsSort(confGroups.reduce(function(all,group){return all.concat(group.teams.slice(3));},[]));wildcards.slice(0,2).forEach(function(r){qualified[r.id]='WC';});});
    function table(group){return '<section class="division-standings panel"><header><span class="division-ribbon">'+group.conference.toUpperCase()+' CONFERENCE</span><h3>'+group.name+' Division</h3><small>Top three qualify · wild cards come from conference standings</small></header><div class="player-table-wrap"><table class="standing-table"><thead><tr><th>#</th><th>TEAM</th><th>GP</th><th>W</th><th>RW</th><th>ROW</th><th>L</th><th>OTL</th><th>PTS</th><th>DIFF</th></tr></thead><tbody>'+group.teams.map(function(r,i){var tag=qualified[r.id]||'',badge=tag==='DIV'?'<small class="playoff-seed-tag">DIVISION LINE</small>':tag==='WC'?'<small class="playoff-seed-tag wild-card-tag">WILD CARD</small>':'';return '<tr class="'+(r.id===g.team?'user-team ':'')+(tag?'playoff-line':'')+'"><td>'+String(i+1).padStart(2,'0')+'</td><td>'+officeMark(r.id,'standings-crest')+'<span>'+esc(r.name)+'</span>'+badge+'</td><td>'+((r.rec.w||0)+(r.rec.l||0)+(r.rec.otl||0))+'</td><td>'+r.rec.w+'</td><td>'+(r.rec.rw||0)+'</td><td>'+(r.rec.row||0)+'</td><td>'+r.rec.l+'</td><td>'+r.rec.otl+'</td><td><strong>'+r.rec.pts+'</strong></td><td>'+((r.rec.gf-r.rec.ga)>0?'+':'')+(r.rec.gf-r.rec.ga)+'</td></tr>';}).join('')+'</tbody></table></div></section>';}
    var conferences=['Eastern','Western'].map(function(name){return '<section class="conference-standings"><header><p class="section-kicker">NHL · '+seasonLabel(g)+'</p><h2>'+name+' Conference</h2></header><div class="division-standings-grid">'+groups.filter(function(x){return x.conference===name;}).map(table).join('')+'</div></section>';}).join('');
    $('office-content').innerHTML='<div class="standings-page">'+officeHeader('League race','NHL Standings','The playoff picture follows the NHL format: the top three clubs in each division qualify, plus two wild cards from each conference.')+'<div class="standings-note"><span>'+Math.min(g.day,seasonGameCount(g))+' / '+seasonGameCount(g)+' GAMES</span><span>PLAYOFF PICTURE · 3 PER DIVISION + 2 WILD CARDS PER CONFERENCE</span></div>'+conferences+'</div>';
  }  function renderHistory(g) {
    $('office-content').innerHTML=('<section class="panel"><div class="panel-head"><div><p class="section-kicker">'+team(g.team).name.toUpperCase()+' · THE RECORD</p><h2>Franchise history</h2><p>Every season, series, transaction and turning point is saved here.</p></div><span class="small-badge">YEAR ')+String(g.season).padStart(2,'0')+' / 25</span></div>'+(g.history.length?'<div class="history-list">'+g.history.slice().reverse().map(function(h){return '<article class="history-item"><time>'+esc(h.year)+'</time><p>'+esc(h.text)+'</p><small>'+esc(h.tag||'FRONT OFFICE')+'</small></article>';}).join('')+'</div>':'<div class="season-end"><strong>The story is yours to write.</strong><p>Game results, draft choices, trades, playoff runs and banners will appear here as the franchise moves forward.</p></div>')+'</section>';
  }
