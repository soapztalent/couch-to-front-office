  }
  function writeSave(g){
    var json,savedAt=Date.now(),summary;
    try{json=JSON.stringify(compactGameForSave(g));summary=saveSummary(g,savedAt);}catch(e){return Promise.resolve({ok:false,error:'the franchise could not be serialised ('+(e&&e.message||e)+')'});}
    var gzip=saveCanGzip()?saveGzip(json).catch(function(){return null;}):Promise.resolve(null);
    return gzip.then(function(gz){
      var record={format:SAVE_FORMAT,savedAt:savedAt,encoding:gz?'gzip':'json',data:gz||json,bytes:gz?gz.byteLength:json.length,rawBytes:json.length,summary:summary};
      return saveDbRequest('readwrite',function(store){return store.put(record,STORAGE_KEY);}).then(function(){
        writeSaveMeta(summary,'IndexedDB',record.bytes);try{localStorage.removeItem(STORAGE_KEY);}catch(e){}
        return {ok:true,where:'IndexedDB',bytes:record.bytes,rawBytes:json.length};
      },function(dbError){
        try{return writeLocalSave(json,savedAt,summary,gz);}
        catch(lsError){return {ok:false,error:'IndexedDB: '+(dbError&&dbError.message||dbError)+'; localStorage: '+(lsError&&lsError.name==='QuotaExceededError'?'storage quota exceeded':(lsError&&lsError.message||lsError))};}
      });
    });
  }
  function updateSaveStateLabel(r){var el=$('save-state');if(!el||!r)return;el.textContent=r.ok?'Auto-saved '+new Date().toLocaleTimeString([], {hour:'numeric',minute:'2-digit'})+' · '+r.where+' · '+saveSizeLabel(r.bytes):'Auto-save failed: '+r.error+'. Use Export to keep a copy.';}
  function flushSave(){
    if(saveState.timer){clearTimeout(saveState.timer);saveState.timer=null;}
    if(saveState.writing)return saveState.writing.then(function(){return saveState.dirty?flushSave():saveState.lastResult;});
    var g=current.game;saveState.dirty=false;if(!g)return Promise.resolve(null);
    var done=function(r){saveState.writing=null;saveState.lastResult=r;updateSaveStateLabel(r);return r;};
    saveState.writing=writeSave(g).then(done,function(e){return done({ok:false,error:String(e&&e.message||e)});});
    return saveState.writing;
  }
  // Auto-save: every call marks the franchise dirty; the write happens shortly after the burst of changes ends.
  function persist(){if(!current.game)return;saveState.dirty=true;if(saveState.timer)clearTimeout(saveState.timer);saveState.timer=setTimeout(function(){saveState.timer=null;flushSave();},700);}
  function persistOnLeave(){if(!current.game||!(saveState.dirty||saveState.timer))return;flushSave();try{var savedAt=Date.now(),json=JSON.stringify(compactGameForSave(current.game));if(json.length<4500000)writeLocalSave(json,savedAt,saveSummary(current.game,savedAt),null);}catch(e){}}
  window.addEventListener('pagehide',persistOnLeave);
  document.addEventListener('visibilitychange',function(){if(document.visibilityState==='hidden'&&current.game&&(saveState.dirty||saveState.timer))flushSave();});
  function parseLocalSave(raw){if(!raw)return null;try{return JSON.parse(raw);}catch(e){return null;}}
  function gameFromLocalRecord(p){if(!p)return Promise.resolve(null);if(p.cfoSave){if(p.encoding==='gzip-base64')return saveGunzip(saveFromBase64(p.data)).then(function(t){return {game:JSON.parse(t),where:'localStorage',savedAt:p.savedAt};});return Promise.resolve({game:p.game,where:'localStorage',savedAt:p.savedAt});}return Promise.resolve({game:p,where:'localStorage (older save)',savedAt:0});}
  function readStoredSave(){
    var rawCurrent=null,rawLegacy=null,local=null,localCorrupt=false;
    try{rawCurrent=localStorage.getItem(STORAGE_KEY);rawLegacy=localStorage.getItem(LEGACY_STORAGE_KEY);}catch(e){rawCurrent=null;rawLegacy=null;}
    if(rawCurrent){try{local=JSON.parse(rawCurrent);}catch(e){localCorrupt=true;}}
    if(!local&&rawLegacy){try{local=JSON.parse(rawLegacy);}catch(e){localCorrupt=true;}}
    var localAt=local&&local.cfoSave?Number(local.savedAt)||0:0;
    return saveDbRequest('readonly',function(store){return store.get(STORAGE_KEY);}).catch(function(){return null;}).then(function(rec){
      if(rec&&rec.data!=null&&(!local||(Number(rec.savedAt)||0)>=localAt)){
        var text=rec.encoding==='gzip'?saveGunzip(rec.data):Promise.resolve(typeof rec.data==='string'?rec.data:JSON.stringify(rec.data));
        return text.then(function(t){return {game:JSON.parse(t),where:'IndexedDB',savedAt:rec.savedAt};}).catch(function(e){if(local)return gameFromLocalRecord(local);throw e;});
      }
      if(!(rec&&rec.data!=null)&&localCorrupt)return Promise.reject(new Error('The saved game could not be read.'));
      return gameFromLocalRecord(local);
